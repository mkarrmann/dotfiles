#!/usr/bin/env python3
"""Sync MCP definitions from plugins/custom-mcps/mcps/*.json into each
agent's native config. Idempotent — safe to re-run.

Targets:
  - Claude:   ~/.claude.json                      .mcpServers.<name>
  - Codex:    ~/.codex/config.toml               [mcp_servers.<name>]
  - Metacode: ~/.config/opencode/opencode.json    .mcp.<name>
  - Pi:       ~/.pi/agent/mcp.json                .mcpServers.<name>
  - Muse:     ~/.config/muse/settings.json        .mcpServers.<name>

Claude's target is ~/.claude.json, NOT ~/.claude/settings.json. settings.json
accepts an mcpServers key and silently ignores it -- see sync_claude.

Devmate inherits from Claude via DOTSYNC_DEVSERVER — no separate config.

For Codex we replace managed tables by name and then merge local MCP
overrides. --generate-config also renders the shared Codex template and
migrates the retired dotfiles config symlink, preserving local settings.
Desktop runs retain portable MCPs and retract work MCPs, preserving personal servers.

Usage: sync-mcps [claude|codex|metacode|pi|muse|all]   (default: all)
       sync-mcps codex --generate-config
"""

from __future__ import annotations

from collections.abc import Callable, Collection, Mapping
import json
import os
from pathlib import Path
import subprocess
import sys

from mcp_registry import (
    McpServerSpec,
    RETIRED_MCPS as RETIRED,
    for_agent,
    for_profile,
    load_mcps as _load_mcps,
    resolve_muse_settings_path,
    resolve_pi_agent_dir,
)

HOME = Path.home()
CFG = Path(os.environ.get("AGENT_CONFIG_DIR", HOME / "dotfiles" / "agent_config"))
MCP_DIR = CFG / "plugins" / "custom-mcps" / "mcps"
SKILLS_DIR = CFG / "skills"
VENDORED_SKILLS = SKILLS_DIR / "meta-powertools-vendored"
GLOBAL_RULES = CFG / "global-development-preferences.md"


def load_mcps() -> dict[str, McpServerSpec]:
    return _load_mcps(MCP_DIR)


def _write_json_atomic(path: Path, data: dict) -> None:
    """Replace *path* in one step so live agent processes never read partial JSON."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f"{path.name}.sync-mcps.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def sync_claude(
    mcps: Mapping[str, McpServerSpec],
    retired: Collection[str] = (),
    *,
    work: bool = True,
    generate: bool = False,
) -> None:
    """Register user-scope MCP servers where Claude Code actually reads them.

    ``~/.claude/settings.json`` accepts an ``mcpServers`` key and does nothing
    with it: servers written there never appear in `claude mcp list`, their
    tools are never advertised, and nothing reports the absence. The user
    scope Claude Code does read is top-level ``mcpServers`` in
    ``~/.claude.json`` -- what `claude mcp add --scope user` writes.
    """
    del work, generate
    path = HOME / ".claude.json"
    if not path.exists():
        print(f"skip claude: {path} not found")
        return
    data = json.loads(path.read_text(encoding="utf-8"))
    servers = data.setdefault("mcpServers", {})
    rendered = {name: spec.to_claude_dict() for name, spec in mcps.items()}
    removed = any(name in servers for name in retired)
    for name in retired:
        servers.pop(name, None)
    if not removed and all(servers.get(name) == spec for name, spec in rendered.items()):
        print(f"claude already current ({len(rendered)} MCPs in {path})")
    else:
        servers.update(rendered)
        _write_json_atomic(path, data)
        print(f"synced {len(rendered)} MCPs into {path}")

    # Retract misdirected copies so dead keys cannot be mistaken for live entries.
    stale = HOME / ".claude" / "settings.json"
    if not stale.exists():
        return
    settings = json.loads(stale.read_text(encoding="utf-8"))
    leftover = settings.get("mcpServers")
    if not isinstance(leftover, dict) or not leftover:
        return
    for name in set(rendered) | set(retired):
        leftover.pop(name, None)
    if not leftover:
        settings.pop("mcpServers", None)
    _write_json_atomic(stale, settings)
    print(f"removed ignored mcpServers entries from {stale}")


def sync_metacode(
    mcps: Mapping[str, McpServerSpec],
    retired: Collection[str] = (),
    *,
    work: bool = True,
    generate: bool = False,
) -> None:
    del generate
    xdg_config = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
    config_dir = Path(os.environ.get("OPENCODE_CONFIG_DIR") or xdg_config / "opencode")
    path = config_dir / "opencode.json"
    if not path.exists():
        print(f"skip metacode: {path} not found")
        return
    data = json.loads(path.read_text(encoding="utf-8"))
    mcp_block = data.setdefault("mcp", {})
    for name in retired:
        mcp_block.pop(name, None)
    for name, spec in mcps.items():
        mcp_block[name] = spec.to_metacode_dict()

    skills = data.setdefault("skills", {})
    existing_paths = skills.setdefault("paths", [])
    work_paths = [str(SKILLS_DIR), str(VENDORED_SKILLS)]
    managed_paths = set(work_paths)
    preserved = [p for p in existing_paths if p not in managed_paths]
    skills["paths"] = preserved + (work_paths if work else [])

    # Metacode does NOT read ~/.config/opencode/AGENTS.md despite the upstream
    # opencode convention; its `instructions` list is what actually loads rules.
    instructions = data.setdefault("instructions", [])
    rules = str(GLOBAL_RULES)
    if rules not in instructions:
        instructions.append(rules)

    _write_json_atomic(path, data)
    print(f"synced {len(mcps)} MCPs + skills.paths + instructions into {path}")


def sync_codex(
    mcps: Mapping[str, McpServerSpec],
    retired: Collection[str] = (),
    *,
    work: bool = True,
    generate: bool = False,
) -> None:
    # Keep TOML dependencies scoped to Codex; other agents need only stdlib.
    from codex_config import (
        GENERATED_HEADER,
        apply_mcps,
        codex_home,
        dumps,
        generate_config,
        read_config,
        write_atomic,
    )

    rendered = {name: spec.to_codex_dict() for name, spec in mcps.items()}
    if generate:
        generate_config(CFG.parent, rendered, work=work, retired=retired)
        return
    path = codex_home() / "config.toml"
    if not path.exists():
        print(f"skip codex: {path} not found")
        return
    if path.is_symlink():
        raise ValueError(f"migrate {path} first with sync-mcps codex --generate-config")
    local = read_config(path.with_name("config.local.toml"))
    data = apply_mcps(read_config(path), rendered, local, retired)
    write_atomic(path, GENERATED_HEADER + dumps(data))
    print(f"synced {len(rendered)} MCPs into {path}")


def sync_pi(
    mcps: Mapping[str, McpServerSpec],
    retired: Collection[str] = (),
    *,
    work: bool = True,
    generate: bool = False,
) -> None:
    """Register managed MCP servers in Pi's ``mcp.json``, preserving user overrides."""
    del work, generate
    agent_dir = resolve_pi_agent_dir(HOME)
    path = agent_dir / "mcp.json"
    if not agent_dir.exists() and not path.exists():
        print(f"skip pi: {agent_dir} not found")
        return
    data = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    servers = data.setdefault("mcpServers", {})
    removed = any(name in servers for name in retired)
    for name in retired:
        servers.pop(name, None)
    rendered = {
        name: spec.to_pi_dict(existing=servers.get(name))
        for name, spec in mcps.items()
    }
    if path.exists() and not removed and all(servers.get(name) == spec for name, spec in rendered.items()):
        print(f"pi already current ({len(rendered)} MCPs in {path})")
        return
    servers.update(rendered)
    _write_json_atomic(path, data)
    print(f"synced {len(rendered)} MCPs into {path}")


def sync_muse(
    mcps: Mapping[str, McpServerSpec],
    retired: Collection[str] = (),
    *,
    work: bool = True,
    generate: bool = False,
) -> None:
    """Register managed MCP servers in Muse's ``settings.json`` ``mcpServers``."""
    del work, generate
    path = resolve_muse_settings_path(HOME)
    if not path.exists():
        print(f"skip muse: {path} not found")
        return
    data = json.loads(path.read_text(encoding="utf-8"))
    servers = data.setdefault("mcpServers", {})
    removed = any(name in servers for name in retired)
    for name in retired:
        servers.pop(name, None)
    rendered = {
        name: spec.to_muse_dict(existing=servers.get(name))
        for name, spec in mcps.items()
    }
    if not removed and all(servers.get(name) == spec for name, spec in rendered.items()):
        print(f"muse already current ({len(rendered)} MCPs in {path})")
        return
    servers.update(rendered)
    _write_json_atomic(path, data)
    print(f"synced {len(rendered)} MCPs into {path}")


Adapter = Callable[..., None]

ADAPTERS: dict[str, Adapter] = {
    "claude": sync_claude,
    "codex": sync_codex,
    "metacode": sync_metacode,
    "pi": sync_pi,
    "muse": sync_muse,
}


def main() -> int:
    target = sys.argv[1] if len(sys.argv) > 1 else "all"
    if target != "all" and target not in ADAPTERS:
        print(f"unknown target: {target}", file=sys.stderr)
        return 2
    generate = sys.argv[2:] == ["--generate-config"] and target == "codex"
    if sys.argv[2:] and not generate:
        print("--generate-config is supported only for the codex target", file=sys.stderr)
        return 2
    mcps = load_mcps()
    if not mcps:
        print(f"no MCPs found under {MCP_DIR}", file=sys.stderr)
        return 1
    profile_helper = Path(__file__).resolve().parents[1] / "bin/dotfiles-profile"
    profile = subprocess.check_output([str(profile_helper)], text=True).strip()
    work = profile == "work"
    selected = for_profile(mcps, profile)
    retired = RETIRED | (set(mcps) - set(selected))
    targets = list(ADAPTERS) if target == "all" else [target]
    for name in targets:
        ADAPTERS[name](for_agent(selected, name), retired, work=work, generate=generate)
    return 0


if __name__ == "__main__":
    sys.exit(main())
