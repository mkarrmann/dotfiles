#!/usr/bin/env python3
"""Sync MCP definitions from plugins/custom-mcps/mcps/*.json into each
agent's native config. Idempotent — safe to re-run.

Targets:
  - Claude:   ~/.claude.json                     .mcpServers.<name>
  - Codex:    ~/.codex/config.toml              [mcp_servers.<name>]
  - Metacode: ~/.config/opencode/opencode.json   .mcp.<name>

Claude's target is ~/.claude.json, NOT ~/.claude/settings.json. settings.json
accepts an mcpServers key and silently ignores it -- see sync_claude.

Devmate inherits from Claude via DOTSYNC_DEVSERVER — no separate config.

For Codex we replace managed tables by name and then merge local MCP
overrides. --generate-config also renders the shared Codex template and
migrates the retired dotfiles config symlink, preserving local settings.
Desktop runs retract the managed work MCPs while retaining personal servers.

Usage: sync-mcps [claude|codex|metacode|all]   (default: all)
       sync-mcps codex --generate-config
"""

import json
import os
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CFG = Path(os.environ.get("AGENT_CONFIG_DIR", HOME / "dotfiles" / "agent_config"))
MCP_DIR = CFG / "plugins" / "custom-mcps" / "mcps"
VENDORED_SKILLS = CFG / "skills" / "meta-powertools-vendored"
GLOBAL_RULES = CFG / "global-development-preferences.md"


def load_mcps() -> dict:
    """Map server name -> spec, carrying a private ``_agents`` allowlist.

    An MCP file may set a top-level ``"agents": [...]`` to restrict itself to
    some agents. For example, native Codex gets a different diff_watch
    invocation from config.work.toml, so its definition here is limited
    to the other agents.
    """
    out = {}
    for p in sorted(MCP_DIR.glob("*.json")):
        data = json.loads(p.read_text())
        agents = data.get("agents")
        for name, spec in data.get("mcpServers", {}).items():
            spec = dict(spec)
            # These files are source; the configs they generate are per
            # machine, so a `~`-relative command is expanded here rather than
            # left to an agent that will not expand it.
            if isinstance(spec.get("command"), str):
                spec["command"] = os.path.expanduser(spec["command"])
            # Drop env entries left as unresolved ${VAR} refs. No agent
            # expands them: Codex passes them through verbatim and Claude
            # reports "Missing environment variables" on every `mcp list`.
            # The MCP process inherits the spawning environment regardless.
            env = {
                k: v
                for k, v in (spec.get("env") or {}).items()
                if not (isinstance(v, str) and v.startswith("${") and v.endswith("}"))
            }
            if env:
                spec["env"] = env
            else:
                spec.pop("env", None)
            if agents is not None:
                spec["_agents"] = list(agents)
            out[name] = spec
    return out


def for_agent(mcps: dict, agent: str) -> dict:
    """Drop entries an MCP file restricts to other agents."""
    return {
        name: {k: v for k, v in spec.items() if k != "_agents"}
        for name, spec in mcps.items()
        if spec.get("_agents") is None or agent in spec["_agents"]
    }


def _write_json_atomic(path: Path, data: dict) -> None:
    """Replace *path* in one step.

    ~/.claude.json is owned by Claude Code and rewritten by every live
    session, so a partial write would corrupt unrelated project state.
    """
    tmp = path.with_name(f"{path.name}.sync-mcps.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    os.replace(tmp, path)


def sync_claude(mcps: dict, retired=()) -> None:
    """Register user-scope MCP servers where Claude Code actually reads them.

    ``~/.claude/settings.json`` accepts an ``mcpServers`` key and does nothing
    with it: servers written there never appear in `claude mcp list`, their
    tools are never advertised, and nothing reports the absence. The user
    scope Claude Code does read is top-level ``mcpServers`` in
    ``~/.claude.json`` -- what `claude mcp add --scope user` writes. This
    script targeted the former, which left the whole bundle inert on every
    Claude and Devmate session.
    """
    path = HOME / ".claude.json"
    if not path.exists():
        print(f"skip claude: {path} not found")
        return
    data = json.loads(path.read_text())
    servers = data.setdefault("mcpServers", {})
    removed = any(name in servers for name in retired)
    for name in retired:
        servers.pop(name, None)
    if not removed and all(servers.get(name) == spec for name, spec in mcps.items()):
        print(f"claude already current ({len(mcps)} MCPs in {path})")
    else:
        servers.update(mcps)
        _write_json_atomic(path, data)
        print(f"synced {len(mcps)} MCPs into {path}")

    # Retract the misdirected copies, so the dead key cannot be mistaken for a
    # live registration by whoever next greps for one of these names.
    stale = HOME / ".claude" / "settings.json"
    if not stale.exists():
        return
    settings = json.loads(stale.read_text())
    leftover = settings.get("mcpServers")
    if not isinstance(leftover, dict) or not leftover:
        return
    for name in set(mcps) | set(retired):
        leftover.pop(name, None)
    if not leftover:
        settings.pop("mcpServers", None)
    _write_json_atomic(stale, settings)
    print(f"removed ignored mcpServers entries from {stale}")


def sync_metacode(mcps: dict, retired=(), *, work: bool = True) -> None:
    path = HOME / ".config" / "opencode" / "opencode.json"
    if not path.exists():
        print(f"skip metacode: {path} not found")
        return
    data = json.loads(path.read_text())
    mcp_block = data.setdefault("mcp", {})
    for name in retired:
        mcp_block.pop(name, None)
    for name, spec in mcps.items():
        entry = {
            "type": "local",
            "command": [spec["command"], *spec.get("args", [])],
        }
        env = spec.get("env") or {}
        if env:
            entry["environment"] = env
        mcp_block[name] = entry

    skills = data.setdefault("skills", {})
    paths = skills.setdefault("paths", [])
    vendored = str(VENDORED_SKILLS)
    if work and vendored not in paths:
        paths.append(vendored)
    elif not work:
        skills["paths"] = [p for p in paths if p != vendored]

    # Metacode does NOT read ~/.config/opencode/AGENTS.md, despite that being the
    # documented opencode convention: asked to quote a rule from it, it answered
    # NONE. The `instructions` list is what actually loads global rules -- adding
    # this entry took its startup banner from "1 rule loaded" to "2 rules loaded"
    # and the same question to YES. Absolute path, because this file is generated
    # per machine and $HOME differs between the Mac and the devservers.
    instructions = data.setdefault("instructions", [])
    rules = str(GLOBAL_RULES)
    if rules not in instructions:
        instructions.append(rules)

    path.write_text(json.dumps(data, indent=2) + "\n")
    print(f"synced {len(mcps)} MCPs + skills.paths + instructions into {path}")


def sync_codex(mcps: dict, generate: bool = False, *, work: bool = True, retired=()) -> None:
    # Keep TOML dependencies scoped to Codex; other agents need only stdlib.
    from codex_config import (
        GENERATED_HEADER,
        apply_mcps,
        codex_home,
        dumps,
        generate_config,
        read_config,
        write_atomic,
    )

    if generate:
        generate_config(CFG.parent, mcps, work=work, retired=retired)
        return
    path = codex_home() / "config.toml"
    if not path.exists():
        print(f"skip codex: {path} not found")
        return
    if path.is_symlink():
        raise ValueError(f"migrate {path} first with sync-mcps codex --generate-config")
    local = read_config(path.with_name("config.local.toml"))
    data = apply_mcps(read_config(path), mcps, local, retired)
    write_atomic(path, GENERATED_HEADER + dumps(data))
    print(f"synced {len(mcps)} MCPs into {path}")


def main() -> int:
    target = sys.argv[1] if len(sys.argv) > 1 else "all"
    if target not in ("all", "claude", "codex", "metacode"):
        print(f"unknown target: {target}", file=sys.stderr)
        return 2
    generate = sys.argv[2:] == ["--generate-config"] and target == "codex"
    if sys.argv[2:] and not generate:
        print("--generate-config is supported only for the codex target", file=sys.stderr)
        return 2
    mcps = load_mcps()
    if not mcps:
        print(f"no MCPs found under {MCP_DIR}", file=sys.stderr)
        return 1
    profile_helper = Path(__file__).resolve().parents[1] / "bin/dotfiles-profile"
    profile = subprocess.check_output([str(profile_helper)], text=True).strip()
    work = profile == "work"
    retired = set() if work else set(mcps)
    if target in ("all", "claude"):
        sync_claude(for_agent(mcps, "claude") if work else {}, retired)
    if target in ("all", "codex"):
        sync_codex(for_agent(mcps, "codex") if work else {}, generate=generate,
                   work=work, retired=retired)
    if target in ("all", "metacode"):
        sync_metacode(for_agent(mcps, "metacode") if work else {}, retired, work=work)
    return 0


if __name__ == "__main__":
    sys.exit(main())
