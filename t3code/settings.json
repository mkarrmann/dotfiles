{
  "providerInstances": {
    "omnigent-claude": {
      "driver": "acpRegistry",
      "displayName": "Omnigent \u00b7 Claude",
      "config": {
        "source": "local",
        "commandPath": "omnigent-acp",
        "commandArgs": [
          "--agent",
          "claude-native-ui"
        ]
      }
    },
    "omnigent-codex": {
      "driver": "acpRegistry",
      "displayName": "Omnigent \u00b7 Codex",
      "config": {
        "source": "local",
        "commandPath": "omnigent-acp",
        "commandArgs": [
          "--agent",
          "codex-native-ui"
        ]
      }
    },
    "codex": {
      "driver": "codex",
      "enabled": false
    },
    "claudeAgent": {
      "driver": "claudeAgent",
      "enabled": false
    }
  }
}
