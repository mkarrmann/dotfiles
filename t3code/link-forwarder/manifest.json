{
  "manifest_version": 3,
  "name": "T3 Code link forwarder",
  "description": "Opens links from T3 Code windows in Google Chrome's work profile instead of here.",
  "version": "1.1",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*.t3.localhost/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*.t3.localhost/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ]
}
