#!/usr/bin/env bash
set -euo pipefail

# Do not let one wedged AeroSpace IPC client freeze workspace startup. Layout
# verification already retries the whole operation, so timed-out mutations are
# safely observed and corrected by the next pass.
AEROSPACE_COMMAND_TIMEOUT="${AEROSPACE_COMMAND_TIMEOUT:-8}"
AEROSPACE_TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
AEROSPACE_BIN="$(command -v aerospace || true)"

aerospace() {
  local attempts=1 attempt=1 output status
  case "${1:-}" in
    list-*) attempts=3 ;;
  esac

  while [[ "$attempt" -le "$attempts" ]]; do
    if [[ -n "$AEROSPACE_TIMEOUT_BIN" ]]; then
      if output=$("$AEROSPACE_TIMEOUT_BIN" --foreground --kill-after=1 \
          "$AEROSPACE_COMMAND_TIMEOUT" "$AEROSPACE_BIN" "$@"); then
        printf '%s' "$output"
        return 0
      else
        status=$?
      fi
    else
      if output=$("$AEROSPACE_BIN" "$@"); then
        printf '%s' "$output"
        return 0
      else
        status=$?
      fi
    fi
    if [[ "$status" -eq 124 || "$status" -eq 137 ]]; then
      echo "WARNING: AeroSpace command timed out: aerospace $*" >&2
    fi
    attempt=$(( attempt + 1 ))
    [[ "$attempt" -le "$attempts" ]] && sleep 0.25
  done
  return "$status"
}

# arrange-workspaces owns workspace layout dispatch:
#   - Standard workspaces: Orchest tiles on the left, accordion on the right.
#   - Workspace 11: delegated to arrange-ws11.
#   - Workspace Z: overflow/scaffolding, intentionally left unchanged.
# Standard workspaces without Orchest windows stay as a flat accordion.
# Skips a workspace whose window set hasn't changed since its last arrangement
# and whose tree still has the right shape, to preserve manual size adjustments:
# that check only reads, so an unchanged run moves no focus. If only the split is
# off (a monitor plugged in or out, or a manual resize), it resets the split
# alone. --splits does only that, from one listing of every window, for a
# caller that knows the windows and trees are unchanged. Use --force to rebuild.
# Can be run standalone or called from startup-windows.
#
# Requires enable-normalization-flatten-containers = false so that
# single-child accordion containers persist without being auto-collapsed.
#
# AeroSpace gotchas this script works around:
#   - default-root-container-layout is 'accordion', so flatten-workspace-tree
#     resets root to accordion. We immediately override with tiles horizontal.
#   - `layout accordion` on a direct child of root changes the ROOT layout,
#     not the child's. Only use it on windows inside a nested container.
#
# Debugging: check layout state with:
#   aerospace list-windows --workspace N --format \
#     '%{window-id} %{app-name} | parent=%{window-parent-container-layout} | root=%{workspace-root-container-layout}'

SIDEBAR_TITLE_PATTERN="Orchest \\["
# Windows that must never take part in a layout, matched by title because
# AeroSpace's own classification of them is not stable. Omnigent's update
# overlay (desktop 0.10.0, web/electron/src/update_overlay.js) is a 344x1
# transparent child window created resizable:false: AeroSpace usually floats it,
# but `layout tiling` sometimes succeeds and then the accordion holds an
# invisible pane the user has to cycle past. Leaving them in place is not an
# option either — an overlay does NOT follow its parent across workspaces, so
# they pile up on whichever workspace was focused when they were created.
NON_LAYOUT_TITLE_PATTERN="^Omnigent Update$"
SIDEBAR_PERCENT=12
# How far, in points, a window may be from the split enforce_split sets.
SPLIT_TOLERANCE=4
MARKER_DIR="${ARRANGE_MARKER_DIR:-/tmp/aerospace-arrange-markers}"
ARRANGEMENT_LOCK_DIR="${ARRANGEMENT_LOCK_DIR:-/tmp/aerospace-arrangement.lock}"
ARRANGE_ATTEMPTS="${ARRANGE_ATTEMPTS:-5}"
ARRANGE_RETRY_SLEEP="${ARRANGE_RETRY_SLEEP:-1}"
FORCE=false
ENSURE_WINDOWS=false
SPLITS_ONLY=false
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ARRANGE_WS11="$SCRIPT_DIR/arrange-ws11"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force|-f) FORCE=true; shift ;;
    --ensure-windows) ENSURE_WINDOWS=true; shift ;;
    --splits) SPLITS_ONLY=true; shift ;;
    -h|--help)
      echo "Usage: arrange-workspaces [--force|--splits] [--ensure-windows] [workspace ...]"
      echo "  --force           rebuild standard workspaces even when their marker matches"
      echo "  --ensure-windows  allow specialized arrangers to provision missing windows"
      echo "  --splits          only reset sidebar | accordion splits that are off (after a"
      echo "                    monitor change), leaving trees and window sets alone"
      exit 0
      ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) break ;;
  esac
done

if [[ -z "$AEROSPACE_BIN" ]]; then
  echo "ERROR: aerospace CLI not found." >&2
  exit 1
fi
if [[ ! -x "$ARRANGE_WS11" ]]; then
  echo "ERROR: workspace 11 arranger not found: $ARRANGE_WS11" >&2
  exit 1
fi

acquire_arrangement_lock() {
  if mkdir "$ARRANGEMENT_LOCK_DIR" 2>/dev/null; then
    echo "$$" > "$ARRANGEMENT_LOCK_DIR/pid"
    return 0
  fi

  local lock_pid
  lock_pid=$(cat "$ARRANGEMENT_LOCK_DIR/pid" 2>/dev/null || true)
  if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
    echo "ERROR: workspace arrangement is already running as PID $lock_pid" >&2
    return 1
  fi

  rm -f "$ARRANGEMENT_LOCK_DIR/pid"
  if ! rmdir "$ARRANGEMENT_LOCK_DIR" 2>/dev/null || ! mkdir "$ARRANGEMENT_LOCK_DIR" 2>/dev/null; then
    echo "ERROR: could not acquire $ARRANGEMENT_LOCK_DIR" >&2
    return 1
  fi
  echo "$$" > "$ARRANGEMENT_LOCK_DIR/pid"
}

release_arrangement_lock() {
  rm -f "$ARRANGEMENT_LOCK_DIR/pid"
  rmdir "$ARRANGEMENT_LOCK_DIR" 2>/dev/null || true
}

acquire_arrangement_lock || exit 1

ORIGINAL_FOCUS=$(aerospace list-windows --focused --format '%{window-id}|%{workspace}' 2>/dev/null || true)
# Whether anything here may have moved focus; a run that only skipped leaves it be.
FOCUS_TOUCHED=false
restore_original_focus() {
  local original_wid original_ws actual_wid
  [[ "$FOCUS_TOUCHED" == true ]] || return 0
  IFS='|' read -r original_wid original_ws <<< "$ORIGINAL_FOCUS"
  if [[ -n "$original_wid" ]]; then
    aerospace focus --window-id "$original_wid" >/dev/null 2>&1 || true
    actual_wid=$(aerospace list-windows --focused --format '%{window-id}' 2>/dev/null || true)
    [[ "$actual_wid" == "$original_wid" ]] && return 0
  fi
  [[ -n "$original_ws" ]] && aerospace workspace "$original_ws" >/dev/null 2>&1 || true
}

cleanup_arrangement() {
  restore_original_focus
  release_arrangement_lock
}
trap cleanup_arrangement EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir -p "$MARKER_DIR"

# load_geometry -- read once per run, on first use:
#   MONITOR_WIDTHS: "WS WIDTH" for every workspace, the width of the monitor it
#     is on, hidden or not;
#   WINDOW_WIDTHS: "ID WIDTH" for every window, from CoreGraphics by window id
#     (AeroSpace's ids are CGWindowIDs). A hidden workspace's windows keep the
#     frames of its last layout.
MONITOR_WIDTHS=""
WINDOW_WIDTHS=""
GEOMETRY_LOADED=false
load_geometry() {
  [[ "$GEOMETRY_LOADED" == true ]] && return 0
  GEOMETRY_LOADED=true
  local geometry monitors ws_monitors
  # NSScreen.screens is what %{monitor-appkit-nsscreen-screens-id} counts, from 1.
  geometry=$(osascript -l JavaScript -e '
    ObjC.import("AppKit"); ObjC.import("CoreGraphics");
    var s = $.NSScreen.screens, out = [];
    for (var i = 0; i < s.count; i++) out.push("screen " + (i + 1) + " " + Math.round(s.objectAtIndex(i).frame.size.width));
    var list = ObjC.castRefToObject($.CGWindowListCopyWindowInfo($.kCGWindowListOptionAll, 0));
    for (var i = 0; i < list.count; i++) {
      var d = list.objectAtIndex(i);
      out.push("win " + d.objectForKey("kCGWindowNumber").js + " " +
               Math.round(d.objectForKey("kCGWindowBounds").objectForKey("Width").js));
    }
    out.join("\n")' 2>/dev/null) || return 0
  monitors=$(aerospace list-monitors --format '%{monitor-id}|%{monitor-appkit-nsscreen-screens-id}' 2>/dev/null) || return 0
  ws_monitors=$(aerospace list-workspaces --all --format '%{workspace}|%{monitor-id}' 2>/dev/null) || return 0
  WINDOW_WIDTHS=$(awk '$1 == "win" { print $2, $3 }' <<< "$geometry")
  MONITOR_WIDTHS=$({ grep '^screen ' <<< "$geometry"
                     tr '|' ' ' <<< "$monitors" | sed 's/^/monitor /'
                     tr '|' ' ' <<< "$ws_monitors" | sed 's/^/ws /'; } | awk '
    $1 == "screen" { width[$2] = $3 }
    $1 == "monitor" { screen[$2] = $3 }
    $1 == "ws" && ($3 in screen) && (screen[$3] in width) { print $2, width[screen[$3]] }')
}

# workspace_width WS -> the width of the monitor WS is on, or nothing if unknown.
workspace_width() {
  awk -v ws="$1" '$1 == ws { print $2; exit }' <<< "$MONITOR_WIDTHS"
}

# split_target WIDTH -> the accordion width for a monitor WIDTH wide, or nothing
# when the split is left to AeroSpace (an even one).
split_target() {
  local width="$1" accordion_percent=$((100 - SIDEBAR_PERCENT))
  [[ "$accordion_percent" -ne 50 ]] || return 0
  local target=$(( width * accordion_percent / 100 ))
  # Orchest windows won't shrink below ~300px. On narrow monitors the sidebar's
  # (100 - accordion_percent)% slice falls below that floor, so the sidebar keeps
  # its minimum while the absolute accordion target overflows and overlaps it.
  # Cap the accordion so the remainder always covers the sidebar minimum.
  local min_sidebar=300
  local max_accordion=$(( width - min_sidebar ))
  [[ "$target" -gt "$max_accordion" ]] && target="$max_accordion"
  echo "$target"
}

# Idempotently set the accordion column to its split_target for the monitor $ws
# is on, via an ABSOLUTE resize (no +/-): a fixed +delta nudge computed on one
# monitor does not survive a move to a different-size monitor. Safe to call on
# an already-correct layout. The workspace must be visible: `resize width N`
# sets a weight, not a width, and AeroSpace turns weights into widths only when
# it lays a workspace out, adding (width - sum of weights) / n to each. A hidden
# workspace keeps the weights of its last layout, which sum to the width of the
# monitor it was last shown on, so N lands off by half that difference.
enforce_split() {
  local ws="$1" first_accordion="$2" width target
  [[ -n "$first_accordion" ]] || return 0
  load_geometry
  width=$(workspace_width "$ws")
  [[ "$width" -gt 0 ]] 2>/dev/null || return 0
  target=$(split_target "$width")
  [[ -n "$target" ]] || return 0
  aerospace resize --window-id "$first_accordion" width "$target" 2>/dev/null || true
}

# split_off WS SIDEBAR_IDS ACCORDION_IDS -- whether WS's windows are not at the
# split enforce_split sets for its monitor: the accordion at its target and,
# with the sidebar, spanning the monitor. A workspace last laid out on another
# monitor (one unplugged since, even if plugged back in) fails the span; a manual
# resize fails the target. Assumes no horizontal gaps (aerospace.toml). False
# when anything can't be read, so an unreadable frame never moves focus.
split_off() {
  local ws="$1" sidebar_ids="$2" accordion_ids="$3" width target
  load_geometry
  width=$(workspace_width "$ws")
  [[ "$width" -gt 0 ]] 2>/dev/null || return 1
  target=$(split_target "$width")
  [[ -n "$target" ]] || return 1
  awk -v sidebars="$(echo $sidebar_ids)" -v accordion="$(head -1 <<< "$accordion_ids")" \
      -v target="$target" -v width="$width" -v tol="$SPLIT_TOLERANCE" '
    BEGIN { n = split(sidebars, s, " "); for (i = 1; i <= n; i++) sidebar[s[i]] = 1 }
    $1 in sidebar { sidebar_width += $2; found_sidebars++ }
    $1 == accordion { accordion_width = $2; found_accordion = 1 }
    function off(d) { return d > tol || -d > tol }
    END {
      if (!found_accordion || found_sidebars != n) exit 1
      exit !(off(accordion_width - target) || off(sidebar_width + accordion_width - width))
    }' <<< "$WINDOW_WIDTHS"
}

# reset_split WS FIRST_ACCORDION -- show WS, so AeroSpace lays it out for its
# monitor, then enforce its split. Focus is given back on exit.
reset_split() {
  FOCUS_TOUCHED=true
  aerospace workspace "$1" 2>/dev/null || true
  enforce_split "$1" "$2"
}

workspace_fingerprint() {
  local windows="$1"
  echo "$windows" | jq -r '.[] | "\(.["window-id"]):\(.["app-name"])"' | sort | md5 -q
}

# Try to focus a window by ID and verify focus actually landed there.
# `aerospace focus --window-id` can silently land focus on a *different*
# window when the target is phantom/transient (observed with cmux
# occasionally reporting `window-id 0`, which AeroSpace treats as a
# sentinel — focusing it from various neighbors lands on whichever window
# AeroSpace picks, not 0). Such windows also break spatial navigation
# (`focus left/right` wraps past them even with `--boundaries-action stop`)
# and confuse join-with/move. The only reliable test is to attempt the
# focus and verify the result.
focus_verified() {
  local wid="$1"
  aerospace focus --window-id "$wid" 2>/dev/null || true
  local actual
  actual=$(aerospace list-windows --focused --format '%{window-id}' 2>/dev/null)
  [[ "$actual" == "$wid" ]]
}

# Move any non-Orchest window on $ws that fails focus_verified to workspace Z.
# Orchest windows are part of the workspace contract: quarantining one makes
# its observed desktopWorkspaceId become Z and causes future opens to target Z.
# Return failure instead so the outer retry can try again without corrupting
# that binding. Returns the number of windows swept (via stdout).
sweep_unfocusable() {
  local ws="$1" windows_json="$2"
  local swept=0 wid app title
  aerospace workspace "$ws" 2>/dev/null || true
  for wid in $(echo "$windows_json" | jq -r '.[]["window-id"]'); do
    if ! focus_verified "$wid"; then
      sleep 0.2
    fi
    if ! focus_verified "$wid"; then
      sleep 0.5
    fi
    if ! focus_verified "$wid"; then
      app=$(echo "$windows_json" | jq -r --argjson wid "$wid" \
        '.[] | select(.["window-id"] == $wid) | .["app-name"] // ""')
      title=$(echo "$windows_json" | jq -r --argjson wid "$wid" \
        '.[] | select(.["window-id"] == $wid) | .["window-title"] // ""')
      if [[ "$app" == "Orchest" || "$title" == *"Orchest ["* ]]; then
        echo "  [$ws] Orchest window $wid is temporarily unfocusable; preserving it and retrying" >&2
        return 1
      else
        echo "  [$ws] sweeping unfocusable window $wid → Z" >&2
        aerospace move-node-to-workspace --window-id "$wid" Z 2>/dev/null || true
        swept=$(( swept + 1 ))
      fi
    fi
  done
  echo "$swept"
}

# Move NON_LAYOUT_TITLE_PATTERN windows off $ws. Returns 0 if any were moved.
evict_non_layout_windows() {
  local ws="$1" windows_json="$2" wid moved=1
  for wid in $(echo "$windows_json" | jq -r --arg pat "$NON_LAYOUT_TITLE_PATTERN" \
      '[.[] | select((.["window-title"] // "") | test($pat))] | .[]["window-id"]'); do
    echo "  [$ws] evicting non-layout window $wid → Z"
    FOCUS_TOUCHED=true
    aerospace move-node-to-workspace --window-id "$wid" Z 2>/dev/null || true
    moved=0
  done
  return "$moved"
}

# Bring every floating window on $ws into the tiling tree, then echo the ids
# AeroSpace still refuses to tile.
#
# AeroSpace floats what it cannot resize, and `layout tiling` is a silent no-op
# on such a window — Omnigent's per-window update overlay is created
# resizable:false, so it never leaves `floating`. Such a window can never
# satisfy layout_tree_correct, so leaving it in the layout sets burns every
# retry and strands the workspace half-built; it also defeats
# `focus --boundaries-action stop` (see discover_spatial_order). The caller
# drops what this reports rather than fighting it.
untileable_ids() {
  local ws="$1" windows_json="$2"
  local wid ids parents attempted=false

  ids=$(echo "$windows_json" | jq -r '.[]["window-id"]')
  aerospace workspace "$ws" 2>/dev/null || true

  parents=$(aerospace list-windows --workspace "$ws" \
    --format '%{window-id}|%{window-parent-container-layout}' 2>/dev/null)
  for wid in $ids; do
    [[ "$(awk -F'|' -v w="$wid" '$1==w {print $2; exit}' <<< "$parents")" == "floating" ]] || continue
    echo "    unfloating window $wid" >&2
    aerospace focus --window-id "$wid" 2>/dev/null || true
    aerospace layout tiling 2>/dev/null || true
    attempted=true
  done
  $attempted || return 0

  parents=$(aerospace list-windows --workspace "$ws" \
    --format '%{window-id}|%{window-parent-container-layout}' 2>/dev/null)
  for wid in $ids; do
    if [[ "$(awk -F'|' -v w="$wid" '$1==w {print $2; exit}' <<< "$parents")" == "floating" ]]; then
      echo "$wid"
    fi
  done
  return 0
}

# classify_windows WINDOWS_JSON -- the ids of its Orchest sidebar windows and of
# the rest, newline-separated, in sidebar_ids and accordion_ids.
classify_windows() {
  sidebar_ids=$(echo "$1" | jq -r \
    --arg pat "$SIDEBAR_TITLE_PATTERN" \
    '[.[] | select(.["window-title"] | test($pat))] | .[]["window-id"]') || true
  accordion_ids=$(echo "$1" | jq -r \
    --arg pat "$SIDEBAR_TITLE_PATTERN" \
    '[.[] | select(.["window-title"] | test($pat) | not)] | .[]["window-id"]') || true
}

# Check whether $ws is already in the desired tree shape. Returns 0 if
# correct, 1 otherwise.
#
# Desired:
#   - Mixed sidebar+accordion: root = h_tiles; sidebar windows have
#     parent = h_tiles (either root, or an h_tiles sub-container when
#     there are multiple sidebars); accordion windows have parent =
#     v_accordion (a single sub-container).
#   - Accordion-only: every window has parent = v_accordion.
layout_tree_correct() {
  local ws="$1" sidebar_ids="$2" accordion_ids="$3"

  local id_to_parent
  id_to_parent=$(aerospace list-windows --workspace "$ws" \
    --format '%{window-id}|%{window-parent-container-layout}' 2>/dev/null) || return 1

  local wid parent

  # Accordion-only: every window's parent is v_accordion
  if [[ -z "$sidebar_ids" ]]; then
    for wid in $accordion_ids; do
      parent=$(echo "$id_to_parent" | awk -F'|' -v w="$wid" '$1==w {print $2; exit}')
      [[ "$parent" == "v_accordion" ]] || return 1
    done
    return 0
  fi

  # Mixed: root must be h_tiles
  local root_layout
  root_layout=$(aerospace list-windows --workspace "$ws" \
    --format '%{workspace-root-container-layout}' 2>/dev/null | head -1)
  [[ "$root_layout" == "h_tiles" ]] || return 1

  for wid in $sidebar_ids; do
    parent=$(echo "$id_to_parent" | awk -F'|' -v w="$wid" '$1==w {print $2; exit}')
    [[ "$parent" == "h_tiles" ]] || return 1
  done
  for wid in $accordion_ids; do
    parent=$(echo "$id_to_parent" | awk -F'|' -v w="$wid" '$1==w {print $2; exit}')
    [[ "$parent" == "v_accordion" ]] || return 1
  done
  return 0
}

# Check spatial order for the mixed layout: all sidebar windows must be left of
# all accordion windows. This closes the gap left by parent-layout checks alone.
layout_order_correct() {
  local ws="$1" sidebar_ids="$2" accordion_ids="$3"

  [[ -z "$sidebar_ids" || -z "$accordion_ids" ]] && return 0

  local first_sidebar
  first_sidebar=$(echo "$sidebar_ids" | head -1)

  aerospace workspace "$ws" 2>/dev/null || true
  focus_verified "$first_sidebar" || return 1
  discover_spatial_order "$ws"

  local seen_accordion=false wid
  for wid in "${_spatial[@]}"; do
    if echo "$accordion_ids" | grep -qx "$wid"; then
      seen_accordion=true
    elif echo "$sidebar_ids" | grep -qx "$wid" && $seen_accordion; then
      return 1
    fi
  done
  return 0
}

layout_already_correct() {
  local ws="$1" sidebar_ids="$2" accordion_ids="$3"

  layout_tree_correct "$ws" "$sidebar_ids" "$accordion_ids" &&
    layout_order_correct "$ws" "$sidebar_ids" "$accordion_ids"
}

# Walk left-to-right from the currently focused window to discover the full
# spatial order of workspace $1. Results stored in global _spatial array.
#
# Three terminator conditions, all needed:
#   1. n == p — focus held at boundary (works when --boundaries-action stop
#      engages cleanly).
#   2. focus left the workspace. AeroSpace's `stop` action does not always
#      engage when an untileable floating window survived the unfloat pass:
#      focus wraps onto a NEIGHBOURING workspace, and every join-with/move the
#      caller issues afterwards then mutates that workspace's tree instead of
#      this one. Observed with Omnigent's update overlay, which flattened
#      already-correct neighbours on each failed attempt. Step back onto the
#      last in-workspace window and stop.
#   3. n already seen — focus cycled back. Final backstop.
discover_spatial_order() {
  local ws="$1"
  _spatial=()
  local p n n_ws seen w
  # Walk to leftmost
  while true; do
    p=$(aerospace list-windows --focused --format '%{window-id}' 2>/dev/null)
    aerospace focus --boundaries-action stop left 2>/dev/null
    IFS='|' read -r n n_ws <<< "$(aerospace list-windows --focused \
      --format '%{window-id}|%{workspace}' 2>/dev/null)"
    if [[ "$n_ws" != "$ws" ]]; then
      aerospace focus --window-id "$p" 2>/dev/null
      break
    fi
    [[ "$n" == "$p" ]] && break
  done
  _spatial+=("$(aerospace list-windows --focused --format '%{window-id}' 2>/dev/null)")
  # Walk right collecting; break on stop, workspace exit, OR cycle
  while true; do
    p=$(aerospace list-windows --focused --format '%{window-id}' 2>/dev/null)
    aerospace focus --boundaries-action stop right 2>/dev/null
    IFS='|' read -r n n_ws <<< "$(aerospace list-windows --focused \
      --format '%{window-id}|%{workspace}' 2>/dev/null)"
    if [[ "$n_ws" != "$ws" ]]; then
      aerospace focus --window-id "$p" 2>/dev/null
      break
    fi
    [[ "$n" == "$p" ]] && break
    seen=false
    for w in "${_spatial[@]}"; do
      [[ "$w" == "$n" ]] && { seen=true; break; }
    done
    $seen && break
    _spatial+=("$n")
  done
}

arrange_standard_workspace_once() {
  local ws="$1"

  local windows
  windows=$(aerospace list-windows --workspace "$ws" --json 2>/dev/null) || return 0

  # Before anything reads the window set — including the fingerprint, which must
  # not churn every time an overlay appears or disappears.
  if evict_non_layout_windows "$ws" "$windows"; then
    windows=$(aerospace list-windows --workspace "$ws" --json 2>/dev/null) || return 0
  fi

  local total
  total=$(echo "$windows" | jq 'length')

  [[ "$total" -lt 2 ]] && return 0

  # Skip if the window set hasn't changed since last arrangement and the tree
  # still has its shape (something else may have flattened it). The fingerprint
  # covers window IDs + app names; if nothing changed there can't be a new
  # phantom either, so we can skip the sweep too. A floating window fails the
  # tree check, so a workspace that kept an untileable one is rebuilt.
  # Order within the tree is not checked: reading it takes focus.
  local fingerprint marker_file sidebar_ids accordion_ids
  fingerprint=$(workspace_fingerprint "$windows")
  marker_file="$MARKER_DIR/ws-$ws"
  if [[ "$FORCE" != true ]] && [[ -f "$marker_file" ]] && [[ "$(cat "$marker_file")" == "$fingerprint" ]]; then
    classify_windows "$windows"
    if layout_tree_correct "$ws" "$sidebar_ids" "$accordion_ids"; then
      # A monitor change, or a manual resize, changes no window's tree.
      if [[ -n "$sidebar_ids" && -n "$accordion_ids" ]] && split_off "$ws" "$sidebar_ids" "$accordion_ids"; then
        echo "  [$ws] same windows, but the split is off; resetting it"
        reset_split "$ws" "$(echo "$accordion_ids" | head -1)"
        return 0
      fi
      echo "  [$ws] already arranged, skipping"
      return 0
    fi
    echo "  [$ws] same windows, but the layout changed; rearranging"
  fi
  FOCUS_TOUCHED=true

  # Sweep phantom/unfocusable windows to Z before computing the layout.
  # These break spatial navigation, join-with, and move commands. If any
  # were swept, re-read the window list, re-check the early-exit, and
  # re-compute the fingerprint (it's what we'll write to the marker).
  local swept
  if ! swept=$(sweep_unfocusable "$ws" "$windows"); then
    return 1
  fi
  if [[ "$swept" -gt 0 ]]; then
    windows=$(aerospace list-windows --workspace "$ws" --json 2>/dev/null) || return 0
    total=$(echo "$windows" | jq 'length')
    [[ "$total" -lt 2 ]] && return 0
    fingerprint=$(workspace_fingerprint "$windows")
  fi

  # Drop what AeroSpace will not tile. The fingerprint deliberately keeps
  # covering these ids: it is compared against the unfiltered window list by the
  # early-exit check above, so filtering it here would never match again.
  local untileable skip_json
  untileable=$(untileable_ids "$ws" "$windows")
  if [[ -n "$untileable" ]]; then
    echo "  [$ws] untileable window(s) excluded from layout: $(echo $untileable | tr '\n' ' ')"
    skip_json=$(printf '%s\n' "$untileable" \
      | jq -R -s 'split("\n") | map(select(. != "") | tonumber)')
    windows=$(echo "$windows" | jq --argjson skip "$skip_json" \
      '[.[] | select(.["window-id"] | IN($skip[]) | not)]')
    total=$(echo "$windows" | jq 'length')
    [[ "$total" -lt 2 ]] && return 0
  fi

  classify_windows "$windows"

  local accordion_count=0 sidebar_count=0
  [[ -n "$accordion_ids" ]] && accordion_count=$(echo "$accordion_ids" | wc -l | tr -d ' ')
  [[ -n "$sidebar_ids" ]] && sidebar_count=$(echo "$sidebar_ids" | wc -l | tr -d ' ')

  # Only accordion windows → flat accordion, no nesting needed
  if [[ "$sidebar_count" -eq 0 ]]; then
    if layout_already_correct "$ws" "" "$accordion_ids"; then
      echo "  [$ws] flat accordion already correct → marker only"
      echo "$fingerprint" > "$marker_file"
      return 0
    fi
    echo "  [$ws] ${accordion_count} accordion window(s), no sidebar → flat accordion"
    aerospace workspace "$ws" 2>/dev/null
    aerospace flatten-workspace-tree 2>/dev/null || true
    aerospace layout accordion vertical 2>/dev/null || true
    if layout_already_correct "$ws" "" "$accordion_ids"; then
      echo "$fingerprint" > "$marker_file"
      return 0
    fi
    echo "  [$ws] flat accordion verification failed" >&2
    return 1
  fi

  # No accordion windows → leave as-is
  if [[ "$accordion_count" -eq 0 ]]; then
    echo "  [$ws] no non-Orchest windows, skipping"
    return 0
  fi

  if layout_already_correct "$ws" "$sidebar_ids" "$accordion_ids"; then
    echo "  [$ws] sidebar+accordion already correct → enforcing split + marker"
    enforce_split "$ws" "$(echo "$accordion_ids" | head -1)"
    echo "$fingerprint" > "$marker_file"
    return 0
  fi

  echo "  [$ws] ${sidebar_count} sidebar + ${accordion_count} accordion → tiles | accordion"
  echo "    sidebar_ids: $(echo $sidebar_ids | tr '\n' ' ')"
  echo "    accordion_ids: $(echo $accordion_ids | tr '\n' ' ')"

  aerospace workspace "$ws" 2>/dev/null

  aerospace flatten-workspace-tree 2>/dev/null || true

  echo "    after flatten: $(aerospace list-windows --workspace "$ws" --format '%{window-id}:%{window-parent-container-layout}' 2>/dev/null | tr '\n' ' ')"

  # Root defaults to accordion after flatten (default-root-container-layout).
  # Set to tiles horizontal immediately so move/join commands behave correctly.
  local first_sidebar
  first_sidebar=$(echo "$sidebar_ids" | head -1)
  focus_verified "$first_sidebar" || return 1
  # Use h_tiles directly — `layout tiles horizontal` cycles through args
  # rather than setting both, so it leaves a v_accordion root as v_tiles.
  aerospace layout h_tiles 2>/dev/null || true

  echo "    after h_tiles: $(aerospace list-windows --workspace "$ws" --format '%{window-id}:%{window-parent-container-layout}' 2>/dev/null | tr '\n' ' ')"

  # Sort windows so all sidebar windows are on the left and all accordion
  # windows are on the right. Swaps accordion windows rightward past sidebar
  # windows — an interior swap between flat root-level siblings.
  # Multiple passes handle cascading cases (e.g. [acc, acc, sidebar]).
  #
  # Capped at sidebar_count * accordion_count (bubble-sort worst case) so
  # a silently-no-op'd `move right` can't infinite-loop the script.
  local swap_max=$(( sidebar_count * accordion_count ))
  local swap_iter=0
  local swap_overflow=false
  while true; do
    focus_verified "$first_sidebar" || return 1
    discover_spatial_order "$ws"
    echo "    swap scan: ${_spatial[*]}"

    local did_swap=false
    for ((idx = 0; idx < ${#_spatial[@]} - 1; idx++)); do
      local cur="${_spatial[$idx]}" nxt="${_spatial[$((idx + 1))]}"
      if echo "$accordion_ids" | grep -qx "$cur" && \
         echo "$sidebar_ids" | grep -qx "$nxt"; then
        if [[ "$swap_iter" -ge "$swap_max" ]]; then
          swap_overflow=true
          break
        fi
        swap_iter=$(( swap_iter + 1 ))
        echo "    swapping $cur right (past sidebar $nxt)"
        focus_verified "$cur" || return 1
        aerospace move right 2>/dev/null || true
        did_swap=true
        break
      fi
    done
    $swap_overflow && break
    $did_swap || break
  done
  if $swap_overflow; then
    echo "  [$ws] swap budget ($swap_max) exhausted — bailing without marker so next pass retries"
    return 1
  fi

  # Final spatial discovery after sorting. Membership is positive (in
  # accordion_ids) rather than "not a sidebar": the walk can surface ids this
  # pass does not own — an excluded untileable window, or a neighbour picked up
  # before discover_spatial_order's workspace guard stops it — and moving one of
  # those would rearrange something we were never asked to touch.
  focus_verified "$first_sidebar" || return 1
  discover_spatial_order "$ws"
  echo "    final spatial: ${_spatial[*]}"

  local spatial_accordion=()
  for wid in "${_spatial[@]}"; do
    if echo "$accordion_ids" | grep -qx "$wid"; then
      spatial_accordion+=("$wid")
    fi
  done
  local spatial_count=${#spatial_accordion[@]}
  # `${arr[*]}` on an empty array trips `set -u` in bash 3.2.
  echo "    spatial_accordion: ${spatial_accordion[*]:-} (count=$spatial_count)"

  # Build the accordion group.
  local first_accordion
  first_accordion=$(echo "$accordion_ids" | head -1)

  if [[ "$spatial_count" -gt 1 ]]; then
    local rightmost="${spatial_accordion[$((spatial_count - 1))]}"

    echo "    join-with: focusing $rightmost, join-with left"
    # Create initial 2-child container from the rightmost pair
    focus_verified "$rightmost" || return 1
    aerospace join-with left 2>/dev/null || true

    echo "    after join-with: $(aerospace list-windows --workspace "$ws" --format '%{window-id}:%{window-parent-container-layout}' 2>/dev/null | tr '\n' ' ')"

    # Verify join-with actually nested $rightmost. join-with-left silently
    # no-ops when the left neighbor isn't a joinable tiling sibling
    # (mid-creation, just-unfloated, etc.). After a successful join from
    # h_tiles root the parent is a perpendicular v_tiles sub-container; if
    # parent is still h_tiles we'd be calling `layout accordion` on a
    # root-level child and flipping ROOT to accordion (see gotcha above).
    # Bail without writing the marker so the next pass retries.
    local parent_layout
    parent_layout=$(aerospace list-windows --focused \
      --format '%{window-parent-container-layout}' 2>/dev/null)
    if [[ "$parent_layout" == "h_tiles" ]]; then
      echo "  [$ws] join-with no-op'd (parent still h_tiles); bailing before accordion to avoid root corruption"
      return 1
    fi

    # Set it to accordion
    aerospace layout accordion 2>/dev/null || true

    echo "    after layout accordion: $(aerospace list-windows --workspace "$ws" --format '%{window-id}:%{window-parent-container-layout}' 2>/dev/null | tr '\n' ' ')"

    # Move preceding windows into the accordion (right-to-left)
    for (( i = spatial_count - 3; i >= 0; i-- )); do
      focus_verified "${spatial_accordion[$i]}" || continue
      aerospace move right 2>/dev/null || true
    done
  elif [[ "$spatial_count" -eq 1 ]]; then
    # Single accordion window — create a single-child accordion container
    # using a scaffold window. We can't join the accordion with the sidebar
    # because extracting the sidebar afterward always lands it rightmost,
    # and `move left` enters the accordion rather than swapping.
    # Instead: borrow a window from Z, join it with the accordion window
    # (scaffold lands rightmost, so join-with left pairs them), set to
    # accordion, then return the scaffold. The sidebar never moves.
    # Evicted overlays live on Z, and one of those is the last thing that can
    # serve as a scaffold: it may refuse to join and would bail the whole pass.
    # Titles can contain '|' (diff titles do), so strip the two fixed fields
    # rather than splitting on the last one.
    local scaffold_wid
    scaffold_wid=$(aerospace list-windows --workspace Z \
      --format '%{window-id}|%{window-parent-container-layout}|%{window-title}' 2>/dev/null \
      | awk -F'|' -v skip="$NON_LAYOUT_TITLE_PATTERN" '
          $2 == "floating" { next }
          { title = $0; sub(/^[^|]*\|[^|]*\|/, "", title) }
          title ~ skip { next }
          { print $1; exit }')

    if [[ -n "$scaffold_wid" ]]; then
      echo "    scaffold: borrowing $scaffold_wid from Z"
      aerospace move-node-to-workspace --window-id "$scaffold_wid" "$ws" 2>/dev/null || true

      # Scaffold lands rightmost: [..., accordion, scaffold]
      if ! focus_verified "$scaffold_wid"; then
        echo "  [$ws] could not focus scaffold $scaffold_wid; returning it and bailing"
        aerospace move-node-to-workspace --window-id "$scaffold_wid" Z 2>/dev/null || true
        return 1
      fi
      aerospace join-with left 2>/dev/null || true

      # Verify the scaffold actually joined. If parent is still h_tiles,
      # join-with no-op'd (target window in transient state) — calling
      # `layout accordion` here would flip ROOT to accordion. Return the
      # scaffold and bail without the marker so the next pass retries.
      local scaffold_parent
      scaffold_parent=$(aerospace list-windows --focused \
        --format '%{window-parent-container-layout}' 2>/dev/null)
      if [[ "$scaffold_parent" == "h_tiles" ]]; then
        echo "  [$ws] scaffold join-with no-op'd; returning scaffold and bailing"
        aerospace move-node-to-workspace --window-id "$scaffold_wid" Z 2>/dev/null || true
        return 1
      fi

      aerospace layout accordion 2>/dev/null || true

      # Return scaffold — single-child accordion persists
      aerospace move-node-to-workspace --window-id "$scaffold_wid" Z 2>/dev/null || true
    else
      echo "    no scaffold window on Z, skipping single-child accordion"
      return 1
    fi
  fi

  # Group sidebar windows so root has exactly 2 children → even split
  if [[ "$sidebar_count" -gt 1 ]]; then
    focus_verified "$first_sidebar" || return 1
    for _ in $(seq 1 $((sidebar_count - 1))); do
      aerospace join-with right 2>/dev/null || true
    done
    # Set sidebar container to horizontal tiles
    aerospace layout h_tiles 2>/dev/null || true
  fi

  # Set the sidebar/accordion split for the current monitor.
  enforce_split "$ws" "$first_accordion"

  if layout_already_correct "$ws" "$sidebar_ids" "$accordion_ids"; then
    echo "$fingerprint" > "$marker_file"
    return 0
  fi

  echo "  [$ws] layout verification failed" >&2
  return 1
}

arrange_standard_workspace() {
  local ws="$1"
  local attempt=1

  while [[ "$attempt" -le "$ARRANGE_ATTEMPTS" ]]; do
    if arrange_standard_workspace_once "$ws"; then
      return 0
    fi

    if [[ "$attempt" -lt "$ARRANGE_ATTEMPTS" ]]; then
      echo "  [$ws] arrangement incomplete; retrying in ${ARRANGE_RETRY_SLEEP}s (${attempt}/${ARRANGE_ATTEMPTS})" >&2
      sleep "$ARRANGE_RETRY_SLEEP"
    fi
    attempt=$(( attempt + 1 ))
  done

  echo "  [$ws] ERROR: arrangement did not converge after ${ARRANGE_ATTEMPTS} attempt(s)" >&2
  return 1
}

arrange_workspace_by_policy() {
  local ws="$1"
  case "$ws" in
    11)
      FOCUS_TOUCHED=true
      if [[ "$ENSURE_WINDOWS" == true ]]; then
        "$ARRANGE_WS11" --ensure-windows
      else
        "$ARRANGE_WS11"
      fi
      ;;
    Z)
      echo "  [Z] overflow/scaffold workspace has no managed layout; leaving unchanged"
      ;;
    *)
      arrange_standard_workspace "$ws"
      ;;
  esac
}

# check_splits WS... -- reset the split of each WS whose tree has the sidebar |
# accordion shape but whose split is off. A tree of any other shape is left to a
# full pass. One listing of every window serves every workspace, and a workspace
# whose split is right moves no focus.
check_splits() {
  local listing ws shaped sidebar_ids accordion_ids
  listing=$(aerospace list-windows --all --json --format \
    '%{window-id}%{workspace}%{app-name}%{window-title}%{window-parent-container-layout}%{workspace-root-container-layout}' \
    2>/dev/null) || return 1
  # One line a workspace: WS, whether its tree has the shape, its sidebar ids
  # and its accordion ids (space-separated, in listing order, as classify_windows).
  while IFS=$'\t' read -r ws shaped sidebar_ids accordion_ids; do
    [[ -n "$sidebar_ids" && -n "$accordion_ids" ]] || continue
    if [[ "$shaped" != true ]]; then
      echo "  [$ws] not in its sidebar | accordion shape; leaving it to a full pass"
      continue
    fi
    if split_off "$ws" "$(tr ' ' '\n' <<< "$sidebar_ids")" "$(tr ' ' '\n' <<< "$accordion_ids")"; then
      echo "  [$ws] the split is off; resetting it"
      reset_split "$ws" "${accordion_ids%% *}"
    fi
  done < <(jq -r --args --arg pat "$SIDEBAR_TITLE_PATTERN" --arg skip "$NON_LAYOUT_TITLE_PATTERN" '
    def title: .["window-title"] // "";
    . as $all
    | $ARGS.positional[] | select(. != "11" and . != "Z") as $ws
    | [ $all[] | select(.workspace == $ws and (title | test($skip) | not)) ] as $w
    | [ $w[] | select(title | test($pat)) ] as $side
    | [ $w[] | select(title | test($pat) | not) ] as $acc
    | [ $ws,
        ( ($w | length > 0) and
          all($w[]; .["workspace-root-container-layout"] == "h_tiles") and
          all($side[]; .["window-parent-container-layout"] == "h_tiles") and
          all($acc[]; .["window-parent-container-layout"] == "v_accordion") | tostring ),
        ($side | map(.["window-id"] | tostring) | join(" ")),
        ($acc | map(.["window-id"] | tostring) | join(" ")) ]
    | @tsv' "$@" <<< "$listing")
}

# ── Main ──────────────────────────────────────────────────────────────

# Accept workspace list as args, or default to all non-empty workspaces.
workspaces=()
if [[ $# -gt 0 ]]; then
  workspaces=("$@")
else
  if ! workspace_names=$(aerospace list-workspaces --all --json 2>/dev/null \
      | jq -r '.[]["workspace"]'); then
    echo "ERROR: failed to discover AeroSpace workspaces" >&2
    exit 1
  fi
  if [[ -n "$workspace_names" ]]; then
    while IFS= read -r w; do
      workspaces+=("$w")
    done <<< "$workspace_names"
  fi
fi

if [[ "$SPLITS_ONLY" == true ]]; then
  check_splits ${workspaces[@]+"${workspaces[@]}"} || {
    echo "ERROR: could not list windows to check the splits" >&2
    exit 1
  }
  exit 0
fi

echo "Arranging workspace layouts..."
if [[ ${#workspaces[@]} -eq 0 ]]; then
  echo "No workspaces to arrange."
  exit 0
fi
failures=0
for ws in "${workspaces[@]}"; do
  if ! arrange_workspace_by_policy "$ws"; then
    failures=$(( failures + 1 ))
  fi
done
if [[ "$failures" -gt 0 ]]; then
  echo "Done with ${failures} workspace arrangement failure(s)." >&2
  exit 1
fi
echo "Done."
