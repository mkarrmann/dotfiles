#!/bin/bash
set -uo pipefail

# arrange-ws11: build the workspace 11 "dashboard" and pin it to the external
# secondary monitor.
#
#   ┌──────────────┬──────────────────────┐
#   │ Calendar 27% │ Obsidian         73% │   top row (internalfb calendar)
#   ├──────────────┴──────────────────────┤
#   │ Chat 70%              │ Orchest  30% │   bottom row (Google Chat / Orchest)
#   └──────────────────────┴──────────────┘
#
# Rows are 50/50 height; per-row width splits are TOP_LEFT_PCT / BOT_LEFT_PCT.
#
# Design notes / AeroSpace gotchas this script relies on:
#   - Directional `focus`/`join` are SPATIAL and cross monitors unpredictably
#     when the workspace lives on a side monitor. We therefore never navigate by
#     direction: window→cell placement is made deterministic by emptying the
#     workspace and re-inserting the four windows in a fixed order, then joining
#     pairs by known window-id (join-with pairs the focused window with its
#     in-column neighbour; the focused window becomes the left cell).
#   - `flatten-workspace-tree` only acts on the focused workspace and can no-op
#     if called immediately after a move; we focus a ws-11 window by id first and
#     retry until the tree is flat.
#   - `enable-normalization-opposite-orientation-for-nested-containers = true`
#     turns each join under the v_tiles root into a perpendicular h_tiles row —
#     which is exactly the grid we want, and it is normalization-stable.
#   - Resize needs the target monitor's width. We read it from AppKit NSScreen
#     (no Accessibility permission required), matching AeroSpace's
#     monitor-appkit-nsscreen-screens-id (a 1-based index into NSScreen.screens).
#
# Window identity:
#   Workspace 11 holds exactly these four windows. Anything else found there is
#   evicted to the sweep workspace, because ws 11 is deliberately absent from
#   startup-windows' managed_workspaces and none of its stray sweeps reach here.
#
#   Which window fills each slot is decided by id, not by title. A title regex
#   is ambiguous — '^Calendar\b' matches any Chrome window showing a calendar —
#   and AeroSpace's ordering of equal titles is not stable between calls, so
#   resolving the same regex twice can yield two different windows. When
#   startup-windows reserves the dashboard's Chrome windows it passes their ids
#   in WS11_CAL_WINDOW_ID / WS11_CHAT_WINDOW_ID (WS11_OBS_WINDOW_ID and
#   WS11_ORCH_WINDOW_ID are honoured too) and those win outright. Title matching
#   is only the fallback for a standalone run, and it never takes a Chrome
#   window off another workspace — it opens a fresh one instead.
#
# By default, this script only arranges the four existing dashboard windows.
# Startup passes --ensure-windows to provision any missing windows first.

AEROSPACE_COMMAND_TIMEOUT="${AEROSPACE_COMMAND_TIMEOUT:-8}"
AEROSPACE_TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
AEROSPACE_BIN="$(command -v aerospace || true)"

aerospace() {
  local attempts=1 attempt=1 output status
  case "${1:-}" in
    list-*) attempts=3 ;;
  esac
  while [[ "$attempt" -le "$attempts" ]]; do
    if [[ -n "$AEROSPACE_TIMEOUT_BIN" ]]; then
      if output=$("$AEROSPACE_TIMEOUT_BIN" --foreground --kill-after=1 \
          "$AEROSPACE_COMMAND_TIMEOUT" "$AEROSPACE_BIN" "$@"); then
        printf '%s' "$output"; return 0
      else status=$?; fi
    else
      if output=$("$AEROSPACE_BIN" "$@"); then printf '%s' "$output"; return 0; else status=$?; fi
    fi
    if [[ "$status" -eq 124 || "$status" -eq 137 ]]; then
      echo "WARNING: AeroSpace command timed out: aerospace $*" >&2
    fi
    attempt=$(( attempt + 1 ))
    [[ "$attempt" -le "$attempts" ]] && sleep 0.25
  done
  return "$status"
}

# ── Config ───────────────────────────────────────────────────────────
WS=11
SWEEP_WORKSPACE="Z"
LAPTOP_RE='Built-in|Retina'
TOP_LEFT_PCT=27   # Calendar's width share of the top row
BOT_LEFT_PCT=70   # Chat's width share of the bottom row
CHROME_APP="Google Chrome"
CAL_URL="https://www.internalfb.com/calendar"
CHAT_URL="https://chat.google.com/u/0/app/home"
# Identity matchers: app name + window-title regex. Order = TL, TR, BL, BR.
CAL_TITLE_RE='^Calendar\b'
CHAT_TITLE_RE='^Chat\b'
ORCHEST_TITLE_RE='^Orchest$'
ATTEMPTS="${WS11_ATTEMPTS:-4}"
ENSURE_WINDOWS=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ensure-windows) ENSURE_WINDOWS=true; shift ;;
    -h|--help)
      echo "Usage: arrange-ws11 [--ensure-windows]"
      echo "  --ensure-windows  launch missing dashboard windows before arranging"
      exit 0
      ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [[ -z "$AEROSPACE_BIN" ]]; then echo "ERROR: aerospace CLI not found." >&2; exit 1; fi
if ! aerospace list-windows --all &>/dev/null; then echo "ERROR: AeroSpace is not running." >&2; exit 1; fi

# ── Helpers ──────────────────────────────────────────────────────────

# Every lookup runs against one of these snapshots. Asking for %{workspace}
# here is what makes the dashboard lookups workspace-aware without paying for a
# second CLI round trip per window.
snapshot() {
  aerospace list-windows --all --json \
    --format '%{window-id}%{workspace}%{app-name}%{window-title}' 2>/dev/null
}

# resolve_window SNAPSHOT APP TITLE_RE [own|any] -> window id (or empty)
#
# A title regex is not an identity: '^Calendar\b' matches any Chrome window
# showing a calendar, not only the dashboard's. Two rules keep that from
# selecting the wrong one:
#   - preference. A window already on ws 11 wins, then one parked on the sweep
#     workspace, then (policy=any only) any remaining match. policy=own refuses
#     to take a window off a workspace somebody else owns; for the Chrome slots
#     a freshly opened URL is always a valid substitute, so stealing another
#     workspace's window is never the right trade.
#   - determinism. AeroSpace orders list-windows by title and breaks ties
#     arbitrarily — successive calls reshuffle same-titled windows — so `first`
#     on its own is not reproducible. Sorting by window id makes two runs, and
#     this script versus startup-windows, always agree on which window is "the"
#     Calendar.
resolve_window() {
  local snapshot="$1" app="$2" re="$3" policy="${4:-any}"
  jq -r \
    --arg app "$app" --arg re "$re" \
    --arg ws "$WS" --arg sweep "$SWEEP_WORKSPACE" --arg policy "$policy" '
    [ .[] | select(."app-name" == $app and ((.["window-title"] // "") | test($re))) ]
    | sort_by(.["window-id"])
    | (  (map(select(.workspace == $ws))    | first)
      // (map(select(.workspace == $sweep)) | first)
      // (if $policy == "any" then first else empty end) )
    | .["window-id"] // empty
  ' <<< "$snapshot"
}

# claimed_window SNAPSHOT ID APP LABEL -> ID when it still exists and belongs to
# APP. startup-windows hands over the ids it reserved so this script never
# re-resolves them by title. Window ids die with the app, so a value carried
# over from a stale environment must not pin the dashboard to a dead window.
claimed_window() {
  local snapshot="$1" wid="$2" app="$3" label="$4"
  [[ -n "$wid" ]] || return 1
  if [[ ! "$wid" =~ ^[0-9]+$ ]]; then
    echo "  [ws11] ignoring malformed reserved $label window id '$wid'" >&2
    return 1
  fi
  if jq -e --argjson wid "$wid" --arg app "$app" \
      'any(.[]; .["window-id"] == $wid and ."app-name" == $app)' \
      <<< "$snapshot" >/dev/null 2>&1; then
    echo "$wid"
    return 0
  fi
  echo "  [ws11] reserved $label window $wid is gone; falling back to title match" >&2
  return 1
}

# wait for a new window of APP to appear relative to BEFORE_JSON; echo its id
wait_for_new_window() {
  local app="$1" before="$2" before_ids
  before_ids=$(echo "$before" | jq -r --arg a "$app" '[.[]|select(."app-name"==$a)]|.[]["window-id"]' | sort -n)
  local _ cur new
  for _ in $(seq 1 30); do
    sleep 0.5
    cur=$(snapshot | jq -r --arg a "$app" '[.[]|select(."app-name"==$a)]|.[]["window-id"]' | sort -n)
    new=$(comm -23 <(echo "$cur") <(echo "$before_ids") | head -1)
    [[ -n "$new" ]] && { echo "$new"; return 0; }
  done
  return 1
}

open_chrome_url() {
  local url="$1" before wid
  before=$(snapshot)
  open -na "$CHROME_APP" --args --profile-directory=Default --new-window "$url" 2>/dev/null || return 1
  wid=$(wait_for_new_window "$CHROME_APP" "$before") || return 1
  echo "$wid"
}

# ensure_chrome TITLE_RE URL -> echo window id (reuse existing or open URL)
ensure_chrome() {
  local re="$1" url="$2" wid
  wid=$(resolve_window "$(snapshot)" "$CHROME_APP" "$re" own)
  if [[ -z "$wid" ]]; then
    echo "[ws11] opening Chrome $url" >&2
    wid=$(open_chrome_url "$url") || return 1
    # give the tab a moment to load its title so later runs can match it
    sleep 1
  fi
  echo "$wid"
}

# ensure_app APP_BUNDLE_OR_NAME TITLE_RE -> echo window id (launch if missing)
ensure_app_window() {
  local app="$1" re="$2" wid before
  wid=$(resolve_window "$(snapshot)" "$app" "$re" any)
  if [[ -z "$wid" ]]; then
    echo "[ws11] launching $app" >&2
    before=$(snapshot)
    open -a "$app" 2>/dev/null || true
    wid=$(wait_for_new_window "$app" "$before") \
      || wid=$(resolve_window "$(snapshot)" "$app" "$re" any)
  fi
  echo "$wid"
}

# monitor_rect MON -> "x y w h" for the target monitor in top-left-origin
# (Accessibility) coordinates, empty if unknown. AppKit is bottom-left origin
# while System Events reports window positions top-left origin, so y is flipped
# against the primary screen's height to make the two comparable in frame_of.
monitor_rect() {
  local mid="$1" nsid
  nsid=$(aerospace list-monitors --format '%{monitor-id}|%{monitor-appkit-nsscreen-screens-id}' 2>/dev/null \
    | awk -F'|' -v m="$mid" '$1==m{print $2; exit}')
  [[ -z "$nsid" ]] && return 1
  osascript -l JavaScript -e "ObjC.import('AppKit');(function(){\
var s=\$.NSScreen.screens;var i=${nsid}-1;if(i<0||i>=s.count)return '';\
var p=s.objectAtIndex(0).frame,f=s.objectAtIndex(i).frame;\
return [Math.round(f.origin.x),Math.round(p.size.height-(f.origin.y+f.size.height)),\
Math.round(f.size.width),Math.round(f.size.height)].join(' ');})()" 2>/dev/null
}

# target monitor id: external (non-main, non-laptop) > any non-main > main
select_target_monitor() {
  local lines id name ismain main_id="" ext_id="" other_id=""
  lines=$(aerospace list-monitors --format '%{monitor-id}|%{monitor-name}|%{monitor-is-main}' 2>/dev/null)
  while IFS='|' read -r id name ismain; do
    [[ -z "$id" ]] && continue
    if [[ "$ismain" == "true" ]]; then main_id="$id"; continue; fi
    if echo "$name" | grep -qE "$LAPTOP_RE"; then
      [[ -z "$other_id" ]] && other_id="$id"
    else
      [[ -z "$ext_id" ]] && ext_id="$id"
    fi
  done <<< "$lines"
  if   [[ -n "$ext_id"   ]]; then echo "$ext_id"
  elif [[ -n "$other_id" ]]; then echo "$other_id"
  else echo "$main_id"; fi
}

# Focus a specific window and verify that AeroSpace actually landed on it.
# During startup, `focus --window-id` can transiently leave focus on the
# previous workspace even when it exits successfully. Any following command
# without an explicit window id would then mutate that workspace instead.
focus_verified() {
  local wid="$1" expected_ws="$2" attempt actual
  for attempt in 1 2 3 4 5; do
    aerospace focus --window-id "$wid" 2>/dev/null || true
    sleep 0.15
    actual=$(aerospace list-windows --focused \
      --format '%{window-id}|%{workspace}' 2>/dev/null) || actual=""
    [[ "$actual" == "$wid|$expected_ws" ]] && return 0
    sleep 0.2
  done
  echo "  could not focus window $wid on workspace $expected_ws (focused: ${actual:-none})" >&2
  return 1
}

# focus a ws-11 window by id, flatten, retry until the tree is a flat v_tiles column
flatten_flat() {
  local anchor="$1" attempt nonflat root
  for attempt in 1 2 3 4 5 6; do
    focus_verified "$anchor" "$WS" || continue
    aerospace flatten-workspace-tree 2>/dev/null || true; sleep 0.35
    root=$(aerospace list-windows --workspace "$WS" --format '%{workspace-root-container-layout}' | head -1)
    if [[ "$root" != "v_tiles" ]]; then
      focus_verified "$anchor" "$WS" || continue
      aerospace layout v_tiles 2>/dev/null || true; sleep 0.2
    fi
    nonflat=$(aerospace list-windows --workspace "$WS" \
      --format '%{window-parent-container-layout}:%{workspace-root-container-layout}' \
      | awk -F: '$1!=$2{c++} END{print c+0}')
    [[ "$nonflat" -eq 0 ]] && return 0
  done
  return 1
}

# ── Resolve the four windows ─────────────────────────────────────────
# Reserved ids win outright: startup-windows already decided which Calendar and
# Chat windows are the dashboard's, and re-deriving that from titles here is
# what let a second same-titled window get pulled onto ws 11.
#
# Otherwise retry title-based resolution: window titles can be briefly empty
# right after windows appear (and AeroSpace/AX titles occasionally lag).
# Provisioning mode opens or launches missing windows only after these retries,
# so a transient blank title never causes a duplicate window to be spawned.
echo "arrange-ws11: resolving windows..."
SNAP=$(snapshot)
CAL=$(claimed_window  "$SNAP" "${WS11_CAL_WINDOW_ID:-}"  "$CHROME_APP" Calendar) || CAL=""
CHAT=$(claimed_window "$SNAP" "${WS11_CHAT_WINDOW_ID:-}" "$CHROME_APP" Chat)     || CHAT=""
OBS=$(claimed_window  "$SNAP" "${WS11_OBS_WINDOW_ID:-}"  Obsidian      Obsidian) || OBS=""
ORCH=$(claimed_window "$SNAP" "${WS11_ORCH_WINDOW_ID:-}" Orchest       Orchest)  || ORCH=""

for attempt in $(seq 1 8); do
  [[ "$attempt" -gt 1 ]] && SNAP=$(snapshot)
  [[ -z "$CAL"  ]] && CAL=$(resolve_window  "$SNAP" "$CHROME_APP" "$CAL_TITLE_RE"     own)
  [[ -z "$CHAT" ]] && CHAT=$(resolve_window "$SNAP" "$CHROME_APP" "$CHAT_TITLE_RE"    own)
  [[ -z "$OBS"  ]] && OBS=$(resolve_window  "$SNAP" Obsidian      '.'                 any)
  [[ -z "$ORCH" ]] && ORCH=$(resolve_window "$SNAP" Orchest       "$ORCHEST_TITLE_RE" any)
  [[ -n "$CAL" && -n "$CHAT" && -n "$OBS" && -n "$ORCH" ]] && break
  sleep 1
done
if [[ "$ENSURE_WINDOWS" == true ]]; then
  [[ -z "$CAL"  ]] && CAL=$(ensure_chrome "$CAL_TITLE_RE" "$CAL_URL")
  [[ -z "$CHAT" ]] && CHAT=$(ensure_chrome "$CHAT_TITLE_RE" "$CHAT_URL")
  [[ -z "$OBS"  ]] && OBS=$(ensure_app_window "Obsidian" '.')
  [[ -z "$ORCH" ]] && ORCH=$(ensure_app_window "Orchest" "$ORCHEST_TITLE_RE")
fi
echo "  cal(TL)=$CAL obs(TR)=$OBS chat(BL)=$CHAT orch(BR)=$ORCH"

missing=0
for pair in "Calendar $CAL" "Obsidian $OBS" "Chat $CHAT" "Orchest $ORCH"; do
  set -- $pair
  [[ -z "${2:-}" ]] && { echo "WARNING: [ws11] $1 window not found" >&2; missing=1; }
done

# Two slots resolving to one window would make the grid unbuildable in a way
# that is hard to read off the failure. Only reachable via bad reserved ids,
# since the four matchers are mutually exclusive.
if [[ "$missing" -eq 0 ]] &&
   [[ "$(printf '%s\n' "$CAL" "$OBS" "$CHAT" "$ORCH" | sort -u | wc -l)" -ne 4 ]]; then
  echo "WARNING: [ws11] slots collide on one window (cal=$CAL obs=$OBS chat=$CHAT orch=$ORCH)" >&2
  missing=1
fi

if [[ "$missing" -ne 0 ]]; then
  if [[ "$ENSURE_WINDOWS" == true ]]; then
    echo "arrange-ws11: some windows are still missing; placing those found on workspace $WS" >&2
    for wid in "$CAL" "$OBS" "$CHAT" "$ORCH"; do
      [[ -n "$wid" ]] && aerospace move-node-to-workspace --window-id "$wid" "$WS" 2>/dev/null || true
    done
  else
    echo "arrange-ws11: existing-window mode leaves an incomplete dashboard unchanged" >&2
  fi
  exit 1
fi

# ── Place ws 11 on the external secondary monitor ────────────────────
TARGET_MON=$(select_target_monitor)
if [[ -n "$TARGET_MON" ]]; then
  echo "arrange-ws11: pinning workspace $WS to monitor $TARGET_MON"
  aerospace move-workspace-to-monitor --workspace "$WS" "$TARGET_MON" 2>/dev/null || true
fi

# Read once, up front: frame_of needs it to attribute geometry, and the resize
# step needs the width. Same single osascript call the old monitor_width made.
MON_X=0; MON_Y=0; MON_W=0; MON_H=0
if mon_rect=$(monitor_rect "$TARGET_MON") && [[ -n "$mon_rect" ]]; then
  read -r MON_X MON_Y MON_W MON_H <<< "$mon_rect"
fi

# ── Build the 2×2 (deterministic; verify by geometry when available) ──
build_grid() {
  # 1. empty ws 11, then re-insert in a fixed order -> deterministic column.
  #    Evacuating *every* current resident, not just the four, is what enforces
  #    the exact-four contract: ws 11 is absent from startup-windows'
  #    managed_workspaces, so none of its stray sweeps ever look here and
  #    anything that drifted in would otherwise stay forever.
  local wid residents foreign evacuate
  residents=$(aerospace list-windows --workspace "$WS" --format '%{window-id}' 2>/dev/null)
  # residents is an intentional whitespace-delimited id list.
  # shellcheck disable=SC2086
  foreign=$(comm -23 \
    <(printf '%s\n' $residents | sort -u) \
    <(printf '%s\n' "$CAL" "$OBS" "$CHAT" "$ORCH" | sort -u))
  for wid in $foreign; do
    echo "  evicting foreign window $wid from workspace $WS to $SWEEP_WORKSPACE"
  done
  # shellcheck disable=SC2086
  evacuate=$(printf '%s\n' $residents "$CAL" "$OBS" "$CHAT" "$ORCH" | awk 'NF && !seen[$0]++')
  for wid in $evacuate; do
    aerospace move-node-to-workspace --window-id "$wid" "$SWEEP_WORKSPACE" 2>/dev/null || true
  done
  sleep 0.3
  for wid in "$CAL" "$OBS" "$CHAT" "$ORCH"; do
    aerospace move-node-to-workspace --window-id "$wid" "$WS" 2>/dev/null || true; sleep 0.15
  done
  sleep 0.2
  # 2. flatten to a v_tiles column [CAL, OBS, CHAT, ORCH] top->bottom
  flatten_flat "$CAL" || { echo "  flatten did not converge" >&2; return 1; }
  # 3. join top pair, then bottom pair (focused window becomes the left cell)
  focus_verified "$CAL" "$WS" || return 1
  aerospace join-with down 2>/dev/null || true; sleep 0.3
  focus_verified "$CHAT" "$WS" || return 1
  aerospace join-with down 2>/dev/null || true; sleep 0.3
  # ws 11 must now hold exactly the four dashboard windows, all under h_tiles
  # rows. One query answers both; a late arrival that slipped in during the
  # build fails membership here and the next attempt evicts it.
  local rows nonrow actual expected
  rows=$(aerospace list-windows --workspace "$WS" \
    --format '%{window-id}|%{window-parent-container-layout}' 2>/dev/null)
  nonrow=$(awk -F'|' 'NF && $2!="h_tiles"{c++} END{print c+0}' <<< "$rows")
  actual=$(awk -F'|' 'NF{print $1}' <<< "$rows" | sort -n | tr '\n' ' ')
  expected=$(printf '%s\n' "$CAL" "$OBS" "$CHAT" "$ORCH" | sort -n | tr '\n' ' ')
  if [[ "$actual" != "$expected" ]]; then
    echo "  workspace $WS holds [${actual% }], expected [${expected% }]" >&2
    return 1
  fi
  [[ "$nonrow" -eq 0 ]]
}

# System Events geometry cache: "title\tx\ty\tw\th" (best-effort; may be empty),
# plus the ws-11 id->title map. Both are read once per verification pass;
# frame_of used to re-query AeroSpace on every lookup, a dozen round trips a pass.
GEOM=""
WS_TITLES=""
refresh_geom() {
  WS_TITLES=$(aerospace list-windows --workspace "$WS" \
    --format '%{window-id}|%{window-title}' 2>/dev/null)
  GEOM=$(osascript <<'OSA' 2>/dev/null
set out to ""
repeat with appName in {"Google Chrome", "Obsidian", "Orchest"}
  try
    tell application "System Events" to tell process (appName as string)
      repeat with w in windows
        set p to position of w
        set s to size of w
        set out to out & (name of w) & "\t" & (item 1 of p) & "\t" & (item 2 of p) & "\t" & (item 1 of s) & "\t" & (item 2 of s) & linefeed
      end repeat
    end tell
  end try
end repeat
return out
OSA
)
}
# Titles can contain '|' (diff titles do), so strip only the first field.
title_of() { awk -F'|' -v w="$1" '$1==w{sub(/^[^|]*\|/, ""); print; exit}' <<< "$WS_TITLES"; }

# frame_of ID -> "x y w h", empty when geometry cannot be pinned to exactly one
# window. A title is not unique — any other Chrome window showing a calendar
# carries the same name — and AeroSpace parks every window of a hidden
# workspace at one shared off-screen point, so a title-only match can silently
# hand back a different workspace's frame and make this check lie in either
# direction. Accept only a candidate lying on the dashboard monitor, and only
# when it is the sole one; otherwise report "unavailable" and let the caller
# fall back to trusting the deterministic build.
frame_of() {
  local t candidates
  t=$(title_of "$1")
  [[ -z "$t" ]] && return 0
  candidates=$(awk -F'\t' -v t="$t" '$1==t{print $2,$3,$4,$5}' <<< "$GEOM")
  if [[ -n "$candidates" && "$MON_W" -gt 0 ]]; then
    candidates=$(awk -v mx="$MON_X" -v my="$MON_Y" -v mw="$MON_W" -v mh="$MON_H" \
      '$1>=mx-1 && $2>=my-1 && $1+$3<=mx+mw+1 && $2+$4<=my+mh+1' <<< "$candidates")
  fi
  [[ -z "$candidates" ]] && return 0
  [[ "$(wc -l <<< "$candidates")" -eq 1 ]] || return 0
  printf '%s\n' "$candidates"
}

# verify cells via geometry; returns 0 if CAL=TL OBS=TR CHAT=BL ORCH=BR, 1 if wrong,
# 2 if geometry unavailable (cannot tell)
TOL=80
VC_MINX=0; VC_MINY=0
cell_of() {
  set -- $1
  local c=""
  [[ ${2} -le $((VC_MINY+TOL)) ]] && c="T" || c="B"
  [[ ${1} -le $((VC_MINX+TOL)) ]] && c="${c}L" || c="${c}R"
  echo "$c"
}
verify_cells() {
  refresh_geom
  [[ -z "$GEOM" ]] && return 2
  local f_cal f_obs f_chat f_orch f x y
  f_cal=$(frame_of "$CAL");   f_obs=$(frame_of "$OBS")
  f_chat=$(frame_of "$CHAT"); f_orch=$(frame_of "$ORCH")
  VC_MINX=""; VC_MINY=""
  for f in "$f_cal" "$f_obs" "$f_chat" "$f_orch"; do
    set -- $f; x="${1:-}"; y="${2:-}"
    [[ -z "$x" ]] && return 2
    [[ -z "$VC_MINX" || $x -lt $VC_MINX ]] && VC_MINX=$x
    [[ -z "$VC_MINY" || $y -lt $VC_MINY ]] && VC_MINY=$y
  done
  [[ "$(cell_of "$f_cal")" == "TL" && "$(cell_of "$f_obs")" == "TR" \
     && "$(cell_of "$f_chat")" == "BL" && "$(cell_of "$f_orch")" == "BR" ]]
}

built=0
for attempt in $(seq 1 "$ATTEMPTS"); do
  echo "arrange-ws11: building grid (attempt $attempt/$ATTEMPTS)"
  if ! build_grid; then continue; fi
  verify_cells; rc=$?
  if [[ "$rc" -eq 0 ]]; then built=1; break; fi
  if [[ "$rc" -eq 2 ]]; then
    echo "  geometry unavailable; trusting deterministic build" >&2
    built=1; break
  fi
  echo "  cell verification failed; retrying" >&2
done
[[ "$built" -ne 1 ]] && { echo "arrange-ws11: grid build did not converge" >&2; exit 1; }

# ── Resize to the configured proportions (width from AppKit) ─────────
WIDTH="$MON_W"
if [[ "$WIDTH" -gt 0 ]]; then
  resize_left() { # LEFT_ID PCT
    local delta=$(( WIDTH * $2 / 100 - WIDTH / 2 )) arg
    [[ $delta -ge 0 ]] && arg="+$delta" || arg="$delta"
    echo "arrange-ws11: resize win $1 -> width $arg (${2}% of ${WIDTH})"
    aerospace resize --window-id "$1" width "$arg" 2>/dev/null || true; sleep 0.2
  }
  resize_left "$CAL" "$TOP_LEFT_PCT"
  resize_left "$CHAT" "$BOT_LEFT_PCT"
else
  echo "arrange-ws11: could not read monitor width; leaving rows at 50/50" >&2
fi

echo "arrange-ws11: done."
