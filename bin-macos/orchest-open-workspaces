#!/usr/bin/env bash
set -euo pipefail

# Opens Orchest workspace windows on the correct AeroSpace workspaces.
# Launches Orchest if not running, creates missing workspaces, opens windows,
# and corrects any misplaced windows.
#
# Called by startup-windows, but can also be invoked independently.

ORCHEST_PORT=3100
ORCHEST_LOG="${ORCHEST_LOG:-/tmp/orchest.log}"
ORCHEST_MANAGED_WORKSPACES=(1 2 3 4 5 6 7 8)
ORCHEST_DIR="${HOME}/dev/orchest"
ORCHEST_DESKTOP_DIR="${ORCHEST_DIR}/apps/desktop"
ORCHEST_PROD_ENTRY="${ORCHEST_DESKTOP_DIR}/out/main/index.js"

MODE=dev
ACTION=open
while [[ $# -gt 0 ]]; do
  case "$1" in
    --prod) MODE=prod; shift ;;
    --dev)  MODE=dev;  shift ;;
    --reconcile-only) ACTION=reconcile; shift ;;
    --verify-only)    ACTION=verify; shift ;;
    -h|--help)
      echo "Usage: orchest-open-workspaces [--dev|--prod] [--reconcile-only|--verify-only]"
      echo "  --dev   (default) launch via 'pnpm dev' with HMR"
      echo "  --prod  launch built Electron app from apps/desktop/out/ (lower memory, no HMR)"
      echo "  --reconcile-only  repair existing Orchest window placements without opening windows"
      echo "  --verify-only     verify window placements and persisted desktop bindings"
      exit 0
      ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

orchest_health() {
  local response status body curl_status=0
  response=$(curl --silent --show-error --noproxy '*' \
    --connect-timeout 1 --max-time 2 --write-out '\n%{http_code}' \
    "http://127.0.0.1:${ORCHEST_PORT}/health" 2>/dev/null) || curl_status=$?
  if [[ "$curl_status" == 7 ]]; then
    orchest_state=absent
    return 0
  elif [[ "$curl_status" != 0 ]]; then
    echo "WARNING: [Orchest] cannot check port ${ORCHEST_PORT} (curl exit ${curl_status}); inspect the listener before retrying" >&2
    return 1
  fi

  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if ! printf '%s' "$body" | jq -se --arg status "$status" '
    length == 1 and (.[0] |
      type == "object" and .service == "orchest" and
      .protocolVersion == 1 and .shell == "desktop" and
      (.pid | type == "number" and . > 0 and floor == .) and
      (($status == "200" and .ready == true) or
       ($status == "503" and .ready == false)))
  ' >/dev/null 2>&1; then
    echo "WARNING: [Orchest] port ${ORCHEST_PORT} does not expose a compatible Orchest desktop /health endpoint (HTTP ${status}); inspect the listener. For an older Orchest build, rebuild and explicitly restart it before retrying" >&2
    return 1
  fi
  if [[ "$status" == 200 ]]; then
    orchest_state=ready
  else
    orchest_state=starting
  fi
}

# The CLI's own bin, run from its package as `pnpm --filter @orchest/cli
# orchest` runs it, without pnpm's ~0.4s a call.
orchest_cli() {
  if command -v node >/dev/null 2>&1 && [[ -f "$ORCHEST_DIR/apps/cli/bin/orchest.js" ]]; then
    (cd "$ORCHEST_DIR/apps/cli" && node bin/orchest.js "$@")
  else
    (cd "$ORCHEST_DIR" && pnpm --silent --filter @orchest/cli orchest "$@")
  fi
}

launched_pid=
launch_orchest_dev() {
  (
    cd "$ORCHEST_DIR"
    exec env ORCHEST_PROVIDER=macos-aerospace nohup pnpm dev
  ) </dev/null > "$ORCHEST_LOG" 2>&1 &
  launched_pid=$!
}

launch_orchest_prod() {
  (
    cd "$ORCHEST_DESKTOP_DIR"
    exec env ORCHEST_PROVIDER=macos-aerospace nohup pnpm exec electron .
  ) </dev/null > "$ORCHEST_LOG" 2>&1 &
  launched_pid=$!
}

orchest_launch_alive() {
  local launch_status=0
  if [[ -n "$launched_pid" ]] && ! jobs -pr | grep -qx "$launched_pid"; then
    wait "$launched_pid" || launch_status=$?
    echo "WARNING: [Orchest] launch process exited before readiness (status ${launch_status}); see ${ORCHEST_LOG}" >&2
    return 1
  fi
}

failures=0
orchest_health || exit 1
if [[ "$orchest_state" == absent ]]; then
  if [[ "$ACTION" != open ]]; then
    echo "WARNING: [Orchest] is not running; cannot ${ACTION} workspace placement" >&2
    exit 1
  fi
  if [[ "$MODE" == "prod" ]]; then
    if [[ ! -f "$ORCHEST_PROD_ENTRY" ]]; then
      echo "[Orchest] no prod build found, running 'pnpm -r build'..."
      if ! (cd "$ORCHEST_DIR" && pnpm -r build); then
        echo "WARNING: [Orchest] build failed" >&2
        exit 1
      fi
    fi
    echo "[Orchest] launching (prod)..."
    launch_orchest_prod
  else
    echo "[Orchest] launching (dev)..."
    launch_orchest_dev
  fi
fi

if [[ "$orchest_state" != ready ]]; then
  deadline=$((SECONDS + 20))
  while [[ "$SECONDS" -lt "$deadline" ]]; do
    orchest_launch_alive || exit 1
    orchest_health || exit 1
    orchest_launch_alive || exit 1
    [[ "$orchest_state" == ready ]] && break
    sleep 0.5
  done
  if [[ "$orchest_state" != ready ]]; then
    echo "WARNING: [Orchest] did not become ready within 20s; see ${ORCHEST_LOG}. Inspect the existing instance before retrying" >&2
    exit 1
  fi
fi

workspace_json='[]'
# slot_table: "SLOT ID DESKTOP_WORKSPACE" for each managed slot's workspace in
# workspace_json, "-" for what it lacks; read without a process per lookup.
slot_table=""
build_slot_table() {
  slot_table=$(echo "$workspace_json" | jq -r --arg slots "${ORCHEST_MANAGED_WORKSPACES[*]}" '
    . as $all | ($slots | split(" "))[] as $slot
    | ([$all[] | select(.label == "Workspace \($slot)")] | first) as $w
    | "\($slot) \($w.id // "-") \($w.desktopWorkspaceId // "-")"')
}

# slot_field SLOT FIELD -> FIELD (2: workspace id, 3: its persisted desktop workspace).
slot_field() {
  local slot id desktop
  while read -r slot id desktop; do
    [[ "$slot" == "$1" ]] || continue
    case "$2" in
      2) [[ "$id" == - ]] || printf '%s\n' "$id" ;;
      3) [[ "$desktop" == - ]] || printf '%s\n' "$desktop" ;;
    esac
    return 0
  done <<< "$slot_table"
}

workspace_json_fresh=false

refresh_workspace_json() {
  local candidate _attempt
  for _attempt in 1 2 3 4 5; do
    if candidate=$(orchest_cli workspace list --json 2>/dev/null) && \
       echo "$candidate" | jq -e 'type == "array"' >/dev/null 2>&1; then
      workspace_json="$candidate"
      workspace_json_fresh=true
      build_slot_table
      return 0
    fi
    sleep 0.4
  done
  echo "WARNING: [Orchest] could not read workspace state" >&2
  return 1
}

if ! refresh_workspace_json; then
  exit 1
fi

workspace_id_for_slot() {
  slot_field "$1" 2
}

# Orchest windows' titles end in their workspace's short id: "NAME — Orchest [9c47b2fa]".
orchest_aero_windows=""
refresh_orchest_aero_windows() {
  orchest_aero_windows=$(aerospace list-windows --all \
    --format '%{window-id}|%{workspace}|%{window-title}' 2>/dev/null \
    | grep 'Orchest \[' || true)
}

# workspace_window ID -> "WINDOW_ID|WORKSPACE|TITLE" of that workspace's window.
workspace_window() {
  local line
  while IFS= read -r line; do
    [[ "$line" != *"[${1%%-*}]"* ]] || { printf '%s\n' "$line"; return 0; }
  done <<< "$orchest_aero_windows"
}

# Each create, open or move this or a recent run issued may still be in flight:
# the provider persists a desktop binding on its next poll, and an open focuses
# its window. Only placements no recent request touched are taken on one look.
ACTION_STAMP="${ORCHEST_ACTION_STAMP:-${TMPDIR:-/tmp}/orchest-open-workspaces.last-action}"
ACTION_SETTLE_SECONDS=10
acted=false
note_action() {
  acted=true
  workspace_json_fresh=false
  touch "$ACTION_STAMP" 2>/dev/null || true
}
recent_action() {
  local stamped
  [[ "$acted" != true ]] || return 0
  stamped=$(stat -f %m "$ACTION_STAMP" 2>/dev/null) || return 1
  (( $(date +%s) - stamped < ACTION_SETTLE_SECONDS ))
}

if [[ "$ACTION" == "open" ]]; then
  # Explicit bindings make first launch deterministic. Existing bindings are
  # observational and will be repaired after their windows are moved below.
  for ws in "${ORCHEST_MANAGED_WORKSPACES[@]}"; do
    label="Workspace ${ws}"
    if [[ -z "$(workspace_id_for_slot "$ws")" ]]; then
      echo "[Orchest] creating workspace \"${label}\" on desktop workspace ${ws}..."
      note_action
      orchest_cli workspace create --desktop-workspace "$ws" "$label" 2>/dev/null || {
        echo "WARNING: [Orchest] failed to create workspace \"${label}\"" >&2
        ((failures++)) || true
      }
    fi
  done

  if [[ "$workspace_json_fresh" != true ]] && ! refresh_workspace_json; then
    exit 1
  fi
  # Opening a workspace whose window is already open switches to its desktop
  # workspace and focuses that window, so only the missing ones are opened.
  refresh_orchest_aero_windows
  for ws in "${ORCHEST_MANAGED_WORKSPACES[@]}"; do
    label="Workspace ${ws}"
    ws_id=$(workspace_id_for_slot "$ws")
    if [[ -z "$ws_id" ]]; then
      echo "WARNING: [Orchest] workspace \"${label}\" is missing" >&2
      ((failures++)) || true
    elif [[ -z "$(workspace_window "$ws_id")" ]]; then
      echo "[Orchest] opening workspace \"${label}\"..."
      note_action
      orchest_cli workspace open "$ws_id" 2>/dev/null || {
        echo "WARNING: [Orchest] failed to open workspace \"${label}\"" >&2
        ((failures++)) || true
      }
    fi
  done
fi

# Verify both sources of truth: AeroSpace's current window location and the
# desktopWorkspaceId that Orchest learns from its polling provider. After a
# request that may still be in flight (recent_action), two consecutive good
# observations are required, so an open/focus request cannot undo a placement
# just after this helper returns.
reconcile_orchest_placements() {
  local allow_moves="$1" timeout="$2"
  local deadline stable_passes=0 all_good ws label ws_id match
  local aero_wid current_ws persisted_ws
  deadline=$(($(date +%s) + timeout))

  while [[ $(date +%s) -lt "$deadline" ]]; do
    if [[ "$workspace_json_fresh" != true ]] && ! refresh_workspace_json; then
      stable_passes=0
      sleep 0.75
      continue
    fi
    workspace_json_fresh=false
    refresh_orchest_aero_windows
    all_good=true

    for ws in "${ORCHEST_MANAGED_WORKSPACES[@]}"; do
      label="Workspace ${ws}"
      ws_id=$(workspace_id_for_slot "$ws")
      if [[ -z "$ws_id" ]]; then
        echo "WARNING: [Orchest] cannot find \"${label}\"" >&2
        all_good=false
        continue
      fi

      match=$(workspace_window "$ws_id")
      if [[ -z "$match" ]]; then
        echo "[Orchest] waiting for \"${label}\" window..."
        all_good=false
        continue
      fi

      IFS='|' read -r aero_wid current_ws _ <<< "$match"
      persisted_ws=$(slot_field "$ws" 3)

      if [[ "$current_ws" != "$ws" ]]; then
        all_good=false
        if [[ "$allow_moves" == true ]]; then
          echo "[Orchest] moving \"${label}\" from workspace ${current_ws} to ${ws}..."
          note_action
          if ! aerospace move-node-to-workspace --window-id "$aero_wid" "$ws" 2>/dev/null; then
            echo "WARNING: [Orchest] move of window ${aero_wid} failed" >&2
          fi
        else
          echo "[Orchest] \"${label}\" is on workspace ${current_ws}; expected ${ws}" >&2
        fi
      elif [[ "$persisted_ws" != "$ws" ]]; then
        # The provider polls every two seconds; let it observe the corrected
        # AeroSpace location before declaring the operation complete.
        [[ "$allow_moves" == true ]] || \
          echo "[Orchest] \"${label}\" persists desktop binding ${persisted_ws:-none}; expected ${ws}" >&2
        all_good=false
      fi
    done

    if $all_good; then
      stable_passes=$(( stable_passes + 1 ))
      if [[ "$stable_passes" -ge 2 ]] || ! recent_action; then
        return 0
      fi
    else
      stable_passes=0
    fi
    sleep 0.75
  done

  echo "WARNING: [Orchest] workspace placement did not converge within ${timeout}s" >&2
  return 1
}

case "$ACTION" in
  open)      reconcile_orchest_placements true 45 || ((failures++)) || true ;;
  reconcile) reconcile_orchest_placements true 30 || ((failures++)) || true ;;
  verify)    reconcile_orchest_placements false 6 || ((failures++)) || true ;;
esac

if [[ "$failures" -gt 0 ]]; then
  echo "[Orchest] done with ${failures} warning(s)."
  exit 1
else
  echo "[Orchest] done."
fi
