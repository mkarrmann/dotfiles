#!/usr/bin/env bash
set -euo pipefail

# AeroSpace's CLI can occasionally leave an individual IPC client blocked while
# newer clients continue to work. Bound every call so one stale client cannot
# freeze the entire login sequence. Read-only calls are safe to retry.
AEROSPACE_COMMAND_TIMEOUT="${AEROSPACE_COMMAND_TIMEOUT:-8}"
AEROSPACE_TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
AEROSPACE_BIN="$(command -v aerospace || true)"

aerospace() {
  local attempts=1 attempt=1 output status
  case "${1:-}" in
    list-*) attempts=3 ;;
  esac

  while [[ "$attempt" -le "$attempts" ]]; do
    if [[ -n "$AEROSPACE_TIMEOUT_BIN" ]]; then
      if output=$("$AEROSPACE_TIMEOUT_BIN" --foreground --kill-after=1 \
          "$AEROSPACE_COMMAND_TIMEOUT" "$AEROSPACE_BIN" "$@"); then
        printf '%s' "$output"
        return 0
      else
        status=$?
      fi
    else
      if output=$("$AEROSPACE_BIN" "$@"); then
        printf '%s' "$output"
        return 0
      else
        status=$?
      fi
    fi

    if [[ "$status" -eq 124 || "$status" -eq 137 ]]; then
      echo "WARNING: AeroSpace command timed out: aerospace $*" >&2
    fi
    attempt=$(( attempt + 1 ))
    [[ "$attempt" -le "$attempts" ]] && sleep 0.25
  done
  return "$status"
}

# ── Args ─────────────────────────────────────────────────────────────
ORCHEST_MODE_FLAG="--prod"
DEFERRED=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --orchest-prod) ORCHEST_MODE_FLAG="--prod"; shift ;;
    --orchest-dev)  ORCHEST_MODE_FLAG="--dev";  shift ;;
    --deferred)     DEFERRED=true;              shift ;;
    -h|--help)
      echo "Usage: startup-windows [--orchest-prod|--orchest-dev|--deferred]"
      echo "  --orchest-prod  (default) launch built Orchest from apps/desktop/out/ (lower memory)"
      echo "  --orchest-dev   launch Orchest via 'pnpm dev' with HMR"
      echo "  --deferred      open only the windows the last run left for a tunnel"
      echo "                  (bin-macos/nvs-tunnels runs it once it is through Duo)"
      exit 0
      ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

# Every line of output, the child scripts' too, starts with the time and the
# seconds since the run started, to find slow steps. The script reruns itself
# through the stamper and waits for both, so no line lands after it returns
# (bash 3.2 cannot wait on an `exec > >(...)`). STARTUP_WINDOWS_TIMESTAMPS=0
# turns it off.
if [[ "${STARTUP_WINDOWS_TIMESTAMPS:-1}" == 1 && -z "${STARTUP_WINDOWS_STAMPED:-}" ]]; then
  STARTUP_WINDOWS_STAMPED=1 PYTHONUNBUFFERED=1 "$0" "$@" 2>&1 \
    | perl -MPOSIX=strftime -MTime::HiRes=time -ne '
        BEGIN { $| = 1; $start = time }
        $now = time;
        printf "%s.%03d +%5.1fs %s", strftime("%H:%M:%S", localtime $now),
          ($now - int $now) * 1000, $now - $start, $_;'
  exit "${PIPESTATUS[0]}"
fi

# Rows whose window needs a tunnel that was not through Duo yet ("WS|TYPE", one
# a line): an Omnigent window needs the hub, a T3 Code window its devservers'
# servers. A run never waits on Duo; it records these as it exits, and the
# --deferred run each nvs-tunnels starts on connecting opens them. A full run
# starts the list over; --deferred keeps whatever still waits on a tunnel.
STARTUP_PENDING_FILE="${STARTUP_PENDING_FILE:-$HOME/.local/state/startup-windows-pending}"
pending_rows=""
# Set once this run owns the list, so an early exit leaves it as it was.
pending_ready=false
row_pending() {
  [[ $'\n'"$pending_rows"$'\n' == *$'\n'"$1"$'\n'* ]]
}
defer_row() {
  row_pending "$1" || pending_rows="${pending_rows}${pending_rows:+$'\n'}$1"
}
# A list older than this is from a day whose tunnels never came up for it, and
# opening its windows hours later would move windows in use since; it is dropped.
STARTUP_PENDING_MAX_AGE_MIN=720
read_pending_file() {
  [[ -s "$STARTUP_PENDING_FILE" ]] || return 0
  [[ -z "$(find "$STARTUP_PENDING_FILE" -mmin "+$STARTUP_PENDING_MAX_AGE_MIN" 2>/dev/null)" ]] || return 0
  cat "$STARTUP_PENDING_FILE"
}
save_pending_rows() {
  [[ "$pending_ready" == true ]] || return 0
  if [[ -z "$pending_rows" ]]; then
    rm -f "$STARTUP_PENDING_FILE"
    return 0
  fi
  mkdir -p "$(dirname "$STARTUP_PENDING_FILE")"
  printf '%s\n' "$pending_rows" > "$STARTUP_PENDING_FILE.tmp"
  mv "$STARTUP_PENDING_FILE.tmp" "$STARTUP_PENDING_FILE"
}

# AeroSpace can invoke after-startup-command more than once across a config
# reload/restart. Only one reconciler may mutate the workspace tree at a time.
# A --deferred run queues behind whichever run holds the lock, since a tunnel
# can connect while the run that deferred its windows is still going; a full
# run queues behind a --deferred one, and otherwise leaves the work to the
# running one.
STARTUP_LOCK_DIR="${STARTUP_LOCK_DIR:-/tmp/startup-windows.lock}"
STARTUP_MODE=full
[[ "$DEFERRED" != true ]] || STARTUP_MODE=deferred
# A tunnel reconnecting with nothing deferred costs no lock and no window. The
# lock is checked first: a run that holds it may yet defer rows, and saves them
# before letting it go.
if [[ "$DEFERRED" == true && ! -d "$STARTUP_LOCK_DIR" && -z "$(read_pending_file)" ]]; then
  echo "No deferred windows."
  exit 0
fi
lock_waiting=false
missing_pid_checks=0
until mkdir "$STARTUP_LOCK_DIR" 2>/dev/null; do
  lock_pid=$(cat "$STARTUP_LOCK_DIR/pid" 2>/dev/null || true)
  if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
    lock_mode=$(cat "$STARTUP_LOCK_DIR/mode" 2>/dev/null || echo full)
    if [[ "$DEFERRED" != true && "$lock_mode" != deferred ]]; then
      echo "startup-windows is already running as PID $lock_pid; exiting."
      exit 0
    fi
    [[ "$lock_waiting" == true ]] || echo "Waiting for startup-windows (PID $lock_pid) to finish..."
    lock_waiting=true
    missing_pid_checks=0
    sleep 1
    continue
  fi
  # The owner writes its pid just after taking the lock; give it a moment
  # before treating a lock without one as abandoned.
  if [[ -z "$lock_pid" ]] && (( ++missing_pid_checks < 3 )); then
    sleep 1
    continue
  fi
  # Abandoned. Moved aside in one step, so of several runs that saw it only
  # one takes it over; the others go round again.
  stale_lock="$STARTUP_LOCK_DIR.stale.$$"
  if mv "$STARTUP_LOCK_DIR" "$stale_lock" 2>/dev/null; then
    rm -rf "$stale_lock"
  fi
  missing_pid_checks=0
done
# Mode first: a run that finds the pid reads the mode next.
echo "$STARTUP_MODE" > "$STARTUP_LOCK_DIR/mode"
echo "$$" > "$STARTUP_LOCK_DIR/pid"
T3_WINDOWS_CACHE="$STARTUP_LOCK_DIR/t3-windows"
# The pending list is saved before the lock goes, so a --deferred run queued on
# the lock reads all of it.
cleanup_startup_lock() {
  save_pending_rows || true
  rm -f "$STARTUP_LOCK_DIR/pid" "$STARTUP_LOCK_DIR/mode" "$T3_WINDOWS_CACHE"
  rmdir "$STARTUP_LOCK_DIR" 2>/dev/null || true
}
trap cleanup_startup_lock EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# ── Workspace definitions ────────────────────────────────────────────
# Format: ws|type|title|title_match|...
#   ghostty:  ws|ghostty|title|title_match|workdir|command
#   cmux:     ws|cmux|title|title_match
#   chrome:   ws|chrome|title
#   omnigent: ws|omnigent|title
#   t3:       ws|t3|title   (a window on its host's T3 Code server, the Mac's for a local workspace, from bin-macos/workspaces)
# title_match is a regex used to find existing windows in AeroSpace.
# ws is the AeroSpace workspace to place the window in.
# Multiple entries can share a workspace (accordion layout toggles between them).
# Stray windows are swept to workspace "Z".
WORKSPACES=(
  "1|ghostty|Local MacOS|^Local MacOS$|~|while true; do nvim --cmd 'set title titlestring=Local\\ MacOS'; sleep 0.5; done"
  "1|chrome|Chrome: ws1"
  "1|omnigent|Omnigent: ws1"
  "1|t3|T3: ws1"
  "T|ghostty|FTW: tunnels|FTW.*tunnels|~|nvs-tunnels devvm36111.ftw0.facebook.com FTW-checkout1:~/checkout1 FTW-checkout2:~/checkout2 FTW-checkout3:~/checkout3"
  "T|ghostty|CCO: tunnels|CCO.*tunnels|~|nvs-tunnels devvm20365.cco0.facebook.com CCO-checkout1:~/checkout1 CCO-checkout2:~/checkout2 CCO-checkout3:~/checkout3 CCO-checkout4:~/checkout4"
  # No "Omnigent: tunnel" entry: mac_proxy is owned by the launchd job
  # com.mkarrmann.omnigent-tunnel so that a kill self-heals in seconds.
  # retire_omnigent_tunnel_window below closes any window left from before.
  "2|ghostty|CCO: checkout1|CCO.*checkout1\\b|~|nvs CCO-checkout1"
  "2|chrome|Chrome: ws2"
  "2|t3|T3: ws2"
  "3|ghostty|FTW: checkout1|FTW.*checkout1\\b|~|nvs FTW-checkout1"
  "3|chrome|Chrome: ws3"
  "3|t3|T3: ws3"
  "4|ghostty|CCO: checkout2|CCO.*checkout2\\b|~|nvs CCO-checkout2"
  "4|chrome|Chrome: ws4"
  "4|t3|T3: ws4"
  "5|ghostty|FTW: checkout2|FTW.*checkout2\\b|~|nvs FTW-checkout2"
  "5|chrome|Chrome: ws5"
  "5|t3|T3: ws5"
  "6|ghostty|CCO: checkout3|CCO.*checkout3\\b|~|nvs CCO-checkout3"
  "6|chrome|Chrome: ws6"
  "6|t3|T3: ws6"
  "7|ghostty|FTW: checkout3|FTW.*checkout3\\b|~|nvs FTW-checkout3"
  "7|chrome|Chrome: ws7"
  "7|t3|T3: ws7"
  "8|ghostty|CCO: checkout4|CCO.*checkout4\\b|~|nvs CCO-checkout4"
  "8|chrome|Chrome: ws8"
  "8|t3|T3: ws8"
)

# STARTUP_T3_WINDOWS=0 drops the T3 Code rows and the tunnel checks they need
# (the T3 Code forward, pairing-token minting). With the windows on, each
# tunnel also mints their pairing tokens.
STARTUP_T3_WINDOWS="${STARTUP_T3_WINDOWS:-1}"
enabled_workspaces=()
for entry in "${WORKSPACES[@]}"; do
  if [[ "$STARTUP_T3_WINDOWS" != 1 ]]; then
    [[ "$entry" == *"|t3|"* ]] || enabled_workspaces+=("$entry")
  elif [[ "$entry" =~ ^([^|]*\|ghostty\|[^|]*\|[^|]*\|[^|]*\|nvs-tunnels\ [^ ]+)(.*)$ ]]; then
    enabled_workspaces+=("${BASH_REMATCH[1]} --t3-pairing${BASH_REMATCH[2]}")
  else
    enabled_workspaces+=("$entry")
  fi
done
WORKSPACES=("${enabled_workspaces[@]}")

SWEEP_WORKSPACE="Z"

CHROME_APP="Google Chrome"
CHROME_INVALID_TITLE_PATTERN="^Who.s using Chrome\\?$"
claimed_chrome_ids=""
chrome_restore_settled=false

# Omnigent window titles are conversation names, so they carry no stable
# workspace identity. Claim windows by ID like Chrome rather than by title.
#
# The updater overlay is the one window that must be matched by title. Since
# desktop 0.10.0 every shell window gets a 344x1 transparent child window titled
# "Omnigent Update" (electron/src/update_overlay.js), deliberately kept shown
# even when the card is empty so its ResizeObserver stays alive. Overlays are
# created one window id after their parent, so ascending-id slot filling handed
# every second workspace an invisible 1px window instead of a chat window — and
# a workspace whose Omnigent slot is an overlay cannot be laid out at all.
#
# Getting them off the managed workspaces is arrange-workspaces' job
# (NON_LAYOUT_TITLE_PATTERN); an overlay does not follow its parent across
# workspaces, so nothing here can keep one next to the window it belongs to.
# Each workspace's T3 Code window is an app window of T3_BROWSER_APP, a
# Chromium of its own so that Chrome's reserved shortcuts (Cmd+N, Cmd+T, Cmd+W...)
# can be moved off T3 Code's (bin-macos/t3-browser-shortcuts) without taking them
# from your browsing, on the workspace's own origin, served by its host's one T3 Code server (a
# devserver's t3@checkouts, whose projects are every checkout there; the Mac's
# t3@local, whose project is ~/dotfiles, for workspace 1), and linked to every
# other one, so each window lists, searches and starts threads on all of them; a window this script opens starts its new
# threads in its own checkout (t3-window-scope). Titles cannot tell these windows apart (they share one,
# or show an error page's host before the tunnel is up), so the origin a window
# is on, which t3-window-scope --list-windows reads through AppleScript,
# identifies its workspace. That needs View > Developer > Allow JavaScript from
# Apple Events on in T3_BROWSER_APP. What this script knows of each window's
# servers is kept in T3_STATE_DIR/<origin's first label>, per browser: another
# browser's windows have none of its cookies or saved connections.
# T3_BROWSER_APP="Google Chrome" puts them back in your own Chrome.
T3_BROWSER_APP="${T3_BROWSER_APP:-Google Chrome Beta}"
export T3_BROWSER_APP
T3_BROWSER_PROFILE="Default"
T3_STATE_DIR="$HOME/.local/state/t3-windows/${T3_BROWSER_APP// /-}"
t3_browser_missing_warned=false
# Each window used to be its own Chrome instance on a data directory here. They
# share Chrome's bundle id, so macOS handed Chrome launches, links and the Dock
# to one of them when your own Chrome was not running; any still running are
# quit (retire_t3_profile_chromes).
# TODO: drop once no Mac has them, along with the directory itself.
T3_LEGACY_CHROME_DATA_ROOT="$HOME/.t3-workspace-chrome"
# Pairing tokens bin-macos/nvs-tunnels pools from each devserver's session, a
# file each in HOST/. A window this script creates opens on /pair with one of
# its own host's, and links each other host's server with one of that host's.
# A window on a new origin waits up to T3_PAIRING_TOKEN_WAIT seconds for each; one
# on an origin that has paired before takes one only when one is there. Tokens last 12 hours,
# so older files are dropped.
T3_PAIRING_DIR="${T3_PAIRING_DIR:-$HOME/.local/state/t3-pairing}"
T3_PAIRING_TOKEN_WAIT="${T3_PAIRING_TOKEN_WAIT:-30}"
T3_PAIRING_TOKEN_MAX_AGE_MIN=660
# A devserver's server answers only once its tunnel is through Duo, which you
# approve whenever you get to it: this run never waits on it, and defers that
# host's windows to the --deferred run its nvs-tunnels starts on connecting.
# The Mac's own server gets a moment to come up at login.
T3_SERVER_WAIT="${T3_SERVER_WAIT:-0}"
T3_LOCAL_SERVER_WAIT="${T3_LOCAL_SERVER_WAIT:-15}"
t3_waited_hosts=""
t3_unreachable_hosts=""
T3_TITLE_PATTERN="^T3 Code"
# What AeroSpace shows as a T3 Code window's title: T3 Code's own, or the host on
# an error page. Keeps a T3 Code window out of the Chrome slots even when the
# origin listing missed it.
T3_ANY_TITLE_PATTERN='^T3 Code|\.t3\.localhost'

OMNIGENT_APP="Omnigent"
OMNIGENT_INVALID_TITLE_PATTERN="^Omnigent Update$"
claimed_omnigent_ids=""
omnigent_restore_settled=false

# Workspace 11 hosts a fixed 2x2 "dashboard" laid out by arrange-ws11. Its two
# Chrome windows (internalfb Calendar + Slack) must be claimed BEFORE the
# generic Chrome distribution below, or they get handed to ws 1-8 / swept to Z.
WS11_WORKSPACE=11
WS11_CAL_URL="https://www.internalfb.com/calendar"
WS11_SLACK_URL="https://app.slack.com/client"
WS11_CAL_TITLE_RE='^Calendar\b'
WS11_SLACK_TITLE_RE=' - Slack - '
# Ids reserved by reserve_ws11_chrome, handed to arrange-ws11 so it arranges the
# windows this script picked instead of re-resolving the titles itself.
WS11_CAL_WINDOW_ID=""
WS11_SLACK_WINDOW_ID=""
OMNIGENT_PORT="${OMNIGENT_PORT:-$(omnigent-server-url --port)}"
OMNIGENT_TLS_PORT="${OMNIGENT_TLS_PORT:-$(omnigent-server-url --tls-port)}"
OMNIGENT_PRIMARY_FQDN="${OMNIGENT_PRIMARY_FQDN:-$(omnigent-server-url --primary)}"
OMNIGENT_STANDBY_FQDN="${OMNIGENT_STANDBY_FQDN:-$(omnigent-server-url --standby)}"
OMNIGENT_PRIMARY_TUNNEL_PORT="${OMNIGENT_PRIMARY_TUNNEL_PORT:-$(omnigent-server-url --primary-tunnel-port)}"
OMNIGENT_STANDBY_TUNNEL_PORT="${OMNIGENT_STANDBY_TUNNEL_PORT:-$(omnigent-server-url --standby-tunnel-port)}"
TOPOLOGY_FILE="${OMNIGENT_TOPOLOGY_FILE:-${DOTFILES_DIR:-$HOME/dotfiles}/omnigent_config/topology.env}"
topology_value() {
  local value
  value="$(sed -n "s/^$1=//p" "$TOPOLOGY_FILE" 2>/dev/null | tail -n 1)"
  printf '%s' "${value:-$2}"
}
T3_PORT="${T3_PORT:-$(topology_value T3_PORT 3780)}"
T3_PRIMARY_TUNNEL_PORT="${T3_PRIMARY_TUNNEL_PORT:-$(topology_value T3_PRIMARY_TUNNEL_PORT 13780)}"
T3_STANDBY_TUNNEL_PORT="${T3_STANDBY_TUNNEL_PORT:-$(topology_value T3_STANDBY_TUNNEL_PORT 23780)}"
