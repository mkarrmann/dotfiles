#!/usr/bin/env bash
set -euo pipefail

# AeroSpace's CLI can occasionally leave an individual IPC client blocked while
# newer clients continue to work. Bound every call so one stale client cannot
# freeze the entire login sequence. Read-only calls are safe to retry.
AEROSPACE_COMMAND_TIMEOUT="${AEROSPACE_COMMAND_TIMEOUT:-8}"
AEROSPACE_TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
AEROSPACE_BIN="$(command -v aerospace || true)"

aerospace() {
  local attempts=1 attempt=1 output status
  case "${1:-}" in
    list-*) attempts=3 ;;
  esac

  while [[ "$attempt" -le "$attempts" ]]; do
    if [[ -n "$AEROSPACE_TIMEOUT_BIN" ]]; then
      if output=$("$AEROSPACE_TIMEOUT_BIN" --foreground --kill-after=1 \
          "$AEROSPACE_COMMAND_TIMEOUT" "$AEROSPACE_BIN" "$@"); then
        printf '%s' "$output"
        return 0
      else
        status=$?
      fi
    else
      if output=$("$AEROSPACE_BIN" "$@"); then
        printf '%s' "$output"
        return 0
      else
        status=$?
      fi
    fi

    if [[ "$status" -eq 124 || "$status" -eq 137 ]]; then
      echo "WARNING: AeroSpace command timed out: aerospace $*" >&2
    fi
    attempt=$(( attempt + 1 ))
    [[ "$attempt" -le "$attempts" ]] && sleep 0.25
  done
  return "$status"
}

# ── Args ─────────────────────────────────────────────────────────────
ORCHEST_MODE_FLAG="--prod"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --orchest-prod) ORCHEST_MODE_FLAG="--prod"; shift ;;
    --orchest-dev)  ORCHEST_MODE_FLAG="--dev";  shift ;;
    -h|--help)
      echo "Usage: startup-windows [--orchest-prod|--orchest-dev]"
      echo "  --orchest-prod  (default) launch built Orchest from apps/desktop/out/ (lower memory)"
      echo "  --orchest-dev   launch Orchest via 'pnpm dev' with HMR"
      exit 0
      ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

# AeroSpace can invoke after-startup-command more than once across a config
# reload/restart. Only one reconciler may mutate the workspace tree at a time.
STARTUP_LOCK_DIR="/tmp/startup-windows.lock"
if ! mkdir "$STARTUP_LOCK_DIR" 2>/dev/null; then
  lock_pid=$(cat "$STARTUP_LOCK_DIR/pid" 2>/dev/null || true)
  if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
    echo "startup-windows is already running as PID $lock_pid; exiting."
    exit 0
  fi

  rm -f "$STARTUP_LOCK_DIR/pid"
  if ! rmdir "$STARTUP_LOCK_DIR" 2>/dev/null || ! mkdir "$STARTUP_LOCK_DIR" 2>/dev/null; then
    echo "ERROR: could not acquire $STARTUP_LOCK_DIR" >&2
    exit 1
  fi
fi
echo "$$" > "$STARTUP_LOCK_DIR/pid"
cleanup_startup_lock() {
  rm -f "$STARTUP_LOCK_DIR/pid"
  rmdir "$STARTUP_LOCK_DIR" 2>/dev/null || true
}
trap cleanup_startup_lock EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# ── Workspace definitions ────────────────────────────────────────────
# Format: ws|type|title|title_match|...
#   ghostty:  ws|ghostty|title|title_match|workdir|command
#   cmux:     ws|cmux|title|title_match
#   chrome:   ws|chrome|title
#   omnigent: ws|omnigent|title
# title_match is a regex used to find existing windows in AeroSpace.
# ws is the AeroSpace workspace to place the window in.
# Multiple entries can share a workspace (accordion layout toggles between them).
# Stray windows are swept to workspace "Z".
WORKSPACES=(
  "1|ghostty|Local MacOS|^Local MacOS$|~|while true; do nvim --cmd 'set title titlestring=Local\\ MacOS'; sleep 0.5; done"
  "1|chrome|Chrome: ws1"
  "1|omnigent|Omnigent: ws1"
  "T|ghostty|FTW: tunnels|FTW.*tunnels|~|nvs-tunnels devvm36111.ftw0.facebook.com FTW-checkout1:~/checkout1 FTW-checkout2:~/checkout2 FTW-checkout3:~/checkout3"
  "T|ghostty|CCO: tunnels|CCO.*tunnels|~|nvs-tunnels devvm20365.cco0.facebook.com CCO-checkout1:~/checkout1 CCO-checkout2:~/checkout2 CCO-checkout3:~/checkout3 CCO-checkout4:~/checkout4"
  # No "Omnigent: tunnel" entry: mac_proxy is owned by the launchd job
  # com.mkarrmann.omnigent-tunnel so that a kill self-heals in seconds.
  # retire_omnigent_tunnel_window below closes any window left from before.
  "2|ghostty|CCO: checkout1|CCO.*checkout1\\b|~|nvs CCO-checkout1"
  "2|chrome|Chrome: ws2"
  "2|omnigent|Omnigent: ws2"
  "3|ghostty|FTW: checkout1|FTW.*checkout1\\b|~|nvs FTW-checkout1"
  "3|chrome|Chrome: ws3"
  "3|omnigent|Omnigent: ws3"
  "4|ghostty|CCO: checkout2|CCO.*checkout2\\b|~|nvs CCO-checkout2"
  "4|chrome|Chrome: ws4"
  "4|omnigent|Omnigent: ws4"
  "5|ghostty|FTW: checkout2|FTW.*checkout2\\b|~|nvs FTW-checkout2"
  "5|chrome|Chrome: ws5"
  "5|omnigent|Omnigent: ws5"
  "6|ghostty|CCO: checkout3|CCO.*checkout3\\b|~|nvs CCO-checkout3"
  "6|chrome|Chrome: ws6"
  "6|omnigent|Omnigent: ws6"
  "7|ghostty|FTW: checkout3|FTW.*checkout3\\b|~|nvs FTW-checkout3"
  "7|chrome|Chrome: ws7"
  "7|omnigent|Omnigent: ws7"
  "8|ghostty|CCO: checkout4|CCO.*checkout4\\b|~|nvs CCO-checkout4"
  "8|chrome|Chrome: ws8"
  "8|omnigent|Omnigent: ws8"
)

SWEEP_WORKSPACE="Z"

CHROME_APP="Google Chrome"
CHROME_INVALID_TITLE_PATTERN="^Who.s using Chrome\\?$"
claimed_chrome_ids=""
chrome_restore_settled=false

# Omnigent window titles are conversation names, so they carry no stable
# workspace identity. Claim windows by ID like Chrome rather than by title.
#
# The updater overlay is the one window that must be matched by title. Since
# desktop 0.10.0 every shell window gets a 344x1 transparent child window titled
# "Omnigent Update" (electron/src/update_overlay.js), deliberately kept shown
# even when the card is empty so its ResizeObserver stays alive. Overlays are
# created one window id after their parent, so ascending-id slot filling handed
# every second workspace an invisible 1px window instead of a chat window — and
# a workspace whose Omnigent slot is an overlay cannot be laid out at all.
#
# Getting them off the managed workspaces is arrange-workspaces' job
# (NON_LAYOUT_TITLE_PATTERN); an overlay does not follow its parent across
# workspaces, so nothing here can keep one next to the window it belongs to.
OMNIGENT_APP="Omnigent"
OMNIGENT_INVALID_TITLE_PATTERN="^Omnigent Update$"
claimed_omnigent_ids=""
omnigent_restore_settled=false

# Workspace 11 hosts a fixed 2x2 "dashboard" laid out by arrange-ws11. Its two
# Chrome windows (internalfb Calendar + Google Chat) must be claimed BEFORE the
# generic Chrome distribution below, or they get handed to ws 1-8 / swept to Z.
WS11_WORKSPACE=11
WS11_CAL_URL="https://www.internalfb.com/calendar"
WS11_CHAT_URL="https://chat.google.com/u/0/app/home"
WS11_CAL_TITLE_RE='^Calendar\b'
WS11_CHAT_TITLE_RE='^Chat\b'
# Ids reserved by reserve_ws11_chrome, handed to arrange-ws11 so it arranges the
# windows this script picked instead of re-resolving the titles itself.
WS11_CAL_WINDOW_ID=""
WS11_CHAT_WINDOW_ID=""
OMNIGENT_PORT="${OMNIGENT_PORT:-$(omnigent-server-url --port)}"
OMNIGENT_TLS_PORT="${OMNIGENT_TLS_PORT:-$(omnigent-server-url --tls-port)}"
OMNIGENT_PRIMARY_FQDN="${OMNIGENT_PRIMARY_FQDN:-$(omnigent-server-url --primary)}"
OMNIGENT_STANDBY_FQDN="${OMNIGENT_STANDBY_FQDN:-$(omnigent-server-url --standby)}"
OMNIGENT_PRIMARY_TUNNEL_PORT="${OMNIGENT_PRIMARY_TUNNEL_PORT:-$(omnigent-server-url --primary-tunnel-port)}"
OMNIGENT_STANDBY_TUNNEL_PORT="${OMNIGENT_STANDBY_TUNNEL_PORT:-$(omnigent-server-url --standby-tunnel-port)}"
# ─────────────────────────────────────────────────────────────────────

# ── Window creation ─────────────────────────────────────────────────

create_ghostty_window() {
  local title="$1" workdir="$2" cmd="$3"
  workdir="${workdir/#\~/$HOME}"
  osascript \
    -e 'on run argv' \
    -e '  set theTitle to item 1 of argv' \
    -e '  set theWorkdir to item 2 of argv' \
    -e '  set theCmd to item 3 of argv' \
    -e '  set titleSeq to "printf '\''\\033]0;%s\\007'\'' " & quoted form of theTitle & " && exec zsh -lc " & quoted form of theCmd' \
    -e '  tell application "Ghostty"' \
    -e '    set cfg to new surface configuration' \
    -e '    set command of cfg to "zsh -lic " & quoted form of titleSeq' \
    -e '    set initial working directory of cfg to theWorkdir' \
    -e '    set wait after command of cfg to true' \
    -e '    set environment variables of cfg to {"GHOSTTY_WORKSPACE_TITLE=" & theTitle}' \
    -e '    new window with configuration cfg' \
    -e '  end tell' \
    -e 'end run' \
    -- "$title" "$workdir" "$cmd"
}

create_cmux_window() {
  if osascript -e 'application "cmux" is running' 2>/dev/null | grep -q 'true'; then
    return 0
  fi
  open -a cmux
}

# `open -n` is a no-op for Omnigent: its Electron single-instance lock hands the
# launch to the running app, which does not open a window for it. The Server ▸
# New Window menu item is the only window-creation entry point.
create_omnigent_window() {
  osascript \
    -e 'tell application "System Events" to tell process "Omnigent"' \
    -e '  click menu item "New Window" of menu 1 of menu bar item "Server" of menu bar 1' \
    -e 'end tell' >/dev/null 2>&1
}

omnigent_app_is_running() {
  osascript -e 'application "Omnigent" is running' 2>/dev/null | grep -q 'true'
}

ensure_omnigent_running() {
  if ! omnigent_app_is_running; then
    echo "[Omnigent] launching app..."
    open -a "$OMNIGENT_APP" || return 1
    for _ in $(seq 1 40); do
      sleep 0.5
      if omnigent_app_is_running; then
        break
      fi
    done
    omnigent_app_is_running || return 1
  fi

  if [[ "$omnigent_restore_settled" != true ]]; then
    wait_for_window_settle "$OMNIGENT_APP" 2 20 || true
    omnigent_restore_settled=true
    SNAPSHOT=$(snapshot_windows)
  fi
}

# ── Helpers ──────────────────────────────────────────────────────────

managed_workspaces() {
  printf '%s\n' "${WORKSPACES[@]}" | cut -d'|' -f1 | sort -u
}

# %{workspace} is not in the default --json payload. Asking for it costs the
# same single call and lets workspace-aware lookups run off the snapshot
# instead of a second query.
snapshot_windows() {
  aerospace list-windows --all --json \
    --format '%{window-id}%{workspace}%{app-name}%{window-title}' 2>/dev/null
}

wait_for_window_settle() {
  local app_name="$1" stable_seconds="${2:-2}" timeout="${3:-20}"
  local deadline last_ids="" stable_since=0 snapshot ids now
  deadline=$(($(date +%s) + timeout))

  while [[ $(date +%s) -lt "$deadline" ]]; do
    snapshot=$(snapshot_windows) || {
      sleep 0.5
      continue
    }
    ids=$(echo "$snapshot" | jq -r --arg app "$app_name" \
      '[.[] | select(."app-name" == $app)] | .[]["window-id"]' | sort -n)
    now=$(date +%s)
    if [[ "$ids" == "$last_ids" ]]; then
      [[ "$stable_since" -eq 0 ]] && stable_since="$now"
      if [[ $((now - stable_since)) -ge "$stable_seconds" ]]; then
        return 0
      fi
    else
      last_ids="$ids"
      stable_since="$now"
    fi
    sleep 0.5
  done
  return 1
}

# AeroSpace orders list-windows by title and breaks ties arbitrarily, so `first`
# alone picks a different window run to run whenever two titles match. Sorting
# by window id makes every lookup here reproducible, and makes this script and
# arrange-ws11 agree on which window a shared title refers to.
find_window_id() {
  local app_name="$1" title_substr="$2" snapshot="$3"
  echo "$snapshot" | jq -r \
    --arg app "$app_name" \
    --arg title "$title_substr" \
    '[.[] | select(."app-name" == $app and (.["window-title"] | test($title; "i")))]
       | sort_by(.["window-id"]) | first | .["window-id"] // empty'
}

find_window_id_for_workspace() {
  local app_name="$1" title_substr="$2" ws="$3" snapshot="$4"
  local window_id

  window_id=$(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
    | jq -r \
      --arg app "$app_name" \
      --arg title "$title_substr" \
      '[.[] | select(."app-name" == $app and (.["window-title"] | test($title; "i")))]
         | sort_by(.["window-id"]) | first | .["window-id"] // empty') || true
  if [[ -n "$window_id" ]]; then
    echo "$window_id"
    return 0
  fi

  find_window_id "$app_name" "$title_substr" "$snapshot"
}

get_focused_window_id() {
  aerospace list-windows --focused --json 2>/dev/null | jq -r '.[0]["window-id"] // empty'
}

window_exists() {
  local wid="$1"
  aerospace list-windows --all --json 2>/dev/null \
    | jq -e --argjson wid "$wid" \
      '[.[] | select(.["window-id"] == $wid)] | length > 0' >/dev/null
}

close_window_id() {
  local wid="$1" reason="$2"
  echo "Closing ${reason} window $wid..."
  aerospace close --window-id "$wid" 2>/dev/null || true
  for _ in $(seq 1 20); do
    sleep 0.2
    window_exists "$wid" || return 0
  done

  echo "WARNING: ${reason} window $wid did not close" >&2
  return 1
}

tunnel_command_is_current() {
  local host="$1"
  local cmds local_port expected
  # We need the complete command line to inspect its tunnel flags.
  # shellcheck disable=SC2009
  cmds=$(ps -axo command | grep -F "x2ssh -et $host" | grep -v grep || true)

  # If the tunnel is between x2ssh attempts (Duo/reconnect), don't churn the
  # Ghostty window. We only know it is stale when a live x2ssh command lacks
  # the candidate-specific Omnigent forward.
  [[ -z "$cmds" ]] && return 0

  case "$host" in
    "$OMNIGENT_PRIMARY_FQDN") local_port="$OMNIGENT_PRIMARY_TUNNEL_PORT" ;;
    "$OMNIGENT_STANDBY_FQDN") local_port="$OMNIGENT_STANDBY_TUNNEL_PORT" ;;
    *) return 0 ;;
  esac
  expected="${local_port}:${OMNIGENT_PORT}"
  echo "$cmds" | grep -F -- "-t " | grep -F -- "$expected" >/dev/null
}

stop_tunnel_processes_for_host() {
  local host="$1"
  local pids

  pids=$(ps -axo pid,command | awk -v host="$host" '
    index($0, "nvs-tunnels " host) ||
    index($0, "x2ssh -et " host) ||
    index($0, "fallback " host) ||
    index($0, "HostName=" host) {
      print $1
    }
  ') || true

  [[ -z "$pids" ]] && return 0
  echo "Stopping stale tunnel process(es) for $host: $(echo "$pids" | tr '\n' ' ')"
  # pids is an intentional whitespace-delimited list produced by awk.
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
}

# mac_proxy is owned by the launchd job com.mkarrmann.omnigent-tunnel. Any copy
# started some other way -- the retired workspace-T Ghostty window, or a manual
# `omnigent-tunnel` -- is an active competitor for OMNIGENT_PORT: whichever
# copy binds first wins and the loser spins on "address already in use"
# indefinitely, because mac_proxy retries the bind rather than exiting. So the
# port has to have exactly one owner, and it has to be the supervised one.
#
# ppid is the discriminator: launchd reparents its child to 1. Refuse to act
# when the job is not loaded, so this never leaves the Mac with no proxy at all
# on a machine where sync.sh has not run yet.
#
# omnigent-tunnel exec's into python, so the retired window's own process IS
# mac_proxy -- killing it closes the Ghostty window with it.
retire_unsupervised_mac_proxy() {
  local pids
  launchctl print "gui/$UID/com.mkarrmann.omnigent-tunnel" >/dev/null 2>&1 || {
    echo "WARNING: com.mkarrmann.omnigent-tunnel is not loaded; leaving the unsupervised proxy alone (run $HOME/dotfiles/sync.sh)" >&2
    return 0
  }

  # Also catches the pre-mac_proxy dedicated ET forward (`x2ssh -et ... -t
  # 6767:6767`), which binds the same port and would deadlock the job just as
  # effectively. macOS truncates `ps comm` to 16 characters, which for the venv
  # interpreter is just "/Users/mkarrmann", so match structured argv fields.
  pids=$(ps -axo pid=,ppid=,args= | awk -v port="$OMNIGENT_PORT" '
    $3 ~ /(^|\/)python([0-9.]*)?$/ && $4 == "-m" && $5 == "omnigent_hub.mac_proxy" && $2 != 1 { print $1; next }
    index($0, "x2ssh -et ") && index($0, "-t " port ":" port) { print $1 }
  ') || true
  [[ -n "$pids" ]] || return 0

  echo "retiring unsupervised mac_proxy (launchd owns :${OMNIGENT_PORT} now): $(echo "$pids" | tr '\n' ' ')"
  # pids is an intentional whitespace-delimited list produced by awk.
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
}

# Ghostty outlives the command it was given, so killing the proxy above leaves
# an idle "Omnigent: tunnel" window behind. With the workspace-T entry gone it
# is no longer a managed window, and the stray sweep would only relocate it to
# Z rather than close it -- so close it here, by title, wherever it ended up.
close_retired_omnigent_tunnel_windows() {
  local snapshot wid
  snapshot=$(snapshot_windows)
  while IFS= read -r wid; do
    [[ -n "$wid" ]] || continue
    close_window_id "$wid" "retired Omnigent tunnel" || true
  done < <(printf '%s' "$snapshot" | jq -r '
    .[] | select(."app-name" == "Ghostty")
        | select(."window-title" | test("Omnigent.*tunnel"; "i"))
        | ."window-id"')
}

close_stale_tunnel_window_if_needed() {
  local wid="$1" title="$2" cmd="$3"
  local _nvs host _rest

  [[ "$cmd" == nvs-tunnels\ * ]] || return 1
  read -r _nvs host _rest <<< "$cmd"
  [[ -n "$host" ]] || return 1

  if tunnel_command_is_current "$host"; then
    return 1
  fi

  echo "[$title] existing NVS tunnel is stale for $host; recreating it..."
  close_window_id "$wid" "stale tunnel"
  stop_tunnel_processes_for_host "$host"
}

# window_ids_for_app SNAPSHOT APP EXCLUDE_TITLE_RE -> ascending window ids
# An empty EXCLUDE_TITLE_RE excludes nothing.
window_ids_for_app() {
  local snapshot="$1" app_name="$2" exclude_title_re="$3"
  echo "$snapshot" | jq -r \
    --arg app "$app_name" --arg excl "$exclude_title_re" \
    '[.[] | select(
       ."app-name" == $app and
       ($excl == "" or ((.["window-title"] // "") | test($excl) | not))
     )] | .[]["window-id"]' | sort -n
}

# wait_for_new_window APP BEFORE_SNAPSHOT [EXCLUDE_TITLE_RE] -> new window id
#
# EXCLUDE_TITLE_RE drops windows that belong to APP but can never satisfy a
# workspace slot, so a helper window created alongside the real one is not
# mistaken for it (Omnigent's update overlay appears one id after its parent).
wait_for_new_window() {
  local app_name="$1" before_snapshot="$2" exclude_title_re="${3:-}"
  local before_ids
  before_ids=$(window_ids_for_app "$before_snapshot" "$app_name" "$exclude_title_re")

  for _ in $(seq 1 20); do
    sleep 0.5
    local current_snapshot current_ids new_id
    current_snapshot=$(snapshot_windows)
    current_ids=$(window_ids_for_app "$current_snapshot" "$app_name" "$exclude_title_re")
    new_id=$(comm -23 <(echo "$current_ids") <(echo "$before_ids") | head -1)
    if [[ -n "$new_id" ]]; then
      echo "$new_id"
      return 0
    fi
  done
  return 1
}

chrome_id_is_claimed() {
  local wid="$1"
  [[ -n "$claimed_chrome_ids" ]] && echo "$claimed_chrome_ids" | grep -qx "$wid"
}

claim_chrome_window() {
  local wid="$1"
  chrome_id_is_claimed "$wid" || claimed_chrome_ids="${claimed_chrome_ids}${claimed_chrome_ids:+$'\n'}${wid}"
}

find_valid_unclaimed_chrome_window_on_workspace() {
  local ws="$1"
  local wid
  for wid in $(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
    | jq -r --arg app "$CHROME_APP" --arg invalid "$CHROME_INVALID_TITLE_PATTERN" \
      '.[] | select(
        ."app-name" == $app and
        ((.["window-title"] // "") | test($invalid) | not)
      ) | .["window-id"]' | sort -n); do
    if ! chrome_id_is_claimed "$wid"; then
      echo "$wid"
      return 0
    fi
  done
  return 1
}

find_valid_unclaimed_chrome_window() {
  local wid
  for wid in $(aerospace list-windows --all --json 2>/dev/null \
    | jq -r --arg app "$CHROME_APP" --arg invalid "$CHROME_INVALID_TITLE_PATTERN" \
      '.[] | select(
        ."app-name" == $app and
        ((.["window-title"] // "") | test($invalid) | not)
      ) | .["window-id"]' | sort -n); do
    if ! chrome_id_is_claimed "$wid"; then
      echo "$wid"
      return 0
    fi
  done
  return 1
}

workspace_has_claimed_chrome_window() {
  local ws="$1" wid
  for wid in $(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
    | jq -r --arg app "$CHROME_APP" --arg invalid "$CHROME_INVALID_TITLE_PATTERN" \
      '.[] | select(
        ."app-name" == $app and
        ((.["window-title"] // "") | test($invalid) | not)
      ) | .["window-id"]'); do
    chrome_id_is_claimed "$wid" && return 0
  done
  return 1
}

omnigent_id_is_claimed() {
  local wid="$1"
  [[ -n "$claimed_omnigent_ids" ]] && echo "$claimed_omnigent_ids" | grep -qx "$wid"
}

claim_omnigent_window() {
  local wid="$1"
  omnigent_id_is_claimed "$wid" || claimed_omnigent_ids="${claimed_omnigent_ids}${claimed_omnigent_ids:+$'\n'}${wid}"
}

omnigent_window_ids() {
  local ws="${1:-}"
  if [[ -n "$ws" ]]; then
    aerospace list-windows --workspace "$ws" --json 2>/dev/null
  else
    aerospace list-windows --all --json 2>/dev/null
  fi | jq -r --arg app "$OMNIGENT_APP" --arg invalid "$OMNIGENT_INVALID_TITLE_PATTERN" \
    '.[] | select(
      ."app-name" == $app and
      ((.["window-title"] // "") | test($invalid) | not)
    ) | .["window-id"]' | sort -n
}

find_unclaimed_omnigent_window() {
  local ws="${1:-}" wid
  for wid in $(omnigent_window_ids "$ws"); do
    if ! omnigent_id_is_claimed "$wid"; then
      echo "$wid"
      return 0
    fi
  done
  return 1
}

workspace_has_claimed_omnigent_window() {
  local ws="$1" wid
  for wid in $(omnigent_window_ids "$ws"); do
    omnigent_id_is_claimed "$wid" && return 0
  done
  return 1
}

close_invalid_chrome_windows_on_workspace() {
  local ws="$1"
  local invalid_ids wid
  invalid_ids=$(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
    | jq -r --arg app "$CHROME_APP" --arg invalid "$CHROME_INVALID_TITLE_PATTERN" \
      '.[] | select(
        ."app-name" == $app and
        ((.["window-title"] // "") | test($invalid))
      ) | .["window-id"]') || true

  for wid in $invalid_ids; do
    [[ -z "$wid" ]] && continue
    echo "Closing invalid Chrome window $wid from workspace $ws..."
    aerospace focus --window-id "$wid" 2>/dev/null || true
    if [[ "$(get_focused_window_id)" == "$wid" ]]; then
      aerospace close 2>/dev/null || true
    else
      echo "WARNING: could not focus invalid Chrome window $wid; moving it to $SWEEP_WORKSPACE" >&2
      aerospace move-node-to-workspace --window-id "$wid" "$SWEEP_WORKSPACE" 2>/dev/null || true
    fi
  done
}

# find_chrome_by_title RE [SNAPSHOT] -> window id (or empty)
#
# Prefers a match already on workspace 11 so a re-run keeps the window it
# reserved last time, then falls back to anywhere. Ties break by window id: the
# title alone is ambiguous (any Chrome window showing a calendar matches
# '^Calendar\b') and AeroSpace's ordering of equal titles is not stable.
find_chrome_by_title() {
  local re="$1" snapshot="${2:-}"
  [[ -n "$snapshot" ]] || snapshot=$(snapshot_windows)
  jq -r --arg app "$CHROME_APP" --arg re "$re" \
        --arg invalid "$CHROME_INVALID_TITLE_PATTERN" --arg ws "$WS11_WORKSPACE" '
    [ .[] | select(
        ."app-name" == $app and
        ((.["window-title"] // "") | test($re)) and
        ((.["window-title"] // "") | test($invalid) | not)
    ) ]
    | sort_by(.["window-id"])
    | ((map(select(.workspace == $ws)) | first) // first)
    | .["window-id"] // empty
  ' <<< "$snapshot"
}

# Reserve (claim + relocate) the two workspace-11 dashboard Chrome windows
# before the generic Chrome distribution runs. Reuses a matching restored
# window if present; otherwise opens the URL. Claiming keeps them out of the
# ws 1-8 pool and the surplus->Z sweep. arrange-ws11 does the actual layout.
reserve_ws11_chrome() {
  if [[ "$chrome_restore_settled" != true ]] && \
     osascript -e 'application "Google Chrome" is running' 2>/dev/null | grep -q 'true'; then
    echo "[ws11] waiting for Chrome session restore to settle..."
    wait_for_window_settle "$CHROME_APP" 2 20 || true
    chrome_restore_settled=true
    SNAPSHOT=$(snapshot_windows)
  fi

  local spec slot title_re url wid tries
  for spec in "CAL|${WS11_CAL_TITLE_RE}|${WS11_CAL_URL}" \
              "CHAT|${WS11_CHAT_TITLE_RE}|${WS11_CHAT_URL}"; do
    IFS='|' read -r slot title_re url <<< "$spec"
    wid=$(find_chrome_by_title "$title_re" "$SNAPSHOT")
    if [[ -z "$wid" ]] || chrome_id_is_claimed "$wid"; then
      echo "[ws11] opening dashboard Chrome window: $url"
      open -na "$CHROME_APP" --args --profile-directory=Default --new-window "$url" 2>/dev/null || true
      wid=""
      for tries in $(seq 1 30); do
        sleep 0.5
        wid=$(find_chrome_by_title "$title_re")
        [[ -n "$wid" ]] && ! chrome_id_is_claimed "$wid" && break
        wid=""
      done
    fi
    if [[ -n "$wid" ]]; then
      claim_chrome_window "$wid"
      aerospace move-node-to-workspace --window-id "$wid" "$WS11_WORKSPACE" 2>/dev/null || true
      # Remember the exact id. arrange-ws11 is a separate process and cannot see
      # claimed_chrome_ids; without the id it re-derives the window from the
      # title and can land on a different one, leaving both on workspace 11.
      case "$slot" in
        CAL)  WS11_CAL_WINDOW_ID="$wid" ;;
        CHAT) WS11_CHAT_WINDOW_ID="$wid" ;;
      esac
      echo "[ws11] reserved Chrome window $wid ($title_re) for workspace $WS11_WORKSPACE"
    else
      echo "WARNING: [ws11] could not reserve Chrome window for $title_re" >&2
    fi
    SNAPSHOT=$(snapshot_windows)
  done
}

# Poll until every WORKSPACES entry has at least one matching window
# present anywhere. wait_for_new_window in the main loop has a 10s
# timeout, but app windows can take longer to appear and titles may still
# be loading after the window exists. arrange-workspaces is
# destructive (flatten + rebuild) and produces unrecoverable layouts
# when the expected window set is incomplete — e.g. a workspace with
# only Orchest + one app window present hits the single-accordion-window
# scaffold branch, then a late Ghostty/Chrome arrival triggers
# a layout rebuild and the resulting `move` calls can create unwanted nesting.
# Returns 0 if all entries are satisfied within the timeout, 1 otherwise.
wait_for_expected_windows() {
  local timeout="${1:-30}"
  local deadline=$(($(date +%s) + timeout))

  while [[ $(date +%s) -lt $deadline ]]; do
    local snapshot all_present=true
    snapshot=$(snapshot_windows)

    for entry in "${WORKSPACES[@]}"; do
      IFS='|' read -r _ws type _title rest <<< "$entry"
      local app_name title_match
      case "$type" in
        ghostty) IFS='|' read -r title_match _ <<< "$rest"; app_name="Ghostty" ;;
        cmux)    title_match="."; app_name="cmux" ;;
        *)       continue ;;
      esac

      local found
      found=$(echo "$snapshot" | jq -r \
        --arg app "$app_name" --arg pat "$title_match" \
        '[.[] | select(."app-name" == $app and (.["window-title"] | test($pat; "i")))] | length')
      if [[ "$found" -lt 1 ]]; then
        all_present=false
        break
      fi
    done

    $all_present && return 0
    sleep 0.5
  done
  return 1
}

reconcile_expected_managed_windows_once() {
  local snapshot entry ws type title rest app_name title_match window_id already
  RECONCILE_MISSING=0
  RECONCILE_MOVED=0
  matched_ids=()
  snapshot=$(snapshot_windows)

  for entry in "${WORKSPACES[@]}"; do
    IFS='|' read -r ws type title rest <<< "$entry"
    case "$type" in
      ghostty)
        IFS='|' read -r title_match _ <<< "$rest"
        app_name="Ghostty"
        ;;
      cmux)
        title_match="."
        app_name="cmux"
        ;;
      *) continue ;;
    esac

    window_id=$(find_window_id_for_workspace "$app_name" "$title_match" "$ws" "$snapshot")
    if [[ -z "$window_id" ]]; then
      RECONCILE_MISSING=$(( RECONCILE_MISSING + 1 ))
      continue
    fi
    matched_ids+=("$window_id")

    already=$(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
      | jq -r --argjson wid "$window_id" \
        '[.[] | select(.["window-id"] == $wid)] | first | .["window-id"] // empty') || true
    if [[ -z "$already" ]]; then
      echo "[$title] relocating to workspace $ws..."
      if aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null; then
        RECONCILE_MOVED=$(( RECONCILE_MOVED + 1 ))
      else
        echo "WARNING: [$title] relocate failed" >&2
      fi
    fi
  done
}

reconcile_expected_managed_windows() {
  local timeout="${1:-20}"
  local deadline=$(($(date +%s) + timeout))

  while true; do
    reconcile_expected_managed_windows_once
    if [[ "$RECONCILE_MISSING" -eq 0 && "$RECONCILE_MOVED" -eq 0 ]]; then
      return 0
    fi

    if [[ $(date +%s) -ge $deadline ]]; then
      return 1
    fi
    sleep 0.5
  done
}

# ── Main ─────────────────────────────────────────────────────────────

if [[ -z "$AEROSPACE_BIN" ]]; then
  echo "ERROR: aerospace CLI not found." >&2
  echo "Install AeroSpace: brew install --cask nikitabobko/tap/aerospace" >&2
  exit 1
fi

if ! aerospace list-windows --all &>/dev/null; then
  echo "ERROR: AeroSpace is not running." >&2
  echo "Start AeroSpace.app first." >&2
  exit 1
fi

# Ensure Ghostty is running (but don't close its default window).
# Ghostty creates a default window on launch. We leave it open so the
# SNAPSHOT captures it — this prevents wait_for_new_window from
# misidentifying it as a newly created window. The reconciliation pass
# at the end sweeps it to workspace Z.
if ! osascript -e 'application "Ghostty" is running' 2>/dev/null | grep -q 'true'; then
  open -a Ghostty
  sleep 2
fi

# Snapshot all windows
SNAPSHOT=$(snapshot_windows)

failures=0

# The local Omnigent proxy exposes the hub on Mac loopback. The CCO and FTW
# nvs-tunnels supply its candidate-specific upstream forwards. Retire any
# unsupervised copy first, so the probe below reports on the launchd-owned one
# rather than on whichever copy happened to win the port.
retire_unsupervised_mac_proxy
close_retired_omnigent_tunnel_windows
if ! curl -sf "http://127.0.0.1:${OMNIGENT_PORT}/health" >/dev/null 2>&1; then
  echo "Omnigent proxy is not healthy at http://127.0.0.1:${OMNIGENT_PORT} (check: launchctl print gui/\$UID/com.mkarrmann.omnigent-tunnel, and ~/.local/state/omnigent-tunnel/stderr.log); the nvs-tunnels windows below supply its upstream forwards" >&2
fi

# The desktop app connects through the TLS front door, not OMNIGENT_PORT, so it
# needs its own probe: the plain-HTTP check above passes even when this is down.
# Deliberately not `-k` — an untrusted CA fails the app exactly like an outage,
# so the probe has to exercise the same trust path Chromium will.
if ! curl -sf "https://localhost:${OMNIGENT_TLS_PORT}/health" >/dev/null 2>&1; then
  echo "Omnigent TLS front door is not healthy at https://localhost:${OMNIGENT_TLS_PORT}; the app will fail to connect (check: launchctl print gui/\$UID/com.mkarrmann.omnigent-tls, and 'caddy trust' for the local CA)" >&2
fi

# The app updates itself every six hours, so this should never fire. That is
# the point: the last time it went stale nothing said so for two months. Only
# exit 1 means "definitely behind" -- an unreachable feed exits 2 and stays
# quiet, so an offline login does not cry wolf.
omnigent_app_check_rc=0
OMNIGENT_APP_CURL_TIMEOUT=5 omnigent-app-ensure --check >/dev/null 2>&1 || omnigent_app_check_rc=$?
if [[ "$omnigent_app_check_rc" == 1 ]]; then
  echo "Omnigent desktop app is out of date and its own updater has not taken it; run 'omnigent-app-ensure --install'" >&2
fi

# Reserve the ws-11 dashboard Chrome windows before generic Chrome distribution.
reserve_ws11_chrome

for i in "${!WORKSPACES[@]}"; do
  IFS='|' read -r ws type title rest <<< "${WORKSPACES[$i]}"

  case "$type" in
    ghostty)
      IFS='|' read -r title_match workdir cmd <<< "$rest"
      app_name="Ghostty"

      window_id=$(find_window_id_for_workspace "$app_name" "$title_match" "$ws" "$SNAPSHOT")
      if [[ -n "$window_id" ]] && close_stale_tunnel_window_if_needed "$window_id" "$title" "$cmd"; then
        SNAPSHOT=$(snapshot_windows)
        window_id=""
      fi

      if [[ -n "$window_id" ]]; then
        echo "[$title] moving existing window to workspace $ws..."
        aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || {
          echo "WARNING: [$title] move failed" >&2
          ((failures++)) || true
        }
      else
        echo "[$title] creating on workspace $ws..."
        before_snapshot="$SNAPSHOT"
        create_ghostty_window "$title" "$workdir" "$cmd" || {
          echo "WARNING: [$title] creation failed, skipping" >&2
          ((failures++)) || true
          continue
        }
        window_id=$(wait_for_new_window "$app_name" "$before_snapshot") || {
          # Fallback: try the focused window
          window_id=$(get_focused_window_id)
        }
        if [[ -n "$window_id" ]]; then
          aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || true
        else
          echo "WARNING: [$title] could not find new window ID" >&2
          ((failures++)) || true
        fi
        # Update snapshot for subsequent iterations
        SNAPSHOT=$(snapshot_windows)
      fi
      ;;
    cmux)
      IFS='|' read -r title_match _ <<< "$rest"
      app_name="cmux"

      window_id=$(find_window_id_for_workspace "$app_name" "$title_match" "$ws" "$SNAPSHOT")
      if [[ -n "$window_id" ]]; then
        echo "[$title] moving existing window to workspace $ws..."
        aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || {
          echo "WARNING: [$title] move failed" >&2
          ((failures++)) || true
        }
      else
        echo "[$title] creating on workspace $ws..."
        before_snapshot="$SNAPSHOT"
        create_cmux_window || {
          echo "WARNING: [$title] creation failed, skipping" >&2
          ((failures++)) || true
          continue
        }
        window_id=$(wait_for_new_window "$app_name" "$before_snapshot") || {
          window_id=$(get_focused_window_id)
        }
        if [[ -n "$window_id" ]]; then
          aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || true
        else
          echo "WARNING: [$title] could not find new window ID" >&2
          ((failures++)) || true
        fi
        SNAPSHOT=$(snapshot_windows)
      fi
      ;;
    chrome)
      app_name="$CHROME_APP"

      if [[ "$chrome_restore_settled" != true ]] && \
         osascript -e 'application "Google Chrome" is running' 2>/dev/null | grep -q 'true'; then
        echo "[Chrome] waiting for session restore to settle..."
        wait_for_window_settle "$CHROME_APP" 2 20 || true
        chrome_restore_settled=true
        SNAPSHOT=$(snapshot_windows)
      fi

      # Profile-picker windows are Chrome windows, but they do not satisfy the
      # workspace contract. Close them so we create/reuse a real profile window.
      close_invalid_chrome_windows_on_workspace "$ws"

      # Prefer a usable window already on this workspace. If Chrome restored
      # all of its previous windows onto the active workspace, reuse the next
      # unclaimed restored window instead of opening another one.
      existing=$(find_valid_unclaimed_chrome_window_on_workspace "$ws") || true
      if [[ -z "$existing" ]]; then
        existing=$(find_valid_unclaimed_chrome_window) || true
      fi
      if [[ -n "$existing" ]]; then
        echo "[$title] assigning restored Chrome window $existing to workspace $ws..."
        aerospace move-node-to-workspace --window-id "$existing" "$ws" 2>/dev/null || true
        claim_chrome_window "$existing"
      else
        echo "[$title] creating on workspace $ws..."
        before_snapshot="$SNAPSHOT"
        open -na "$CHROME_APP" --args --profile-directory=Default --new-window 2>/dev/null || {
          echo "WARNING: [$title] creation failed, skipping" >&2
          ((failures++)) || true
          continue
        }
        window_id=$(wait_for_new_window "$app_name" "$before_snapshot") || {
          window_id=$(get_focused_window_id)
        }
        if [[ -n "$window_id" ]]; then
          aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || true
          claim_chrome_window "$window_id"
          # The first Chrome launch may restore many windows asynchronously.
          # Let that burst finish so later workspace entries can reuse them.
          wait_for_window_settle "$CHROME_APP" 2 20 || true
          chrome_restore_settled=true
        else
          echo "WARNING: [$title] could not find new Chrome window" >&2
          ((failures++)) || true
        fi
        SNAPSHOT=$(snapshot_windows)
      fi
      ;;
    omnigent)
      app_name="$OMNIGENT_APP"

      if ! ensure_omnigent_running; then
        echo "WARNING: [$title] Omnigent app did not start, skipping" >&2
        ((failures++)) || true
        continue
      fi

      existing=$(find_unclaimed_omnigent_window "$ws") || true
      if [[ -z "$existing" ]]; then
        existing=$(find_unclaimed_omnigent_window) || true
      fi
      if [[ -n "$existing" ]]; then
        echo "[$title] assigning existing Omnigent window $existing to workspace $ws..."
        aerospace move-node-to-workspace --window-id "$existing" "$ws" 2>/dev/null || true
        claim_omnigent_window "$existing"
      else
        echo "[$title] creating on workspace $ws..."
        before_snapshot="$SNAPSHOT"
        create_omnigent_window || {
          echo "WARNING: [$title] creation failed, skipping" >&2
          ((failures++)) || true
          continue
        }
        # No focused-window fallback here: Omnigent windows are claimed by ID,
        # so misidentifying one pins the wrong window to this workspace for the
        # rest of the run.
        if window_id=$(wait_for_new_window "$app_name" "$before_snapshot" \
            "$OMNIGENT_INVALID_TITLE_PATTERN"); then
          aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || true
          claim_omnigent_window "$window_id"
        else
          echo "WARNING: [$title] could not find new Omnigent window" >&2
          ((failures++)) || true
        fi
        SNAPSHOT=$(snapshot_windows)
      fi
      ;;
  esac
done

# Chrome session restore can continue after an individual wait_for_new_window
# returns. Fill any still-missing Chrome slots from the restored pool, then put
# surplus restored windows on the overflow workspace rather than leaving them
# piled onto a managed workspace.
for entry in "${WORKSPACES[@]}"; do
  IFS='|' read -r ws type _title _rest <<< "$entry"
  [[ "$type" == "chrome" ]] || continue
  workspace_has_claimed_chrome_window "$ws" && continue

  existing=$(find_valid_unclaimed_chrome_window_on_workspace "$ws") || true
  if [[ -z "$existing" ]]; then
    existing=$(find_valid_unclaimed_chrome_window) || true
    if [[ -n "$existing" ]]; then
      echo "[Chrome reconciliation] assigning window $existing to workspace $ws..."
      aerospace move-node-to-workspace --window-id "$existing" "$ws" 2>/dev/null || true
    fi
  fi
  [[ -z "$existing" ]] || claim_chrome_window "$existing"
done

extra_chrome_ids=$(aerospace list-windows --all --json 2>/dev/null \
  | jq -r --arg app "$CHROME_APP" --arg invalid "$CHROME_INVALID_TITLE_PATTERN" \
    '.[] | select(
      ."app-name" == $app and
      ((.["window-title"] // "") | test($invalid) | not)
    ) | .["window-id"]' | sort -n) || true
for wid in $extra_chrome_ids; do
  chrome_id_is_claimed "$wid" && continue
  echo "Sweeping surplus restored Chrome window $wid to $SWEEP_WORKSPACE..."
  aerospace move-node-to-workspace --window-id "$wid" "$SWEEP_WORKSPACE" 2>/dev/null || true
done

# Same two-step for Omnigent: fill slots whose window arrived after its
# wait_for_new_window timed out, then sweep the surplus off managed workspaces.
for entry in "${WORKSPACES[@]}"; do
  IFS='|' read -r ws type _title _rest <<< "$entry"
  [[ "$type" == "omnigent" ]] || continue
  workspace_has_claimed_omnigent_window "$ws" && continue

  existing=$(find_unclaimed_omnigent_window "$ws") || true
  if [[ -z "$existing" ]]; then
    existing=$(find_unclaimed_omnigent_window) || true
    if [[ -n "$existing" ]]; then
      echo "[Omnigent reconciliation] assigning window $existing to workspace $ws..."
      aerospace move-node-to-workspace --window-id "$existing" "$ws" 2>/dev/null || true
    fi
  fi
  [[ -z "$existing" ]] || claim_omnigent_window "$existing"
done

for wid in $(omnigent_window_ids); do
  omnigent_id_is_claimed "$wid" && continue
  echo "Sweeping surplus Omnigent window $wid to $SWEEP_WORKSPACE..."
  aerospace move-node-to-workspace --window-id "$wid" "$SWEEP_WORKSPACE" 2>/dev/null || true
done

# ── Orchest ──────────────────────────────────────────────────────────

orchest-open-workspaces ${ORCHEST_MODE_FLAG:+$ORCHEST_MODE_FLAG} || {
  echo "WARNING: orchest-open-workspaces failed" >&2
  ((failures++)) || true
}

# ── Wait for late-appearing windows ──────────────────────────────────

echo "Waiting up to 30s for any late-appearing windows..."
if wait_for_expected_windows 30; then
  echo "All expected windows present."
else
  echo "WARNING: some expected windows did not appear within 30s; layout may be incomplete" >&2
  ((failures++)) || true
fi

# ── Reconciliation pass ───────────────────────────────────────────────
# Relocate windows that appeared after their wait_for_new_window timed
# out, and sweep unmatched Ghostty windows from managed
# workspaces (e.g. the default Ghostty window created on launch).

swept=0
if ! reconcile_expected_managed_windows 20; then
  echo "WARNING: some expected managed windows were still missing or moving after reconciliation" >&2
  ((failures++)) || true
fi

# Sweep unmatched Ghostty windows from managed workspaces
matched_pattern=$(printf '%s\n' "${matched_ids[@]}" | jq -R -s 'split("\n") | map(select(. != "") | tonumber)')
for ws in $(managed_workspaces); do
  stray_ids=$(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
    | jq -r --argjson matched "$matched_pattern" \
      '[.[] | select(
        ."app-name" == "Ghostty" and
        (.["window-id"] | IN($matched[]) | not)
      )] | .[]["window-id"]') || true
  for wid in $stray_ids; do
    [[ -z "$wid" ]] && continue
    echo "Sweeping unmatched window $wid from workspace $ws to $SWEEP_WORKSPACE..."
    if aerospace move-node-to-workspace --window-id "$wid" "$SWEEP_WORKSPACE" 2>/dev/null; then
      ((swept++)) || true
    fi
  done
done

# ─────────────────────────────────────────────────────────────────────

# Close invalid Chrome windows from managed workspaces. They can be restored by
# Chrome after the per-workspace checks above, and otherwise look like valid app
# windows to the generic stray sweep.
for ws in $(managed_workspaces); do
  close_invalid_chrome_windows_on_workspace "$ws"
done
close_invalid_chrome_windows_on_workspace "$SWEEP_WORKSPACE"

# Sweep stray windows: move unrecognized windows off managed workspaces to Z
for ws in $(managed_workspaces); do
  stray_ids=$(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
    | jq -r --arg chrome "$CHROME_APP" --arg omnigent "$OMNIGENT_APP" \
      '[.[] | select(
        ."app-name" != "Ghostty" and
        ."app-name" != "cmux" and
        ."app-name" != $chrome and
        ."app-name" != $omnigent and
        (.["window-title"] | test("Orchest \\[") | not)
      )] | .[]["window-id"]') || true
  for wid in $stray_ids; do
    [[ -z "$wid" ]] && continue
    if aerospace move-node-to-workspace --window-id "$wid" "$SWEEP_WORKSPACE" 2>/dev/null; then
      ((swept++)) || true
    fi
  done
done

if [[ "$swept" -gt 0 ]]; then
  echo "Swept ${swept} stray window(s) to workspace ${SWEEP_WORKSPACE}."
fi

# Arrange layouts (tiles | accordion) on managed workspaces
# managed_workspaces intentionally expands to separate workspace arguments.
# shellcheck disable=SC2046
ARRANGE_ATTEMPTS=8 ARRANGE_RETRY_SLEEP=1 arrange-workspaces --force $(managed_workspaces) || {
  echo "WARNING: arrange-workspaces did not converge" >&2
  ((failures++)) || true
}

# A successful layout must still contain every Orchest sidebar. If an
# AeroSpace mutation raced the layout pass, repair the placements, rebuild the
# affected trees, and verify again. This also heals stale desktopWorkspaceId
# values learned while an Orchest window was temporarily on Z.
if ! orchest-open-workspaces --verify-only; then
  echo "[Orchest] final placement verification failed; repairing and rebuilding layouts..."
  if orchest-open-workspaces --reconcile-only; then
    # managed_workspaces intentionally expands to separate arguments.
    # shellcheck disable=SC2046
    ARRANGE_ATTEMPTS=8 ARRANGE_RETRY_SLEEP=1 arrange-workspaces --force $(managed_workspaces) || {
      echo "WARNING: arrange-workspaces did not converge after Orchest repair" >&2
      ((failures++)) || true
    }
  else
    echo "WARNING: final Orchest placement repair failed" >&2
    ((failures++)) || true
  fi

  if ! orchest-open-workspaces --verify-only; then
    echo "WARNING: final Orchest placement verification still failed" >&2
    ((failures++)) || true
  fi
fi

# If auto-accordion is re-enabled, it should do a full rebuild for any window
# that appears after this point, so no drain sleep is needed here.

# Provision and arrange the workspace-11 dashboard after the standard workspace
# and Orchest placement passes have converged. The reserved ids travel with the
# call: arrange-ws11 would otherwise re-resolve '^Calendar\b' / '^Chat\b' from
# scratch, and any other Chrome window showing a calendar matches just as well.
WS11_CAL_WINDOW_ID="$WS11_CAL_WINDOW_ID" \
WS11_CHAT_WINDOW_ID="$WS11_CHAT_WINDOW_ID" \
  arrange-workspaces --ensure-windows 11 || {
  echo "WARNING: workspace 11 arrangement did not converge" >&2
  ((failures++)) || true
}

# Focus workspace 1
aerospace workspace 1 2>/dev/null || true

# Trigger SketchBar reconciliation so items are created for any workspaces
# that appeared after SketchBar's initial sync (T, Z, Orchest workspaces, etc.)
sketchybar --trigger aerospace_reconcile 2>/dev/null || true

if [[ "$failures" -gt 0 ]]; then
  echo "Done with ${failures} warning(s)."
else
  echo "Done."
fi
