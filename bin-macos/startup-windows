# ── Window creation ─────────────────────────────────────────────────

create_ghostty_window() {
  local title="$1" workdir="$2" cmd="$3"
  workdir="${workdir/#\~/$HOME}"
  osascript \
    -e 'on run argv' \
    -e '  set theTitle to item 1 of argv' \
    -e '  set theWorkdir to item 2 of argv' \
    -e '  set theCmd to item 3 of argv' \
    -e '  set titleSeq to "printf '\''\\033]0;%s\\007'\'' " & quoted form of theTitle & " && exec zsh -lc " & quoted form of theCmd' \
    -e '  tell application "Ghostty"' \
    -e '    set cfg to new surface configuration' \
    -e '    set command of cfg to "zsh -lic " & quoted form of titleSeq' \
    -e '    set initial working directory of cfg to theWorkdir' \
    -e '    set wait after command of cfg to true' \
    -e '    set environment variables of cfg to {"GHOSTTY_WORKSPACE_TITLE=" & theTitle}' \
    -e '    new window with configuration cfg' \
    -e '  end tell' \
    -e 'end run' \
    -- "$title" "$workdir" "$cmd"
}

create_cmux_window() {
  if osascript -e 'application "cmux" is running' 2>/dev/null | grep -q 'true'; then
    return 0
  fi
  open -a cmux
}

# `open -n` is a no-op for Omnigent: its Electron single-instance lock hands the
# launch to the running app, which does not open a window for it. The New
# Window menu item is the only window-creation entry point that does not
# name an origin, so it is now the FALLBACK -- a window it makes lands on
# whatever origin the app last used, which is the bug this file works around.
# It is under File since 0.21.0 and was under Server before.
create_omnigent_window() {
  local menu
  for menu in File Server; do
    osascript \
      -e 'tell application "System Events" to tell process "Omnigent"' \
      -e "  click menu item \"New Window\" of menu 1 of menu bar item \"$menu\" of menu bar 1" \
      -e 'end tell' >/dev/null 2>&1 && return 0
  done
  return 1
}

# Deep link that pins this workspace's Omnigent window to its own origin.
#
# Each workspace has a distinct hostname on the one TLS listener, so its window
# gets its own localStorage and therefore its own memory of which host and
# checkout the composer starts on. Without this the app's choice is app-global
# and every window shares it. See docs/omnigent-window-location-design.md.
#
# The link grammar accepts only /c/<session_id> (deepLink.js), so the origin
# needs a session to point at: the most recent one already on that host and
# checkout, which lands the window on the last thing worked on there.
#
# Prints the URL, or nothing when it cannot be resolved -- a missing table, a
# hub that is not answering, or a location with no sessions yet. The caller
# falls back to an unscoped window rather than failing a login-time script.
omnigent_deep_link() {
  local ws="$1" table row kind origin fqdn workspace_filter host_id session base

  command -v workspaces >/dev/null 2>&1 || return 1
  table=$(workspaces --json 2>/dev/null) || return 1
  row=$(jq -c --arg ws "$ws" '.workspaces[] | select(.workspace == $ws)' <<< "$table")
  [[ -n "$row" ]] || return 1

  kind=$(jq -r '.kind' <<< "$row")
  origin=$(jq -r '.origin' <<< "$row")
  [[ -n "$origin" && "$origin" != null ]] || return 1

  # A devserver row is pinned to one checkout on one host; the local row is the
  # Mac itself, where any of its own sessions is the right landing place.
  if [[ "$kind" == devserver ]]; then
    fqdn=$(jq -r '.host' <<< "$row")
    workspace_filter=$(jq -r '.checkout' <<< "$row")
  else
    fqdn=$(hostname -f 2>/dev/null || hostname 2>/dev/null)
    workspace_filter=""
  fi

  base="http://127.0.0.1:${OMNIGENT_PORT}"
  host_id=$(curl -s --noproxy '*' -m 5 "$base/v1/hosts" 2>/dev/null \
    | jq -r --arg fqdn "$fqdn" '.hosts[]? | select(.name == $fqdn) | .host_id' | head -1)
  [[ -n "$host_id" ]] || return 1

  # No server-side host_id filter exists, so page a window of recent sessions
  # and pick client-side. Archived sessions are already excluded by default.
  # Untitled sessions are skipped: the title is how the resulting window is
  # identified below, so a session without one cannot be claimed.
  session=$(curl -s --noproxy '*' -m 8 "$base/v1/sessions?limit=100" 2>/dev/null \
    | jq -r --arg host "$host_id" --arg ws_dir "$workspace_filter" '
        [ .data[]?
          | select(.host_id == $host)
          | select($ws_dir == "" or .workspace == $ws_dir)
          | select((.title // "") != "")
        ] | .[0] // empty | "\(.id)\t\(.title)"' | head -1)
  [[ -n "$session" && "$session" != "null" ]] || return 1

  printf 'omnigent://%s:%s/c/%s\t%s\n' \
    "$origin" "$OMNIGENT_TLS_PORT" "${session%%$'\t'*}" "${session#*$'\t'}"
}

# Make every workspace origin a KNOWN server before linking to it.
#
# The app asks for consent the first time a link pins a new origin, and records
# the grant by pushing the URL onto `recent_servers` -- whose own docstring says
# a user who consented "should not have to consent again next time". That list
# is also the UI's recents list and is capped at MAX_RECENT_SERVERS (5), so with
# 8 workspace origins plus the saved default it cannot hold them all: the
# earliest grants are evicted and re-prompt at the next login, forever.
#
# knownOrigins() re-reads settings.json on every link and applies no cap on
# READ -- only writes truncate. So restoring the full set immediately before
# each link is enough for every one of them to be recognised. The app is free
# to truncate afterwards; the next call puts it back.
#
# HACK: this writes another application's settings file. It is contained
# (recent_servers only, atomic replace, every other key preserved) and that
# file is explicitly documented as tolerating hand edits (main.js:1065), but the
# real fix is upstream -- the consent set is a trust store and should not be
# kept in a display list with a display cap. Delete this once that lands.
omnigent_seed_known_origins() {
  local settings="$HOME/Library/Application Support/Omnigent/settings.json"
  local table origins tmp
  [[ -f "$settings" ]] || return 0
  command -v workspaces >/dev/null 2>&1 || return 0
  table=$(workspaces --json 2>/dev/null) || return 0

  origins=$(jq -c --arg port "$OMNIGENT_TLS_PORT" \
    '[.workspaces[].origin | "https://\(.):\($port)"]' <<< "$table") || return 0

  tmp=$(mktemp "${settings}.XXXXXX") || return 0
  if jq --argjson origins "$origins" '.recent_servers = $origins' "$settings" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$settings"
  else
    rm -f "$tmp"
  fi
}

# Omnigent windows showing conversation TITLE, by id.
#
# The conversation title is the only identity an Omnigent window exposes to
# AeroSpace -- there is no origin and no stable id -- and a deep link names the
# session it targets, so the title is knowable in advance. Tolerates the "● "
# the app prepends while that conversation has a turn running.
omnigent_window_ids_by_title() {
  local want="$1"
  aerospace list-windows --all --json 2>/dev/null \
    | jq -r --arg app "$OMNIGENT_APP" --arg invalid "$OMNIGENT_INVALID_TITLE_PATTERN" \
           --arg want "$want" '
        .[] | select(
          ."app-name" == $app
          and ((.["window-title"] // "") | test($invalid) | not)
          and (((.["window-title"] // "") | ltrimstr("● ")) == $want)
        ) | .["window-id"]' | sort -n
}

# Resolve which window a deep link landed on, by the conversation it shows.
#
# Matching on identity rather than on arrival: the app reuses the window already
# pinned to that origin or opens a new one (`reuse-inplace` / `open-known` in
# deepLink.js), and window creation is slow enough that "whichever window
# appeared" attributes a late window from one workspace to the next one in the
# loop -- which shuffled every window into the wrong workspace the first time
# this ran.
#
# Returns nothing rather than guessing. The first link to an origin raises a
# consent dialog and opens no window until accepted, and a wrong claim would
# pin the wrong location for the rest of the run.
wait_for_omnigent_deep_link_window() {
  local title="$1" attempt=0 wid focused unclaimed count

  while [[ "$attempt" -lt 20 ]]; do
    attempt=$(( attempt + 1 ))
    sleep 0.5

    unclaimed=""
    for wid in $(omnigent_window_ids_by_title "$title"); do
      omnigent_id_is_claimed "$wid" || unclaimed="${unclaimed}${unclaimed:+$'\n'}${wid}"
    done
    [[ -n "$unclaimed" ]] || continue

    # Titles are conversation names and are NOT unique -- three checkouts can
    # each hold a session called "Casual greeting". Title alone would then hand
    # a workspace a correctly-titled window belonging to another origin, which
    # is the original mis-assignment wearing a better disguise. The app raises
    # the window a link targets, so focus is what disambiguates; the title is
    # what stops a stale focus being mistaken for the link landing. Require
    # both.
    focused=$(get_focused_window_id)
    if [[ -n "$focused" ]] && echo "$unclaimed" | grep -qx "$focused"; then
      echo "$focused"
      return 0
    fi

    # Unique title and the app has had time to raise: focus is not needed to
    # tell the windows apart, so accept it rather than fail over a window
    # manager that did not report focus.
    count=$(echo "$unclaimed" | grep -c .)
    if [[ "$count" -eq 1 && "$attempt" -ge 6 ]]; then
      echo "$unclaimed"
      return 0
    fi
  done
  return 1
}

omnigent_app_is_running() {
  osascript -e 'application "Omnigent" is running' 2>/dev/null | grep -q 'true'
}

ensure_omnigent_running() {
  if ! omnigent_app_is_running; then
    echo "[Omnigent] launching app..."
    open -a "$OMNIGENT_APP" || return 1
    for _ in $(seq 1 40); do
      sleep 0.5
      if omnigent_app_is_running; then
        break
      fi
    done
    omnigent_app_is_running || return 1
  fi

  if [[ "$omnigent_restore_settled" != true ]]; then
    wait_for_window_settle "$OMNIGENT_APP" 2 20 || true
    omnigent_restore_settled=true
    SNAPSHOT=$(snapshot_windows)
  fi
}

# Whether the hub answers through the Mac's proxy, trying for up to
# OMNIGENT_HUB_WAIT seconds (none in a full run; a --deferred run starts as a
# tunnel connects, a moment before its forwards serve). A miss is kept for the
# rest of the run: while a tunnel waits on Duo the proxy holds each probe for
# its full timeout, and the rows it would have served are deferred anyway.
OMNIGENT_HUB_WAIT=0
omnigent_hub_down=false
omnigent_hub_answers() {
  local deadline=$((SECONDS + OMNIGENT_HUB_WAIT))
  [[ "$omnigent_hub_down" != true ]] || return 1
  until curl -sf -m 5 "http://127.0.0.1:${OMNIGENT_PORT}/health" >/dev/null 2>&1; do
    if (( SECONDS >= deadline )); then
      omnigent_hub_down=true
      return 1
    fi
    sleep 1
  done
}

# omnigent_hold_slot WS -- claim the Omnigent window already on WS, if any, for
# a row that waits on the hub: it keeps the slot rather than being swept, until
# the row's own window replaces it.
omnigent_hold_slot() {
  local wid
  wid=$(find_unclaimed_omnigent_window "$1") || return 0
  claim_omnigent_window "$wid"
}

# ── Helpers ──────────────────────────────────────────────────────────

managed_workspaces() {
  printf '%s\n' "${WORKSPACES[@]}" | cut -d'|' -f1 | sort -u
}

# %{workspace} is not in the default --json payload. Asking for it costs the
# same single call and lets workspace-aware lookups run off the snapshot
# instead of a second query.
snapshot_windows() {
  aerospace list-windows --all --json \
    --format '%{window-id}%{workspace}%{app-name}%{window-title}' 2>/dev/null
}

wait_for_window_settle() {
  local app_name="$1" stable_seconds="${2:-2}" timeout="${3:-20}"
  local deadline last_ids="" stable_since=0 snapshot ids now
  deadline=$(($(date +%s) + timeout))

  while [[ $(date +%s) -lt "$deadline" ]]; do
    snapshot=$(snapshot_windows) || {
      sleep 0.5
      continue
    }
    ids=$(echo "$snapshot" | jq -r --arg app "$app_name" \
      '[.[] | select(."app-name" == $app)] | .[]["window-id"]' | sort -n)
    now=$(date +%s)
    if [[ "$ids" == "$last_ids" ]]; then
      [[ "$stable_since" -eq 0 ]] && stable_since="$now"
      if [[ $((now - stable_since)) -ge "$stable_seconds" ]]; then
        return 0
      fi
    else
      last_ids="$ids"
      stable_since="$now"
    fi
    sleep 0.5
  done
  return 1
}

# AeroSpace orders list-windows by title and breaks ties arbitrarily, so `first`
# alone picks a different window run to run whenever two titles match. Sorting
# by window id makes every lookup here reproducible, and makes this script and
# arrange-ws11 agree on which window a shared title refers to.
find_window_id() {
  local app_name="$1" title_substr="$2" snapshot="$3"
  echo "$snapshot" | jq -r \
    --arg app "$app_name" \
    --arg title "$title_substr" \
    '[.[] | select(."app-name" == $app and (.["window-title"] | test($title; "i")))]
       | sort_by(.["window-id"]) | first | .["window-id"] // empty'
}

find_window_id_for_workspace() {
  local app_name="$1" title_substr="$2" ws="$3" snapshot="$4"
  local window_id

  window_id=$(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
    | jq -r \
      --arg app "$app_name" \
      --arg title "$title_substr" \
      '[.[] | select(."app-name" == $app and (.["window-title"] | test($title; "i")))]
         | sort_by(.["window-id"]) | first | .["window-id"] // empty') || true
  if [[ -n "$window_id" ]]; then
    echo "$window_id"
    return 0
  fi

  find_window_id "$app_name" "$title_substr" "$snapshot"
}

get_focused_window_id() {
  aerospace list-windows --focused --json 2>/dev/null | jq -r '.[0]["window-id"] // empty'
}

window_exists() {
  local wid="$1"
  aerospace list-windows --all --json 2>/dev/null \
    | jq -e --argjson wid "$wid" \
      '[.[] | select(.["window-id"] == $wid)] | length > 0' >/dev/null
}

close_window_id() {
  local wid="$1" reason="$2"
  echo "Closing ${reason} window $wid..."
  aerospace close --window-id "$wid" 2>/dev/null || true
  for _ in $(seq 1 20); do
    sleep 0.2
    window_exists "$wid" || return 0
  done

  echo "WARNING: ${reason} window $wid did not close" >&2
  return 1
}

# t3_forwards_for_host HOST -> the LOCAL:REMOTE forward nvs-tunnels makes for
# the host's T3 Code server, when a workspace is on that host; else nothing.
t3_forwards_for_host() {
  local host="$1" port
  case "$host" in
    "$OMNIGENT_PRIMARY_FQDN") port="$T3_PRIMARY_TUNNEL_PORT" ;;
    "$OMNIGENT_STANDBY_FQDN") port="$T3_STANDBY_TUNNEL_PORT" ;;
    *) return 0 ;;
  esac
  if workspaces --json 2>/dev/null \
      | jq -e --arg host "$host" 'any(.workspaces[]; .kind == "devserver" and .host == $host)' >/dev/null; then
    echo "${port}:${T3_PORT}"
  fi
}

tunnel_command_is_current() {
  local host="$1"
  local cmds local_port expected
  # We need the complete command line to inspect its tunnel flags.
  # shellcheck disable=SC2009
  cmds=$(ps -axo command | grep -F "x2ssh -et $host" | grep -v grep || true)

  # If the tunnel is between x2ssh attempts (Duo/reconnect), don't churn the
  # Ghostty window. We only know it is stale when a live x2ssh command lacks
  # the candidate-specific Omnigent forward.
  [[ -z "$cmds" ]] && return 0

  case "$host" in
    "$OMNIGENT_PRIMARY_FQDN") local_port="$OMNIGENT_PRIMARY_TUNNEL_PORT" ;;
    "$OMNIGENT_STANDBY_FQDN") local_port="$OMNIGENT_STANDBY_TUNNEL_PORT" ;;
    *) return 0 ;;
  esac
  expected="${local_port}:${OMNIGENT_PORT}"
  echo "$cmds" | grep -F -- "-t " | grep -F -- "$expected" >/dev/null || return 1
  if [[ "$STARTUP_T3_WINDOWS" == 1 ]]; then
    # Likewise the host's T3 Code forward and a session that mints a pool of
    # T3 Code pairing tokens (nvs-tunnels' remote command), so a tunnel started
    # before nvs-tunnels made them, with a forward per checkout from when each
    # had a server, or minting a token per checkout, is rebuilt rather than kept.
    expected=$(t3_forwards_for_host "$host")
    if [[ -n "$expected" ]]; then
      echo "$cmds" | grep -F -- "-t " | grep -F -- "$expected" >/dev/null || return 1
      echo "$cmds" | grep -E -- "t3-pairing-tokens [0-9]+" >/dev/null || return 1
    fi
  fi

  # A failed ET registration can leave the process alive with all forward
  # ports listening but no transport to its local SSH proxy. Treat that exact
  # state as stale; a process that has not opened listeners yet may simply be
  # waiting for interactive Duo and must not be churned.
  ! tunnel_et_is_stuck "$host"
}

tunnel_et_is_stuck() {
  local host="$1" pid proxy_port
  local found_listener=false

  while IFS='|' read -r pid proxy_port; do
    [[ -n "$pid" && -n "$proxy_port" ]] || continue

    if lsof -nP -a -p "$pid" -iTCP -sTCP:ESTABLISHED 2>/dev/null \
        | grep -Eq -- "->(\\[::1\\]|127\\.0\\.0\\.1):${proxy_port} \\(ESTABLISHED\\)$"; then
      return 1
    fi
    if lsof -nP -a -p "$pid" -iTCP -sTCP:LISTEN >/dev/null 2>&1; then
      found_listener=true
    fi
  done < <(ps -axo pid=,command= | awk -v host="$host" '
    index($0, "et --ssh-socket") && index($0, "HostName=" host) {
      for (i = 2; i < NF; i++) {
        if ($i ~ /^localhost:[0-9]+$/ && $(i + 1) == "-t") {
          split($i, endpoint, ":")
          print $1 "|" endpoint[2]
          break
        }
      }
    }
  ')

  [[ "$found_listener" == true ]]
}

stop_tunnel_processes_for_host() {
  local host="$1"
  local pids

  pids=$(ps -axo pid,command | awk -v host="$host" '
    index($0, "nvs-tunnels " host) ||
    index($0, "x2ssh -et " host) ||
    index($0, "fallback " host) ||
    index($0, "HostName=" host) {
      print $1
    }
  ') || true

  [[ -z "$pids" ]] && return 0
  echo "Stopping stale tunnel process(es) for $host: $(echo "$pids" | tr '\n' ' ')"
  # pids is an intentional whitespace-delimited list produced by awk.
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
}

# mac_proxy is owned by the launchd job com.mkarrmann.omnigent-tunnel. Any copy
# started some other way -- the retired workspace-T Ghostty window, or a manual
# `omnigent-tunnel` -- is an active competitor for OMNIGENT_PORT: whichever
# copy binds first wins and the loser spins on "address already in use"
# indefinitely, because mac_proxy retries the bind rather than exiting. So the
# port has to have exactly one owner, and it has to be the supervised one.
#
# ppid is the discriminator: launchd reparents its child to 1. Refuse to act
# when the job is not loaded, so this never leaves the Mac with no proxy at all
# on a machine where sync.sh has not run yet.
#
# omnigent-tunnel exec's into python, so the retired window's own process IS
# mac_proxy -- killing it closes the Ghostty window with it.
retire_unsupervised_mac_proxy() {
  local pids
  launchctl print "gui/$UID/com.mkarrmann.omnigent-tunnel" >/dev/null 2>&1 || {
    echo "WARNING: com.mkarrmann.omnigent-tunnel is not loaded; leaving the unsupervised proxy alone (run $HOME/dotfiles/sync.sh)" >&2
    return 0
  }

  # Also catches the pre-mac_proxy dedicated ET forward (`x2ssh -et ... -t
  # 6767:6767`), which binds the same port and would deadlock the job just as
  # effectively. macOS truncates `ps comm` to 16 characters, which for the venv
  # interpreter is just "/Users/mkarrmann", so match structured argv fields.
  pids=$(ps -axo pid=,ppid=,args= | awk -v port="$OMNIGENT_PORT" '
    $3 ~ /(^|\/)python([0-9.]*)?$/ && $4 == "-m" && $5 == "omnigent_hub.mac_proxy" && $2 != 1 { print $1; next }
    index($0, "x2ssh -et ") && index($0, "-t " port ":" port) { print $1 }
  ') || true
  [[ -n "$pids" ]] || return 0

  echo "retiring unsupervised mac_proxy (launchd owns :${OMNIGENT_PORT} now): $(echo "$pids" | tr '\n' ' ')"
  # pids is an intentional whitespace-delimited list produced by awk.
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
}

# Ghostty outlives the command it was given, so killing the proxy above leaves
# an idle "Omnigent: tunnel" window behind. With the workspace-T entry gone it
# is no longer a managed window, and the stray sweep would only relocate it to
# Z rather than close it -- so close it here, by title, wherever it ended up.
close_retired_omnigent_tunnel_windows() {
  local snapshot wid
  snapshot=$(snapshot_windows)
  while IFS= read -r wid; do
    [[ -n "$wid" ]] || continue
    close_window_id "$wid" "retired Omnigent tunnel" || true
  done < <(printf '%s' "$snapshot" | jq -r '
    .[] | select(."app-name" == "Ghostty")
        | select(."window-title" | test("Omnigent.*tunnel"; "i"))
        | ."window-id"')
}

close_stale_tunnel_window_if_needed() {
  local wid="$1" title="$2" cmd="$3"
  local _nvs host _rest

  [[ "$cmd" == nvs-tunnels\ * ]] || return 1
  read -r _nvs host _rest <<< "$cmd"
  [[ -n "$host" ]] || return 1

  if tunnel_command_is_current "$host"; then
    return 1
  fi

  echo "[$title] existing NVS tunnel is stale for $host; recreating it..."
  close_window_id "$wid" "stale tunnel"
  stop_tunnel_processes_for_host "$host"
}

# window_ids_for_app SNAPSHOT APP EXCLUDE_TITLE_RE -> ascending window ids
# An empty EXCLUDE_TITLE_RE excludes nothing.
window_ids_for_app() {
  local snapshot="$1" app_name="$2" exclude_title_re="$3"
  echo "$snapshot" | jq -r \
    --arg app "$app_name" --arg excl "$exclude_title_re" \
    '[.[] | select(
       ."app-name" == $app and
       ($excl == "" or ((.["window-title"] // "") | test($excl) | not))
     )] | .[]["window-id"]' | sort -n
}

# wait_for_new_window APP BEFORE_SNAPSHOT [EXCLUDE_TITLE_RE] -> new window id
#
# EXCLUDE_TITLE_RE drops windows that belong to APP but can never satisfy a
# workspace slot, so a helper window created alongside the real one is not
# mistaken for it (Omnigent's update overlay appears one id after its parent).
wait_for_new_window() {
  local app_name="$1" before_snapshot="$2" exclude_title_re="${3:-}"
  local before_ids
  before_ids=$(window_ids_for_app "$before_snapshot" "$app_name" "$exclude_title_re")

  for _ in $(seq 1 20); do
    sleep 0.5
    local current_snapshot current_ids new_id
    current_snapshot=$(snapshot_windows)
    current_ids=$(window_ids_for_app "$current_snapshot" "$app_name" "$exclude_title_re")
    new_id=$(comm -23 <(echo "$current_ids") <(echo "$before_ids") | head -1)
    if [[ -n "$new_id" ]]; then
      echo "$new_id"
      return 0
    fi
  done
  return 1
}

chrome_id_is_claimed() {
  local wid="$1"
  [[ -n "$claimed_chrome_ids" ]] && echo "$claimed_chrome_ids" | grep -qx "$wid"
}

claim_chrome_window() {
  local wid="$1"
  chrome_id_is_claimed "$wid" || claimed_chrome_ids="${claimed_chrome_ids}${claimed_chrome_ids:+$'\n'}${wid}"
}

find_valid_unclaimed_chrome_window_on_workspace() {
  local ws="$1"
  local wid
  for wid in $(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
    | jq -r --arg app "$CHROME_APP" --arg invalid "$CHROME_INVALID_TITLE_PATTERN" --arg t3title "$T3_ANY_TITLE_PATTERN" --argjson t3ids "$(t3_window_ids_json)" \
      '.[] | select(
        ."app-name" == $app and
        ((.["window-title"] // "") | test($invalid) | not) and
        ((.["window-title"] // "") | test($t3title) | not) and
        (.["window-id"] | IN($t3ids[]) | not)
      ) | .["window-id"]' | sort -n); do
    if ! chrome_id_is_claimed "$wid"; then
      echo "$wid"
      return 0
    fi
  done
  return 1
}

find_valid_unclaimed_chrome_window() {
  local wid
  for wid in $(aerospace list-windows --all --json 2>/dev/null \
    | jq -r --arg app "$CHROME_APP" --arg invalid "$CHROME_INVALID_TITLE_PATTERN" --arg t3title "$T3_ANY_TITLE_PATTERN" --argjson t3ids "$(t3_window_ids_json)" \
      '.[] | select(
        ."app-name" == $app and
        ((.["window-title"] // "") | test($invalid) | not) and
        ((.["window-title"] // "") | test($t3title) | not) and
        (.["window-id"] | IN($t3ids[]) | not)
      ) | .["window-id"]' | sort -n); do
    if ! chrome_id_is_claimed "$wid"; then
      echo "$wid"
      return 0
    fi
  done
  return 1
}

workspace_has_claimed_chrome_window() {
  local ws="$1" wid
  for wid in $(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
    | jq -r --arg app "$CHROME_APP" --arg invalid "$CHROME_INVALID_TITLE_PATTERN" --arg t3title "$T3_ANY_TITLE_PATTERN" --argjson t3ids "$(t3_window_ids_json)" \
      '.[] | select(
        ."app-name" == $app and
        ((.["window-title"] // "") | test($invalid) | not) and
        ((.["window-title"] // "") | test($t3title) | not) and
        (.["window-id"] | IN($t3ids[]) | not)
      ) | .["window-id"]'); do
    chrome_id_is_claimed "$wid" && return 0
  done
  return 1
}

omnigent_id_is_claimed() {
  local wid="$1"
  [[ -n "$claimed_omnigent_ids" ]] && echo "$claimed_omnigent_ids" | grep -qx "$wid"
}

claim_omnigent_window() {
  local wid="$1"
  omnigent_id_is_claimed "$wid" || claimed_omnigent_ids="${claimed_omnigent_ids}${claimed_omnigent_ids:+$'\n'}${wid}"
}

omnigent_window_ids() {
  local ws="${1:-}"
  if [[ -n "$ws" ]]; then
    aerospace list-windows --workspace "$ws" --json 2>/dev/null
  else
    aerospace list-windows --all --json 2>/dev/null
  fi | jq -r --arg app "$OMNIGENT_APP" --arg invalid "$OMNIGENT_INVALID_TITLE_PATTERN" \
    '.[] | select(
      ."app-name" == $app and
      ((.["window-title"] // "") | test($invalid) | not)
    ) | .["window-id"]' | sort -n
}

find_unclaimed_omnigent_window() {
  local ws="${1:-}" wid
  for wid in $(omnigent_window_ids "$ws"); do
    if ! omnigent_id_is_claimed "$wid"; then
      echo "$wid"
      return 0
    fi
  done
  return 1
}

workspace_has_claimed_omnigent_window() {
  local ws="$1" wid
  for wid in $(omnigent_window_ids "$ws"); do
    omnigent_id_is_claimed "$wid" && return 0
  done
  return 1
}

# T3 Code servers by host: a devserver's FQDN, or this for the Mac's own server
# (t3@local, launchd/com.mkarrmann.t3-local.plist), which mints its tokens here.
T3_LOCAL_HOST="local"

# t3_workspace_window WS -> "STATE_DIR<TAB>URL<TAB>HOST<TAB>PROJECT" for the
# workspace's T3 Code window: PROJECT is ~/checkoutN on a devserver (its home is
# not known here), an absolute path on the Mac.
t3_workspace_window() {
  local ws="$1" row url origin
  row=$(workspaces --json 2>/dev/null | jq -r --arg ws "$ws" --arg local "$T3_LOCAL_HOST" '
    .workspaces[] | select(.workspace == $ws and (.t3Url // "") != "")
    | [.t3Url, (.host // $local), .t3Project] | @tsv') || return 1
  [[ -n "$row" ]] || return 1
  url="${row%%$'\t'*}"
  origin="${url#http://}"
  origin="${origin%%:*}"
  printf '%s/%s\t%s\n' "$T3_STATE_DIR" "${origin%.t3.localhost}" "$row"
}

# t3_links WS -> "HOST<TAB>URL<TAB>LABEL" for each other T3 Code server, which
# workspace WS's window links: its port here (a devserver's tunnel forward, the
# Mac's own server), and a label (the prefix a devserver's nvs sessions share,
# CCO or FTW; Mac).
t3_links() {
  workspaces --json 2>/dev/null | jq -r --arg ws "$1" --arg local "$T3_LOCAL_HOST" '
    [.workspaces[] | select((.t3Url // "") != "") | .host //= $local] as $rows
    | ($rows[] | select(.workspace == $ws) | .host) as $own
    | [$rows[] | select(.host != $own)] | group_by(.host)[] | first
    | [.host, ("http://127.0.0.1:" + (.t3Url | capture(":(?<port>[0-9]+)/").port)),
       (if .host == $local then "Mac" else (.nvsSession | split("-") | first) end)]
    | @tsv'
}

# t3_wait_for_server HOST URL — before the first window or link for a host,
# check that its server answers at URL, waiting up to T3_SERVER_WAIT seconds
# for a devserver's (T3_LOCAL_SERVER_WAIT for the Mac's). A window opened
# earlier lands on an error page that never retries. Fails when it does not
# answer, saying so once per host: for the Mac's server as a warning (counted in
# $failures), for a devserver's as the wait on its tunnel it is.
t3_wait_for_server() {
  local host="$1" url="$2" port deadline wait="$T3_SERVER_WAIT"
  [[ " $t3_unreachable_hosts " != *" $host "* ]] || return 1
  [[ " $t3_waited_hosts " != *" $host "* ]] || return 0
  [[ "$host" != "$T3_LOCAL_HOST" ]] || wait="$T3_LOCAL_SERVER_WAIT"
  port="${url##*:}"
  port="${port%%/*}"
  deadline=$((SECONDS + wait))
  until curl -s --noproxy '*' -o /dev/null -m 2 "http://127.0.0.1:$port/"; do
    if (( SECONDS >= deadline )); then
      if [[ "$host" == "$T3_LOCAL_HOST" ]]; then
        echo "WARNING: [T3] $host's T3 Code server is not answering; skipping its windows" >&2
        ((failures++)) || true
      else
        echo "[T3] $host's T3 Code server is not answering yet; its windows wait for its tunnel"
      fi
      t3_unreachable_hosts+=" $host"
      return 1
    fi
    sleep 0.5
  done
  t3_waited_hosts+=" $host"
}

# t3_url_port URL -> its port.
t3_url_port() {
  local port="${1##*:}"
  printf '%s' "${port%%/*}"
}

# t3_environment_id URL -> the environment id of the T3 Code server at URL.
t3_environment_id() {
  curl -s --noproxy '*' -m 5 "$1/.well-known/t3/environment" 2>/dev/null | jq -r '.environmentId // empty' 2>/dev/null || true
}

# t3_take_pairing_token DEVSERVER [WAIT] -> a token from that devserver's pool,
# removed so it is used once, waiting up to WAIT seconds for nvs-tunnels to pool
# one; nothing when none comes.
t3_take_pairing_token() {
  local dir="$T3_PAIRING_DIR/$1" deadline=$((SECONDS + ${2:-0})) file token
  if [[ "$1" == "$T3_LOCAL_HOST" ]]; then
    # The Mac's own server mints one on the spot.
    T3CODE_HOME="$HOME/.t3-workspaces/local" "${T3_BIN:-$HOME/.local/bin/t3}" pair --ttl 5m --label startup-windows 2>/dev/null \
      | sed -n 's/^Token: //p' | tr -d '\r' || true
    return 0
  fi
  while true; do
    find "$dir" -type f -mmin "+$T3_PAIRING_TOKEN_MAX_AGE_MIN" -delete 2>/dev/null || true
    file=$(find "$dir" -type f 2>/dev/null | head -n 1 || true)
    if [[ -n "$file" ]]; then
      token=$(head -n 1 "$file")
      rm -f "$file"
      if [[ -n "$token" ]]; then
        printf '%s\n' "$token"
        return 0
      fi
      continue
    fi
    (( SECONDS < deadline )) || return 0
    sleep 0.5
  done
}

# t3_window_title WINDOW_ID -> its title.
t3_window_title() {
  aerospace list-windows --all --json --format '%{window-id}%{window-title}' 2>/dev/null \
    | jq -r --argjson wid "$1" '.[] | select(.["window-id"] == $wid) | .["window-title"] // empty'
}

# t3_windows -> "WINDOW_ID ORIGIN" for each T3 Code window in T3_BROWSER_APP.
# Listing tags window titles for a moment, so it is redone only when the set of
# the browser's windows changed since the last listing, which T3_WINDOWS_CACHE keeps
# (first line) with its result: callers run in command substitutions, whose
# variables die with them.
t3_windows() {
  local key list
  key=$(aerospace list-windows --all --json 2>/dev/null \
    | jq -c --arg app "$T3_BROWSER_APP" '[.[] | select(."app-name" == $app) | .["window-id"]] | sort') || key=""
  if [[ ! -e "$T3_WINDOWS_CACHE" || "$(head -n 1 "$T3_WINDOWS_CACHE")" != "$key" ]]; then
    list=$(t3-window-scope --list-windows 2>/dev/null) || list=""
    printf '%s\n%s' "$key" "${list:+$list$'\n'}" > "$T3_WINDOWS_CACHE"
  fi
  tail -n +2 "$T3_WINDOWS_CACHE"
}

# t3_window_ids_json -> JSON array of the ids of every T3 Code window.
t3_window_ids_json() {
  t3_windows | awk '{ print $1 }' | jq -s -c '.'
}

# t3_window_id_for_origin ORIGIN -> the lowest id of a T3 Code window on ORIGIN.
t3_window_id_for_origin() {
  t3_windows | awk -v o="$1" '$2 == o { print $1 }' | sort -n | head -n 1
}

# retire_t3_profile_chromes -- quit the Chrome instances T3 Code windows used to
# run in (T3_LEGACY_CHROME_DATA_ROOT), waiting up to 10s for them to go.
retire_t3_profile_chromes() {
  local pids
  pids=$(ps -axo pid=,command= 2>/dev/null \
    | awk -v root="--user-data-dir=$T3_LEGACY_CHROME_DATA_ROOT/" 'index($0, root) && !/--type=/ { print $1 }') || pids=""
  [[ -n "$pids" ]] || return 0
  echo "[T3] quitting the Chrome instances of the old per-workspace T3 Code profiles..."
  # shellcheck disable=SC2086
  kill -TERM $pids 2>/dev/null || true
  local pid alive
  for _ in $(seq 1 20); do
    alive=""
    for pid in $pids; do
      ! kill -0 "$pid" 2>/dev/null || alive+=" $pid"
    done
    [[ -n "$alive" ]] || return 0
    sleep 0.5
  done
  echo "WARNING: [T3] an old T3 Code Chrome instance is still running (pids:$alive)" >&2
}

# A window's state directory records the T3 Code servers its origin is set up
# with as files named by their environment ids in STATE/$T3_SERVERS_DIR: its own
# host's once a window on it was paired and scoped, each other host's once linked. A server whose
# state was reset has a new id, and so does a server of an earlier design (a
# server per checkout, on another port, whose session cookie this origin does
# not get), so neither counts.
T3_SERVERS_DIR=".t3-servers"

# t3_browser_installed -- whether T3_BROWSER_APP is where t3-window-scope looks for it.
t3_browser_installed() {
  [[ -d "/Applications/$T3_BROWSER_APP.app" ]]
}

# t3_set_up STATE ENVIRONMENT_ID -> whether STATE's origin is set up with that server.
t3_set_up() {
  [[ -n "$2" && -e "$1/$T3_SERVERS_DIR/$2" ]]
}

# t3_mark_set_up STATE ENVIRONMENT_ID...
t3_mark_set_up() {
  local state="$1" env
  shift
  mkdir -p "$state/$T3_SERVERS_DIR"
  for env; do
    : > "$state/$T3_SERVERS_DIR/$env"
  done
}

# t3_collect_links WS STATE TITLE -- each other devserver's server the window
# has not linked yet, with a token of its own, in T3_LINK_ARGS (t3-window-scope's
# --link arguments), T3_LINK_TOKENS and T3_LINK_ENVS.
t3_collect_links() {
  local ws="$1" state="$2" title="$3" link_host link_url link_label link_env link_token
  T3_LINK_ARGS=() T3_LINK_TOKENS=() T3_LINK_ENVS=()
  while IFS=$'\t' read -r link_host link_url link_label; do
    [[ -n "$link_host" ]] || continue
    t3_wait_for_server "$link_host" "$link_url" || continue
    link_env=$(t3_environment_id "$link_url")
    if [[ -z "$link_env" ]]; then
      echo "WARNING: [$title] $link_host's T3 Code server did not say which it is; not linked" >&2
      ((failures++)) || true
      continue
    fi
    ! t3_set_up "$state" "$link_env" || continue
    link_token=$(t3_take_pairing_token "$link_host" "$T3_PAIRING_TOKEN_WAIT")
    if [[ -z "$link_token" ]]; then
      echo "WARNING: [$title] no pairing token from $link_host; its threads are not listed here" >&2
      ((failures++)) || true
      continue
    fi
    T3_LINK_ARGS+=(--link "$link_url" "$link_label")
    T3_LINK_TOKENS+=("$link_token")
    T3_LINK_ENVS+=("$link_env")
  done < <(t3_links "$ws")
}

# reconcile_t3_window WS TITLE -- find or open workspace WS's T3 Code window and
# move it there. A window found is left as it is; a window this opens starts its
# new threads in the workspace's checkout. Problems count in $failures.
reconcile_t3_window() {
  local ws="$1" title="$2" row state url origin host workdir window_id token open_url created=false
  local fresh=false wait scope_rc own_env=""
  if ! t3_browser_installed; then
    if [[ "$t3_browser_missing_warned" != true ]]; then
      echo "WARNING: T3 Code windows need $T3_BROWSER_APP, which is not installed:" >&2
      echo "         brew install --cask google-chrome@beta (or set T3_BROWSER_APP)" >&2
      ((failures++)) || true
      t3_browser_missing_warned=true
    fi
    return 0
  fi
  row=$(t3_workspace_window "$ws") || row=""
  if [[ -z "$row" ]]; then
    echo "WARNING: [$title] workspace $ws has no T3 Code server; skipping" >&2
    ((failures++)) || true
    return 0
  fi
  IFS=$'\t' read -r state url host workdir <<< "$row"
  origin="${url%/}"
  window_id=$(t3_window_id_for_origin "$origin") || window_id=""
  # A window left on an error page (it opened before its tunnel was up) never
  # retries, and its title is the host rather than T3 Code's; replace it.
  if [[ -n "$window_id" ]] && ! [[ "$(t3_window_title "$window_id")" =~ $T3_TITLE_PATTERN ]]; then
    close_window_id "$window_id" "T3 Code error page" || true
    window_id=""
  fi
  if t3_wait_for_server "$host" "$url"; then
    own_env=$(t3_environment_id "http://127.0.0.1:$(t3_url_port "$url")")
  fi
  # A window whose origin is not set up with its server (a run that failed to
  # pair or scope it, a window that loaded only once its tunnel came up, an
  # origin paired with an earlier server) sits on the pairing page or in no
  # project; open it again, paired, once its server answers.
  if [[ -n "$window_id" && -n "$own_env" ]] && ! t3_set_up "$state" "$own_env"; then
    close_window_id "$window_id" "T3 Code window not set up with its server" || true
    window_id=""
  fi
  if [[ -n "$window_id" ]]; then
    echo "[$title] assigning T3 Code window $window_id to workspace $ws..."
    # Link servers it has not listed yet (the other host was down when it was
    # set up, or a server's state was reset) in place, leaving its project.
    if t3_set_up "$state" "$own_env"; then
      t3_collect_links "$ws" "$state" "$title"
      if [[ ${#T3_LINK_TOKENS[@]} -gt 0 ]]; then
        if printf '%s\n' "${T3_LINK_TOKENS[@]}" \
            | t3-window-scope @chrome "$origin" --link-only "${T3_LINK_ARGS[@]}"; then
          t3_mark_set_up "$state" "${T3_LINK_ENVS[@]}"
        else
          echo "WARNING: [$title] could not link every other devserver's T3 Code server into window $window_id (see above)" >&2
          ((failures++)) || true
        fi
      fi
    fi
  else
    # A window opened on a server that does not answer lands on Chrome's error
    # page and cannot be paired or scoped; the next run opens it instead.
    if [[ -z "$own_env" ]]; then
      echo "[$title] not opened until $host's T3 Code server answers"
      return 0
    fi
    echo "[$title] opening $url on workspace $ws..."
    # An origin set up with this server keeps its session cookie, so only one
    # that is not waits for a token.
    t3_set_up "$state" "$own_env" || fresh=true
    wait=0
    [[ "$fresh" == false ]] || wait="$T3_PAIRING_TOKEN_WAIT"
    token=$(t3_take_pairing_token "$host" "$wait")
    open_url="$url${token:+pair#token=$token}"
    # -n: a launch the browser's own singleton hands to its running instance, or
    # that starts it, rather than one LaunchServices may route elsewhere. The
    # first-run flags keep a first launch from adding welcome windows.
    # --no-default-browser-check does not cover Chrome's default-browser prompt
    # experiments, which open macOS's "change your default web browser" dialog
    # moments after a launch that starts the browser.
    open -na "$T3_BROWSER_APP" --args --profile-directory="$T3_BROWSER_PROFILE" \
      --no-first-run --no-default-browser-check \
      --disable-features=DefaultBrowserPromptSurfaces,DefaultBrowserFramework,DefaultBrowserModal,DefaultBrowserStickyModal,DefaultBrowserSetterSelection,DefaultBrowserChangedOsNotification \
      --app="$open_url" 2>/dev/null || {
      echo "WARNING: [$title] creation failed, skipping" >&2
      ((failures++)) || true
      return 0
    }
    for _ in $(seq 1 40); do
      sleep 0.5
      # A listing taken while the page was still loading can miss it, and the
      # set of Chrome windows it is cached by does not change again.
      rm -f "$T3_WINDOWS_CACHE"
      window_id=$(t3_window_id_for_origin "$origin") || window_id=""
      [[ -n "$window_id" ]] && break
    done
    [[ -z "$window_id" ]] || created=true
  fi
  if [[ -z "$window_id" ]]; then
    echo "WARNING: [$title] could not find its T3 Code window (is Allow JavaScript from Apple Events" >&2
    echo "         on in $T3_BROWSER_APP? see t3-window-scope --list-windows)" >&2
    ((failures++)) || true
  else
    aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || true
  fi
  if [[ "$created" == true ]]; then
    echo "[$title] starting window $window_id's new threads in $workdir..."
    t3_collect_links "$ws" "$state" "$title"
    scope_rc=0
    { [[ ${#T3_LINK_TOKENS[@]} -eq 0 ]] || printf '%s\n' "${T3_LINK_TOKENS[@]}"; } \
      | t3-window-scope @chrome "$origin" "$workdir" ${T3_LINK_ARGS[@]+"${T3_LINK_ARGS[@]}"} || scope_rc=$?
    if [[ "$scope_rc" -eq 0 ]]; then
      t3_mark_set_up "$state" "$own_env" ${T3_LINK_ENVS[@]+"${T3_LINK_ENVS[@]}"}
    else
      echo "WARNING: [$title] could not start window $window_id's new threads in $workdir," >&2
      echo "         or link every other devserver's T3 Code server (see above)" >&2
      ((failures++)) || true
    fi
  fi
  SNAPSHOT=$(snapshot_windows)
}

# t3_row_waits_on_tunnel WS -- whether workspace WS's T3 Code window is missing,
# or missing a link, only because a devserver it uses (its own, or one it links)
# did not answer this run: what a tunnel coming up finishes.
t3_row_waits_on_tunnel() {
  local row host
  row=$(t3_workspace_window "$1") || return 1
  IFS=$'\t' read -r _ _ host _ <<< "$row"
  for host in "$host" $(t3_links "$1" | cut -f1); do
    [[ "$host" != "$T3_LOCAL_HOST" && " $t3_unreachable_hosts " == *" $host "* ]] && return 0
  done
  return 1
}

# stray_window_ids WS -> ids of the windows on WS that are no row's: not a
# terminal, Chrome, Omnigent, T3 Code's browser or an Orchest sidebar.
stray_window_ids() {
  aerospace list-windows --workspace "$1" --json 2>/dev/null \
    | jq -r --arg chrome "$CHROME_APP" --arg omnigent "$OMNIGENT_APP" --arg t3 "$T3_BROWSER_APP" \
      '[.[] | select(
        ."app-name" != "Ghostty" and
        ."app-name" != "cmux" and
        ."app-name" != $chrome and
        ."app-name" != $omnigent and
        ."app-name" != $t3 and
        (.["window-title"] | test("Orchest \\[") | not)
      )] | .[]["window-id"]'
}

close_invalid_chrome_windows_on_workspace() {
  local ws="$1"
  local invalid_ids wid
  invalid_ids=$(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
    | jq -r --arg app "$CHROME_APP" --arg invalid "$CHROME_INVALID_TITLE_PATTERN" \
      '.[] | select(
        ."app-name" == $app and
        ((.["window-title"] // "") | test($invalid))
      ) | .["window-id"]') || true

  for wid in $invalid_ids; do
    [[ -z "$wid" ]] && continue
    echo "Closing invalid Chrome window $wid from workspace $ws..."
    aerospace focus --window-id "$wid" 2>/dev/null || true
    if [[ "$(get_focused_window_id)" == "$wid" ]]; then
      aerospace close 2>/dev/null || true
    else
      echo "WARNING: could not focus invalid Chrome window $wid; moving it to $SWEEP_WORKSPACE" >&2
      aerospace move-node-to-workspace --window-id "$wid" "$SWEEP_WORKSPACE" 2>/dev/null || true
    fi
  done
}

# find_chrome_by_title RE [SNAPSHOT] -> window id (or empty)
#
# Prefers a match already on workspace 11 so a re-run keeps the window it
# reserved last time, then falls back to anywhere. Ties break by window id: the
# title alone is ambiguous (any Chrome window showing a calendar matches
# '^Calendar\b') and AeroSpace's ordering of equal titles is not stable.
find_chrome_by_title() {
  local re="$1" snapshot="${2:-}"
  [[ -n "$snapshot" ]] || snapshot=$(snapshot_windows)
  jq -r --arg app "$CHROME_APP" --arg re "$re" \
        --arg invalid "$CHROME_INVALID_TITLE_PATTERN" --arg ws "$WS11_WORKSPACE" '
    [ .[] | select(
        ."app-name" == $app and
        ((.["window-title"] // "") | test($re)) and
        ((.["window-title"] // "") | test($invalid) | not)
    ) ]
    | sort_by(.["window-id"])
    | ((map(select(.workspace == $ws)) | first) // first)
    | .["window-id"] // empty
  ' <<< "$snapshot"
}

# Reserve (claim + relocate) the two workspace-11 dashboard Chrome windows
# before the generic Chrome distribution runs. Reuses a matching restored
# window if present; otherwise opens the URL. Claiming keeps them out of the
# ws 1-8 pool and the surplus->Z sweep. arrange-ws11 does the actual layout.
reserve_ws11_chrome() {
  if [[ "$chrome_restore_settled" != true ]] && \
     osascript -e 'application "Google Chrome" is running' 2>/dev/null | grep -q 'true'; then
    echo "[ws11] waiting for Chrome session restore to settle..."
    wait_for_window_settle "$CHROME_APP" 2 20 || true
    chrome_restore_settled=true
    SNAPSHOT=$(snapshot_windows)
  fi

  local spec slot title_re url wid tries
  for spec in "CAL|${WS11_CAL_TITLE_RE}|${WS11_CAL_URL}" \
              "SLACK|${WS11_SLACK_TITLE_RE}|${WS11_SLACK_URL}"; do
    IFS='|' read -r slot title_re url <<< "$spec"
    wid=$(find_chrome_by_title "$title_re" "$SNAPSHOT")
    if [[ -z "$wid" ]] || chrome_id_is_claimed "$wid"; then
      echo "[ws11] opening dashboard Chrome window: $url"
      open -na "$CHROME_APP" --args --profile-directory=Default --new-window "$url" 2>/dev/null || true
      wid=""
      for tries in $(seq 1 30); do
        sleep 0.5
        wid=$(find_chrome_by_title "$title_re")
        [[ -n "$wid" ]] && ! chrome_id_is_claimed "$wid" && break
        wid=""
      done
    fi
    if [[ -n "$wid" ]]; then
      claim_chrome_window "$wid"
      aerospace move-node-to-workspace --window-id "$wid" "$WS11_WORKSPACE" 2>/dev/null || true
      # Remember the exact id. arrange-ws11 is a separate process and cannot see
      # claimed_chrome_ids; without the id it re-derives the window from the
      # title and can land on a different one, leaving both on workspace 11.
      case "$slot" in
        CAL)   WS11_CAL_WINDOW_ID="$wid" ;;
        SLACK) WS11_SLACK_WINDOW_ID="$wid" ;;
      esac
      echo "[ws11] reserved Chrome window $wid ($title_re) for workspace $WS11_WORKSPACE"
    else
      echo "WARNING: [ws11] could not reserve Chrome window for $title_re" >&2
    fi
    SNAPSHOT=$(snapshot_windows)
  done
}

# Poll until every WORKSPACES entry has at least one matching window
# present anywhere. wait_for_new_window in the main loop has a 10s
# timeout, but app windows can take longer to appear and titles may still
# be loading after the window exists. arrange-workspaces is
# destructive (flatten + rebuild) and produces unrecoverable layouts
# when the expected window set is incomplete — e.g. a workspace with
# only Orchest + one app window present hits the single-accordion-window
# scaffold branch, then a late Ghostty/Chrome arrival triggers
# a layout rebuild and the resulting `move` calls can create unwanted nesting.
# Returns 0 if all entries are satisfied within the timeout, 1 otherwise.
wait_for_expected_windows() {
  local timeout="${1:-30}"
  local deadline=$(($(date +%s) + timeout))

  while [[ $(date +%s) -lt $deadline ]]; do
    local snapshot all_present=true
    snapshot=$(snapshot_windows)

    for entry in "${WORKSPACES[@]}"; do
      IFS='|' read -r _ws type _title rest <<< "$entry"
      local app_name title_match
      case "$type" in
        ghostty) IFS='|' read -r title_match _ <<< "$rest"; app_name="Ghostty" ;;
        cmux)    title_match="."; app_name="cmux" ;;
        *)       continue ;;
      esac

      local found
      found=$(echo "$snapshot" | jq -r \
        --arg app "$app_name" --arg pat "$title_match" \
        '[.[] | select(."app-name" == $app and (.["window-title"] | test($pat; "i")))] | length')
      if [[ "$found" -lt 1 ]]; then
        all_present=false
        break
      fi
    done

    $all_present && return 0
    sleep 0.5
  done
  return 1
}

reconcile_expected_managed_windows_once() {
  local snapshot entry ws type title rest app_name title_match window_id already
  RECONCILE_MISSING=0
  RECONCILE_MOVED=0
  matched_ids=()
  snapshot=$(snapshot_windows)

  for entry in "${WORKSPACES[@]}"; do
    IFS='|' read -r ws type title rest <<< "$entry"
    case "$type" in
      ghostty)
        IFS='|' read -r title_match _ <<< "$rest"
        app_name="Ghostty"
        ;;
      cmux)
        title_match="."
        app_name="cmux"
        ;;
      *) continue ;;
    esac

    window_id=$(find_window_id_for_workspace "$app_name" "$title_match" "$ws" "$snapshot")
    if [[ -z "$window_id" ]]; then
      RECONCILE_MISSING=$(( RECONCILE_MISSING + 1 ))
      continue
    fi
    matched_ids+=("$window_id")

    already=$(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
      | jq -r --argjson wid "$window_id" \
        '[.[] | select(.["window-id"] == $wid)] | first | .["window-id"] // empty') || true
    if [[ -z "$already" ]]; then
      echo "[$title] relocating to workspace $ws..."
      if aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null; then
        RECONCILE_MOVED=$(( RECONCILE_MOVED + 1 ))
      else
        echo "WARNING: [$title] relocate failed" >&2
      fi
    fi
  done
}

reconcile_expected_managed_windows() {
  local timeout="${1:-20}"
  local deadline=$(($(date +%s) + timeout))

  while true; do
    reconcile_expected_managed_windows_once
    if [[ "$RECONCILE_MISSING" -eq 0 && "$RECONCILE_MOVED" -eq 0 ]]; then
      return 0
    fi

    if [[ $(date +%s) -ge $deadline ]]; then
      return 1
    fi
    sleep 0.5
  done
}

# reconcile_row WS TYPE TITLE REST -- find or open one WORKSPACES row's window
# and move it to WS. A row whose window needs a tunnel that is not through Duo
# yet is left for --deferred (defer_row). Problems count in $failures.
reconcile_row() {
  local ws="$1" type="$2" title="$3" rest="$4"

  case "$type" in
    ghostty)
      IFS='|' read -r title_match workdir cmd <<< "$rest"
      app_name="Ghostty"

      window_id=$(find_window_id_for_workspace "$app_name" "$title_match" "$ws" "$SNAPSHOT")
      if [[ -n "$window_id" ]] && close_stale_tunnel_window_if_needed "$window_id" "$title" "$cmd"; then
        SNAPSHOT=$(snapshot_windows)
        window_id=""
      fi

      if [[ -n "$window_id" ]]; then
        echo "[$title] moving existing window to workspace $ws..."
        aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || {
          echo "WARNING: [$title] move failed" >&2
          ((failures++)) || true
        }
      else
        echo "[$title] creating on workspace $ws..."
        before_snapshot="$SNAPSHOT"
        create_ghostty_window "$title" "$workdir" "$cmd" || {
          echo "WARNING: [$title] creation failed, skipping" >&2
          ((failures++)) || true
          return 0
        }
        window_id=$(wait_for_new_window "$app_name" "$before_snapshot") || {
          # Fallback: try the focused window
          window_id=$(get_focused_window_id)
        }
        if [[ -n "$window_id" ]]; then
          aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || true
        else
          echo "WARNING: [$title] could not find new window ID" >&2
          ((failures++)) || true
        fi
        # Update snapshot for subsequent iterations
        SNAPSHOT=$(snapshot_windows)
      fi
      ;;
    cmux)
      IFS='|' read -r title_match _ <<< "$rest"
      app_name="cmux"

      window_id=$(find_window_id_for_workspace "$app_name" "$title_match" "$ws" "$SNAPSHOT")
      if [[ -n "$window_id" ]]; then
        echo "[$title] moving existing window to workspace $ws..."
        aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || {
          echo "WARNING: [$title] move failed" >&2
          ((failures++)) || true
        }
      else
        echo "[$title] creating on workspace $ws..."
        before_snapshot="$SNAPSHOT"
        create_cmux_window || {
          echo "WARNING: [$title] creation failed, skipping" >&2
          ((failures++)) || true
          return 0
        }
        window_id=$(wait_for_new_window "$app_name" "$before_snapshot") || {
          window_id=$(get_focused_window_id)
        }
        if [[ -n "$window_id" ]]; then
          aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || true
        else
          echo "WARNING: [$title] could not find new window ID" >&2
          ((failures++)) || true
        fi
        SNAPSHOT=$(snapshot_windows)
      fi
      ;;
    chrome)
      app_name="$CHROME_APP"

      if [[ "$chrome_restore_settled" != true ]] && \
         osascript -e 'application "Google Chrome" is running' 2>/dev/null | grep -q 'true'; then
        echo "[Chrome] waiting for session restore to settle..."
        wait_for_window_settle "$CHROME_APP" 2 20 || true
        chrome_restore_settled=true
        SNAPSHOT=$(snapshot_windows)
      fi

      # Profile-picker windows are Chrome windows, but they do not satisfy the
      # workspace contract. Close them so we create/reuse a real profile window.
      close_invalid_chrome_windows_on_workspace "$ws"

      # Prefer a usable window already on this workspace. If Chrome restored
      # all of its previous windows onto the active workspace, reuse the next
      # unclaimed restored window instead of opening another one.
      existing=$(find_valid_unclaimed_chrome_window_on_workspace "$ws") || true
      if [[ -z "$existing" ]]; then
        existing=$(find_valid_unclaimed_chrome_window) || true
      fi
      if [[ -n "$existing" ]]; then
        echo "[$title] assigning restored Chrome window $existing to workspace $ws..."
        aerospace move-node-to-workspace --window-id "$existing" "$ws" 2>/dev/null || true
        claim_chrome_window "$existing"
      else
        echo "[$title] creating on workspace $ws..."
        before_snapshot="$SNAPSHOT"
        open -na "$CHROME_APP" --args --profile-directory=Default --new-window 2>/dev/null || {
          echo "WARNING: [$title] creation failed, skipping" >&2
          ((failures++)) || true
          return 0
        }
        window_id=$(wait_for_new_window "$app_name" "$before_snapshot" "$T3_TITLE_PATTERN") || {
          window_id=$(get_focused_window_id)
        }
        if [[ -n "$window_id" ]]; then
          aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || true
          claim_chrome_window "$window_id"
          # The first Chrome launch may restore many windows asynchronously.
          # Let that burst finish so later workspace entries can reuse them.
          wait_for_window_settle "$CHROME_APP" 2 20 || true
          chrome_restore_settled=true
        else
          echo "WARNING: [$title] could not find new Chrome window" >&2
          ((failures++)) || true
        fi
        SNAPSHOT=$(snapshot_windows)
      fi
      ;;
    omnigent)
      app_name="$OMNIGENT_APP"

      if ! ensure_omnigent_running; then
        echo "WARNING: [$title] Omnigent app did not start, skipping" >&2
        ((failures++)) || true
        return 0
      fi

      # Omnigent windows are no longer interchangeable: each is pinned to the
      # origin that carries its host/checkout memory, and nothing exposes a
      # window's origin to AeroSpace (the title is the conversation name; the
      # host-prefixed title in main.js applies to OAuth popups only). So adopting
      # an arbitrary unclaimed window would pin the wrong location here. Fire
      # this workspace's deep link instead and let the app raise the right one.
      # In a --deferred run, the windows on WS that held its slot (unclaimed:
      # see the deferred run) give way to the row's own window once it lands.
      placeholders=""
      [[ "$DEFERRED" != true ]] || placeholders=$(omnigent_window_ids "$ws")
      deep_link_row=""
      if [[ "$omnigent_hub_down" != true ]]; then
        deep_link_row=$(omnigent_deep_link "$ws") || deep_link_row=""
      fi
      # The link comes from the hub, which answers only once its tunnel is
      # through Duo. An unscoped window opened meanwhile would sit on the wrong
      # origin, so the row waits for the tunnel instead.
      if [[ -z "$deep_link_row" ]] && ! omnigent_hub_answers; then
        echo "[$title] deferred until the hub answers (its tunnel, through Duo)"
        defer_row "$ws|omnigent"
        omnigent_hold_slot "$ws"
        return 0
      fi
      deep_link="${deep_link_row%%$'\t'*}"
      deep_link_title="${deep_link_row#*$'\t'}"
      if [[ -n "$deep_link_row" ]]; then
        echo "[$title] pinning workspace $ws to ${deep_link#omnigent://}"
        # Restore the full trust set first, or an origin evicted from the app's
        # 5-slot recents list prompts for consent again. See the function.
        omnigent_seed_known_origins
        open "$deep_link" >/dev/null 2>&1 || true
        if window_id=$(wait_for_omnigent_deep_link_window "$deep_link_title"); then
          aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || true
          claim_omnigent_window "$window_id"
          for wid in $placeholders; do
            [[ "$wid" != "$window_id" ]] || continue
            echo "[$title] moving window $wid, which held the slot, to $SWEEP_WORKSPACE"
            aerospace move-node-to-workspace --window-id "$wid" "$SWEEP_WORKSPACE" 2>/dev/null || true
          done
        else
          echo "WARNING: [$title] deep link landed no window; the first link to an" >&2
          echo "         origin needs its consent dialog accepted once" >&2
          ((failures++)) || true
          omnigent_hold_slot "$ws"
        fi
        SNAPSHOT=$(snapshot_windows)
      else
        # Degraded: no workspace table, or no session on that host and checkout
        # yet. An unscoped window is better than no window at login.
        echo "WARNING: [$title] could not resolve an origin for workspace $ws;" >&2
        echo "         falling back to an unscoped window" >&2
        existing=$(find_unclaimed_omnigent_window "$ws") || true
        # A --deferred run leaves windows elsewhere alone: they may be in use.
        if [[ -z "$existing" && "$DEFERRED" != true ]]; then
          existing=$(find_unclaimed_omnigent_window) || true
        fi
        if [[ -n "$existing" ]]; then
          echo "[$title] assigning existing Omnigent window $existing to workspace $ws..."
          aerospace move-node-to-workspace --window-id "$existing" "$ws" 2>/dev/null || true
          claim_omnigent_window "$existing"
        else
          echo "[$title] creating on workspace $ws..."
          before_snapshot="$SNAPSHOT"
          create_omnigent_window || {
            echo "WARNING: [$title] creation failed, skipping" >&2
            ((failures++)) || true
            return 0
          }
          # No focused-window fallback here: a menu-click window is claimed by
          # ID, so misidentifying one pins the wrong window to this workspace
          # for the rest of the run. The deep-link path above can trust focus
          # because the app raises the window the link targeted.
          if window_id=$(wait_for_new_window "$app_name" "$before_snapshot" \
              "$OMNIGENT_INVALID_TITLE_PATTERN"); then
            aerospace move-node-to-workspace --window-id "$window_id" "$ws" 2>/dev/null || true
            claim_omnigent_window "$window_id"
          else
            echo "WARNING: [$title] could not find new Omnigent window" >&2
            ((failures++)) || true
          fi
          SNAPSHOT=$(snapshot_windows)
        fi
      fi
      ;;
    t3)
      reconcile_t3_window "$ws" "$title"
      ! t3_row_waits_on_tunnel "$ws" || defer_row "$ws|t3"
      ;;
  esac
}

# ── Main ─────────────────────────────────────────────────────────────

if [[ -z "$AEROSPACE_BIN" ]]; then
  echo "ERROR: aerospace CLI not found." >&2
  echo "Install AeroSpace: brew install --cask nikitabobko/tap/aerospace" >&2
  exit 1
fi

if ! aerospace list-windows --all &>/dev/null; then
  echo "ERROR: AeroSpace is not running." >&2
  echo "Start AeroSpace.app first." >&2
  exit 1
fi

# ── Deferred rows (--deferred) ───────────────────────────────────────
# Only the rows the last run left for a tunnel. Nothing is swept, so windows
# opened since login stay where they are, and only the workspaces those rows
# are on are arranged again (without --force, so one whose windows did not
# change keeps its sizes).
if [[ "$DEFERRED" == true ]]; then
  # The list starts over: a row this run cannot finish is deferred again, and
  # one no longer in WORKSPACES drops out.
  deferred_rows=$(read_pending_file)
  pending_rows=""
  pending_ready=true
  if [[ -z "$deferred_rows" ]]; then
    echo "No deferred windows."
    exit 0
  fi
  echo "Deferred windows: $(printf '%s\n' "$deferred_rows" | paste -sd ' ' -)"
  # This run starts as a tunnel connects, a moment before its forwards serve
  # and its pairing tokens are pooled: give the servers that long.
  T3_SERVER_WAIT="${T3_DEFERRED_SERVER_WAIT:-30}"
  OMNIGENT_HUB_WAIT="${OMNIGENT_DEFERRED_HUB_WAIT:-30}"
  SNAPSHOT=$(snapshot_windows)
  failures=0
  # Every Omnigent window on a managed workspace is that workspace's, claimed
  # so nothing here takes it -- except on a workspace whose Omnigent row is
  # deferred, where it only held the slot for the row's own window.
  for ws in $(managed_workspaces); do
    [[ $'\n'"$deferred_rows"$'\n' != *$'\n'"$ws|omnigent"$'\n'* ]] || continue
    for wid in $(omnigent_window_ids "$ws"); do
      claim_omnigent_window "$wid"
    done
  done
  deferred_workspaces=""
  deferred_t3=false
  for entry in "${WORKSPACES[@]}"; do
    IFS='|' read -r ws type title rest <<< "$entry"
    [[ $'\n'"$deferred_rows"$'\n' == *$'\n'"$ws|$type"$'\n'* ]] || continue
    reconcile_row "$ws" "$type" "$title" "$rest"
    [[ " $deferred_workspaces " == *" $ws "* ]] || deferred_workspaces+=" $ws"
    [[ "$type" != t3 ]] || deferred_t3=true
  done
  if [[ "$deferred_t3" == true ]]; then
    t3-client-settings || {
      echo "WARNING: T3 Code's client settings were not synced (above); rerun ~/bin/t3-client-settings" >&2
      ((failures++)) || true
    }
  fi
  # With no arguments arrange-workspaces would take every workspace.
  if [[ -n "$deferred_workspaces" ]]; then
    # shellcheck disable=SC2086  # one argument per workspace
    ARRANGE_ATTEMPTS=8 ARRANGE_RETRY_SLEEP=1 arrange-workspaces $deferred_workspaces || {
      echo "WARNING: arrange-workspaces did not converge" >&2
      ((failures++)) || true
    }
  fi
  sketchybar --trigger aerospace_reconcile 2>/dev/null || true
  if [[ -n "$pending_rows" ]]; then
    echo "Still waiting on a tunnel: $(printf '%s\n' "$pending_rows" | paste -sd ' ' -)"
  fi
  if [[ "$failures" -gt 0 ]]; then
    echo "Done with ${failures} warning(s)."
  else
    echo "Done."
  fi
  exit 0
fi

# Ensure Ghostty is running (but don't close its default window).
# Ghostty creates a default window on launch. We leave it open so the
# SNAPSHOT captures it — this prevents wait_for_new_window from
# misidentifying it as a newly created window. The reconciliation pass
# at the end sweeps it to workspace Z.
if ! osascript -e 'application "Ghostty" is running' 2>/dev/null | grep -q 'true'; then
  open -a Ghostty
  sleep 2
fi

# Before anything opens Chrome, so the launch reaches your own.
retire_t3_profile_chromes

# Snapshot all windows
SNAPSHOT=$(snapshot_windows)

failures=0

# The local Omnigent proxy exposes the hub on Mac loopback. The CCO and FTW
# nvs-tunnels supply its candidate-specific upstream forwards. Retire any
# unsupervised copy first, so the probe below reports on the launchd-owned one
# rather than on whichever copy happened to win the port.
retire_unsupervised_mac_proxy
close_retired_omnigent_tunnel_windows
# Bounded: while a tunnel waits on Duo the proxy accepts and then holds the
# connection, which hung a run before it printed anything.
if ! omnigent_hub_answers; then
  echo "Omnigent proxy is not healthy at http://127.0.0.1:${OMNIGENT_PORT} (check: launchctl print gui/\$UID/com.mkarrmann.omnigent-tunnel, and ~/.local/state/omnigent-tunnel/stderr.log); the nvs-tunnels windows below supply its upstream forwards, and the Omnigent windows wait for them" >&2
fi

# The desktop app connects through the TLS front door, not OMNIGENT_PORT, so it
# needs its own probe: the plain-HTTP check above passes even when this is down.
# Deliberately not `-k` — an untrusted CA fails the app exactly like an outage,
# so the probe has to exercise the same trust path Chromium will.
if ! curl -sf -m 5 "https://localhost:${OMNIGENT_TLS_PORT}/health" >/dev/null 2>&1; then
  echo "Omnigent TLS front door is not healthy at https://localhost:${OMNIGENT_TLS_PORT}; the app will fail to connect (check: launchctl print gui/\$UID/com.mkarrmann.omnigent-tls, and 'caddy trust' for the local CA)" >&2
fi

# The app updates itself every six hours, so this should never fire. That is
# the point: the last time it went stale nothing said so for two months. Only
# exit 1 means "definitely behind" -- an unreachable feed exits 2 and stays
# quiet, so an offline login does not cry wolf.
omnigent_app_check_rc=0
OMNIGENT_APP_CURL_TIMEOUT=5 omnigent-app-ensure --check >/dev/null 2>&1 || omnigent_app_check_rc=$?
if [[ "$omnigent_app_check_rc" == 1 ]]; then
  echo "Omnigent desktop app is out of date and its own updater has not taken it; run 'omnigent-app-ensure --install'" >&2
fi

# Reserve the ws-11 dashboard Chrome windows before generic Chrome distribution.
reserve_ws11_chrome

pending_rows=""
pending_ready=true
for entry in "${WORKSPACES[@]}"; do
  IFS='|' read -r ws type title rest <<< "$entry"
  reconcile_row "$ws" "$type" "$title" "$rest"
done

# Once the T3 Code windows are up, sync their client settings (appearance and
# the like) with ~/dotfiles/t3code/client-settings.json: a setting changed in
# any window reaches the file and every other window.
if [[ "$STARTUP_T3_WINDOWS" == 1 ]]; then
  t3-client-settings || {
    echo "WARNING: T3 Code's client settings were not synced (above); rerun ~/bin/t3-client-settings" >&2
    ((failures++)) || true
  }
fi

# Chrome session restore can continue after an individual wait_for_new_window
# returns. Fill any still-missing Chrome slots from the restored pool, then put
# surplus restored windows on the overflow workspace rather than leaving them
# piled onto a managed workspace.
for entry in "${WORKSPACES[@]}"; do
  IFS='|' read -r ws type _title _rest <<< "$entry"
  [[ "$type" == "chrome" ]] || continue
  workspace_has_claimed_chrome_window "$ws" && continue

  existing=$(find_valid_unclaimed_chrome_window_on_workspace "$ws") || true
  if [[ -z "$existing" ]]; then
    existing=$(find_valid_unclaimed_chrome_window) || true
    if [[ -n "$existing" ]]; then
      echo "[Chrome reconciliation] assigning window $existing to workspace $ws..."
      aerospace move-node-to-workspace --window-id "$existing" "$ws" 2>/dev/null || true
    fi
  fi
  [[ -z "$existing" ]] || claim_chrome_window "$existing"
done

extra_chrome_ids=$(aerospace list-windows --all --json 2>/dev/null \
  | jq -r --arg app "$CHROME_APP" --arg invalid "$CHROME_INVALID_TITLE_PATTERN" --arg t3title "$T3_ANY_TITLE_PATTERN" --argjson t3ids "$(t3_window_ids_json)" \
    '.[] | select(
      ."app-name" == $app and
      ((.["window-title"] // "") | test($invalid) | not) and
      ((.["window-title"] // "") | test($t3title) | not) and
      (.["window-id"] | IN($t3ids[]) | not)
    ) | .["window-id"]' | sort -n) || true
for wid in $extra_chrome_ids; do
  chrome_id_is_claimed "$wid" && continue
  echo "Sweeping surplus restored Chrome window $wid to $SWEEP_WORKSPACE..."
  aerospace move-node-to-workspace --window-id "$wid" "$SWEEP_WORKSPACE" 2>/dev/null || true
done

# Same two-step for Omnigent: fill slots whose window arrived after its
# wait_for_new_window timed out, then sweep the surplus off managed workspaces.
for entry in "${WORKSPACES[@]}"; do
  IFS='|' read -r ws type _title _rest <<< "$entry"
  [[ "$type" == "omnigent" ]] || continue
  row_pending "$ws|omnigent" && continue
  workspace_has_claimed_omnigent_window "$ws" && continue

  existing=$(find_unclaimed_omnigent_window "$ws") || true
  if [[ -z "$existing" ]]; then
    existing=$(find_unclaimed_omnigent_window) || true
    if [[ -n "$existing" ]]; then
      echo "[Omnigent reconciliation] assigning window $existing to workspace $ws..."
      aerospace move-node-to-workspace --window-id "$existing" "$ws" 2>/dev/null || true
    fi
  fi
  [[ -z "$existing" ]] || claim_omnigent_window "$existing"
done

for wid in $(omnigent_window_ids); do
  omnigent_id_is_claimed "$wid" && continue
  echo "Sweeping surplus Omnigent window $wid to $SWEEP_WORKSPACE..."
  aerospace move-node-to-workspace --window-id "$wid" "$SWEEP_WORKSPACE" 2>/dev/null || true
done

# ── Orchest ──────────────────────────────────────────────────────────

orchest-open-workspaces ${ORCHEST_MODE_FLAG:+$ORCHEST_MODE_FLAG} || {
  echo "WARNING: orchest-open-workspaces failed" >&2
  ((failures++)) || true
}

# ── Wait for late-appearing windows ──────────────────────────────────

echo "Waiting up to 30s for any late-appearing windows..."
if wait_for_expected_windows 30; then
  echo "All expected windows present."
else
  echo "WARNING: some expected windows did not appear within 30s; layout may be incomplete" >&2
  ((failures++)) || true
fi

# ── Reconciliation pass ───────────────────────────────────────────────
# Relocate windows that appeared after their wait_for_new_window timed
# out, and sweep unmatched Ghostty windows from managed
# workspaces (e.g. the default Ghostty window created on launch).

swept=0
if ! reconcile_expected_managed_windows 20; then
  echo "WARNING: some expected managed windows were still missing or moving after reconciliation" >&2
  ((failures++)) || true
fi

# Sweep unmatched Ghostty windows from managed workspaces
matched_pattern=$(printf '%s\n' "${matched_ids[@]}" | jq -R -s 'split("\n") | map(select(. != "") | tonumber)')
for ws in $(managed_workspaces); do
  stray_ids=$(aerospace list-windows --workspace "$ws" --json 2>/dev/null \
    | jq -r --argjson matched "$matched_pattern" \
      '[.[] | select(
        ."app-name" == "Ghostty" and
        (.["window-id"] | IN($matched[]) | not)
      )] | .[]["window-id"]') || true
  for wid in $stray_ids; do
    [[ -z "$wid" ]] && continue
    echo "Sweeping unmatched window $wid from workspace $ws to $SWEEP_WORKSPACE..."
    if aerospace move-node-to-workspace --window-id "$wid" "$SWEEP_WORKSPACE" 2>/dev/null; then
      ((swept++)) || true
    fi
  done
done

# ─────────────────────────────────────────────────────────────────────

# Close invalid Chrome windows from managed workspaces. They can be restored by
# Chrome after the per-workspace checks above, and otherwise look like valid app
# windows to the generic stray sweep.
for ws in $(managed_workspaces); do
  close_invalid_chrome_windows_on_workspace "$ws"
done
close_invalid_chrome_windows_on_workspace "$SWEEP_WORKSPACE"

# Sweep stray windows: move unrecognized windows off managed workspaces to Z
for ws in $(managed_workspaces); do
  stray_ids=$(stray_window_ids "$ws") || true
  for wid in $stray_ids; do
    [[ -z "$wid" ]] && continue
    if aerospace move-node-to-workspace --window-id "$wid" "$SWEEP_WORKSPACE" 2>/dev/null; then
      ((swept++)) || true
    fi
  done
done

if [[ "$swept" -gt 0 ]]; then
  echo "Swept ${swept} stray window(s) to workspace ${SWEEP_WORKSPACE}."
fi

# Arrange layouts (tiles | accordion) on managed workspaces
# managed_workspaces intentionally expands to separate workspace arguments.
# shellcheck disable=SC2046
ARRANGE_ATTEMPTS=8 ARRANGE_RETRY_SLEEP=1 arrange-workspaces --force $(managed_workspaces) || {
  echo "WARNING: arrange-workspaces did not converge" >&2
  ((failures++)) || true
}

# A successful layout must still contain every Orchest sidebar. If an
# AeroSpace mutation raced the layout pass, repair the placements, rebuild the
# affected trees, and verify again. This also heals stale desktopWorkspaceId
# values learned while an Orchest window was temporarily on Z.
if ! orchest-open-workspaces --verify-only; then
  echo "[Orchest] final placement verification failed; repairing and rebuilding layouts..."
  if orchest-open-workspaces --reconcile-only; then
    # managed_workspaces intentionally expands to separate arguments.
    # shellcheck disable=SC2046
    ARRANGE_ATTEMPTS=8 ARRANGE_RETRY_SLEEP=1 arrange-workspaces --force $(managed_workspaces) || {
      echo "WARNING: arrange-workspaces did not converge after Orchest repair" >&2
      ((failures++)) || true
    }
  else
    echo "WARNING: final Orchest placement repair failed" >&2
    ((failures++)) || true
  fi

  if ! orchest-open-workspaces --verify-only; then
    echo "WARNING: final Orchest placement verification still failed" >&2
    ((failures++)) || true
  fi
fi

# If auto-accordion is re-enabled, it should do a full rebuild for any window
# that appears after this point, so no drain sleep is needed here.

# Provision and arrange the workspace-11 dashboard after the standard workspace
# and Orchest placement passes have converged. The reserved ids travel with the
# call: arrange-ws11 would otherwise re-resolve '^Calendar\b' / ' - Slack - ' from
# scratch, and any other Chrome window showing a calendar matches just as well.
WS11_CAL_WINDOW_ID="$WS11_CAL_WINDOW_ID" \
WS11_SLACK_WINDOW_ID="$WS11_SLACK_WINDOW_ID" \
  arrange-workspaces --ensure-windows 11 || {
  echo "WARNING: workspace 11 arrangement did not converge" >&2
  ((failures++)) || true
}

# Focus workspace 1
aerospace workspace 1 2>/dev/null || true

# Trigger SketchBar reconciliation so items are created for any workspaces
# that appeared after SketchBar's initial sync (T, Z, Orchest workspaces, etc.)
sketchybar --trigger aerospace_reconcile 2>/dev/null || true

if [[ -n "$pending_rows" ]]; then
  echo ""
  echo "Waiting on a tunnel: $(printf '%s\n' "$pending_rows" | paste -sd ' ' -)"
  echo "  Each tunnel on workspace T opens these once it is through Duo"
  echo "  (startup-windows --deferred, logged to ~/.local/state/startup-windows-logs/deferred.log)."
fi
if [[ " $t3_unreachable_hosts " == *" $T3_LOCAL_HOST "* ]]; then
  echo ""
  echo "The Mac's T3 Code server did not answer: is com.mkarrmann.t3-local loaded?"
  echo "  Rerun ~/bin/startup-windows once it is."
fi

if [[ "$failures" -gt 0 ]]; then
  echo "Done with ${failures} warning(s)."
else
  echo "Done."
fi
