#!/usr/bin/env bash
# t3-pair-workspaces [WS...] — sign each devserver workspace's T3 Code window in.
#
# Each workspace's T3 Code window (bin-macos/startup-windows) is a Chrome profile
# of its own, talking to its checkout's T3 Code server (systemd/t3@.service), so
# each needs one pairing. This mints a one-time token on every devserver with
# `t3 pair` (one ssh login per host), then reopens each workspace's window on the
# server's /pair URL, which keeps that profile signed in afterwards.
#
# Needs bin/t3-ensure to have started the servers and nvs-tunnels to forward
# them. Pairs every devserver workspace by default; pass workspace numbers to
# pair only those. Run startup-windows afterwards to place the windows.
set -euo pipefail

T3_CHROME_DATA_ROOT="$HOME/.t3-workspace-chrome"
CHROME_APP="Google Chrome"

# Windows whose Chrome process runs with this --user-data-dir (as in startup-windows).
profile_window_ids() {
  local profile="$1" wid pid
  aerospace list-windows --all --json --format '%{window-id}%{app-pid}%{app-name}' 2>/dev/null \
    | jq -r --arg app "$CHROME_APP" '.[] | select(."app-name" == $app) | "\(.["window-id"]) \(.["app-pid"])"' \
    | while read -r wid pid; do
        ps -o command= -p "$pid" 2>/dev/null | grep -qE -- "--user-data-dir=${profile}( |$)" && echo "$wid"
      done
}

table=$(workspaces --json)
rows=$(jq -r --args '
  .workspaces[]
  | select(.kind == "devserver" and (.t3Url // "") != "")
  | select(($ARGS.positional | length) == 0 or (.workspace | IN($ARGS.positional[])))
  | [.workspace, .host, (.checkout | split("/") | last), .t3Url] | @tsv' "$@" <<< "$table")
[[ -n "$rows" ]] || { echo "t3-pair-workspaces: no matching devserver workspace" >&2; exit 1; }

for host in $(cut -f2 <<< "$rows" | sort -u); do
  checkouts=$(awk -F'\t' -v h="$host" '$2 == h { print $3 }' <<< "$rows" | sort -u | tr '\n' ' ')
  echo "[$host] minting pairing tokens for: $checkouts"
  # Remote side prints "checkoutN TOKEN" per checkout; $HOME expands there.
  # shellcheck disable=SC2016
  tokens=$(ssh "$host" "for c in $checkouts; do"' T3CODE_HOME="$HOME/.t3-workspaces/$c" "$HOME/.local/bin/t3" pair --ttl 30m --label "mac-$c" 2>/dev/null | sed -n "s/^Token: /$c /p"; done') || {
    echo "WARNING: [$host] could not mint tokens (are the t3@ servers running? run bin/t3-ensure there)" >&2
    continue
  }
  while IFS=$'\t' read -r ws row_host checkout url; do
    [[ "$row_host" == "$host" ]] || continue
    token=$(awk -v c="$checkout" '$1 == c { print $2 }' <<< "$tokens")
    if [[ -z "$token" ]]; then
      echo "WARNING: [ws$ws] no token for ~/$checkout on $host" >&2
      continue
    fi
    host_part="${url#http://}"
    profile="$T3_CHROME_DATA_ROOT/${host_part%%.t3.localhost*}"
    mkdir -p "$profile"
    # A window already open on this profile is unpaired; replace it so only the
    # signed-in one is left for startup-windows to adopt.
    for wid in $(profile_window_ids "$profile"); do
      aerospace close --window-id "$wid" 2>/dev/null || true
    done
    echo "[ws$ws] pairing ${url}"
    open -na "$CHROME_APP" --args --user-data-dir="$profile" \
      --no-first-run --no-default-browser-check --app="${url}pair#token=${token}"
  done <<< "$rows"
done
echo "Done. Run startup-windows to place the windows."
