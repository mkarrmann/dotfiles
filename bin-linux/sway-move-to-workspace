#!/usr/bin/env bash
set -euo pipefail

# Move the focused window to WORKSPACE and re-arrange both workspaces, so the
# window joins the destination's stack instead of landing beside its sidebar.
# Bound to Alt+Shift+<workspace> in sway_config, the way AeroSpace's
# alt-shift-N is followed by `arrange-workspaces --force`.
#
# --next-output moves the focused WORKSPACE to the next output, then
# re-arranges it for that output's width.
#
# The move itself is never held back; the re-arrangement is skipped when a
# reconciler holds the layout lock, since its own final pass covers it. Focus
# stays where it was: the arranger addresses everything by container id.

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=./sway-windows-lib.sh
source "$SCRIPT_DIR/sway-windows-lib.sh"

usage() { echo "Usage: sway-move-to-workspace WORKSPACE | --next-output"; }
if [[ $# == 1 && ( "$1" == --help || "$1" == -h ) ]]; then usage; exit 0; fi
if [[ $# != 1 ]] || [[ "$1" != --next-output && ! "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]*$ ]]; then
  usage >&2; exit 2
fi
target="$1"

layout=$("$SCRIPT_DIR/startup-windows" --print-layout)
sweep_ws=$(jq -er '.sweepWorkspace' <<< "$layout")
export DASHBOARD_WS DASHBOARD_LAYOUT DASHBOARD_ORDER DASHBOARD_WIDTHS \
       TERM_APP_ID_PREFIX STACK_LAYOUT SIDEBAR_PERCENT SIDEBAR_MIN_WIDTH
DASHBOARD_WS=$(jq -er '.dashboardWorkspace' <<< "$layout")
DASHBOARD_LAYOUT=$(jq -er '.dashboardLayout' <<< "$layout")
DASHBOARD_ORDER=$(jq -r '[.dashboardPanes[].name] | join(" ")' <<< "$layout")
DASHBOARD_WIDTHS=$(jq -r '[.dashboardPanes[] | select(.percent != null) | "\(.name):\(.percent)"] | join(" ")' <<< "$layout")
TERM_APP_ID_PREFIX=$(jq -er '.terminalAppIdPrefix' <<< "$layout")
STACK_LAYOUT=$(jq -er '.stackLayout' <<< "$layout")
SIDEBAR_PERCENT=$(jq -er '.sidebarPercent' <<< "$layout")
SIDEBAR_MIN_WIDTH=$(jq -er '.sidebarMinWidth' <<< "$layout")

targets=()
if [[ "$target" == --next-output ]]; then
  workspaces=$(sway_ipc -t get_workspaces)
  source_ws=$(jq -er '.[] | select(.focused) | .name' <<< "$workspaces")
  current_output=$(jq -er '.[] | select(.focused) | .output' <<< "$workspaces")
  next_output=$(sway_ipc -t get_outputs | jq -er --arg current "$current_output" '
    [.[] | select(.active) | .name] as $names
    | ($names | index($current)) as $index
    | select($index != null)
    | $names[($index + 1) % ($names | length)]')
  [[ "$next_output" != "$current_output" ]] || exit 0
  sway_cmd "move workspace to output $(sway_quote "$next_output")"
  targets=("$source_ws")
else
  snapshot=$(snapshot_windows)
  focused=$(focused_window_id)
  [[ -n "$focused" ]] || { echo "No focused window to move." >&2; exit 0; }
  source_ws=$(workspace_of "$snapshot" "$focused")
  [[ -n "$source_ws" ]] || { echo "Focused window is outside a workspace." >&2; exit 1; }
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    sway_cmd "[con_id=$focused] move --no-auto-back-and-forth container to workspace number $target"
  else
    sway_cmd "[con_id=$focused] move --no-auto-back-and-forth container to workspace $(sway_quote "$target")"
  fi
  # A numeric target can resolve to a named workspace such as "2: code".
  destination_ws=$(workspace_of "$(snapshot_windows)" "$focused")
  [[ -n "$destination_ws" ]] || { echo "Moved window disappeared." >&2; exit 1; }
  targets=("$source_ws")
  [[ "$destination_ws" == "$source_ws" ]] || targets+=("$destination_ws")
fi

arrange=()
for ws in "${targets[@]}"; do [[ "$ws" == "$sweep_ws" ]] || arrange+=("$ws"); done
[[ ${#arrange[@]} -gt 0 ]] || exit 0
exec 9>"$(sway_windows_lock_file)"
if ! flock -w 2 9; then
  echo "layout is being rebuilt; leaving the arrangement to it"
  exit 0
fi
exec "$SCRIPT_DIR/arrange-workspaces" --dashboard-ws "$DASHBOARD_WS" --sweep-ws "$sweep_ws" "${arrange[@]}"
