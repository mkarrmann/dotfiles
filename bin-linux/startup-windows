#!/usr/bin/env bash
set -euo pipefail

# Reconcile the sway session into the declared workspace layout. Idempotent:
# every run finds-or-creates each declared window, puts it on its workspace,
# claims it, and sweeps anything unclaimed off the managed workspaces.
#
# This is the Linux counterpart of bin-macos/startup-windows. It is a rewrite
# rather than a port: most of the Mac script's bulk works around AeroSpace
# (snapshot-diffing to identify new windows, an AppleScript menu click to make
# a window, timeout/retry around a CLI that can wedge, a flatten-and-rebuild
# layout pass). sway needs almost none of that -- see sway-windows-lib.sh for
# how window identity works here, which is the substantive difference.
#
# What survives from the Mac design, because it is the actual product:
#   - a declarative workspace table as the only thing you edit,
#   - find-or-create + relocate + claim, so a re-run repairs a drifted session
#     instead of duplicating windows,
#   - sweeping unclaimed windows to an overflow workspace.
#
# Each standard workspace ends up as [ Orchest sidebar | stack ] with the
# stack holding the table's windows in order; see arrange-workspaces. A window
# that appears later joins the stack through sway-auto-stack.
#
# There is no late-window polling pass here, unlike the Mac. Claims live in
# the compositor as marks, so a window that arrives after a run is simply
# adopted by the next run ($mod+Shift+r); the script is cheap enough to rerun
# that a polling loop would only add wall time to every login.

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=./sway-windows-lib.sh
source "$SCRIPT_DIR/sway-windows-lib.sh"

# Kept verbatim for the lock wrapper below, which re-runs this script: the
# parse loop shifts $@ away, and a re-exec with an empty $@ silently dropped
# every flag -- including --dry-run, which then ran live.
ORIG_ARGS=("$@")
DRY_RUN=false
SKIP_DASHBOARD=false
PRINT_LAYOUT=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    --no-dashboard) SKIP_DASHBOARD=true; shift ;;
    --print-layout) PRINT_LAYOUT=true; shift ;;
    -h|--help)
      echo "Usage: startup-windows [--dry-run] [--no-dashboard] [--print-layout]"
      echo "  --dry-run       print the plan without creating or moving windows"
      echo "  --no-dashboard  skip the workspace-${DASHBOARD_WS:-9} dashboard"
      echo "  --print-layout  emit the resolved workspace table as JSON and exit"
      exit 0
      ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

# ── Workspace definitions ────────────────────────────────────────────
# Format:
#   term:     ws|term|slot|workdir|command
#   chrome:   ws|chrome
#   omnigent: ws|omnigent
#   t3:       ws|t3
#
# A term's app_id is sway-ws.term.<slot> and is set at launch, so it needs no
# title regex -- the identity IS the match. chrome/omnigent slots are claimed
# by the mark sw:<ws>:<type>.
#
# A t3 row gives the workspace a Chrome --app window on the desktop's one T3
# Code server (t3@T3_SERVER: bin/t3-ensure, systemd/t3@.service), which has
# every t3 row's term workdir as a project. The window is claimed by the mark
# sw:<ws>:t3 (see reconcile_t3), and scoped to that workspace's project when
# it is opened: new threads default to it, and the sidebar shows only it.
#
# Terminal commands are wrapped in a restart loop so quitting the editor
# leaves the window in place rather than closing it. They run nvim directly:
# the Mac table's `nvs` attaches to a headless server on a remote devserver so
# buffers survive the SSH session, which has no counterpart on a local desktop.
WORKSPACES=(
  "1|term|local|~|while true; do nvim --cmd 'set title titlestring=local\\ —\\ %t'; sleep 0.5; done"
  "1|chrome"
  "1|omnigent"
  "1|t3"
  "2|term|dotfiles|~/dotfiles|while true; do nvim --cmd 'set title titlestring=dotfiles\\ —\\ %t'; sleep 0.5; done"
  "2|chrome"
  "2|omnigent"
  "2|t3"
  "3|term|orchest|~/dev/orchest|while true; do nvim --cmd 'set title titlestring=orchest\\ —\\ %t'; sleep 0.5; done"
  "3|chrome"
  "3|omnigent"
  "3|t3"
  "4|term|omnigent-repo|~/repos/omnigent|while true; do nvim --cmd 'set title titlestring=omnigent-repo\\ —\\ %t'; sleep 0.5; done"
  "4|chrome"
  "4|omnigent"
  "4|t3"
  "5|term|presto|~/work/presto|while true; do nvim --cmd 'set title titlestring=presto\\ —\\ %t'; sleep 0.5; done"
  "5|chrome"
  "5|omnigent"
  "5|t3"
  "6|term|gatech|~/gatech|while true; do nvim --cmd 'set title titlestring=gatech\\ —\\ %t'; sleep 0.5; done"
  "6|chrome"
  "6|omnigent"
  "6|t3"
)

SWEEP_WORKSPACE="Z"

# The second-monitor dashboard (the ws-11 equivalent). Pinned to the Samsung by
# `workspace 9 output $top` in ~/.config/sway/config.d/displays -- placement is
# the compositor's job here, unlike arrange-ws11 which had to resolve the
# monitor itself. Panes are laid out left-to-right by arrange-workspaces.
#
# Format: app_id|launch-command[|percent]
# Panes are laid out in this order; a percent fixes that pane's share of the
# dashboard and the rest split what is left. To add a pane, add a row:
#   "google-chrome|google-chrome --new-window https://calendar.google.com"
#   "sway-ws.term.monitor|ghostty --class=sway-ws.term.monitor -e btop|25"
# The Orchest Overview is the Mac dashboard's Orchest cell: its window is
# placed by orchest-open-workspaces, which is what the launch sentinel means.
DASHBOARD_WS=9
DASHBOARD_LAYOUT=splith
DASHBOARD_PANES=(
  "obsidian|__desktop_entry__ obsidian.desktop"
  "${ORCHEST_OVERVIEW_PANE}|${ORCHEST_OVERVIEW_LAUNCH}|30"
)

CHROME_CMD=(google-chrome --profile-directory=Default --new-window)
# The t3 rows share one T3 Code server, t3@T3_SERVER on 127.0.0.1:T3_PORT. A
# server per workspace would scope each window, but it would also split the
# threads, so no window could see another's; T3 Code's sidebar scope does the
# scoping instead. A layout override can reassign either.
T3_SERVER=desktop
T3_PORT=3780
# Each t3 row's window runs in a Chrome profile of its own,
# T3_CHROME_PROFILES_DIR/<slot>, as on the Mac. A fresh profile launched
# without --no-first-run and --no-default-browser-check shows only a terms
# dialog and never loads the page. Each profile also keeps the window's own
# project scope: T3 Code stores it in the page's localStorage, which
# T3_SCOPE_CMD (bin-linux/t3-window-scope) writes when the window opens.
# Pairing tokens come from T3_BIN run against the server's state in
# T3_HOMES_DIR/T3_SERVER (bin/t3-workspace-serve's T3CODE_HOME).
# T3_SERVER_WAIT bounds, in seconds, how long a run waits for the server to
# answer before it opens a window on it.
T3_CHROME_PROFILES_DIR="$HOME/.t3-workspace-chrome"
T3_CHROME_CMD=(google-chrome --no-first-run --no-default-browser-check)
T3_BIN="$HOME/.local/bin/t3"
T3_HOMES_DIR="$HOME/.t3-workspaces"
T3_SERVER_WAIT=30
T3_SCOPE_CMD=("$SCRIPT_DIR/t3-window-scope")
OMNIGENT_DESKTOP_ENTRY="omnigent-desktop-electron.desktop"
# Server > New Window is CmdOrCtrl+Shift+N from desktop 0.13.0 (upstream
# 55717242, 2026-08-31). 0.10.0's menu item had no accelerator at all, so on
# an older install no keystroke can open a window and the extra slots are
# skipped up front instead of each waiting out a timeout. Empty disables the
# check (the e2e suite runs against stubs, not the package).
OMNIGENT_NEW_WINDOW_MIN_VERSION=0.13.0
# The keystroke, per injector; which one runs is decided per window by
# new_window_injector in sway-windows-lib.sh.
OMNIGENT_NEW_WINDOW_XDOTOOL_ARGS=(key --clearmodifiers ctrl+shift+n)
OMNIGENT_NEW_WINDOW_WTYPE_ARGS=(-M ctrl -M shift -k n -m shift -m ctrl)

# Orchest: one sidebar window per managed workspace, opened and claimed by
# orchest-open-workspaces (the Mac's --orchest-prod/--orchest-dev flag is the
# ORCHEST_MODE setting here, so a layout override can choose). The sidebar
# split and the stack layout come from sway-windows-lib.sh; an override can
# reassign them the same way.
ORCHEST_DIR="${ORCHEST_DIR:-$HOME/dev/orchest}"
ORCHEST_ENABLED=$([[ -d "$ORCHEST_DIR" ]] && echo true || echo false)
ORCHEST_MODE=prod
ORCHEST_PORT="${ORCHEST_PORT:-3100}"

# Machine-local layout override, sourced LAST so it can reassign any of the
# settings above (WORKSPACES, DASHBOARD_PANES, DASHBOARD_WS, CHROME_CMD, ...).
# Same pattern as the sway display config: the repo carries the layout every
# desktop gets, and a machine that needs a different one drops a file outside
# the repo instead of editing this table.
LAYOUT_OVERRIDE="${SWAY_WINDOWS_LAYOUT:-${XDG_CONFIG_HOME:-$HOME/.config}/sway-windows/layout.sh}"
if [[ -r "$LAYOUT_OVERRIDE" ]]; then
  # stderr: --print-layout writes JSON to stdout, and a notice mixed into it
  # would leave every consumer parsing a corrupt document.
  echo "Using layout override: $LAYOUT_OVERRIDE" >&2
  # shellcheck source=/dev/null
  source "$LAYOUT_OVERRIDE"
fi
# ─────────────────────────────────────────────────────────────────────
# One "ws<TAB>slot<TAB>workdir<TAB>port" line per t3 row: the term row on the
# same workspace names its window (slot) and its project (workdir), and port is
# the shared server's.
t3_rows() {
  local entry term ws type slot workdir server
  for entry in "${WORKSPACES[@]}"; do
    IFS='|' read -r ws type _ <<< "$entry"
    [[ "$type" == t3 ]] || continue
    server=""
    for term in "${WORKSPACES[@]}"; do
      [[ "$term" == "$ws|term|"* ]] || continue
      [[ -z "$server" ]] || { echo "ERROR: t3 row '$entry': workspace $ws has more than one term row" >&2; return 1; }
      IFS='|' read -r _ _ slot workdir _ <<< "$term"
      server=$(printf '%s\t%s\t%s\t%s' "$ws" "$slot" "${workdir/#\~/$HOME}" "$T3_PORT")
    done
    [[ -n "$server" ]] || {
      echo "ERROR: t3 row '$entry': workspace $ws has no term row to take its slot and workdir from" >&2
      return 1
    }
    printf '%s\n' "$server"
  done
}

# The table above is the only place the workspace-to-checkout mapping is
# written down, so anything that needs it reads it from here rather than
# keeping a copy. sync.sh derives Orchest's Omnigent attribution this way, and
# bin/t3-ensure and bin/t3-workspace-serve the desktop's T3 Code server and its
# projects.
# Emitted before the lock and preflight: this reports the DECLARED layout, so
# it must work with no compositor running.
if [[ "$PRINT_LAYOUT" == true ]]; then
  command -v jq >/dev/null 2>&1 || { echo "ERROR: jq not found." >&2; exit 1; }
  panes_json=$(for pane in "${DASHBOARD_PANES[@]}"; do
    IFS='|' read -r app_id _ pct <<< "$pane"
    printf '%s\t%s\n' "$app_id" "$pct"
  done | jq -Rn '[inputs | split("\t") | { name: .[0], percent: (if .[1] == "" then null else (.[1] | tonumber) end) }]')
  t3_tsv=$(t3_rows) || exit 1
  t3_json=$(printf '%s' "$t3_tsv" | jq -Rn '[inputs | split("\t") | { workspace: .[0], slot: .[1], workdir: .[2], port: (.[3] | tonumber) }]')
  for entry in "${WORKSPACES[@]}"; do
    IFS='|' read -r ws type rest <<< "$entry"
    [[ "$type" == term ]] || continue
    IFS='|' read -r slot workdir _ <<< "$rest"
    printf '%s\t%s\t%s\n' "$ws" "$slot" "${workdir/#\~/$HOME}"
  done | jq -Rn --arg sweep "$SWEEP_WORKSPACE" --arg dashboard "$DASHBOARD_WS" \
      --arg dashboardLayout "$DASHBOARD_LAYOUT" --argjson dashboardPanes "$panes_json" \
      --arg terminalAppIdPrefix "$TERM_APP_ID_PREFIX" --arg stackLayout "$STACK_LAYOUT" \
      --argjson sidebarPercent "$SIDEBAR_PERCENT" --argjson sidebarMinWidth "$SIDEBAR_MIN_WIDTH" \
      --argjson orchestEnabled "$ORCHEST_ENABLED" --arg orchestDir "${ORCHEST_DIR/#\~/$HOME}" \
      --arg t3Server "$T3_SERVER" --argjson t3Port "$T3_PORT" --argjson t3 "$t3_json" '
    {
      sweepWorkspace: $sweep,
      dashboardWorkspace: $dashboard,
      dashboardLayout: $dashboardLayout,
      dashboardPanes: $dashboardPanes,
      terminalAppIdPrefix: $terminalAppIdPrefix,
      stackLayout: $stackLayout,
      sidebarPercent: $sidebarPercent,
      sidebarMinWidth: $sidebarMinWidth,
      orchestEnabled: $orchestEnabled,
      orchestDir: $orchestDir,
      terminals: [inputs | split("\t") | { workspace: .[0], slot: .[1], workdir: .[2] }],
      t3Server: $t3Server,
      t3Port: $t3Port,
      t3: $t3
    }'
  exit 0
fi

# Only one reconciler per compositor may mutate its tree at a time. Keyed by
# the IPC socket rather than by user because that is what it protects: a
# nested or headless sway (the e2e tests run one) is a separate tree with a
# reconciler of its own.
#
# The lock is a kernel flock held by a flock(1) parent that re-runs this
# script under it. Two properties matter:
#   - It is released when the parent exits for any reason, so there is no
#     stale-lock recovery path -- and it was exactly that path (a second
#     invocation seeing a lock dir with no pid file yet and deleting it) that
#     let two reconcilers run concurrently under the previous mkdir protocol.
#   - `-o` closes the lock fd before the script runs, so no child can inherit
#     it. Holding the lock on an fd inside this process (`exec 9>file; flock 9`)
#     leaked it into every child: a long-lived one kept the lock after the
#     script exited and every later run quietly reported "already running".
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/sway-startup-windows.$(basename "${SWAYSOCK:-default}").lock"
if [[ "${SWAY_STARTUP_WINDOWS_LOCKED:-}" != 1 ||
      "${SWAY_WINDOWS_LOCK_SOCKET:-${SWAYSOCK:-default}}" != "${SWAYSOCK:-default}" ]]; then
  rc=0
  # A short wait, not -n: sway-auto-stack probes this lock by taking it for a
  # moment, and a probe must never make a real run report "already running".
  SWAY_STARTUP_WINDOWS_LOCKED=1 SWAY_WINDOWS_LOCK_SOCKET="${SWAYSOCK:-default}" \
    flock -w 2 -E 75 -o "$LOCK_FILE" "$BASH" "${BASH_SOURCE[0]}" "${ORIG_ARGS[@]}" || rc=$?
  if [[ "$rc" -eq 75 ]]; then
    echo "startup-windows is already running; exiting."
    exit 0
  fi
  exit "$rc"
fi
trap 'exit 130' INT
trap 'exit 143' TERM

failures=0
warn() { echo "WARNING: $*" >&2; failures=$(( failures + 1 )); }

# ── Preflight ────────────────────────────────────────────────────────

if ! command -v swaymsg >/dev/null 2>&1; then
  echo "ERROR: swaymsg not found; this script requires sway." >&2
  exit 1
fi
if ! sway_ipc -t get_version >/dev/null 2>&1; then
  echo "ERROR: cannot reach sway (is SWAYSOCK set / is sway running?)." >&2
  exit 1
fi
for dep in jq ghostty; do
  command -v "$dep" >/dev/null 2>&1 || { echo "ERROR: $dep not found." >&2; exit 1; }
done

# A SECOND Omnigent window can only come from a keystroke: the app is
# single-instance, its deep link REUSES a window already on the same origin
# (web/electron/src/deepLink.js chooseDeepLinkStrategy), and a plain second
# launch only focuses the existing window (main.js second-instance handler).
# The Server > New Window menu item is the only entry point, so its
# accelerator is synthesized, exactly as the Mac script clicks the same menu
# item via AppleScript. The injector (xdotool or wtype) is chosen per window
# and its absence is reported where it is needed.
#
# The installed version decides whether that accelerator exists at all.
OMNIGENT_INSTALLED_VERSION=""
omnigent_new_window_supported() {
  [[ -n "$OMNIGENT_NEW_WINDOW_MIN_VERSION" ]] || return 0
  # Not a Debian install (AppImage, a dev build): nothing to compare against,
  # so let the keystroke try and the per-run fail-fast below catch it.
  OMNIGENT_INSTALLED_VERSION=$(dpkg-query -W -f='${Version}' omnigent-desktop-electron 2>/dev/null) || return 0
  [[ -n "$OMNIGENT_INSTALLED_VERSION" ]] || return 0
  dpkg --compare-versions "$OMNIGENT_INSTALLED_VERSION" ge "$OMNIGENT_NEW_WINDOW_MIN_VERSION"
}

# Fail fast on a malformed terminal app_id rather than letting ghostty fall
# back to its default class, which would silently collapse every managed
# terminal onto one identity.
validate_term_app_ids() {
  local entry ws type rest slot bad=0
  for entry in "${WORKSPACES[@]}"; do
    IFS='|' read -r ws type rest <<< "$entry"
    [[ "$type" == term ]] || continue
    IFS='|' read -r slot _ <<< "$rest"
    if ! valid_term_app_id "${TERM_APP_ID_PREFIX}${slot}"; then
      echo "ERROR: slot '$slot' yields an invalid GTK application id: ${TERM_APP_ID_PREFIX}${slot}" >&2
      bad=1
    fi
  done
  return "$bad"
}
validate_dashboard_panes() {
  local pane app_id cmd pct bad=0
  for pane in "${DASHBOARD_PANES[@]}"; do
    IFS='|' read -r app_id cmd pct <<< "$pane"
    [[ -n "$app_id" && -n "$cmd" ]] || { echo "ERROR: dashboard pane needs app_id|command: $pane" >&2; bad=1; }
    [[ -z "$pct" || ( "$pct" =~ ^[0-9]+$ && "$pct" -ge 1 && "$pct" -le 99 ) ]] \
      || { echo "ERROR: dashboard pane percent must be 1-99: $pane" >&2; bad=1; }
  done
  return "$bad"
}
# One line per t3 row (see t3_rows), resolved once for reconcile_entry.
T3_ROWS=""
validate_term_app_ids && validate_dashboard_panes && T3_ROWS=$(t3_rows) || {
  echo "ERROR: fix the workspace table before running." >&2
  exit 1
}

managed_workspaces() {
  printf '%s\n' "${WORKSPACES[@]}" | cut -d'|' -f1 | sort -u
}

# The claims the table declares today. The sweep keeps a window on a managed
# workspace only if it holds one of these, so deleting or renaming a slot
# retires its old window instead of leaving it in the layout for good.
# Dashboard claims count even under --no-dashboard: skipping the dashboard
# means leaving its windows alone, not evicting them.
current_claim_marks() {
  local entry ws type rest pane app_id
  for entry in "${WORKSPACES[@]}"; do
    IFS='|' read -r ws type rest <<< "$entry"
    case "$type" in chrome|omnigent|t3) echo "sw:${ws}:${type}" ;; esac
  done
  for pane in "${DASHBOARD_PANES[@]}"; do
    IFS='|' read -r app_id _ <<< "$pane"
    echo "sw:${DASHBOARD_WS}:${app_id}"
  done
  while IFS= read -r ws; do sidebar_mark "$ws"; done < <(managed_workspaces)
}
current_term_app_ids() {
  local entry ws type rest slot
  for entry in "${WORKSPACES[@]}"; do
    IFS='|' read -r ws type rest <<< "$entry"
    [[ "$type" == term ]] || continue
    IFS='|' read -r slot _ <<< "$rest"
    echo "${TERM_APP_ID_PREFIX}${slot}"
  done
}

# ── Window creation ──────────────────────────────────────────────────

# Launch detached from this script, argv passed through untouched.
#
# Not `swaymsg exec`. This script already runs in the compositor's
# environment (sway execs it from the config and from the $mod+Shift+r
# binding), so a direct launch inherits exactly what sway's exec would have
# handed the child -- minus sway's command parser, which is the point. sway
# splits a command on unquoted `;`/`,`, and its escape handling (argsep in
# common/stringop.c, 1.11) does not consume the escape after an escaped
# quote, so `\'\;` reads as a live separator: the terminal command was cut in
# half exactly there, the remainder failed as a sway command, and zsh got a
# `while` with no `done`. Handing the argv to setsid applies no quoting and
# interprets none.
#
# Output stays on the inherited stderr so app logs reach the journal at
# login; from a terminal it is silenced, as it was under sway's exec. The lock
# marker must not be inherited: a reconciler started from inside a launched
# terminal would otherwise believe it already holds the lock.
#
# The first argument is the systemd --user slice for the app's own scope (see
# app-scope): terminals go in the memory-capped app-terminals.slice.
launch() {
  local slice="$1"
  shift
  if [[ "$DRY_RUN" == true ]]; then
    echo "  DRY-RUN launch ($slice): $(printf '%q ' "$@")"
    return 0
  fi
  if [[ -t 2 ]]; then
    env -u SWAY_STARTUP_WINDOWS_LOCKED -u SWAY_WINDOWS_LOCK_SOCKET setsid -f -- "$SCRIPT_DIR/app-scope" "$slice" "$@" </dev/null >/dev/null 2>&1
  else
    env -u SWAY_STARTUP_WINDOWS_LOCKED -u SWAY_WINDOWS_LOCK_SOCKET setsid -f -- "$SCRIPT_DIR/app-scope" "$slice" "$@" </dev/null
  fi
}

launch_desktop_entry() {
  local entry="$1" exec_line
  if ! exec_line=$(desktop_entry_exec "$entry"); then
    warn "no desktop entry found for $entry"
    return 1
  fi
  if [[ "$DRY_RUN" == true ]]; then
    echo "  DRY-RUN launch: $exec_line"
    return 0
  fi
  # An Exec line is shell-quoted by the desktop entry spec, so it still needs
  # one shell -- the one sway's exec used to supply.
  launch app.slice sh -c "exec $exec_line"
}

create_term() {
  local slot="$1" workdir="$2" cmd="$3"
  workdir="${workdir/#\~/$HOME}"
  launch app-terminals.slice ghostty "--class=${TERM_APP_ID_PREFIX}${slot}" \
    "--working-directory=$workdir" -e zsh -lc "$cmd"
}

# Whether Omnigent already has a window we could open another from.
#
# Deliberately NOT a pgrep on the binary path: any process whose command line
# merely mentions that path (a grep, an editor, a shell running this script)
# is a false positive, and a false positive here skips the initial launch and
# then tries to synthesize New Window against an app that is not running. The
# window tree is both the authoritative answer and the thing we actually need.
omnigent_has_window() {
  local ids
  ids=$(window_ids_matching "$SNAPSHOT" "$OMNIGENT_MATCH_JQ" "$OMNIGENT_INVALID_TITLE_RE")
  [[ -n "$ids" ]]
}

# ── Reconcile one slot ───────────────────────────────────────────────

SNAPSHOT=""
# An unreadable tree aborts the run. Continuing with an empty SNAPSHOT would
# make every slot look vacant and launch a duplicate of everything.
refresh() {
  local attempt
  for attempt in 1 2 3; do
    if SNAPSHOT=$(snapshot_windows); then
      return 0
    fi
    sleep 0.5
  done
  echo "ERROR: cannot read the sway window tree; refusing to continue with an unknown window set." >&2
  exit 1
}

place() {
  local id="$1" ws="$2" label="$3" current
  current=$(workspace_of "$SNAPSHOT" "$id")
  [[ "$current" == "$ws" ]] && return 0
  if [[ "$DRY_RUN" == true ]]; then
    echo "  DRY-RUN move $label (id=$id) ${current:-?} -> $ws"
    return 0
  fi
  move_to_workspace "$id" "$ws" || { warn "[$label] move to workspace $ws failed"; return 1; }
}

reconcile_term() {
  local ws="$1" slot="$2" workdir="$3" cmd="$4"
  local app_id="${TERM_APP_ID_PREFIX}${slot}" id
  id=$(id_with_app_id "$SNAPSHOT" "$app_id")
  if [[ -n "$id" ]]; then
    echo "[term:$slot] found (id=$id)"
    place "$id" "$ws" "term:$slot"
    return 0
  fi

  echo "[term:$slot] creating on workspace $ws..."
  create_term "$slot" "$workdir" "$cmd" || { warn "[term:$slot] launch failed"; return 1; }
  [[ "$DRY_RUN" == true ]] && return 0

  # The app_id is fixed at launch, so we just wait for it to appear -- no
  # id-diffing, and no chance of adopting an unrelated window.
  local deadline
  deadline=$(( $(date +%s) + 20 ))
  while [[ $(date +%s) -lt "$deadline" ]]; do
    sleep 0.4
    refresh
    id=$(id_with_app_id "$SNAPSHOT" "$app_id")
    [[ -n "$id" ]] && break
  done
  if [[ -z "$id" ]]; then
    warn "[term:$slot] window never appeared"
    return 1
  fi
  place "$id" "$ws" "term:$slot"
}

# Open one more Omnigent window by sending Server > New Window's accelerator
# to an existing one.
#
# The keystroke goes to whatever has keyboard focus, so focus is put on the
# anchor and confirmed right before injecting. A Ctrl+Shift+N that lands
# elsewhere is not a no-op: in a terminal it opens a stray one, and on
# ghostty's "process exited" screen it closes the window -- which is how the
# workspace-2 terminal vanished on 2026-09-13.
#
# One failure retires the path for the rest of the run. Every slot after it
# would wait out the same timeout for the same reason (the running instance
# predates the accelerator, the injector cannot reach the window), and six of
# those is two minutes added to every login.
OMNIGENT_NEW_WINDOW_STATE=""   # "" | unsupported | failed
open_omnigent_window() {
  local label="$1" anchor injector focused
  case "$OMNIGENT_NEW_WINDOW_STATE" in
    unsupported)
      warn "[$label] skipped: this install cannot open additional Omnigent windows (see above)"; return 1 ;;
    failed)
      warn "[$label] skipped: an earlier New Window keystroke opened nothing this run"; return 1 ;;
  esac
  if ! omnigent_new_window_supported; then
    OMNIGENT_NEW_WINDOW_STATE=unsupported
    warn "[$label] Omnigent $OMNIGENT_INSTALLED_VERSION has no New Window accelerator (needs >= $OMNIGENT_NEW_WINDOW_MIN_VERSION);" \
         "bump omnigent_config/desktop-app.env and run omnigent-desktop-app-ensure --upgrade"
    return 1
  fi
  anchor=$(echo "$SNAPSHOT" | jq -r "[.[] | select($OMNIGENT_MATCH_JQ)] | sort_by(.id) | first | .id // empty")
  [[ -n "$anchor" ]] || { warn "[$label] no Omnigent window to focus"; return 1; }
  injector=$(new_window_injector "$SNAPSHOT" "$anchor")
  if ! command -v "$injector" >/dev/null 2>&1; then
    OMNIGENT_NEW_WINDOW_STATE=unsupported
    warn "[$label] $injector is not installed; cannot open an additional Omnigent window (sudo apt install $injector)"
    return 1
  fi
  if [[ "$DRY_RUN" == true ]]; then
    echo "  DRY-RUN $injector New Window at Omnigent window $anchor"
    return 0
  fi
  sway_cmd "[con_id=$anchor] focus" || {
    warn "[$label] could not focus Omnigent window $anchor; not sending the accelerator"; return 1; }
  sleep 0.4
  focused=$(focused_window_id)
  [[ "$focused" == "$anchor" ]] || {
    warn "[$label] focus is on ${focused:-nothing}, not Omnigent window $anchor; not sending the accelerator"; return 1; }
  case "$injector" in
    xdotool) xdotool "${OMNIGENT_NEW_WINDOW_XDOTOOL_ARGS[@]}" 2>/dev/null ;;
    wtype)   wtype "${OMNIGENT_NEW_WINDOW_WTYPE_ARGS[@]}" 2>/dev/null ;;
  esac || { warn "[$label] $injector failed"; return 1; }
}

# Chrome and Omnigent slots: reuse whatever already holds the mark, else adopt
# an unclaimed window, else create one.
reconcile_marked() {
  local ws="$1" type="$2" match="$3" invalid="$4"
  local mark="sw:${ws}:${type}" id

  id=$(id_with_mark "$SNAPSHOT" "$mark")
  if [[ -n "$id" ]]; then
    echo "[$type:$ws] holding mark $mark (id=$id)"
    place "$id" "$ws" "$type:$ws"
    return 0
  fi

  id=$(unclaimed_window_id "$SNAPSHOT" "$match" "$invalid")

  if [[ -n "$id" ]]; then
    echo "[$type:$ws] adopting unclaimed window $id"
  else
    echo "[$type:$ws] creating..."
    local before via_keystroke=false
    before=$(window_ids_matching "$SNAPSHOT" "$match" "$invalid")
    case "$type" in
      chrome)
        launch app.slice "${CHROME_CMD[@]}" || { warn "[$type:$ws] launch failed"; return 1; } ;;
      omnigent)
        if ! omnigent_has_window; then
          launch_desktop_entry "$OMNIGENT_DESKTOP_ENTRY" || return 1
        else
          via_keystroke=true
          open_omnigent_window "$type:$ws" || return 1
        fi
        ;;
    esac
    [[ "$DRY_RUN" == true ]] && return 0
    id=$(wait_for_new_window "$match" "$before" "$invalid" 25) || {
      [[ "$via_keystroke" == true ]] && OMNIGENT_NEW_WINDOW_STATE=failed
      warn "[$type:$ws] new window never appeared"; return 1; }
  fi

  place "$id" "$ws" "$type:$ws"
  [[ "$DRY_RUN" == true ]] || mark_window "$id" "$mark" || warn "[$type:$ws] could not mark $id"
  refresh
}

# ── T3 Code windows ──────────────────────────────────────────────────
# A t3 row's window is a Chrome --app window on the T3 Code server, at a
# hostname of its own (Chrome resolves *.localhost to loopback)
# and in a Chrome profile of its own. It is found by that profile alone (see
# chrome_profile_window_ids in sway-windows-lib.sh), so it never takes another
# slot's window, and claimed by the mark sw:<ws>:t3.
#
# A row is inert unless t3@T3_SERVER is enabled: bin/t3-ensure enables it
# where T3 Code is installed, and elsewhere the row only says so.

T3_TITLE_RE='^T3 Code'

# The Chrome slots' matcher, minus every window whose browser runs a T3 Code
# profile. A link T3 Code opens in a new tab lands in a regular browser window
# of that profile, and under XWayland an --app window carries Chrome's class:
# CHROME_MATCH_JQ alone would hand either to a Chrome slot.
chrome_slot_match() {
  local pid pids=""
  while read -r pid; do
    if [[ "$(chrome_user_data_dir "$pid")" == "$T3_CHROME_PROFILES_DIR/"* ]]; then
      pids="${pids}${pids:+, }${pid}"
    fi
  done < <(jq -r "[.[] | select($CHROME_MATCH_JQ) | .pid] | unique | .[]" <<< "$SNAPSHOT")
  if [[ -n "$pids" ]]; then
    echo "($CHROME_MATCH_JQ) and (.pid | IN($pids) | not)"
  else
    echo "$CHROME_MATCH_JQ"
  fi
}

# The slots share one server, so they share one deadline, set the first time it
# is found not answering: a broken install costs a run one wait, not one per
# slot. The probe
# is the descriptor route `t3 pair` itself checks
# (apps/server/src/cli/pair.ts), which answers without a session.
T3_SERVER_DEADLINE=""
t3_wait_for_server() {
  local port="$1"
  until curl -sf --noproxy '*' -o /dev/null -m 2 "http://127.0.0.1:${port}/.well-known/t3/environment"; do
    [[ -n "$T3_SERVER_DEADLINE" ]] || T3_SERVER_DEADLINE=$(( $(date +%s) + T3_SERVER_WAIT ))
    [[ $(date +%s) -lt "$T3_SERVER_DEADLINE" ]] || return 1
    sleep 0.5
  done
}

# t3_pairing_token -> a one-time token minted by the running server.
# A window opened on /pair#token=<token> pairs its profile; the session cookie
# lasts about 30 days, and a later window on / comes back signed in.
t3_pairing_token() {
  local out token
  out=$(T3CODE_HOME="$T3_HOMES_DIR/$T3_SERVER" timeout 30 "$T3_BIN" pair --ttl 5m --label sway-startup-windows 2>/dev/null) \
    || return 1
  token=$(sed -n 's/^Token: //p' <<< "$out")
  token="${token%%$'\n'*}"
  [[ "$token" =~ ^[A-Za-z0-9_-]+$ ]] || return 1
  printf '%s\n' "$token"
}

# t3_close_window ID -- close a window and wait, bounded, until it is gone and
# its browser has either exited or kept other windows, so the launch that
# replaces it does not hand its window to a browser that is shutting down.
t3_close_window() {
  local id="$1" pid _
  pid=$(jq -r --argjson i "$id" '.[] | select(.id == $i) | .pid' <<< "$SNAPSHOT")
  sway_cmd "[con_id=$id] kill" || return 1
  for _ in $(seq 1 40); do
    sleep 0.25
    refresh
    jq -e --argjson i "$id" 'any(.[]; .id == $i)' <<< "$SNAPSHOT" >/dev/null && continue
    if jq -e --argjson p "${pid:-0}" 'any(.[]; .pid == $p)' <<< "$SNAPSHOT" >/dev/null \
        || [[ ! -e "$SWAY_WINDOWS_PROC/$pid" ]]; then
      return 0
    fi
  done
  # A browser that outlives its last window (one running background apps) is
  # not shutting down: a launch reaches it like any running profile.
  ! jq -e --argjson i "$id" 'any(.[]; .id == $i)' <<< "$SNAPSHOT" >/dev/null
}

# Same contract as reconcile_marked -- the mark's holder, else an unclaimed
# window, else a new one -- except that every candidate must be a window of
# the slot's profile, and a window stuck on an error page is replaced.
#
# Only a window this run opens is scoped to WORKDIR (T3_SCOPE_CMD). A held or
# adopted one keeps whatever scope it has: rescoping reloads the page, and a
# window from before the debug port cannot be reached anyway.
reconcile_t3() {
  local ws="$1" slot="$2" workdir="$3" port="$4"
  local label="t3:$ws" mark="sw:${ws}:t3" profile="$T3_CHROME_PROFILES_DIR/$slot"
  local url="http://${slot}.t3.localhost:${port}/" ids id held=false title token open_url before deadline new
  local opened=false

  if ! systemctl --user is-enabled --quiet "t3@${T3_SERVER}.service" 2>/dev/null; then
    echo "[$label] t3@${T3_SERVER} is not enabled; no T3 Code window (bin/t3-ensure enables it)"
    return 0
  fi

  ids=$(chrome_profile_window_ids "$SNAPSHOT" "$profile")
  id=$(id_with_mark "$SNAPSHOT" "$mark")
  if [[ -n "$id" ]] && ! grep -qx "$id" <<< "$ids"; then
    echo "[$label] window $id holds $mark but is not a window of $profile; ignoring the claim"
    id=""
  fi
  if [[ -n "$id" ]]; then
    echo "[$label] holding mark $mark (id=$id)"
    held=true
  else
    ids=$(chrome_profile_window_ids "$SNAPSHOT" "$profile" unclaimed)
    id="${ids%%$'\n'*}"
    [[ -z "$id" ]] || echo "[$label] adopting unclaimed window $id"
  fi

  # A window opened while its server was down sits on Chrome's error page,
  # titled with the host, which never retries (as on the Mac): once the server
  # answers, replace it. T3 Code titles its page the same way paired or not,
  # so this cannot tell whether pairing worked.
  if [[ -n "$id" ]]; then
    title=$(jq -r --argjson i "$id" '.[] | select(.id == $i) | .title' <<< "$SNAPSHOT")
    if [[ ! "$title" =~ $T3_TITLE_RE ]]; then
      if [[ "$DRY_RUN" == true ]]; then
        echo "  DRY-RUN replace window $id (titled '$title', not T3 Code's page) once the server answers"
        return 0
      elif t3_wait_for_server "$port"; then
        echo "[$label] window $id is titled '$title', not T3 Code's page; replacing it"
        t3_close_window "$id" || { warn "[$label] could not close window $id"; return 1; }
        id=""
        held=false
      else
        warn "[$label] the T3 Code server is not answering on port $port; window $id stays on its error page"
      fi
    fi
  fi
  if [[ "$held" == true ]]; then
    place "$id" "$ws" "$label"
    return 0
  fi

  # --remote-debugging-port=0 is how T3_SCOPE_CMD reaches the new window's
  # page: Chrome picks a free loopback port and writes it to
  # $profile/DevToolsActivePort (it refuses the flag only in its default
  # profile). Same trust as the Omnigent app's debug port
  # (omnigent_config/omnigent-desktop-electron.desktop): web pages cannot reach
  # it, any local process can, and any local process can already mint a
  # pairing token for this server with T3_BIN.
  if [[ -z "$id" ]]; then
    echo "[$label] opening $url on workspace $ws..."
    if [[ "$DRY_RUN" == true ]]; then
      launch app.slice "${T3_CHROME_CMD[@]}" "--user-data-dir=$profile" --remote-debugging-port=0 \
        "--app=${url}pair#token=TOKEN"
      echo "  DRY-RUN scope it to $workdir: $(printf '%q ' "${T3_SCOPE_CMD[@]}" "$profile" "${url%/}" "$workdir")"
      return 0
    fi
    t3_wait_for_server "$port" || {
      warn "[$label] the T3 Code server (t3@$T3_SERVER) did not answer on port $port within ${T3_SERVER_WAIT}s; not opening a window"
      return 1
    }
    if token=$(t3_pairing_token); then
      open_url="${url}pair#token=${token}"
    else
      warn "[$label] could not mint a pairing token (T3CODE_HOME=$T3_HOMES_DIR/$T3_SERVER $T3_BIN pair); opening $url unpaired"
      open_url="$url"
    fi
    mkdir -p "$profile" || { warn "[$label] cannot create the Chrome profile $profile"; return 1; }
    before=$(chrome_profile_window_ids "$SNAPSHOT" "$profile")
    launch app.slice "${T3_CHROME_CMD[@]}" "--user-data-dir=$profile" --remote-debugging-port=0 \
      "--app=$open_url" || { warn "[$label] launch failed"; return 1; }
    deadline=$(( $(date +%s) + 25 ))
    while [[ -z "$id" && $(date +%s) -lt "$deadline" ]]; do
      sleep 0.5
      refresh
      for new in $(chrome_profile_window_ids "$SNAPSHOT" "$profile"); do
        if ! grep -qx "$new" <<< "$before"; then id="$new"; break; fi
      done
    done
    [[ -n "$id" ]] || { warn "[$label] new window never appeared"; return 1; }
    opened=true
  fi

  place "$id" "$ws" "$label"
  [[ "$DRY_RUN" == true ]] || mark_window "$id" "$mark" || warn "[$label] could not mark $id"
  refresh
  if [[ "$opened" == true ]]; then
    echo "[$label] scoping window $id to $workdir..."
    "${T3_SCOPE_CMD[@]}" "$profile" "${url%/}" "$workdir" \
      || warn "[$label] could not scope window $id to $workdir; its sidebar and new threads may not keep to that project"
  fi
}

# ── Main ─────────────────────────────────────────────────────────────

refresh

reconcile_entry() {
  local entry="$1" ws type rest slot workdir cmd port
  IFS='|' read -r ws type rest <<< "$entry"
  case "$type" in
    term)
      IFS='|' read -r slot workdir cmd <<< "$rest"
      reconcile_term "$ws" "$slot" "$workdir" "$cmd" || true
      refresh
      ;;
    chrome)
      reconcile_marked "$ws" chrome "$(chrome_slot_match)" "$CHROME_INVALID_TITLE_RE" || true
      ;;
    omnigent)
      reconcile_marked "$ws" omnigent "$OMNIGENT_MATCH_JQ" "$OMNIGENT_INVALID_TITLE_RE" || true
      ;;
    t3)
      IFS=$'\t' read -r slot workdir port <<< "$(awk -F'\t' -v ws="$ws" '$1 == ws { print $2 "\t" $3 "\t" $4; exit }' <<< "$T3_ROWS")"
      reconcile_t3 "$ws" "$slot" "$workdir" "$port" || true
      ;;
  esac
}

# Omnigent slots go last, whatever the table order. Their extra windows come
# from a keystroke sent to the focused window, and a window still mapping
# from an earlier slot can take focus between the check and the keystroke.
# Once everything else is up there is nothing left to race.
for entry in "${WORKSPACES[@]}"; do
  if [[ "$entry" != *"|omnigent" ]]; then reconcile_entry "$entry"; fi
done
for entry in "${WORKSPACES[@]}"; do
  if [[ "$entry" == *"|omnigent" ]]; then reconcile_entry "$entry"; fi
done

# ── Orchest ──────────────────────────────────────────────────────────
# After the application windows: Orchest's workspace activation must not race
# the focus-sensitive Omnigent New Window accelerator. Before the dashboard:
# the Overview pane is claimed here and the dashboard pass finds it by mark.
# A failure here is a warning, as on the Mac: the sweep below spares Orchest
# windows by title, so a sidebar that is present but unclaimed stays put, and
# every other window still gets swept and laid out.
if [[ "$ORCHEST_ENABLED" == true ]]; then
  orchest_args=("--$ORCHEST_MODE")
  [[ "$DRY_RUN" == false ]] || orchest_args+=(--dry-run)
  [[ "$SKIP_DASHBOARD" == true ]] || orchest_args+=(--overview-workspace "$DASHBOARD_WS")
  while IFS= read -r ws; do orchest_args+=("$ws"); done < <(managed_workspaces)
  ORCHEST_DIR="$ORCHEST_DIR" ORCHEST_PORT="$ORCHEST_PORT" \
    "$SCRIPT_DIR/orchest-open-workspaces" "${orchest_args[@]}" \
    || warn "Orchest placement finished with warnings; the layout is built with what is there"
  [[ "$DRY_RUN" == true ]] || refresh
fi

# ── Dashboard ────────────────────────────────────────────────────────

# Same contract as reconcile_marked: the pane's own mark wins, then a window
# of that identity no slot has claimed, then a fresh launch. Matching by
# identity alone would let a pane take a window a standard workspace already
# owns -- the same app can legitimately fill both kinds of slot.
reconcile_dashboard_pane() {
  local app_id="$1" cmd="$2"
  local mark="sw:${DASHBOARD_WS}:${app_id}" id deadline

  id=$(id_with_mark "$SNAPSHOT" "$mark")
  if [[ -n "$id" ]]; then
    echo "[dash:$app_id] holding mark $mark (id=$id)"
    place "$id" "$DASHBOARD_WS" "dash:$app_id"
    return 0
  fi

  id=$(unclaimed_id_with_app_identity "$SNAPSHOT" "$app_id")
  if [[ -n "$id" ]]; then
    echo "[dash:$app_id] adopting unclaimed window $id"
  elif [[ "$cmd" == "$ORCHEST_OVERVIEW_LAUNCH" ]]; then
    # Placed and marked by orchest-open-workspaces above, never launched here.
    # Without Orchest the row is simply inert; with it, a missing Overview
    # means it was closed (Orchest does not reopen it on Linux) or the pass
    # above failed, and the next launch of Orchest brings it back.
    [[ "$ORCHEST_ENABLED" == true ]] || { echo "[dash:$app_id] Orchest is not enabled; skipping"; return 0; }
    warn "[dash:$app_id] Orchest did not provide an Overview window"
    return 1
  else
    echo "[dash:$app_id] creating..."
    if [[ "$cmd" == __desktop_entry__* ]]; then
      launch_desktop_entry "${cmd#__desktop_entry__ }" || return 1
    else
      # shellcheck disable=SC2086
      launch app.slice $cmd || { warn "[dash:$app_id] launch failed"; return 1; }
    fi
    [[ "$DRY_RUN" == true ]] && return 0
    deadline=$(( $(date +%s) + 25 ))
    while [[ $(date +%s) -lt "$deadline" ]]; do
      sleep 0.5
      refresh
      id=$(unclaimed_id_with_app_identity "$SNAPSHOT" "$app_id")
      [[ -n "$id" ]] && break
    done
    [[ -n "$id" ]] || { warn "[dash:$app_id] window never appeared"; return 1; }
  fi

  place "$id" "$DASHBOARD_WS" "dash:$app_id"
  [[ "$DRY_RUN" == true ]] || mark_window "$id" "$mark" || warn "[dash:$app_id] could not mark $id"
  refresh
}

if [[ "$SKIP_DASHBOARD" != true ]]; then
  for pane in "${DASHBOARD_PANES[@]}"; do
    IFS='|' read -r app_id cmd _ <<< "$pane"
    reconcile_dashboard_pane "$app_id" "$cmd" || true
  done
  # With the dashboard's output unplugged, sway falls back to the remaining
  # one (the same policy as the Mac's select_target_monitor), so the dashboard
  # is a workspace behind the managed ones rather than a second screen. Say so,
  # or it looks like it was never built.
  if [[ "$(sway_ipc -t get_outputs | jq '[.[] | select(.active)] | length')" == 1 ]]; then
    echo "NOTE: one output active; the dashboard is workspace $DASHBOARD_WS on it (\$mod+$DASHBOARD_WS), not a second screen."
  fi
fi

# ── Sweep ────────────────────────────────────────────────────────────
# Anything on a managed workspace that is not a slot the table declares today
# goes to the overflow workspace, and its stale claims are removed so a later
# slot can adopt it as an ordinary unclaimed window. Omnigent's update overlay
# is parked in the scratchpad by a for_window rule in sway_config, so it is
# not seen here at all. Orchest windows are spared by title as well as by
# mark: one that Orchest opened after the pass above has no claim yet, and
# parking it on Z would teach Orchest that Z is its workspace.

if [[ "$DRY_RUN" != true ]]; then
  refresh
  managed_re=$(managed_workspaces | paste -sd'|' -)
  swept=0
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    echo "Sweeping stray window $id to $SWEEP_WORKSPACE..."
    move_to_workspace "$id" "$SWEEP_WORKSPACE" && swept=$(( swept + 1 )) || true
    while IFS= read -r stale; do
      [[ -n "$stale" ]] || continue
      sway_cmd "[con_id=$id] unmark \"$stale\"" || true
    done < <(sw_marks_of "$SNAPSHOT" "$id")
  done < <(stray_window_ids "$SNAPSHOT" "^($managed_re)$" "$(current_claim_marks)" "$(current_term_app_ids)" \
             "$ORCHEST_SIDEBAR_TITLE_RE")
  [[ "$swept" -gt 0 ]] && echo "Swept ${swept} stray window(s) to ${SWEEP_WORKSPACE}."
fi

# ── Layout ───────────────────────────────────────────────────────────

if [[ "$DRY_RUN" != true ]]; then
  arrange_targets=()
  while IFS= read -r ws; do arrange_targets+=("$ws"); done < <(managed_workspaces)
  [[ "$SKIP_DASHBOARD" == true ]] || arrange_targets+=("$DASHBOARD_WS")
  # The arranger is a separate process: every setting an override can change
  # that it depends on has to be forwarded, or it silently falls back to its
  # defaults -- a moved dashboard gets tabbed, a custom terminal prefix makes
  # it report "no managed windows" and succeed.
  dashboard_order=""; dashboard_widths=""
  for pane in "${DASHBOARD_PANES[@]}"; do
    IFS='|' read -r app_id _ pct <<< "$pane"
    dashboard_order="${dashboard_order}${dashboard_order:+ }${app_id}"
    [[ -z "$pct" ]] || dashboard_widths="${dashboard_widths}${dashboard_widths:+ }${app_id}:${pct}"
  done
  DASHBOARD_LAYOUT="$DASHBOARD_LAYOUT" DASHBOARD_ORDER="$dashboard_order" DASHBOARD_WIDTHS="$dashboard_widths" \
    TERM_APP_ID_PREFIX="$TERM_APP_ID_PREFIX" STACK_LAYOUT="$STACK_LAYOUT" \
    SIDEBAR_PERCENT="$SIDEBAR_PERCENT" SIDEBAR_MIN_WIDTH="$SIDEBAR_MIN_WIDTH" \
    "$SCRIPT_DIR/arrange-workspaces" --dashboard-ws "$DASHBOARD_WS" --sweep-ws "$SWEEP_WORKSPACE" \
    "${arrange_targets[@]}" \
    || warn "arrange-workspaces did not converge"
  sway_cmd "workspace number 1" || true
fi

if [[ "$failures" -gt 0 ]]; then
  echo "Done with ${failures} warning(s)."
  exit 1
fi
echo "Done."
