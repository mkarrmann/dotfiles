<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The omnigent-opencode daemon: the sessions of T3 Code's Omnigent provider,
  followed while T3 Code is not listening (services/omnigent-opencode, its
  README's "Daemon" section). T3 Code still runs bin/omnigent-opencode as its
  OpenCode server; that process forwards to this daemon's socket when it
  answers, and serves on its own when it does not.

  sync.sh loads it; bin/t3-ensure, run by init.sh, restarts it when the
  service's code on disk is not the code it runs (`omnigent-opencode
  daemon-stale`).

  Manual ops:
    launchctl kickstart -k gui/$UID/com.mkarrmann.omnigent-opencode
    tail -f ~/.local/state/omnigent-opencode/daemon.log
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.mkarrmann.omnigent-opencode</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Users/mkarrmann/dotfiles/bin/omnigent-opencode</string>
      <string>daemon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Users/mkarrmann/.local/bin:/Users/mkarrmann/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/mkarrmann/.local/state/omnigent-opencode/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mkarrmann/.local/state/omnigent-opencode/daemon.log</string>
  </dict>
</plist>
