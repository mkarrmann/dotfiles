[Unit]
Description=Create a consistent Omnigent recovery snapshot
OnFailure=omnigent-alert@%n.service
After=network-online.target omnigent-server.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
EnvironmentFile=%h/dotfiles/omnigent_config/topology.env
# Deliberately NOT gated on `omnigent-hub gate`, unlike every other hub unit.
#
# The ownership rule exists so two hubs cannot both write the shared snapshot
# store. That binds PUBLICATION, not capture -- and gating the whole unit on it
# meant recovery points stopped at exactly the moment they were most wanted. When
# the active-hub record expired on 2026-09-16 the gate began denying, this timer
# stopped with it, and the deployment went five days with no snapshot at all.
#
# --fallback-local keeps the distinction: publish when ownership is established,
# otherwise keep an unpublished archive on local disk (pruned to
# snapshot.LOCAL_SNAPSHOT_KEEP) so an ownership outage costs durability but not
# the recovery point itself.
#
# --max-age makes the timer idempotent rather than unconditional: a cycle that
# already has a recent archive does no work, which matters because each one is a
# few hundred megabytes of sqlite copy plus gzip and chat.db keeps growing.
ExecStart=%h/dotfiles/services/omnigent-hub/.venv/bin/omnigent-hub snapshot \
    --fallback-local --max-age 240 --json
# Generous against the 5-minute timer. A SIGKILL here does not just lose the
# cycle: create_snapshot stages into a TemporaryDirectory whose cleanup never
# runs on a kill, which is how ~1.3 GB of orphaned snapshot-* directories
# accumulated under %S/omnigent-hub.
TimeoutStartSec=270
StandardOutput=append:%S/omnigent-hub/snapshot.log
StandardError=append:%S/omnigent-hub/snapshot.log
UMask=0077
NoNewPrivileges=true
