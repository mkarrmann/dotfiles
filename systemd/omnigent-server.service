# Authoritative systemd --user unit for the always-on Omnigent server.
# Symlinked into ~/.config/systemd/user/ by ~/dotfiles/init.sh (Linux block);
# after editing pick up changes with:
#
#   systemctl --user daemon-reload && systemctl --user restart omnigent-server
#   curl -sf http://127.0.0.1:6767/health && ss -ltnp | grep 6767
#
# The Omnigent server runs on ONE devserver (the HUB) and is dialed by:
#   - other devservers, through their local SSH forwards
#   - the Mac, through candidate forwards on its existing CCO/FTW ET sessions
# A shared epoch/lineage check gates it so init.sh can enable it on both hub
# candidates while only the active owner starts. Ownership changes through
# `omnigent-hub promote` and never through a topology edit.
#
# Runs the published uv-tool install (~/.local/bin/omnigent, prebuilt web UI) —
# NOT the ~/repos/omnigent editable build, which can't compile its web UI here
# (Node 16 + guard-locked npm). Upgrade with: with-proxy uv tool install --upgrade omnigent

[Unit]
Description=Omnigent server (hub; serves API + web UI, dialed by Mac and other devservers)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
# Put out-of-tree policy modules on the import path.
Environment=PYTHONPATH=%h/dotfiles/omnigent_config/policy_modules
# Vendored tiktoken BPE — its download host does not resolve here, and any
# server-side token counting fails closed without it.
# See omnigent_config/tiktoken-cache/README.md.
Environment=TIKTOKEN_CACHE_DIR=%h/dotfiles/omnigent_config/tiktoken-cache
# The server computes each session's context window, so it is the process that
# needs litellm's offline cost map. Without this it burns a DNS timeout per
# process refreshing it from github. See bin/omnigent-version-ensure.
Environment=LITELLM_LOCAL_MODEL_COST_MAP=True
# Release features, comma-separated. `canvas` is the web Canvas page (sessions
# as draggable cards grouped by project); it gates a page and a sidebar link and
# nothing server-side. Deliberately NOT `harness_install`, which un-darkens
# endpoints that install and configure harnesses from the web UI -- dotfiles and
# bin/omnigent-version-ensure already own that, and a second source of truth for
# it is how hosts drift.
#
# Set here rather than in topology.env: that file is also sourced by shell
# helpers on every machine, and an unknown name is a STARTUP FAILURE, not a
# no-op (omnigent/server/feature_flags.py). Only the two hubs read this unit and
# both run 0.13.0, which knows `canvas`; the Mac CLI is still 0.12.0 and does
# not. Resolved once at startup, so changing it needs a restart, not a reload.
Environment=OMNIGENT_FEATURES=canvas
# Trust the per-workspace window origins. The hub guards state-changing routes
# that accept multipart (CORS-safelisted, so the JSON content-type guard cannot
# protect them) by requiring a trusted Origin, and in single-user local mode
# "trusted" means a loopback hostname -- tested as `host == "localhost"`, an
# exact match (omnigent/server/ws_origin.py). RFC 6761 makes every *.localhost
# name loopback, but that check does not know it, so a window pinned to
# cco-checkout3.omnigent.localhost is read as cross-site and its uploads 403.
#
# This allowlist is consulted BEFORE the loopback rule and always passes, so it
# is the supported way to say these are first-party. It governs the WebSocket
# handshake too -- one trust boundary for both surfaces -- so without it the
# updates socket from a pinned window is rejected as well.
#
# Kept in step with bin-macos/workspaces by tests/test-workspaces.sh.
Environment=OMNIGENT_WS_ALLOWED_ORIGINS=https://local.omnigent.localhost:6443,https://cco-checkout1.omnigent.localhost:6443,https://ftw-checkout1.omnigent.localhost:6443,https://cco-checkout2.omnigent.localhost:6443,https://ftw-checkout2.omnigent.localhost:6443,https://cco-checkout3.omnigent.localhost:6443,https://ftw-checkout3.omnigent.localhost:6443,https://cco-checkout4.omnigent.localhost:6443
EnvironmentFile=%h/dotfiles/omnigent_config/topology.env
ExecCondition=%h/dotfiles/services/omnigent-hub/.venv/bin/omnigent-hub gate
# Bind 127.0.0.1 (v4 loopback): serves every local consumer (Orchest,
# CodeCompanion) and the Mac's candidate ET forwards, which connect to the
# remote v4 loopback. NOTE: `--host ::` was rejected — uvicorn sets IPV6_V6ONLY, so a
# v6 bind refuses v4 loopback and breaks the tunnel. Other devservers use
# authenticated SSH local forwarding, so the server stays unexposed.
ExecStart=%h/.local/bin/omnigent server --host 127.0.0.1 --port ${OMNIGENT_PORT} --database-uri sqlite:///%h/.omnigent/chat.db --artifact-location %h/.omnigent/artifacts --config %h/dotfiles/omnigent_config/server.yaml
Restart=always
RestartSec=5
TimeoutStartSec=150
StateDirectory=omnigent-server
StandardOutput=append:%S/omnigent-server/server.log
StandardError=append:%S/omnigent-server/server.log

[Install]
WantedBy=default.target
