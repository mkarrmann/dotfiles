# The omnigent-opencode daemon: the sessions of T3 Code's Omnigent provider,
# followed while T3 Code is not listening (services/omnigent-opencode, its
# README's "Daemon" section). T3 Code still runs bin/omnigent-opencode as its
# OpenCode server; that process forwards to this daemon's socket when it
# answers, and serves on its own when it does not.
#
# bin/t3-ensure, run by init.sh wherever a T3 Code server runs, enables it
# and restarts it when the service's code on disk is not the code it runs
# (`omnigent-opencode daemon-stale`).
#
# Manual ops:
#   systemctl --user restart omnigent-opencode
#   tail -f ~/.local/state/omnigent-opencode/daemon.log

[Unit]
Description=omnigent-opencode daemon (T3 Code's Omnigent provider)
After=network-online.target omnigent-server.service omnigent-client-proxy.service
ConditionPathExists=%h/dotfiles/services/omnigent-opencode/.venv/bin/omnigent-opencode

[Service]
Type=simple
# t3 (~/.local/bin) wakes threads; OMNIGENT_URL comes from environment.d.
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
ExecStart=%h/dotfiles/bin/omnigent-opencode daemon
Restart=on-failure
RestartSec=5
StandardOutput=append:%S/omnigent-opencode/daemon.log
StandardError=append:%S/omnigent-opencode/daemon.log
UMask=0077

[Install]
WantedBy=default.target
