[Unit]
Description=Omnigent local server and execution host
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
# Out-of-tree policy modules for the managed local server this host spawns.
# The server reads `policy_modules` from ~/.omnigent/config.yaml (merged there
# from omnigent_config/config.shared.yaml) and imports them by dotted name, so
# their directory must be importable; it is a child of this process and
# inherits this environment. Same mechanism as systemd/omnigent-server.service
# on the work hub, and the same accepted cost: omnigent forwards PYTHONPATH to
# runners, so agent shells can import foreground_wait/no_foreground_wait too.
Environment=PYTHONPATH=%h/dotfiles/omnigent_config/policy_modules
ExecStart=%h/.local/bin/omnigent host --server "" --non-interactive
Restart=on-failure
RestartPreventExitStatus=78 143
RestartSec=10

[Install]
WantedBy=default.target
