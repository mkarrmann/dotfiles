[Unit]
Description=Watch commands and wake local Omnigent sessions when their output changes
After=network-online.target omnigent-host.service
Wants=network-online.target omnigent-host.service
ConditionPathExists=%h/dotfiles/services/omnigent-watcher/.venv/bin/omnigent-watcher

[Service]
Type=simple
WorkingDirectory=%h/dotfiles/services/omnigent-watcher
Environment=PATH=%h/.local/bin:%h/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=OMNIGENT_URL=http://127.0.0.1:6767
ExecStart=%h/dotfiles/services/omnigent-watcher/.venv/bin/omnigent-watcher --config %h/dotfiles/services/omnigent-watcher/config.toml run
Restart=on-failure
RestartSec=5
StateDirectory=omnigent-watcher
StandardOutput=append:%S/omnigent-watcher/service.log
StandardError=append:%S/omnigent-watcher/service.log
UMask=0077
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=default.target
