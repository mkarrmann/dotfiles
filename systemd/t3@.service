# Templated systemd --user unit for this host's T3 Code server, one per host.
# Instance name (%i): on the work hubs "checkouts" (t3@checkouts), whose projects
# are every ~/checkoutN; on the Linux desktop the server for every t3 row of
# bin-linux/startup-windows' table (t3@desktop), whose projects are the rows'
# workdirs. Each workspace's browser window on it (bin-macos/startup-windows,
# bin-linux/startup-windows) starts its new threads in its own project and
# lists every project. bin/t3-workspace-serve resolves the port from it. Its
# providers drive Omnigent sessions through bin/omnigent-acp.
# bin/t3-ensure, run by init.sh, `enable --now`s the instance and never
# restarts a running one; after `t3 update`, restart it to pick up the new
# version.
#
# Provider processes are not in this unit's cgroup: T3 Code runs each in a
# transient scope under app-t3code-agents-<hash>.slice
# (apps/server/src/process/agentScope.ts), so they outlive a restart and the
# next start stops the leftovers.
#
# Manual ops:
#   systemctl --user restart t3@checkouts
#   journalctl --user -u t3@checkouts -e

[Unit]
Description=T3 Code server %i
After=network.target

[Service]
Type=simple
# T3 Code puts the PATH that `zsh -ilc 'printenv PATH'` prints first at startup
# (apps/server/src/os-jank.ts), but when that probe fails or takes over 5s the
# server keeps the user manager's PATH, which has no ~/.local/bin on the
# desktop (verified 2026-11-03: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin).
# bin/omnigent-acp runs under `#!/usr/bin/env -S uv run` with uv in
# ~/.local/bin, so every Omnigent provider would then exit 127.
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
ExecStart=%h/dotfiles/bin/t3-workspace-serve %i
Restart=on-failure
# Exit 2 is t3-workspace-serve's usage error: an instance this host no longer
# runs, such as a t3@checkoutN from when each checkout had a server, or a
# renamed t3 server. Restarting cannot fix it, so stop instead of looping.
RestartPreventExitStatus=2
RestartSec=5

[Install]
WantedBy=default.target
