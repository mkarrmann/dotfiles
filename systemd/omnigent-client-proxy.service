[Unit]
Description=Omnigent stable loopback SSH tunnel to the active hub
After=network-online.target
Wants=network-online.target
# Never stop retrying. The default limiter (5 starts / 10s) parks the unit in
# `failed` after a burst -- and this unit owns the endpoint every Omnigent
# consumer on the box dials, so giving up leaves the machine with no route to
# the hub until a human or the reconcile timer notices. Restarting forever
# against an unreachable hub costs one SSH attempt every RestartSec.
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
EnvironmentFile=%h/dotfiles/omnigent_config/topology.env
ExecStart=%h/bin/omnigent-client-proxy
Restart=always
RestartSec=5
StateDirectory=omnigent-client-proxy
StandardOutput=append:%S/omnigent-client-proxy/proxy.log
StandardError=append:%S/omnigent-client-proxy/proxy.log
