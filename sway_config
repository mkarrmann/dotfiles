# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.


### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term foot
# Your preferred application launcher
# Note: pass the final command to swaymsg so that the resulting window can be opened
# on the original workspace that the command was run on.
set $menu dmenu_path | wmenu | xargs swaymsg exec --

include /etc/sway/config-vars.d/*

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output * bg /usr/share/backgrounds/ubuntu-wallpaper-d.png fill
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
#
# Example configuration:
#
# exec swayidle -w \
#          timeout 300 'swaylock -f -c 000000' \
#          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#          before-sleep 'swaylock -f -c 000000'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

### Input configuration
#
# Example configuration:
#
#   input "2:14:SynPS/2_Synaptics_TouchPad" {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.

### Key bindings
#
# Window navigation is on Alt, the same chords as aerospace.toml on the Mac,
# so the two desktops share muscle memory (on the Glove80 it is literally the
# same key). Super keeps everything that is not navigation: launcher, kill,
# lock, splits, floating, scratchpad, resize, rebuild. Nothing is bound twice.
#
# focus_wrapping workspace: sway's default wraps only after trying the
# neighbouring output, so Alt+k at the top of a stack on the lower monitor
# would jump to the upper one; AeroSpace's boundary is the workspace.
focus_wrapping workspace
bindsym Mod1+1 workspace number 1
bindsym Mod1+2 workspace number 2
bindsym Mod1+3 workspace number 3
bindsym Mod1+4 workspace number 4
bindsym Mod1+5 workspace number 5
bindsym Mod1+6 workspace number 6
bindsym Mod1+7 workspace number 7
bindsym Mod1+8 workspace number 8
bindsym Mod1+9 workspace number 9
# Resolve keypad symbols to physical keys so Shift/NumLock cannot change the action.
bindsym --to-code Mod1+KP_1 workspace number 1
bindsym --to-code Mod1+KP_2 workspace number 2
bindsym --to-code Mod1+KP_3 workspace number 3
bindsym --to-code Mod1+KP_4 workspace number 4
bindsym --to-code Mod1+KP_5 workspace number 5
bindsym --to-code Mod1+KP_6 workspace number 6
bindsym --to-code Mod1+KP_7 workspace number 7
bindsym --to-code Mod1+KP_8 workspace number 8
bindsym --to-code Mod1+KP_9 workspace number 9
bindsym Mod1+a workspace A
bindsym Mod1+b workspace B
bindsym Mod1+z workspace Z
bindsym Mod1+Shift+1 exec $HOME/bin/sway-move-to-workspace 1
bindsym Mod1+Shift+2 exec $HOME/bin/sway-move-to-workspace 2
bindsym Mod1+Shift+3 exec $HOME/bin/sway-move-to-workspace 3
bindsym Mod1+Shift+4 exec $HOME/bin/sway-move-to-workspace 4
bindsym Mod1+Shift+5 exec $HOME/bin/sway-move-to-workspace 5
bindsym Mod1+Shift+6 exec $HOME/bin/sway-move-to-workspace 6
bindsym Mod1+Shift+7 exec $HOME/bin/sway-move-to-workspace 7
bindsym Mod1+Shift+8 exec $HOME/bin/sway-move-to-workspace 8
bindsym Mod1+Shift+9 exec $HOME/bin/sway-move-to-workspace 9
bindsym --to-code Mod1+Shift+KP_1 exec $HOME/bin/sway-move-to-workspace 1
bindsym --to-code Mod1+Shift+KP_2 exec $HOME/bin/sway-move-to-workspace 2
bindsym --to-code Mod1+Shift+KP_3 exec $HOME/bin/sway-move-to-workspace 3
bindsym --to-code Mod1+Shift+KP_4 exec $HOME/bin/sway-move-to-workspace 4
bindsym --to-code Mod1+Shift+KP_5 exec $HOME/bin/sway-move-to-workspace 5
bindsym --to-code Mod1+Shift+KP_6 exec $HOME/bin/sway-move-to-workspace 6
bindsym --to-code Mod1+Shift+KP_7 exec $HOME/bin/sway-move-to-workspace 7
bindsym --to-code Mod1+Shift+KP_8 exec $HOME/bin/sway-move-to-workspace 8
bindsym --to-code Mod1+Shift+KP_9 exec $HOME/bin/sway-move-to-workspace 9
bindsym Mod1+Shift+a exec $HOME/bin/sway-move-to-workspace A
bindsym Mod1+Shift+b exec $HOME/bin/sway-move-to-workspace B
bindsym Mod1+Shift+z exec $HOME/bin/sway-move-to-workspace Z
bindsym Mod1+h focus left
bindsym Mod1+Shift+h move left
bindsym Mod1+Ctrl+h focus output left
bindsym Mod1+j focus down
bindsym Mod1+Shift+j move down
bindsym Mod1+Ctrl+j focus output down
bindsym Mod1+k focus up
bindsym Mod1+Shift+k move up
bindsym Mod1+Ctrl+k focus output up
bindsym Mod1+l focus right
bindsym Mod1+Shift+l move right
bindsym Mod1+Ctrl+l focus output right
# next_on_output: AeroSpace's `workspace next` stays on the current monitor.
bindsym Mod1+i workspace next_on_output
bindsym Mod1+u workspace prev_on_output
bindsym Mod1+Tab workspace back_and_forth
bindsym Mod1+Shift+Tab exec $HOME/bin/sway-move-to-workspace --next-output
# Width resizing reaches the sidebar/stack split from either pane.
bindsym Mod1+Shift+comma resize shrink width 50 px
bindsym Mod1+Shift+period resize grow width 50 px
bindsym Mod1+f fullscreen

#
# Basics:
#
    # Start a terminal, in its own scope under the memory-capped
    # app-terminals.slice (see bin-linux/app-scope).
    bindsym $mod+Return exec $HOME/bin/app-scope app-terminals.slice $term

    # Copy a selected region or the entire desktop to the clipboard.
    bindsym --release Print exec sh -c 'geometry=$(slurp) && grim -g "$geometry" - | wl-copy --type image/png'
    bindsym --release Shift+Print exec grim - | wl-copy --type image/png

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    # bindsym $mod+d exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around and workspaces: see the Alt bindings above.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
bar {
    position top

    # When the status_command prints a new line to stdout, swaybar updates.
    # The default just shows the current date and time.
    status_command while date +'%Y-%m-%d %X'; do sleep 1; done

    colors {
        statusline #ffffff
        background #323232
        inactive_workspace #32323200 #32323200 #5c5c5c
    }
}

include /etc/sway/config.d/*

### Displays ############################################################
# Monitor layout is machine-specific and lives outside the repo in
# ~/.config/sway/config.d/. See sway_config.local.example for a template.
include ~/.config/sway/config.d/*
#########################################################################

output * adaptive_sync off

### Keyboards
# The layout is xkb/symbols/my_us_xkb, linked by sync.sh into
# ~/.config/xkb/symbols/, where libxkbcommon resolves it by name.
set $xkb_options lv3:ralt_switch

input type:keyboard {
    xkb_numlock enabled
    xkb_layout my_us_xkb
    xkb_options $xkb_options,caps:swapescape
}

# Keyboards that place Esc and Caps Lock in their own firmware are exempt from
# the swap. Identifiers match exactly (sway has no globs) and differ per
# transport, so each way a board connects (USB, Bluetooth) gets its own line.
# Take the identifier from `swaymsg -t get_inputs`; a line for an absent
# keyboard is inert, so every machine's boards can be listed here.
input "5824:10203:MoErgo_Glove80_Left_Keyboard" xkb_options $xkb_options

# Apps started from wofi share its scope under app.slice, rather than
# sway's session scope where systemd-oomd cannot see them.
bindsym $mod+d exec $HOME/bin/app-scope app.slice wofi --show drun

input * {
    natural_scroll enabled
    pointer_accel -0.8
}

# Make DISPLAY/WAYLAND_DISPLAY available to systemd --user services and systemd-run scopes
exec_always --no-startup-id systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec_always --no-startup-id dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP

bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute        exec --no-startup-id wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle

bindsym $mod+Shift+x exec swaylock -f --image /usr/share/backgrounds/Autumn_by_mendhak.png


### Managed window layout #################################################
# Workspace contents are declared in bin-linux/startup-windows, which is the
# Linux counterpart of bin-macos/startup-windows (AeroSpace on the Mac). The
# script is idempotent and self-healing: re-run it any time the session drifts.

# Omnigent's update overlay is a real 344x1 transparent window created one id
# after its parent shell window (desktop 0.10.0, web/electron/src/update_overlay.js),
# deliberately kept mapped so its ResizeObserver stays alive. It can never fill
# a workspace slot and must never join a layout, and it does NOT follow its
# parent across workspaces -- so park it instead of letting it pile up on
# whichever workspace was focused when it was created. On the Mac this needs
# ~40 lines of eviction logic in arrange-workspaces; here it is one rule.
for_window [title="^Omnigent Update$"] floating enable, move scratchpad

# Rebuild the declared layout on demand. The overflow workspace Z is Alt+z.
bindsym $mod+Shift+r exec $HOME/bin/startup-windows

# Put a window that appears later into its workspace's stack (sway would
# leave it beside the sidebar when the sidebar is focused). A second copy per
# compositor exits at once, so exec_always is safe across reloads.
exec_always $HOME/bin/sway-auto-stack

# Build the layout once per sway start (not exec_always: a config reload must
# not re-run the reconciler underneath a session you are using).
exec $HOME/bin/startup-windows
###########################################################################
