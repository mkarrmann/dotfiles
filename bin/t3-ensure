#!/usr/bin/env python3
"""t3-ensure — run a T3 Code server per workspace as a UI over its Omnigent sessions.

    t3-ensure

Idempotent; init.sh runs it on the Omnigent hub candidates and the Linux
desktop. A workspace NAME is each ~/checkoutN on a candidate, and on the desktop
each t3 row of bin-linux/startup-windows' table, named after its terminal slot
and serving that slot's workdir (one whose workdir is missing is skipped with a
warning). It:
  1. installs the `t3` CLI with T3 Code's installer when it is missing. Later
     upgrades belong to `t3 update`;
  2. for each workspace, registers bin/omnigent-acp as the "Omnigent · Claude"
     and "Omnigent · Codex" providers in ~/.t3-workspaces/NAME/userdata/
     settings.json, keeping every other setting (a running server reloads it).
     It also turns off T3 Code's built-in Codex and Claude, which would run outside
     Omnigent, unless the settings already configure them;
  3. warms uv's cache for omnigent-acp, since the services have no proxy to
     fetch its dependencies with;
  4. enables and starts t3@NAME (systemd/t3@.service, bin/t3-workspace-serve)
     when it is not enabled yet. A running server is never restarted;
  5. adds the workspace's directory as a project of its server unless it
     already is one. A project the server bootstrapped itself would count as a
     fresh install and open T3 Code's first-run wizard in every new window.

The Mac's workspace windows pair on their own: bin-macos/nvs-tunnels has
bin/t3-pairing-tokens mint tokens in its session, and startup-windows opens a
new window on /pair with one.

Env: DOTFILES_DIR (default ~/dotfiles).
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import NamedTuple

DOTFILES = Path(os.environ.get("DOTFILES_DIR", Path.home() / "dotfiles"))
WORKSPACES_HOME = Path.home() / ".t3-workspaces"
SHIM = DOTFILES / "bin/omnigent-acp"
CHECKOUT = re.compile(r"checkout[0-9]+")
INSTALLERS = (
    "https://t3.codes/install.sh",
    "https://raw.githubusercontent.com/pingdotgg/t3code/main/scripts/install.sh",
)
PROJECT_ADD_ATTEMPTS = 30
PROVIDERS = {"omnigent-claude": ("Omnigent · Claude", "claude-native-ui"), "omnigent-codex": ("Omnigent · Codex", "codex-native-ui")}
BUILTIN_PROVIDERS = ("codex", "claudeAgent")


class Workspace(NamedTuple):
    name: str  # t3@NAME.service, ~/.t3-workspaces/NAME
    directory: Path  # the server's project


def log(message: str) -> None:
    print(f"[t3-ensure] {message}")


def find_t3() -> Path | None:
    found = shutil.which("t3")
    if found:
        return Path(found)
    default = Path.home() / ".local/bin/t3"
    return default if default.exists() else None


def install_t3() -> None:
    # Plain curl on purpose: ~/.curlrc carries the proxy and client cert that reach GitHub.
    with tempfile.TemporaryDirectory() as tmp:
        script = Path(tmp) / "install.sh"
        for url in INSTALLERS:
            if subprocess.run(["curl", "-fsSL", "-o", str(script), url]).returncode == 0:
                break
        else:
            raise SystemExit("[t3-ensure] ERROR: could not download T3 Code's installer")
        subprocess.run(["sh", str(script)], check=True, env={**os.environ, "T3CODE_CHANNEL": "stable"})
    if find_t3() is None:
        raise SystemExit("[t3-ensure] ERROR: the installer finished but no t3 command was found")


def output(*command: str) -> str:
    result = subprocess.run(command, stdout=subprocess.PIPE, text=True)
    if result.returncode != 0:
        raise SystemExit(f"[t3-ensure] ERROR: {' '.join(command)} failed")
    return result.stdout


def checkouts() -> list[Workspace]:
    names = sorted(
        (p.name for p in Path.home().iterdir() if p.is_dir() and CHECKOUT.fullmatch(p.name)),
        key=lambda name: int(name.removeprefix("checkout")),
    )
    return [Workspace(name, Path.home() / name) for name in names]


def desktop_workspaces() -> list[Workspace]:
    layout = json.loads(output(str(DOTFILES / "bin-linux/startup-windows"), "--print-layout"))
    found: list[Workspace] = []
    for server in layout["t3"]:
        workspace = Workspace(str(server["slot"]), Path(server["workdir"]))
        if workspace.directory.is_dir():
            found.append(workspace)
        else:
            log(f"WARNING: skipping t3@{workspace.name}: {workspace.directory} does not exist")
    return found


def find_workspaces() -> list[Workspace]:
    if sys.platform == "linux" and output(str(DOTFILES / "bin/dotfiles-profile")).strip() == "desktop":
        return desktop_workspaces()
    return checkouts()


def provider_instances(shim: Path) -> dict[str, dict]:
    return {
        instance_id: {
            "driver": "acpRegistry",
            "displayName": name,
            "config": {"source": "local", "commandPath": str(shim), "commandArgs": ["--agent", agent]},
        }
        for instance_id, (name, agent) in PROVIDERS.items()
    }


def merge_settings(path: Path, shim: Path) -> bool:
    settings = json.loads(path.read_text()) if path.exists() and path.read_text().strip() else {}
    instances = settings.setdefault("providerInstances", {})
    wanted = provider_instances(shim)
    builtins = {key: {"driver": key, "enabled": False} for key in BUILTIN_PROVIDERS if key not in instances}
    if not builtins and all(instances.get(key) == value for key, value in wanted.items()):
        return False
    instances.update(wanted | builtins)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".json.t3-ensure")
    tmp.write_text(json.dumps(settings, indent=2) + "\n")
    tmp.replace(path)
    return True


def add_project(t3: Path, workspace: Workspace) -> bool:
    env = {**os.environ, "T3CODE_HOME": str(WORKSPACES_HOME / workspace.name)}
    for _ in range(PROJECT_ADD_ATTEMPTS):
        result = subprocess.run([str(t3), "project", "add", str(workspace.directory)], env=env, capture_output=True, text=True)
        if result.returncode == 0 or "ProjectAlreadyExistsError" in result.stderr + result.stdout:
            return True
        time.sleep(1)  # a server started a moment ago may not answer yet
    return False


def systemctl(*args: str) -> int:
    return subprocess.run(["systemctl", "--user", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode


def main() -> int:
    if find_t3() is None:
        log("installing the t3 CLI")
        install_t3()
    t3 = find_t3()
    assert t3 is not None
    workspaces = find_workspaces()
    for workspace in workspaces:
        if merge_settings(WORKSPACES_HOME / workspace.name / "userdata/settings.json", SHIM):
            log(f"registered the Omnigent providers for {workspace.directory}")
    if subprocess.run([str(SHIM), "--help"], stdout=subprocess.DEVNULL).returncode != 0:
        log("WARNING: omnigent-acp did not start; the Omnigent providers will fail until it does")
    failed = False
    for workspace in workspaces:
        unit = f"t3@{workspace.name}.service"
        if systemctl("is-enabled", "--quiet", unit) != 0:
            if systemctl("enable", "--now", unit) == 0:
                log(f"started {unit}")
            else:
                log(f"WARNING: could not enable {unit} (is systemd/t3@.service linked? run sync.sh)")
                failed = True
                continue
        if not add_project(t3, workspace):
            log(f"WARNING: could not add {workspace.directory} as {unit}'s project")
            failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
