#!/usr/bin/env python3
"""t3-ensure — run T3 Code servers as a UI over this host's Omnigent sessions.

    t3-ensure

Idempotent; init.sh runs it on the Omnigent hub candidates, the work Mac and
the Linux desktop. Each runs one server, NAME. On a candidate NAME is
"checkouts" and its projects are every ~/checkoutN. On the Mac NAME is "local",
its project ~/dotfiles (workspace 1's), and launchd runs it
(launchd/com.mkarrmann.t3-local.plist, loaded by sync.sh), so steps 5 and 6
below do not apply there. On the desktop NAME is the layout's t3Server
(bin-linux/startup-windows --print-layout) and its projects are the workdirs of
the table's t3 rows (one whose workdir is missing is skipped with a warning).
Either way each window's new threads start in its own workspace's project
(bin/t3-window-scope) while its sidebar lists every project. It:
  1. installs the pinned `t3` CLI (T3_CLI_VERSION) when it is missing, laid
     out as T3 Code's install.sh lays it out but checked against the pinned
     T3_CLI_SHA256 rather than whatever the release serves. Later upgrades
     belong to `t3 update`;
  2. links the server's settings, ~/.t3-workspaces/NAME/userdata/
     settings.json, to t3code/settings.json in the dotfiles, which every
     server shares: T3 Code saves through the link and reloads the file when
     it changes (00eb8f6183, in 0.1.6), so a setting changed in any window's
     server settings lands in the dotfiles, and T3 Code writes only what
     differs from its defaults. A server's own settings from before are merged
     in, the dotfiles' winning, and kept as settings.json.pre-dotfiles;
  3. registers bin/omnigent-opencode as the "Omnigent" provider in those
     settings (T3 Code's OpenCode driver; each Omnigent agent is a model
     group in it), keeping every other setting, by its bare name, which T3
     Code finds on PATH (~/bin on every host), as the shared file cannot hold
     one host's home. It removes the ACP providers it registered before
     (bin/omnigent-acp, retired). It also turns off T3 Code's
     built-in Codex and Claude, which would run outside Omnigent, unless the
     settings already configure them. The desktop gets the same in the T3
     Code app's own local environment (bin/t3-desktop-app-ensure),
     ~/.t3/userdata/settings.json -- the app's state while T3CODE_HOME is
     unset, as it is here -- by absolute path, as the app's PATH may lack
     ~/bin, and that file is not shared; no server or project for it below;
  4. installs omnigent-opencode's runtime (`uv sync` of
     services/omnigent-opencode), since the services have no proxy to fetch
     its dependencies with, and checks that it starts. Then it keeps the
     provider's daemon running that code: it enables and starts
     omnigent-opencode.service on Linux (on the Mac launchd runs it, as
     sync.sh loads it), and restarts the daemon when the code on disk is not
     the code it runs (`omnigent-opencode daemon-stale`), as after a pull,
     unless a turn is in flight there, which a restart would lose: then it
     says so, and the next run restarts it;
  5. retires the servers it ran before this one: `disable --now` every
     enabled t3@checkoutN on a candidate, and every enabled t3@X other than
     t3@NAME on the desktop (one per t3 row, t3@dotfiles and the like, before
     t3@desktop). Each held only its own workspace's threads, so no window saw
     a thread started in another, and bin/t3-workspace-serve no longer serves
     them. Their state (~/.t3-workspaces/X) is left where it is;
  6. enables and starts t3@NAME (systemd/t3@.service, bin/t3-workspace-serve)
     when it is not enabled yet. A running server is never restarted;
  7. adds each of its directories as a project of the server unless it
     already is one. A project the server bootstrapped itself would count as a
     fresh install and open T3 Code's first-run wizard in every new window.
     On a candidate it also names each project after its host, "checkout1 ·
     cco": every window lists both candidates' projects, and a name is all a
     project row shows (T3 Code marks only the other server's copy, with an
     icon). A name changed in the UI is put back on the next run.

The Mac's workspace windows pair on their own: bin-macos/nvs-tunnels has
bin/t3-pairing-tokens mint tokens in its session, and startup-windows opens a
new window on /pair with one.

Env: DOTFILES_DIR (default ~/dotfiles).
"""

from __future__ import annotations

import hashlib
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import NamedTuple

DOTFILES = Path(os.environ.get("DOTFILES_DIR", Path.home() / "dotfiles"))
WORKSPACES_HOME = Path.home() / ".t3-workspaces"
DESKTOP_APP_SETTINGS = Path.home() / ".t3/userdata/settings.json"
SHIM = DOTFILES / "bin/omnigent-opencode"
SHIM_COMMAND = SHIM.name
SHIM_RUNTIME = DOTFILES / "services/omnigent-opencode"
DAEMON_UNIT = "omnigent-opencode.service"
DAEMON_LABEL = "com.mkarrmann.omnigent-opencode"
DAEMON_BUSY = 2  # `omnigent-opencode daemon-stale`: stale, but a restart would lose a turn
SHARED_SETTINGS = DOTFILES / "t3code/settings.json"
CHECKOUT = re.compile(r"checkout[0-9]+")
WORK_SERVER = "checkouts"  # bin/t3-workspace-serve, bin/t3-pairing-tokens
# The Mac's server (launchd/com.mkarrmann.t3-local.plist, not systemd) and its
# project, workspace 1's (bin-macos/workspaces).
MAC_SERVER = "local"
MAC_PROJECTS = (Path.home() / "dotfiles",)
# Step 1's t3 CLI, from https://github.com/pingdotgg/t3code/releases/tag/v0.1.7,
# the release omnigent_config/t3-desktop-app.env pins the desktop app to. Each
# checksum is the archive's line in that release's SHA256SUMS (GitHub's asset
# digests agree), keyed by install.sh's <os>-<arch>. Bump the version and every
# checksum together; the pin only decides where a fresh host starts.
T3_CLI_VERSION = "0.1.7"
T3_CLI_SHA256 = {
    "linux-x64": "c089892bf7922e2e73c6f44a5d1ea125c99f70e378c18361cbbed2fba1920e6c",
    "linux-arm64": "5a528e23af394cc6f359036d3cb8441fda14129d477630fc6c53e4f4a1025bc8",
}
T3_RELEASES = "https://github.com/pingdotgg/t3code/releases/download"
T3_HOME = Path(os.environ.get("T3CODE_HOME") or Path.home() / ".t3").absolute()
T3_BIN_DIR = Path.home() / ".local/bin"
PROJECT_ADD_ATTEMPTS = 30
PROVIDER = "omnigent"
RETIRED_PROVIDERS = ("omnigent-claude", "omnigent-codex")  # bin/omnigent-acp's
BUILTIN_PROVIDERS = ("codex", "claudeAgent")


class Server(NamedTuple):
    name: str  # t3@NAME.service, ~/.t3-workspaces/NAME
    projects: tuple[Path, ...]
    label: str | None = None  # appended to each project's name, as "checkout1 · cco"


def log(message: str) -> None:
    print(f"[t3-ensure] {message}")


def find_t3() -> Path | None:
    found = shutil.which("t3")
    if found:
        return Path(found)
    default = Path.home() / ".local/bin/t3"
    return default if default.exists() else None


def cli_platform() -> str:
    """This host as T3 Code's release archives name it (install.sh's platform-arch)."""
    machine = platform.machine().lower()
    arch = {"x86_64": "x64", "amd64": "x64", "aarch64": "arm64", "arm64": "arm64"}.get(machine, machine)
    return f"{sys.platform}-{arch}"


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def install_t3(version: str, checksums: dict[str, str], t3_home: Path, bin_dir: Path) -> Path:
    """Step 1: install.sh's install of VERSION -- the archive unpacked into
    T3_HOME/runtime/versions/VERSION (where `t3 service install` and `t3 update`
    look for it), BIN_DIR/t3 linked to it, the link recorded in
    T3_HOME/runtime/launchers -- with the archive checked against CHECKSUMS.
    Returns the link."""
    target = cli_platform()
    expected = checksums.get(target)
    if expected is None:
        raise SystemExit(f"[t3-ensure] ERROR: no pinned t3 CLI for {target} (T3_CLI_SHA256); install t3 by hand")
    archive = f"t3-{version}-{target}.tar.gz"
    versions = t3_home / "runtime/versions"
    version_dir = versions / version
    marker = version_dir / ".install-complete"
    if not (marker.is_file() and marker.read_text().strip() == version):
        versions.mkdir(parents=True, exist_ok=True)
        staging = Path(tempfile.mkdtemp(prefix=".staging-", dir=versions))
        try:
            download = staging / archive
            # Plain curl on purpose: ~/.curlrc carries the proxy and client cert that reach GitHub.
            if subprocess.run(["curl", "-fsSL", "-o", str(download), f"{T3_RELEASES}/v{version}/{archive}"]).returncode != 0:
                raise SystemExit(f"[t3-ensure] ERROR: could not download {archive}")
            if sha256(download) != expected:
                raise SystemExit(f"[t3-ensure] ERROR: checksum mismatch for {archive}; not installing it")
            if subprocess.run(["tar", "-xzf", str(download), "-C", str(staging), "--strip-components=1"]).returncode != 0:
                raise SystemExit(f"[t3-ensure] ERROR: could not unpack {archive}")
            download.unlink()
            if subprocess.run([str(staging / "t3"), "--version"], stdout=subprocess.DEVNULL).returncode != 0:
                raise SystemExit(f"[t3-ensure] ERROR: the t3 in {archive} does not run")
            (staging / ".install-complete").write_text(version + "\n")
            shutil.rmtree(version_dir, ignore_errors=True)
            staging.rename(version_dir)
        finally:
            shutil.rmtree(staging, ignore_errors=True)
    bin_dir.mkdir(parents=True, exist_ok=True)
    link = bin_dir / "t3"
    new_link = bin_dir / ".t3.t3-ensure"
    new_link.unlink(missing_ok=True)
    new_link.symlink_to(version_dir / "t3")
    new_link.replace(link)
    launcher = str(bin_dir.resolve() / "t3")
    launchers = t3_home / "runtime/launchers"
    if launcher not in (launchers.read_text().splitlines() if launchers.exists() else []):
        with launchers.open("a") as f:
            f.write(launcher + "\n")
    return link


def output(*command: str) -> str:
    result = subprocess.run(command, stdout=subprocess.PIPE, text=True)
    if result.returncode != 0:
        raise SystemExit(f"[t3-ensure] ERROR: {' '.join(command)} failed")
    return result.stdout


def checkout_number(name: str) -> int:
    return int(name.removeprefix("checkout"))


def checkout_names(directory: Path) -> list[str]:
    """The checkoutN directories in DIRECTORY, by N."""
    if not directory.is_dir():
        return []
    return sorted((p.name for p in directory.iterdir() if p.is_dir() and CHECKOUT.fullmatch(p.name)), key=checkout_number)


def host_label() -> str | None:
    """This host's region, as startup-windows labels its servers: devvm1.cco0.facebook.com is "cco"."""
    parts = output("hostname", "-f").strip().split(".")
    if len(parts) < 3:
        return None
    return parts[1].rstrip("0123456789") or None


def work_servers() -> list[Server]:
    projects = tuple(Path.home() / name for name in checkout_names(Path.home()))
    return [Server(WORK_SERVER, projects, host_label())] if projects else []


def desktop_server() -> Server:
    layout = json.loads(output(str(DOTFILES / "bin-linux/startup-windows"), "--print-layout"))
    name = str(layout["t3Server"])
    projects: list[Path] = []
    for row in layout["t3"]:
        directory = Path(row["workdir"])
        if directory.is_dir():
            projects.append(directory)
        else:
            log(f"WARNING: skipping t3@{name}'s project {directory} (workspace {row['workspace']}): it does not exist")
    return Server(name, tuple(dict.fromkeys(projects)))


def mac_servers() -> list[Server]:
    projects = tuple(p for p in MAC_PROJECTS if p.is_dir())
    return [Server(MAC_SERVER, projects)] if projects else []


def host_os() -> str:
    """`uname -s`: Linux or Darwin."""
    return output("uname", "-s").strip()


def on_linux_desktop() -> bool:
    return host_os() == "Linux" and output(str(DOTFILES / "bin/dotfiles-profile")).strip() == "desktop"


def provider_instances(command: str) -> dict[str, dict]:
    # T3 Code turns the opencode driver off unless an instance says otherwise (DEFAULT_DISABLED_PROVIDER_DRIVERS).
    return {PROVIDER: {"driver": "opencode", "enabled": True, "displayName": "Omnigent", "config": {"binaryPath": command}}}


def read_settings(path: Path) -> dict:
    return json.loads(path.read_text()) if path.exists() and path.read_text().strip() else {}


def write_settings(path: Path, settings: dict) -> None:
    """Replaces PATH's target, so a link to the shared settings stays one."""
    target = path.resolve()
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_suffix(".json.t3-ensure")
    tmp.write_text(json.dumps(settings, indent=2) + "\n")
    tmp.replace(target)


def link_settings(path: Path, shared: Path) -> bool:
    """Step 2: PATH a link to SHARED, PATH's own settings merged into SHARED
    under SHARED's and kept beside it as .pre-dotfiles. False when it already was."""
    if path.is_symlink() and path.resolve() == shared.resolve():
        return False
    own = read_settings(path)
    if own or not shared.exists():
        write_settings(shared, {**own, **read_settings(shared)})
    if path.exists() or path.is_symlink():
        path.replace(path.with_name(path.name + ".pre-dotfiles"))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.symlink_to(shared)
    return True


def merge_settings(path: Path, command: str) -> bool:
    settings = read_settings(path)
    instances = settings.setdefault("providerInstances", {})
    wanted = provider_instances(command)
    builtins = {key: {"driver": key, "enabled": False} for key in BUILTIN_PROVIDERS if key not in instances}
    retired = [key for key in RETIRED_PROVIDERS if key in instances]
    if not builtins and not retired and all(instances.get(key) == value for key, value in wanted.items()):
        return False
    for key in retired:
        del instances[key]
    instances.update(wanted | builtins)
    write_settings(path, settings)
    return True


def install_shim_runtime() -> bool:
    """Step 4: the shim's virtualenv, from its lock file."""
    uv = shutil.which("uv") or str(Path.home() / ".local/bin/uv")
    command = [uv, "sync", "--frozen", "--quiet", "--project", str(SHIM_RUNTIME)]
    try:
        return subprocess.run(command, stdout=subprocess.DEVNULL).returncode == 0
    except OSError:
        return False


def add_project(t3: Path, server: Server, directory: Path) -> bool:
    env = {**os.environ, "T3CODE_HOME": str(WORKSPACES_HOME / server.name)}
    for _ in range(PROJECT_ADD_ATTEMPTS):
        result = subprocess.run([str(t3), "project", "add", str(directory)], env=env, capture_output=True, text=True)
        if result.returncode == 0 or "ProjectAlreadyExistsError" in result.stderr + result.stdout:
            return True
        time.sleep(1)  # a server started a moment ago may not answer yet
    return False


def name_project(t3: Path, server: Server, directory: Path, title: str) -> bool:
    env = {**os.environ, "T3CODE_HOME": str(WORKSPACES_HOME / server.name)}
    result = subprocess.run([str(t3), "project", "rename", str(directory), title], env=env, capture_output=True, text=True)
    if result.returncode == 0 and result.stdout.startswith("Renamed"):
        log(f"named {directory} {title!r} on t3@{server.name}")
    return result.returncode == 0


def systemctl(*args: str) -> int:
    return subprocess.run(["systemctl", "--user", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode


def ensure_daemon(mac: bool) -> bool:
    """Step 4: the provider's daemon running the code on disk; False when it is not."""
    if not mac and systemctl("is-active", "--quiet", DAEMON_UNIT) != 0:
        if systemctl("enable", "--now", DAEMON_UNIT) != 0:
            log(f"WARNING: could not enable {DAEMON_UNIT} (is systemd/{DAEMON_UNIT} linked? run sync.sh)")
            return False
        log(f"started {DAEMON_UNIT}")
        return True
    stale = subprocess.run([str(SHIM), "daemon-stale"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if stale.returncode == DAEMON_BUSY:
        log("omnigent-opencode's daemon runs old code but a turn is in flight; run init.sh again later to restart it")
        return True
    if stale.returncode != 0:
        return True
    if mac:
        command = ["launchctl", "kickstart", "-k", f"gui/{os.getuid()}/{DAEMON_LABEL}"]
        restarted = subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    else:
        restarted = systemctl("restart", DAEMON_UNIT) == 0
    if restarted:
        log("restarted omnigent-opencode's daemon on the code on disk")
    else:
        log(f"WARNING: could not restart omnigent-opencode's daemon ({'run sync.sh' if mac else DAEMON_UNIT})")
    return restarted


def retire_servers(names: list[str], current: str) -> bool:
    """Step 5: `disable --now` each enabled t3@NAME in NAMES but t3@CURRENT;
    False when one would not stop."""
    retired = True
    for name in names:
        unit = f"t3@{name}.service"
        if name == current or systemctl("is-enabled", "--quiet", unit) != 0:
            continue
        if systemctl("disable", "--now", unit) == 0:
            log(f"retired {unit}: t3@{current} serves its projects")
        else:
            log(f"WARNING: could not disable {unit}")
            retired = False
    return retired


def old_checkout_servers() -> list[str]:
    """A candidate's old instances, each found by its checkout or by the state
    the old t3-ensure wrote for it before enabling it."""
    return sorted({*checkout_names(Path.home()), *checkout_names(WORKSPACES_HOME)}, key=checkout_number)


def old_desktop_servers() -> list[str]:
    """Every t3@ instance the desktop may have enabled: one per state directory
    (t3-ensure wrote ~/.t3-workspaces/NAME before enabling t3@NAME), and one per
    t3@NAME.service link `systemctl --user enable` left in a wants directory."""
    names = {p.name for p in WORKSPACES_HOME.iterdir() if p.is_dir()} if WORKSPACES_HOME.is_dir() else set()
    units = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "systemd/user"
    names.update(link.name.removeprefix("t3@").removesuffix(".service") for link in units.glob("*.wants/t3@*.service"))
    return sorted(names)


def main() -> int:
    t3 = find_t3()
    if t3 is None:
        log(f"installing the t3 CLI {T3_CLI_VERSION}")
        t3 = install_t3(T3_CLI_VERSION, T3_CLI_SHA256, T3_HOME, T3_BIN_DIR)
    mac = host_os() == "Darwin"
    desktop = not mac and on_linux_desktop()
    if desktop and merge_settings(DESKTOP_APP_SETTINGS, str(SHIM)):
        log("registered the Omnigent providers for the T3 Code desktop app")
    layout_server = desktop_server() if desktop else None
    if layout_server is not None:
        servers = [layout_server] if layout_server.projects else []
    else:
        servers = mac_servers() if mac else work_servers()
    for server in servers:
        settings = WORKSPACES_HOME / server.name / "userdata/settings.json"
        if link_settings(settings, SHARED_SETTINGS):
            log(f"linked t3@{server.name}'s settings to {SHARED_SETTINGS}")
        if merge_settings(settings, SHIM_COMMAND):
            log(f"registered the Omnigent providers for t3@{server.name}")
    if not install_shim_runtime():
        log("WARNING: could not install omnigent-opencode's runtime; the Omnigent provider will fail until it is")
    elif subprocess.run([str(SHIM), "--version"], stdout=subprocess.DEVNULL).returncode != 0:
        log("WARNING: omnigent-opencode did not start; the Omnigent provider will fail until it does")
    # Without its daemon the provider still works, only without following sessions between T3 Code's visits.
    elif not ensure_daemon(mac):
        log("WARNING: omnigent-opencode's daemon is not running the current code")
    if mac:
        failed = False
    elif layout_server is not None:
        failed = not retire_servers(old_desktop_servers(), layout_server.name)
    else:
        failed = not retire_servers(old_checkout_servers(), WORK_SERVER)
    for server in servers:
        unit = f"t3@{server.name}.service"
        if not mac and systemctl("is-enabled", "--quiet", unit) != 0:
            if systemctl("enable", "--now", unit) == 0:
                log(f"started {unit}")
            else:
                log(f"WARNING: could not enable {unit} (is systemd/t3@.service linked? run sync.sh)")
                failed = True
                continue
        for directory in server.projects:
            if not add_project(t3, server, directory):
                log(f"WARNING: could not add {directory} as {unit}'s project")
                failed = True
            elif server.label and not name_project(t3, server, directory, f"{directory.name} \u00b7 {server.label}"):
                log(f"WARNING: could not name {unit}'s project {directory}")
                failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
