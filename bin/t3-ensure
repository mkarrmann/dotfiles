#!/usr/bin/env python3
"""t3-ensure — run T3 Code on this devserver as a UI over its Omnigent sessions.

    t3-ensure

Idempotent; init.sh runs it on the Omnigent hub candidates. It:
  1. installs the `t3` CLI with T3 Code's installer when it is missing. Later
     upgrades belong to `t3 update` or the desktop app's update button;
  2. pins the service to loopback on T3_SERVER_PORT (omnigent_config/topology.env)
     in $T3CODE_HOME/service.env. The Mac reaches it through bin-macos/nvs-tunnels;
  3. registers bin/omnigent-acp as the "Omnigent · Claude" and "Omnigent · Codex"
     providers in $T3CODE_HOME/userdata/settings.json, keeping every other
     setting (a running server reloads the file);
  4. warms uv's cache for omnigent-acp, since the service has no proxy to fetch
     its dependencies with;
  5. installs the t3code.service user unit if it does not exist. An existing
     service is never restarted.

Pair a client once per devserver with `t3 pair --ttl 30m`, then open the
printed t3code:// link on the Mac while nvs-tunnels is up.

Env: T3CODE_HOME (default ~/.t3), DOTFILES_DIR (default ~/dotfiles).
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

DOTFILES = Path(os.environ.get("DOTFILES_DIR", Path.home() / "dotfiles"))
T3_HOME = Path(os.environ.get("T3CODE_HOME", Path.home() / ".t3"))
SHIM = DOTFILES / "bin/omnigent-acp"
TOPOLOGY = DOTFILES / "omnigent_config/topology.env"
SERVICE_UNIT = "t3code.service"
INSTALLERS = (
    "https://t3.codes/install.sh",
    "https://raw.githubusercontent.com/pingdotgg/t3code/main/scripts/install.sh",
)
PROVIDERS = {"omnigent-claude": ("Omnigent · Claude", "claude-native-ui"), "omnigent-codex": ("Omnigent · Codex", "codex-native-ui")}


def log(message: str) -> None:
    print(f"[t3-ensure] {message}")


def topology_value(key: str, default: str) -> str:
    if TOPOLOGY.is_file():
        for line in TOPOLOGY.read_text().splitlines():
            name, _, value = line.partition("=")
            if name.strip() == key and value.strip():
                return value.strip()
    return default


def find_t3() -> Path | None:
    found = shutil.which("t3")
    if found:
        return Path(found)
    default = Path.home() / ".local/bin/t3"
    return default if default.exists() else None


def install_t3() -> Path:
    # Plain curl on purpose: ~/.curlrc carries the proxy and client cert that reach GitHub.
    with tempfile.TemporaryDirectory() as tmp:
        script = Path(tmp) / "install.sh"
        for url in INSTALLERS:
            if subprocess.run(["curl", "-fsSL", "-o", str(script), url]).returncode == 0:
                break
        else:
            raise SystemExit("[t3-ensure] ERROR: could not download T3 Code's installer")
        subprocess.run(["sh", str(script)], check=True, env={**os.environ, "T3CODE_CHANNEL": "stable"})
    t3 = find_t3()
    if t3 is None:
        raise SystemExit("[t3-ensure] ERROR: the installer finished but no t3 command was found")
    return t3


def merge_service_env(path: Path, wanted: dict[str, str]) -> bool:
    lines = path.read_text().splitlines() if path.exists() else []
    pending = dict(wanted)
    merged: list[str] = []
    for line in lines:
        key = line.partition("=")[0].strip()
        if key in pending:
            merged.append(f"{key}={pending.pop(key)}")
        else:
            merged.append(line)
    merged.extend(f"{key}={value}" for key, value in pending.items())
    text = "\n".join(merged) + "\n"
    if path.exists() and path.read_text() == text:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    return True


def provider_instances(shim: Path) -> dict[str, dict]:
    return {
        instance_id: {
            "driver": "acpRegistry",
            "displayName": name,
            "config": {"source": "local", "commandPath": str(shim), "commandArgs": ["--agent", agent]},
        }
        for instance_id, (name, agent) in PROVIDERS.items()
    }


def merge_settings(path: Path, shim: Path) -> bool:
    settings = json.loads(path.read_text()) if path.exists() and path.read_text().strip() else {}
    instances = settings.setdefault("providerInstances", {})
    wanted = provider_instances(shim)
    if all(instances.get(key) == value for key, value in wanted.items()):
        return False
    instances.update(wanted)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".json.t3-ensure")
    tmp.write_text(json.dumps(settings, indent=2) + "\n")
    tmp.replace(path)
    return True


def service_installed() -> bool:
    return subprocess.run(
        ["systemctl", "--user", "cat", SERVICE_UNIT], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    ).returncode == 0


def main() -> int:
    t3 = find_t3()
    if t3 is None:
        log("installing the t3 CLI")
        t3 = install_t3()
    if merge_service_env(T3_HOME / "service.env", {"T3CODE_HOST": "127.0.0.1", "T3CODE_PORT": topology_value("T3_SERVER_PORT", "3773")}):
        log(f"updated {T3_HOME / 'service.env'} (takes effect when the service next starts)")
    if merge_settings(T3_HOME / "userdata/settings.json", SHIM):
        log("registered the Omnigent providers")
    if subprocess.run([str(SHIM), "--help"], stdout=subprocess.DEVNULL).returncode != 0:
        log("WARNING: omnigent-acp did not start; the Omnigent providers will fail until it does")
    if not service_installed():
        log(f"installing {SERVICE_UNIT}")
        subprocess.run([str(t3), "service", "install"], check=True)
        log("pair the Mac once: run `t3 pair --ttl 30m` here, then open the t3code:// link there")
    return 0


if __name__ == "__main__":
    sys.exit(main())
