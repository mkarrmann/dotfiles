#!/usr/bin/env python3
"""t3-ensure — run T3 Code servers as a UI over this host's Omnigent sessions.

    t3-ensure

Idempotent; init.sh runs it on the Omnigent hub candidates and the Linux
desktop. Each runs one server, NAME. On a candidate NAME is "checkouts" and its
projects are every ~/checkoutN. On the desktop NAME is the layout's t3Server
(bin-linux/startup-windows --print-layout) and its projects are the workdirs of
the table's t3 rows (one whose workdir is missing is skipped with a warning).
Either way each window's new threads start in its own workspace's project
(bin/t3-window-scope) while its sidebar lists every project. It:
  1. installs the `t3` CLI with T3 Code's installer when it is missing. Later
     upgrades belong to `t3 update`;
  2. registers bin/omnigent-acp as the server's "Omnigent · Claude" and
     "Omnigent · Codex" providers in ~/.t3-workspaces/NAME/userdata/
     settings.json, keeping every other setting (a running server reloads it).
     It also turns off T3 Code's built-in Codex and Claude, which would run outside
     Omnigent, unless the settings already configure them. The desktop gets the
     same in the T3 Code app's own local environment (bin/t3-desktop-app-ensure),
     ~/.t3/userdata/settings.json -- the app's state while T3CODE_HOME is unset,
     as it is here -- and no server or project for it below;
  3. warms uv's cache for omnigent-acp, since the services have no proxy to
     fetch its dependencies with;
  4. on a candidate, retires the servers it ran before t3@checkouts, one per
     checkout: `disable --now` every enabled t3@checkoutN. Each held only its
     own checkout's threads, so no window saw a thread started in another, and
     bin/t3-workspace-serve no longer serves them. Their state
     (~/.t3-workspaces/checkoutN) is left where it is;
  5. enables and starts t3@NAME (systemd/t3@.service, bin/t3-workspace-serve)
     when it is not enabled yet. A running server is never restarted;
  6. adds each of its directories as a project of the server unless it
     already is one. A project the server bootstrapped itself would count as a
     fresh install and open T3 Code's first-run wizard in every new window.

The Mac's workspace windows pair on their own: bin-macos/nvs-tunnels has
bin/t3-pairing-tokens mint tokens in its session, and startup-windows opens a
new window on /pair with one.

Env: DOTFILES_DIR (default ~/dotfiles).
"""

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import NamedTuple

DOTFILES = Path(os.environ.get("DOTFILES_DIR", Path.home() / "dotfiles"))
WORKSPACES_HOME = Path.home() / ".t3-workspaces"
DESKTOP_APP_SETTINGS = Path.home() / ".t3/userdata/settings.json"
SHIM = DOTFILES / "bin/omnigent-acp"
CHECKOUT = re.compile(r"checkout[0-9]+")
WORK_SERVER = "checkouts"  # bin/t3-workspace-serve, bin/t3-pairing-tokens
INSTALLERS = (
    "https://t3.codes/install.sh",
    "https://raw.githubusercontent.com/pingdotgg/t3code/main/scripts/install.sh",
)
PROJECT_ADD_ATTEMPTS = 30
PROVIDERS = {"omnigent-claude": ("Omnigent · Claude", "claude-native-ui"), "omnigent-codex": ("Omnigent · Codex", "codex-native-ui")}
BUILTIN_PROVIDERS = ("codex", "claudeAgent")


class Server(NamedTuple):
    name: str  # t3@NAME.service, ~/.t3-workspaces/NAME
    projects: tuple[Path, ...]


def log(message: str) -> None:
    print(f"[t3-ensure] {message}")


def find_t3() -> Path | None:
    found = shutil.which("t3")
    if found:
        return Path(found)
    default = Path.home() / ".local/bin/t3"
    return default if default.exists() else None


def install_t3() -> None:
    # Plain curl on purpose: ~/.curlrc carries the proxy and client cert that reach GitHub.
    with tempfile.TemporaryDirectory() as tmp:
        script = Path(tmp) / "install.sh"
        for url in INSTALLERS:
            if subprocess.run(["curl", "-fsSL", "-o", str(script), url]).returncode == 0:
                break
        else:
            raise SystemExit("[t3-ensure] ERROR: could not download T3 Code's installer")
        subprocess.run(["sh", str(script)], check=True, env={**os.environ, "T3CODE_CHANNEL": "stable"})
    if find_t3() is None:
        raise SystemExit("[t3-ensure] ERROR: the installer finished but no t3 command was found")


def output(*command: str) -> str:
    result = subprocess.run(command, stdout=subprocess.PIPE, text=True)
    if result.returncode != 0:
        raise SystemExit(f"[t3-ensure] ERROR: {' '.join(command)} failed")
    return result.stdout


def checkout_number(name: str) -> int:
    return int(name.removeprefix("checkout"))


def checkout_names(directory: Path) -> list[str]:
    """The checkoutN directories in DIRECTORY, by N."""
    if not directory.is_dir():
        return []
    return sorted((p.name for p in directory.iterdir() if p.is_dir() and CHECKOUT.fullmatch(p.name)), key=checkout_number)


def work_servers() -> list[Server]:
    projects = tuple(Path.home() / name for name in checkout_names(Path.home()))
    return [Server(WORK_SERVER, projects)] if projects else []


def desktop_servers() -> list[Server]:
    layout = json.loads(output(str(DOTFILES / "bin-linux/startup-windows"), "--print-layout"))
    name = str(layout["t3Server"])
    projects: list[Path] = []
    for row in layout["t3"]:
        directory = Path(row["workdir"])
        if directory.is_dir():
            projects.append(directory)
        else:
            log(f"WARNING: skipping t3@{name}'s project {directory} (workspace {row['workspace']}): it does not exist")
    return [Server(name, tuple(dict.fromkeys(projects)))] if projects else []


def on_linux_desktop() -> bool:
    return sys.platform == "linux" and output(str(DOTFILES / "bin/dotfiles-profile")).strip() == "desktop"


def provider_instances(shim: Path) -> dict[str, dict]:
    return {
        instance_id: {
            "driver": "acpRegistry",
            "displayName": name,
            "config": {"source": "local", "commandPath": str(shim), "commandArgs": ["--agent", agent]},
        }
        for instance_id, (name, agent) in PROVIDERS.items()
    }


def merge_settings(path: Path, shim: Path) -> bool:
    settings = json.loads(path.read_text()) if path.exists() and path.read_text().strip() else {}
    instances = settings.setdefault("providerInstances", {})
    wanted = provider_instances(shim)
    builtins = {key: {"driver": key, "enabled": False} for key in BUILTIN_PROVIDERS if key not in instances}
    if not builtins and all(instances.get(key) == value for key, value in wanted.items()):
        return False
    instances.update(wanted | builtins)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".json.t3-ensure")
    tmp.write_text(json.dumps(settings, indent=2) + "\n")
    tmp.replace(path)
    return True


def add_project(t3: Path, server: Server, directory: Path) -> bool:
    env = {**os.environ, "T3CODE_HOME": str(WORKSPACES_HOME / server.name)}
    for _ in range(PROJECT_ADD_ATTEMPTS):
        result = subprocess.run([str(t3), "project", "add", str(directory)], env=env, capture_output=True, text=True)
        if result.returncode == 0 or "ProjectAlreadyExistsError" in result.stderr + result.stdout:
            return True
        time.sleep(1)  # a server started a moment ago may not answer yet
    return False


def systemctl(*args: str) -> int:
    return subprocess.run(["systemctl", "--user", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode


def retire_checkout_servers() -> bool:
    """Step 4. An old instance is found by its checkout or by the state the old
    t3-ensure wrote for it before enabling it; False when one would not stop."""
    retired = True
    for name in sorted({*checkout_names(Path.home()), *checkout_names(WORKSPACES_HOME)}, key=checkout_number):
        unit = f"t3@{name}.service"
        if systemctl("is-enabled", "--quiet", unit) != 0:
            continue
        if systemctl("disable", "--now", unit) == 0:
            log(f"retired {unit}: t3@{WORK_SERVER} serves every checkout")
        else:
            log(f"WARNING: could not disable {unit}")
            retired = False
    return retired


def main() -> int:
    if find_t3() is None:
        log("installing the t3 CLI")
        install_t3()
    t3 = find_t3()
    assert t3 is not None
    desktop = on_linux_desktop()
    if desktop and merge_settings(DESKTOP_APP_SETTINGS, SHIM):
        log("registered the Omnigent providers for the T3 Code desktop app")
    servers = desktop_servers() if desktop else work_servers()
    for server in servers:
        if merge_settings(WORKSPACES_HOME / server.name / "userdata/settings.json", SHIM):
            log(f"registered the Omnigent providers for t3@{server.name}")
    if subprocess.run([str(SHIM), "--help"], stdout=subprocess.DEVNULL).returncode != 0:
        log("WARNING: omnigent-acp did not start; the Omnigent providers will fail until it does")
    failed = not desktop and not retire_checkout_servers()
    for server in servers:
        unit = f"t3@{server.name}.service"
        if systemctl("is-enabled", "--quiet", unit) != 0:
            if systemctl("enable", "--now", unit) == 0:
                log(f"started {unit}")
            else:
                log(f"WARNING: could not enable {unit} (is systemd/t3@.service linked? run sync.sh)")
                failed = True
                continue
        for directory in server.projects:
            if not add_project(t3, server, directory):
                log(f"WARNING: could not add {directory} as {unit}'s project")
                failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
