#!/usr/bin/env bash
# devserver-health-check: Detect and optionally resolve resource issues
# Usage: devserver-health-check [--fix]

set -euo pipefail

FIX_MODE=false
if [[ "${1:-}" == "--fix" ]]; then
    FIX_MODE=true
fi

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

warn_count=0
fix_count=0

warn() { echo -e "${YELLOW}WARNING:${NC} $1"; warn_count=$((warn_count + 1)); }
err()  { echo -e "${RED}CRITICAL:${NC} $1"; warn_count=$((warn_count + 1)); }
ok()   { echo -e "${GREEN}OK:${NC} $1"; }
info() { echo -e "${BLUE}INFO:${NC} $1"; }
fix()  { echo -e "${GREEN}FIXED:${NC} $1"; fix_count=$((fix_count + 1)); }

echo "=== Devserver Health Check ==="
echo ""

# --- Memory ---
total_mem_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
avail_mem_kb=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
swap_used_kb=$(awk '/SwapTotal/ {total=$2} /SwapFree/ {free=$2} END {print total-free}' /proc/meminfo)
mem_pct=$((100 - (avail_mem_kb * 100 / total_mem_kb)))

echo "--- Memory ---"
if (( mem_pct > 90 )); then
    err "Memory ${mem_pct}% used ($(( avail_mem_kb / 1024 )) MB available)"
elif (( mem_pct > 75 )); then
    warn "Memory ${mem_pct}% used ($(( avail_mem_kb / 1024 )) MB available)"
else
    ok "Memory ${mem_pct}% used ($(( avail_mem_kb / 1024 )) MB available)"
fi

# Swap *occupancy* is not a health signal. Linux parks cold anonymous pages in
# swap to keep the page cache hot, so any long-uptime box accumulates gigabytes
# with nothing stalling -- this devserver sat at 35 GB swapped with 0 pages/s
# faulting back in. What matters is whether tasks are *waiting* on memory, which
# is exactly what PSI reports. Occupancy is printed for context only.
if [[ -r /proc/pressure/memory ]]; then
    psi_pct=$(awk '/^some/ { split($3, a, "="); print a[2]; exit }' /proc/pressure/memory)
    psi_x100=$(awk '/^some/ { split($3, a, "="); printf "%d", a[2] * 100; exit }' /proc/pressure/memory)
    if (( psi_x100 > 3000 )); then
        err "Memory pressure: ${psi_pct}% of the last 60s stalled on memory"
    elif (( psi_x100 > 1000 )); then
        warn "Memory pressure: ${psi_pct}% of the last 60s stalled on memory"
    else
        ok "No memory pressure (PSI some avg60=${psi_pct}%)"
    fi
    info "Swap: $(( swap_used_kb / 1024 )) MB in use (occupancy, not a pressure signal)"
else
    info "Swap: $(( swap_used_kb / 1024 )) MB in use (kernel has no PSI; cannot assess pressure)"
fi
echo ""

# --- Load average ---
echo "--- CPU ---"
nproc_val=$(nproc)
load1=$(cut -d' ' -f1 /proc/loadavg)
load_int=${load1%%.*}
if (( load_int > nproc_val * 2 )); then
    err "Load average: ${load1} (${nproc_val} cores)"
elif (( load_int > nproc_val )); then
    warn "Load average: ${load1} (${nproc_val} cores)"
else
    ok "Load average: ${load1} (${nproc_val} cores)"
fi
echo ""

# --- Buck2 daemons ---
echo "--- Buck2 Daemons ---"
buck2_daemons=$(ps -eo pid,rss,args 2>/dev/null | grep 'buck2-daemon --isolation-dir' | grep -v grep || true)
if [[ -n "$buck2_daemons" ]]; then
    daemon_count=$(echo "$buck2_daemons" | wc -l)
    total_buck2_mb=$(echo "$buck2_daemons" | awk '{sum += $2} END {print int(sum/1024)}')
    info "${daemon_count} buck2 daemons using ${total_buck2_mb} MB total"

    echo "$buck2_daemons" | while read -r pid rss args; do
        rss_mb=$((rss / 1024))
        iso_dir=$(echo "$args" | sed -n 's/.*--isolation-dir \([^ ]*\).*/\1/p')
        if (( rss > 8388608 )); then
            err "  PID ${pid}: $((rss_mb / 1024)) GB (isolation: ${iso_dir})"
        elif (( rss > 4194304 )); then
            warn "  PID ${pid}: $((rss_mb / 1024)) GB (isolation: ${iso_dir})"
        else
            info "  PID ${pid}: ${rss_mb} MB (isolation: ${iso_dir})"
        fi
    done
else
    ok "No buck2 daemons running"
fi
echo ""

# --- Orphaned editor helpers ---
#
# Language servers and editor extensions exist only to serve an editor, so one
# with no nvim among its ancestors is garbage. Testing `ppid == 1` misses them
# on this box: systemd --user and the Omnigent host daemon are both subreapers,
# so orphans get adopted rather than reparented to init. That gap let 13
# abandoned code-compose-ls processes (~8 GB) sit here while this check happily
# reported "no orphaned Neovim instances".
#
# Buck2's .cpplsp/.pyrelsp daemons are deliberately excluded: they live outside
# the nvim share dir and are designed to outlive any one editor.
echo "--- Orphaned Processes ---"

# Never fails, and yields "" for a pid that has already exited -- important
# under `set -o pipefail`, where a dead pid would otherwise abort the script.
ps_field() {
    ps -o "$1"= -p "$2" 2>/dev/null | tr -d ' ' || true
}

ancestor_has_nvim() {
    local pid=$1 hops=0 parent comm
    while (( hops < 40 )); do
        parent=$(ps_field ppid "$pid")
        if [[ -z "$parent" ]] || (( parent <= 1 )); then
            return 1
        fi
        comm=$(ps_field comm "$parent")
        if [[ "$comm" == "nvim" ]]; then
            return 0
        fi
        pid=$parent
        hops=$((hops + 1))
    done
    return 1
}

# The search path goes through the environment, not argv: passed as `awk -v`, it
# appears in awk's own command line and the process listing matches itself.
nvim_share="${HOME}/.local/share/nvim/"
editor_helpers=$(NVIM_SHARE="$nvim_share" ps -eo pid=,ppid=,rss=,args= 2>/dev/null \
    | NVIM_SHARE="$nvim_share" awk 'index($0, ENVIRON["NVIM_SHARE"]) > 0 || /nvim --embed/ { print }' || true)

orphan_found=false
while read -r pid ppid rss args; do
    if [[ -z "${pid:-}" ]]; then
        continue
    fi
    # Skip anything that exited between the snapshot and now; taking the
    # snapshot itself spawns short-lived children.
    if [[ -z "$(ps_field ppid "$pid")" ]]; then
        continue
    fi
    if ancestor_has_nvim "$pid"; then
        continue
    fi
    orphan_found=true
    parent_comm=$(ps_field comm "$ppid")
    warn "Orphaned editor helper PID ${pid} ($((rss / 1024)) MB, adopted by ${parent_comm:-unknown}): $(echo "$args" | head -c 60)"
    if $FIX_MODE; then
        kill "$pid" 2>/dev/null && fix "Killed orphaned helper ${pid}" || warn "Failed to kill ${pid}"
    fi
done <<< "$editor_helpers"

if ! $orphan_found; then
    ok "No orphaned editor helpers"
fi
echo ""

# --- Stuck Sapling operations ---
echo "--- Stuck Sapling Operations ---"
stuck_sl=$(ps -eo pid,etimes,args 2>/dev/null | grep -E 'hg\.real (diff|status|goto|log)' | grep -v grep | awk '$2 > 300 {print}' || true)
if [[ -n "$stuck_sl" ]]; then
    while read -r pid elapsed args; do
        mins=$((elapsed / 60))
        warn "Stuck sl operation PID ${pid} running for ${mins}m: $(echo "$args" | head -c 80)"
        if $FIX_MODE; then
            kill "$pid" 2>/dev/null && fix "Killed stuck sl operation ${pid}" || warn "Failed to kill ${pid}"
        fi
    done <<< "$stuck_sl"
else
    ok "No stuck Sapling operations"
fi
echo ""

# --- Claude Code sessions ---
echo "--- Claude Code Sessions ---"
# TODO: `grep -c` prints "0" *and* exits 1 when there are no matches, so the
# `|| echo 0` appends a second line and claude_count becomes "0\n0". Both
# arithmetic tests below then fail with "syntax error in expression" on stderr
# and fall through to the else branch. Drop the `|| echo 0`.
claude_count=$(ps -eo args 2>/dev/null | grep -c '^claude$' || echo 0)
if (( claude_count > 3 )); then
    warn "${claude_count} Claude Code sessions running (consider closing unused ones)"
elif (( claude_count > 0 )); then
    info "${claude_count} Claude Code session(s) running"
else
    ok "No Claude Code sessions"
fi
echo ""

# --- htop / top consuming CPU ---
echo "--- Miscellaneous ---"
htop_pids=$(ps -eo pid,pcpu,args 2>/dev/null | awk '/[h]top/ && $2 > 50 {print $1}' || true)
if [[ -n "$htop_pids" ]]; then
    for pid in $htop_pids; do
        warn "htop PID ${pid} consuming excessive CPU"
        if $FIX_MODE; then
            kill "$pid" 2>/dev/null && fix "Killed runaway htop ${pid}" || true
        fi
    done
else
    ok "No runaway monitoring tools"
fi
echo ""

# --- Summary ---
echo "=== Summary ==="
if (( warn_count == 0 )); then
    echo -e "${GREEN}All checks passed.${NC}"
else
    echo -e "${YELLOW}${warn_count} issue(s) found.${NC}"
    if ! $FIX_MODE && (( warn_count > 0 )); then
        echo -e "Run with ${BLUE}--fix${NC} to auto-resolve fixable issues."
    elif (( fix_count > 0 )); then
        echo -e "${GREEN}${fix_count} issue(s) auto-resolved.${NC}"
    fi
fi
