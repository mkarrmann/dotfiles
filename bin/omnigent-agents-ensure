#!/usr/bin/env bash
# omnigent-agents-ensure — reconcile the source-controlled Omnigent agent
# bundles (claude-sdk, codex, and at work dvsc) plus the packaged polly/debby
# overlays into the agent store of the server THIS machine owns, so they show
# up in the CodeCompanion picker with their current tools and prompts. The
# existing model/effort pickers key off each agent's harness family.
#
# Which server that is follows the dotfiles profile:
#   work     the active hub (omnigent-server.service on ~/.omnigent/chat.db).
#            Standbys, peer devservers, and the Mac never open a local chat.db.
#   desktop  the managed local server that omnigent-host.service spawns, on
#            the same ~/.omnigent/chat.db (omnigent/host/local_server.py).
#            dvsc is Meta's devmate over ACP and has no runtime here, so it is
#            not registered.
#
# This is the bundle-reconciliation sibling of omnigent-dvsc-ensure: dvsc needs
# an extra acp: config merge (its harness is acp:dvsc-core), so it keeps its own
# script; agent-store reconciliation happens here for all tracked agents in ONE
# throwaway server boot. Omnigent's ``--agent`` registration is content-aware:
# it preserves the stable agent row and updates its bundle only when the
# materialized content hash changes.
#
# Neither the hub unit nor the managed local server has an `--agent` hook, so —
# exactly like omnigent-dvsc-ensure — we register by briefly booting a
# throwaway server (a free port, the SAME chat.db) with one `--agent` per
# managed bundle; it writes changed builtin bundles in place, then exits.
#
# A running server keeps the old parsed bundle cached, and reads its config
# (bin/omnigent-server-config-stale) only at boot, so after a change it must
# restart -- which this script does only when that disturbs nothing:
#   work     after omnigent-hub's quiescence check (no active turn). Restarting
#            omnigent-server.service leaves the host and its runners alone.
#   desktop  only when no session is connected at all. The server lives inside
#            omnigent-host.service, and restarting that ends every live session.
# Otherwise it prints the restart to run and exits 1.
#
# Idempotent and portable: safe to re-run, and self-skips where omnigent isn't
# installed or this host owns no server. Wired into init.sh on both profiles.
#
# Env overrides: OMNIGENT_BIN, DOTFILES_DIR, OMNIGENT_DATA_DIR,
# OMNIGENT_SERVER_URL.
set -euo pipefail

if [[ $# -ne 0 ]]; then
  echo "usage: omnigent-agents-ensure" >&2
  exit 2
fi

log() { printf '[agents-ensure] %s\n' "$*"; }

DOTFILES="${DOTFILES_DIR:-$HOME/dotfiles}"
OMNIGENT_BIN="${OMNIGENT_BIN:-$HOME/.local/bin/omnigent}"
command -v "$OMNIGENT_BIN" >/dev/null 2>&1 || OMNIGENT_BIN="omnigent"

DATA_DIR="${OMNIGENT_DATA_DIR:-${OMNIGENT_CONFIG_HOME:-$HOME/.omnigent}}"
AGENTS_DIR="$DOTFILES/omnigent_config/agents"

_tools_dir="$(uv tool dir 2>/dev/null || echo "$HOME/.local/share/uv/tools")"
OMNIGENT_PY="${OMNIGENT_PY:-$_tools_dir/omnigent/bin/python3}"

PROFILE="$("$DOTFILES/bin/dotfiles-profile")"

# Skip cleanly on machines without a usable omnigent install.
if ! command -v "$OMNIGENT_BIN" >/dev/null 2>&1; then
  log "omnigent not installed; skipping"
  exit 0
fi
if [ ! -x "$OMNIGENT_PY" ]; then
  log "omnigent tool python not found at $OMNIGENT_PY; skipping"
  exit 0
fi

# Only a Linux host that owns a server database seeds it. A Mac may retain a
# legacy ~/.omnigent/chat.db from the old local deployment, and a personal Mac
# runs the native `omnigent start` lifecycle rather than a systemd unit.
if [[ "$(uname -s)" != "Linux" ]]; then
  log "client host detected; skipping local agent-store seed"
  exit 0
fi
# Source-controlled bundles plus packaged upstream bundles that receive the
# shared personal MCP overlay at registration time.
case "$PROFILE" in
  work)
    if ! "$DOTFILES/bin/omnigent-server-url" --is-hub >/dev/null 2>&1; then
      log "non-active hub/client detected; skipping local agent-store seed"
      exit 0
    fi
    TRACKED_AGENT_NAMES=(claude codex dvsc)
    SERVER_UNIT=omnigent-server.service
    ;;
  desktop)
    TRACKED_AGENT_NAMES=(claude codex)
    SERVER_UNIT=omnigent-host.service
    ;;
  *)
    log "unknown dotfiles profile '$PROFILE'"
    exit 1
    ;;
esac
PACKAGED_AGENT_NAMES=(polly debby)

# `omnigent server status` knows the managed local server (it records a
# pidfile) and the number of sessions connected to it. The HA hub is
# systemd-managed, so there the resolved active-hub URL is authoritative.
managed_status() {
  "$OMNIGENT_BIN" server status --json 2>/dev/null || echo '{}'
}
managed_field() {
  printf '%s' "$1" | python3 -c 'import sys,json
value = (json.load(sys.stdin) or {}).get(sys.argv[1])
print("" if value is None else value)' "$2" 2>/dev/null || true
}
live_server_url() {
  local url
  url="$(managed_field "$(managed_status)" url)"
  if [ -z "$url" ] && [ "$PROFILE" = work ]; then
    url="${OMNIGENT_SERVER_URL:-$("$DOTFILES/bin/omnigent-server-url")}"
  fi
  printf '%s' "$url"
}

# True iff GET <url>/v1/agents exposes the watcher MCP surface for agent "$2".
# The API summary omits individual tool names, but name + transport + command
# distinguishes this bundle from the stale pre-watcher registration.
has_current_agent() {
  local url="$1" name="$2"
  [ -n "$url" ] || return 1
  curl -sf --noproxy '*' --max-time 5 "$url/v1/agents?limit=1000" 2>/dev/null \
    | AGENT_NAME="$name" python3 -c 'import os,sys,json
name=os.environ["AGENT_NAME"]
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(1)
for agent in d.get("data") or []:
    if agent.get("name") != name:
        continue
    for server in agent.get("mcp_servers") or []:
        if (server.get("name") == "watch"
                and server.get("transport") == "stdio"
                and server.get("command") == "omnigent-watch-mcp"):
            sys.exit(0)
sys.exit(1)'
}

# Reconcile every tracked spec, even when its name is already registered.
# Existence alone does not imply that the stored content-addressed bundle is
# current. The Omnigent CLI's registration path performs the hash comparison
# and updates the existing row in place without disturbing session history.
managed_dirs=()
managed_names=()
# Agents whose MCP registration is asserted. Only the specs we author qualify:
# a packaged bundle's inline MCP tool is dropped somewhere in omnigent's own
# spec loading, so polly and debby register with no mcp_servers at all no
# matter what the overlay writes. Reproduced against a copy of the live
# chat.db: claude, codex and dvsc register `watch`; polly and debby register
# `[]`. Asserting it for them wedged this script -- and with it every
# server-config reload -- from 2026-09-09 onward, which is a much worse outcome
# than two packaged agents lacking a tool they never actually had.
verified_names=()
for name in "${TRACKED_AGENT_NAMES[@]}"; do
  spec_dir="$AGENTS_DIR/$name"
  if [ ! -d "$spec_dir" ]; then
    log "agent spec missing at $spec_dir; skipping $name"
    continue
  fi
  managed_dirs+=("$spec_dir")
  managed_names+=("$name")
  verified_names+=("$name")
done

overlay_root="$(mktemp -d "${TMPDIR:-/tmp}/omnigent-agent-overlays.XXXXXX")"
cleanup_overlays() {
  rm -rf -- "$overlay_root"
}
trap cleanup_overlays EXIT
"$OMNIGENT_PY" "$DOTFILES/omnigent_config/materialize_agent_overlays.py" \
  "$overlay_root" "${PACKAGED_AGENT_NAMES[@]}"
for name in "${PACKAGED_AGENT_NAMES[@]}"; do
  managed_dirs+=("$overlay_root/$name")
  managed_names+=("$name")
done

if [ "${#managed_dirs[@]}" -eq 0 ]; then
  log "no tracked agent specs found; skipping"
  exit 0
fi

# Snapshot the durable builtin rows around registration. The API summary is
# intentionally lossy (it does not expose prompts, os_env, policies, etc.), so
# checking for one known MCP server cannot tell whether an arbitrary bundle
# edit reached the live process cache. bundle_location is content-addressed and
# version increments on replacement, making the DB row the authoritative
# change detector on the host that owns this database.
agent_bundle_state() {
  python3 - "$DATA_DIR/chat.db" "${managed_names[@]}" <<'PY'
import sqlite3
import sys

db, *names = sys.argv[1:]
if not names:
    raise SystemExit(0)
placeholders = ",".join("?" for _ in names)
with sqlite3.connect(db) as conn:
    try:
        rows = conn.execute(
            f"SELECT name, version, bundle_location FROM agents "
            f"WHERE kind = 1 AND name IN ({placeholders}) ORDER BY name",
            names,
        )
    except sqlite3.OperationalError as exc:
        if "no such table" in str(exc):
            raise SystemExit(0)
        raise
    for name, version, location in rows:
        print(f"{name}\t{version}\t{location}")
PY
}

bundle_state_before="$(agent_bundle_state)"

log "reconciling builtins (${managed_names[*]}) on a throwaway port…"
db="sqlite:///$DATA_DIR/chat.db"
art="$DATA_DIR/artifacts"
seed_port="$(python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()')"
seed_url="http://127.0.0.1:$seed_port"
seed_log="$(mktemp -t omnigent-agents-seed.XXXXXX.log)"

agent_flags=()
for d in "${managed_dirs[@]}"; do
  agent_flags+=(--agent "$d")
done

"$OMNIGENT_BIN" server \
    "${agent_flags[@]}" \
    --host 127.0.0.1 --port "$seed_port" \
    --database-uri "$db" --artifact-location "$art" \
    >"$seed_log" 2>&1 &
seed_pid=$!

cleanup() {
  kill "$seed_pid" 2>/dev/null || true
  wait "$seed_pid" 2>/dev/null || true
  cleanup_overlays
}
trap cleanup EXIT

# Wait for the seed server to boot and confirm it reconciled every managed agent.
registered=false
for _ in $(seq 1 60); do
  if ! kill -0 "$seed_pid" 2>/dev/null; then
    log "seed server exited early; log follows:"; tail -n 20 "$seed_log" >&2; exit 1
  fi
  all=true
  for name in "${verified_names[@]}"; do
    has_current_agent "$seed_url" "$name" || { all=false; break; }
  done
  if [ "$all" = true ]; then registered=true; break; fi
  sleep 1
done
if [ "$registered" != true ]; then
  log "timed out waiting for seed server to reconcile ${verified_names[*]}; log follows:"
  tail -n 20 "$seed_log" >&2
  exit 1
fi
log "seed server reconciled ${managed_names[*]} into chat.db"

cleanup
trap - EXIT

bundle_state_after="$(agent_bundle_state)"
bundles_changed=false
if [ "$bundle_state_before" != "$bundle_state_after" ]; then
  bundles_changed=true
fi

# On a desktop the unit may be mid-boot (init.sh restarts it just before this
# runs); give the managed server a moment to record itself before concluding
# that nothing is running and skipping the live verification below.
live_url="$(live_server_url)"
if [ -z "$live_url" ] && [ "$PROFILE" = desktop ]; then
  for _ in $(seq 1 30); do
    systemctl --user is-active --quiet "$SERVER_UNIT" 2>/dev/null || break
    sleep 1
    live_url="$(live_server_url)"
    [ -z "$live_url" ] || break
  done
fi

# Existing agent rows can remain stale in the running server's in-memory cache
# after the content-addressed database row is updated. Restart only when that
# happens and only when the restart disturbs nothing (see the header). A fresh
# registration is visible immediately and needs no restart.
#
# The server's OWN config (~/.omnigent/config.yaml + the PYTHONPATH policy
# modules) is read only at boot and is checked here too, via
# omnigent-server-config-stale. It is not covered by the bundle hash above --
# policies leave no trace in chat.db -- so a policy-only edit used to reach the
# disk and never the process.
live_reachable=false
if [ -n "$live_url" ] \
    && curl -sf --noproxy '*' --max-time 5 "$live_url/health" >/dev/null 2>&1; then
  live_reachable=true
fi
if [ "$live_reachable" = true ]; then
  live_current=true
  for name in "${verified_names[@]}"; do
    has_current_agent "$live_url" "$name" || live_current=false
  done
  config_stale=false
  if [ -x "$DOTFILES/bin/omnigent-server-config-stale" ] \
      && "$DOTFILES/bin/omnigent-server-config-stale"; then
    config_stale=true
  fi
  if [ "$bundles_changed" = true ] || [ "$live_current" != true ] \
      || [ "$config_stale" = true ]; then
    if ! systemctl --user is-active --quiet "$SERVER_UNIT"; then
      log "server config/agent bundles updated, but $SERVER_UNIT is not active under systemd; restart the server at $live_url yourself"
      exit 1
    fi
    case "$PROFILE" in
      work)
        if [ ! -x "$DOTFILES/bin/omnigent-hub" ] \
            || ! "$DOTFILES/bin/omnigent-hub" quiesce-check --json >/dev/null; then
          log "server config/agent bundles updated, but the active server is busy; rerun after current turns finish"
          exit 1
        fi
        log "restarting quiescent server to load changed agent bundles and policies…"
        systemctl --user restart "$SERVER_UNIT"
        systemctl --user try-restart omnigent-watcher.service 2>/dev/null || true
        ;;
      desktop)
        connected="$(managed_field "$(managed_status)" live_sessions)"
        if [ "$connected" != 0 ]; then
          log "server config/agent bundles updated, but ${connected:-an unknown number of} session(s) are connected to the local server and restarting $SERVER_UNIT ends every one of them; when they are done, run:"
          log "  systemctl --user restart $SERVER_UNIT"
          exit 1
        fi
        log "restarting the idle local host to load changed agent bundles and policies…"
        systemctl --user restart "$SERVER_UNIT"
        ;;
    esac
  fi

  # A host restart re-spawns the managed server, so resolve the URL afresh
  # each attempt rather than trusting the one recorded before the restart.
  live_current=false
  for _ in $(seq 1 60); do
    live_url="$(live_server_url)"
    all=true
    for name in "${verified_names[@]}"; do
      has_current_agent "$live_url" "$name" || { all=false; break; }
    done
    if [ "$all" = true ]; then live_current=true; break; fi
    sleep 1
  done
  if [ "$live_current" != true ]; then
    log "agent bundles were written to chat.db but the live server still exposes stale definitions"
    exit 1
  fi
  log "${managed_names[*]} agent bundles current ✓ ($live_url)"
else
  log "reconciled ${managed_names[*]} ✓ into chat.db (no server currently running; they'll appear when omnigent starts)"
fi

# Success: drop the seed log. Failure paths above exit before here, leaving it
# in place for debugging.
rm -f "$seed_log"
