# ---------------------------------------------------------------------------
# Turn tracking: Omnigent SSE events -> client-facing turn outputs (pure).
# ---------------------------------------------------------------------------


@dataclass(frozen=True)
class TextDelta:
    text: str


@dataclass(frozen=True)
class ThoughtDelta:
    text: str


@dataclass(frozen=True)
class ToolStarted:
    call_id: str
    name: str
    arguments: Any


@dataclass(frozen=True)
class ToolFinished:
    call_id: str
    output: str


@dataclass(frozen=True)
class Usage:
    used: int
    size: int


@dataclass(frozen=True)
class Elicitation:
    elicitation_id: str
    message: str
    target_session_id: str | None
    preview: str | None = None


@dataclass(frozen=True)
class TurnEnded:
    outcome: Literal["completed", "cancelled", "failed"]
    error: str | None = None


@dataclass(frozen=True)
class Quiescent:
    """The turn looks finished but is unconfirmed; it ends if ``generation`` survives a quiet period."""

    generation: int


TurnOutput = TextDelta | ThoughtDelta | ToolStarted | ToolFinished | Usage | Elicitation | TurnEnded | Quiescent


def _is_native_ack(response: dict[str, Any]) -> bool:
    model = response.get("model")
    return isinstance(model, str) and model.endswith("-native-ui") and response.get("usage") is None


def _message_text(item: dict[str, Any]) -> str:
    content = item.get("content")
    if not isinstance(content, list):
        return ""
    return "".join(c["text"] for c in content if isinstance(c, dict) and isinstance(c.get("text"), str))


def _command_preview(preview: Any) -> str | None:
    """The command a policy asks about; its preview is the serialized tool call when it fits."""
    if not isinstance(preview, str):
        return None
    try:
        call = json.loads(preview)
    except json.JSONDecodeError:
        return preview
    arguments = call.get("arguments") if isinstance(call, dict) else None
    command = arguments.get("command") if isinstance(arguments, dict) else None
    return command if isinstance(command, str) else preview


def elicitation_from(data: dict[str, Any]) -> Elicitation:
    params = data.get("params") or {}
    return Elicitation(
        elicitation_id=str(data.get("elicitation_id")),
        message=str(params.get("message") or "Omnigent requests approval"),
        target_session_id=params.get("target_session_id"),
        preview=_command_preview(params.get("content_preview")),
    )


def _is_reply(item: dict[str, Any]) -> bool:
    return item.get("type") == "message" and item.get("role") == "assistant" and not item.get("is_meta")


def _error_text(error: Any) -> str:
    if isinstance(error, dict):
        return str(error.get("message") or error.get("code") or json.dumps(error))
    return str(error) if error else "Omnigent turn failed"


@dataclass
class TurnTracker:
    """Follows one foreground turn on an Omnigent session stream.

    Terminal-backed (``*-native-ui``) agents answer the POST with an empty
    ``response.completed`` acknowledgement; the real turn starts after
    ``session.input.consumed`` and ends at the ``session.status: idle`` that
    carries a ``response_id`` or a ``background_task_count`` — the
    harness-confirmed completion (claude-native's Stop hook). Bare idles come
    from the pane-activity watcher and can fire mid-turn. The confirmed edge is
    not guaranteed to reach the stream, so a turn whose final assistant message
    is committed, with no tool call open and the pane idle, is reported
    ``Quiescent`` and ended by the caller once a quiet period passes without
    any event, terminal activity pulses included. SDK agents end at
    ``response.completed``. Adapted from CodeCompanion's omnigent/events.lua
    reducer.
    """

    native: bool = False
    expected_pending_id: str | None = None
    expected_item_id: str | None = None
    current_response_id: str | None = None
    queue_response: bool = False
    native_consumed: bool = False
    cancelling: bool = False
    message_streamed: bool = False
    emitted_text: str = ""
    replay_text: str | None = None
    seen_calls: set[str] = field(default_factory=set)
    seen_outputs: set[str] = field(default_factory=set)
    open_calls: set[str] = field(default_factory=set)
    pane_idle: bool = False
    reply_committed: bool = False
    quiet_generation: int = 0
    ended: bool = False

    @property
    def quiescent(self) -> bool:
        return self.native_consumed and self.reply_committed and self.pane_idle and not self.open_calls

    def _activity(self) -> None:
        self.quiet_generation += 1

    def expect_input(self, pending_id: str | None, item_id: str | None = None) -> None:
        self.expected_pending_id = pending_id
        self.expected_item_id = item_id

    def on_reconnect(self) -> None:
        # The server replays the in-flight assistant text on subscribe.
        self.replay_text = ""

    def request_cancel(self) -> None:
        self.cancelling = True

    def _awaiting_native_input(self) -> bool:
        # Items that arrive before our input is consumed belong to an earlier turn.
        return self.native and not self.native_consumed

    def _end(self, outcome: Literal["completed", "cancelled", "failed"], error: str | None = None) -> list[TurnOutput]:
        if self.ended:
            return []
        self.ended = True
        return [TurnEnded(outcome, error)]

    def _text_delta(self, delta: str) -> list[TurnOutput]:
        self.message_streamed = True
        if self.replay_text is not None:
            self.replay_text += delta
            if len(self.replay_text) <= len(self.emitted_text):
                return []
            delta = self.replay_text[len(self.emitted_text) :]
            self.replay_text = None
        self.emitted_text += delta
        return [TextDelta(delta)] if delta else []

    def _observe(self, outputs: list[TurnOutput], was_quiescent: bool) -> list[TurnOutput]:
        if self.quiescent and not was_quiescent and not self.ended:
            outputs.append(Quiescent(self.quiet_generation))
        return outputs

    def feed(self, event_type: str, data: dict[str, Any]) -> list[TurnOutput]:
        if self.ended or event_type in IGNORED_EVENTS:
            return []
        was_quiescent = self.quiescent
        return self._observe(self._feed(event_type, data), was_quiescent)

    def on_snapshot(self, snapshot: dict[str, Any]) -> list[TurnOutput]:
        """Catch up from a ``GET /v1/sessions/{id}`` snapshot taken after our input was posted."""
        if self.ended:
            return []
        was_quiescent = self.quiescent
        return self._observe(self._snapshot(snapshot), was_quiescent)

    def _snapshot(self, snapshot: dict[str, Any]) -> list[TurnOutput]:
        status = snapshot.get("status")
        items = [i for i in snapshot.get("items") or [] if isinstance(i, dict)]
        if self.native:
            if not self.native_consumed:
                pending = {p.get("pending_id") for p in snapshot.get("pending_inputs") or [] if isinstance(p, dict)}
                if self.expected_pending_id is None or self.expected_pending_id in pending:
                    return []
                self.native_consumed = True
                self.expected_pending_id = None
            if status == "failed":
                return self._end("failed", _error_text(snapshot.get("last_task_error")))
            # The confirmed idle's response_id is not in the snapshot, so a finished turn ends by quiescence.
            self.pane_idle = status == "idle"
            if self.pane_idle and items and _is_reply(items[-1]):
                self.reply_committed = True
                self.open_calls.clear()
            return []
        ours = next((n for n, i in enumerate(items) if self.expected_item_id and i.get("id") == self.expected_item_id), None)
        # A status from before our turn started would be the previous turn's.
        if self.current_response_id is None and (ours is None or ours + 1 == len(items)):
            return []
        if status == "failed":
            return self._end("failed", _error_text(snapshot.get("last_task_error")))
        if status == "idle":
            return self._end("completed")
        return []

    def _feed(self, event_type: str, data: dict[str, Any]) -> list[TurnOutput]:
        if event_type in ("response.created", "response.in_progress"):
            response = data.get("response") or {}
            model = response.get("model")
            self.queue_response = isinstance(model, str) and model.endswith("-native-ui")
            if response.get("id") != self.current_response_id:
                self.current_response_id = response.get("id")
                self.seen_calls.clear()
                self.seen_outputs.clear()
            return []

        if event_type in (
            "response.output_text.delta",
            "response.reasoning_text.delta",
            "response.reasoning_summary_text.delta",
            "response.output_item.done",
        ) and self._awaiting_native_input():
            return []

        if event_type == "response.output_text.delta":
            self.reply_committed = False
            self._activity()
            return self._text_delta(data.get("delta") or "")

        if event_type in ("response.reasoning_text.delta", "response.reasoning_summary_text.delta"):
            self.reply_committed = False
            self._activity()
            delta = data.get("delta") or ""
            return [ThoughtDelta(delta)] if delta else []

        if event_type == "response.output_item.done":
            self._activity()
            return self._item_done(data.get("item") or {})

        if event_type == "response.completed":
            response = data.get("response") or {}
            if _is_native_ack(response) or self._awaiting_native_input():
                self.queue_response = False
                self.current_response_id = None
                return []
            return self._usage(response.get("usage")) + self._end("completed")

        if event_type == "response.failed":
            return self._end("failed", _error_text((data.get("response") or {}).get("error")))

        if event_type in ("response.cancelled", "session.interrupted"):
            # codex-native reports one Stop twice; the echo can land after the next turn starts.
            if self._awaiting_native_input() and not self.cancelling:
                return []
            return self._end("cancelled")

        if event_type == "session.terminal.activity":
            # Claude redraws its busy line while it thinks, so a pulse means the turn may still be running.
            self._activity()
            return []

        if event_type == "session.status":
            status = data.get("status")
            if status == "failed":
                return self._end("failed", _error_text(data.get("error")))
            self.pane_idle = status == "idle"
            if status != "idle":
                self._activity()
                return []
            if self.cancelling:
                return self._end("cancelled")
            if self.native:
                # Only harness-confirmed edges carry a response id or a background-task count (Stop hook).
                confirmed = data.get("response_id") or data.get("background_task_count") is not None
                if self.native_consumed and confirmed:
                    return self._end("completed")
                return []
            if self.current_response_id and not self.queue_response:
                return self._end("completed")
            return []

        if event_type == "session.input.consumed":
            consumed = data.get("data") or {}
            matches = (
                self.expected_pending_id is None or consumed.get("cleared_pending_id") == self.expected_pending_id
            )
            if self.native and not self.native_consumed and matches:
                self.native_consumed = True
                self.expected_pending_id = None
            return []

        if event_type == "session.usage":
            return self._usage(data)

        if event_type == "response.elicitation_request":
            return [elicitation_from(data)]

        LOG.debug("unhandled event %s", event_type)
        return []

    def _item_done(self, item: dict[str, Any]) -> list[TurnOutput]:
        item_type = item.get("type")
        if _is_reply(item):
            streamed = self.message_streamed
            self.message_streamed = False
            self.emitted_text = ""
            self.replay_text = None
            self.reply_committed = True
            text = _message_text(item)
            return [] if streamed or not text else [TextDelta(text)]
        if item_type == "function_call" and isinstance(item.get("call_id"), str):
            if item["call_id"] in self.seen_calls:
                return []
            self.seen_calls.add(item["call_id"])
            self.open_calls.add(item["call_id"])
            self.reply_committed = False
            arguments: Any = item.get("arguments")
            if isinstance(arguments, str):
                try:
                    arguments = json.loads(arguments)
                except json.JSONDecodeError:
                    pass
            return [ToolStarted(item["call_id"], str(item.get("name") or "tool"), arguments)]
        if item_type == "function_call_output" and isinstance(item.get("call_id"), str):
            key = f"{item.get('response_id') or self.current_response_id}:{item['call_id']}"
            if key in self.seen_outputs:
                return []
            self.seen_outputs.add(key)
            self.open_calls.discard(item["call_id"])
            output = item.get("output")
            text = output if isinstance(output, str) else json.dumps(output)
            return [ToolFinished(item["call_id"], text)]
        LOG.debug("unhandled item type %s", item_type)
        return []

    def _usage(self, usage: Any) -> list[TurnOutput]:
        if not isinstance(usage, dict):
            return []
        used = usage.get("context_tokens")
        size = usage.get("context_window")
        if isinstance(used, int) and isinstance(size, int) and size > 0:
            return [Usage(used, size)]
        return []


# ---------------------------------------------------------------------------
# Prompt rewriting.
# ---------------------------------------------------------------------------

_T3_WRAPPED = re.compile(
    r"\A\s*<t3_code_instructions>\n(?P<instructions>.*?)\n</t3_code_instructions>\n\n"
    r"<user_request>\n(?P<request>.*)\n</user_request>\s*\Z",
    re.DOTALL,
)
_T3_MODE_SECTION = re.compile(
    r"## T3 Code interaction mode: (?P<mode>Default|Plan)\n\n.*?(?=\n\n## |\Z)", re.DOTALL
)

T3Mode = Literal["default", "plan"]


@dataclass(frozen=True)
class RewrittenPrompt:
    text: str
    announced_mode: T3Mode | None
    """The interaction mode T3 Code announced in this prompt, if any."""


def strip_t3_instructions(blocks: list[str], *, agent_mode: T3Mode | None) -> RewrittenPrompt:
    """Reduce T3 Code's ACP prompt to what the user asked.

    HACK: T3 Code has no system-prompt channel over ACP, so it wraps prompts in
    ``<t3_code_instructions>`` (its MCP tools, which an Omnigent agent cannot
    reach) and appends a ``<runtime_info>`` block (packages/provider-core/src/
    server/orchestrationInstructions.ts, runtimeInstructions.ts). Matching its
    tag names is the only hook. The interaction-mode section is how T3 Code
    switches Plan on and off, so it is forwarded when it differs from
    ``agent_mode`` (the mode the agent was last told); ``None`` means the mode
    is applied natively and the section is always dropped.
    """
    parts: list[str] = []
    announced: T3Mode | None = None
    for text in blocks:
        if text.lstrip().startswith("<runtime_info>"):
            continue
        wrapped = _T3_WRAPPED.match(text)
        if wrapped is None:
            parts.append(text)
            continue
        section = _T3_MODE_SECTION.search(wrapped["instructions"])
        if section is None:
            parts.append(wrapped["request"])
            continue
        announced = "plan" if section["mode"] == "Plan" else "default"
        forward = agent_mode is not None and announced != agent_mode
        parts.append(f"{section[0]}\n\n{wrapped['request']}" if forward else wrapped["request"])
    return RewrittenPrompt("\n\n".join(parts), announced)


_FORK_INVOCATION = re.compile(rf"\A\s*/{re.escape(FORK_COMMAND)}(?:\s+(?P<args>.*?))?\s*\Z", re.DOTALL)


def fork_invocation(text: str) -> list[str] | None:
    """The arguments of a ``/fork-to`` prompt, or ``None`` when the prompt is anything else."""
    match = _FORK_INVOCATION.match(text)
    return None if match is None else (match["args"] or "").split()


def fork_workspace(checkout: str | None, cwd: str, home: str | None) -> str:
    """Where a fork runs: ``checkout`` (default: the basename of ``cwd``) under the target's home.

    Without a known home the fork assumes the target lays its checkouts out as this machine does.
    """
    name = checkout or os.path.basename(os.path.normpath(cwd))
    if os.path.isabs(name):
        return os.path.normpath(name)
    base = home or os.path.dirname(os.path.normpath(cwd))
    return os.path.normpath(os.path.join(base, name.removeprefix("~/")))


# ---------------------------------------------------------------------------
# Omnigent REST + SSE.
# ---------------------------------------------------------------------------


class OmnigentError(Exception):
    def __init__(self, message: str, status: int | None = None) -> None:
        super().__init__(message)
        self.status = status
        """The HTTP status Omnigent answered with, if it answered."""

    @property
    def gone(self) -> bool:
        return self.status in (404, 410)


class OmnigentClient:
    def __init__(self, base_url: str, transport: httpx.AsyncBaseTransport | None = None) -> None:
        # trust_env=False: loopback must bypass the corp proxy.
        self._http = httpx.AsyncClient(
            base_url=base_url, trust_env=False, timeout=httpx.Timeout(30.0), transport=transport
        )

    async def _json(self, method: str, path: str, **kwargs: Any) -> Any:
        response = await self._http.request(method, path, **kwargs)
        if response.is_error:
            raise OmnigentError(f"{method} {path} -> {response.status_code}: {response.text[:500]}", response.status_code)
        return response.json() if response.content else None

    async def _paginate(
        self, path: str, params: dict[str, Any] | None = None, *, page_size: int = 100
    ) -> AsyncIterator[dict[str, Any]]:
        after: str | None = None
        while True:
            page = await self._json(
                "GET", path, params={**(params or {}), "limit": page_size, **({"after": after} if after else {})}
            )
            for row in page.get("data", []):
                yield row
            after = next_cursor(page, after)
            if after is None:
                return

    async def agents(self) -> list[dict[str, Any]]:
        return [a async for a in self._paginate("/v1/agents")]

    async def hosts(self) -> list[dict[str, Any]]:
        body = await self._json("GET", "/v1/hosts")
        return body.get("hosts") or body.get("data") or []

    async def model_options(self, host_id: str, harness: str) -> list[dict[str, Any]]:
        body = await self._json("GET", f"/v1/hosts/{host_id}/harnesses/{harness}/model-options")
        return [m for m in body.get("models") or [] if not m.get("hidden")]

    async def session(self, session_id: str) -> dict[str, Any]:
        return await self._json("GET", f"/v1/sessions/{session_id}")

    async def session_snapshot(self, session_id: str, *, items: bool) -> dict[str, Any]:
        params = {"include_items": str(items).lower(), "include_liveness": "false", "include_usage": "false"}
        return await self._json("GET", f"/v1/sessions/{session_id}", params=params)

    async def session_page(self, params: dict[str, Any]) -> dict[str, Any]:
        return await self._json("GET", "/v1/sessions", params=params)

    async def find_session_by_label(self, agent_id: str, key: str, value: str) -> dict[str, Any] | None:
        """The agent's session labelled ``key=value`` among its ``LABEL_SCAN_LIMIT`` most recently updated.

        ``GET /v1/sessions`` has no label filter, so this scans; a thread being
        loaded was almost always active recently.
        """
        params = {"agent_id": agent_id, "include_archived": "true", "sort_by": "updated_at"}
        scanned = 0
        async for session in self._paginate("/v1/sessions", params, page_size=LABEL_SCAN_PAGE):
            labels = session.get("labels") or {}
            if labels.get(key) == value and FORK_SOURCE_LABEL not in labels:
                return session
            scanned += 1
            if scanned >= LABEL_SCAN_LIMIT:
                break
        return None

    async def create_session(self, body: dict[str, Any]) -> dict[str, Any]:
        return await self._json("POST", "/v1/sessions", json=body)

    async def session_items(self, session_id: str) -> AsyncIterator[dict[str, Any]]:
        async for item in self._paginate(f"/v1/sessions/{session_id}/items", {"order": "asc"}, page_size=1000):
            yield item

    async def fork_session(self, session_id: str, body: dict[str, Any]) -> dict[str, Any]:
        return await self._json("POST", f"/v1/sessions/{session_id}/fork", json=body)

    async def launch_runner(self, host_id: str, session_id: str, workspace: str) -> dict[str, Any]:
        return await self._json(
            "POST", f"/v1/hosts/{host_id}/runners", json={"session_id": session_id, "workspace": workspace}
        )

    async def host_home(self, host_id: str) -> str | None:
        """The host daemon's home directory, read off an entry of its listing; ``None`` when it is empty."""
        body = await self._json("GET", f"/v1/hosts/{host_id}/filesystem", params={"limit": 1})
        entries = [e for e in body.get("data") or [] if isinstance(e, dict) and isinstance(e.get("path"), str)]
        return os.path.dirname(entries[0]["path"]) if entries else None

    async def update_session(self, session_id: str, body: dict[str, Any]) -> None:
        await self._json("PATCH", f"/v1/sessions/{session_id}", json=body)

    async def post_event(self, session_id: str, event: dict[str, Any]) -> dict[str, Any]:
        return await self._json("POST", f"/v1/sessions/{session_id}/events", json=event) or {}

    async def resolve_elicitation(self, session_id: str, elicitation_id: str, action: str) -> None:
        await self._json(
            "POST", f"/v1/sessions/{session_id}/elicitations/{elicitation_id}/resolve", json={"action": action}
        )

    async def stream(self, session_id: str, connected: asyncio.Event) -> AsyncIterator[tuple[str, dict[str, Any]]]:
        timeout = httpx.Timeout(30.0, read=60.0)  # the server heartbeats every 15s
        async with self._http.stream("GET", f"/v1/sessions/{session_id}/stream", timeout=timeout) as response:
            if response.is_error:
                await response.aread()
                raise OmnigentError(
                    f"stream {session_id} -> {response.status_code}: {response.text[:500]}", response.status_code
                )
            connected.set()
            yield STREAM_OPENED, {}
            event_type: str | None = None
            data_lines: list[str] = []
            async for line in response.aiter_lines():
                if line.startswith("event:"):
                    event_type = line[6:].strip()
                elif line.startswith("data:"):
                    data_lines.append(line[5:].lstrip())
                elif not line and data_lines:
                    raw = "\n".join(data_lines)
                    data_lines = []
                    if raw == "[DONE]":
                        return
                    try:
                        payload = json.loads(raw)
                    except json.JSONDecodeError:
                        continue
                    if isinstance(payload, dict):
                        yield str(event_type or payload.get("type") or ""), payload
                    event_type = None

    async def aclose(self) -> None:
        await self._http.aclose()


def next_cursor(page: dict[str, Any], after: str | None) -> str | None:
    """The cursor for the page after ``page``, or ``None`` at the end or when the server makes no progress."""
    last = page.get("last_id")
    if not page.get("has_more") or not isinstance(last, str) or not last or last == after:
        return None
    return last


def host_matches(name: str, hostnames: set[str]) -> bool:
    name = name.lower()
    return name in hostnames or name.split(".")[0] in {h.split(".")[0] for h in hostnames}


def resolve_host(hosts: list[dict[str, Any]], spec: str) -> dict[str, Any]:
    online = [h for h in hosts if h.get("status") == "online"]
    if spec == "auto":
        local = {socket.getfqdn().lower(), socket.gethostname().lower()}
        matches = [h for h in online if host_matches(str(h.get("name") or ""), local)]
    else:
        lowered = spec.lower()
        matches = (
            [h for h in online if spec in (h.get("host_id"), h.get("name"))]
            or [h for h in online if host_matches(str(h.get("name") or ""), {lowered})]
            or [h for h in online if str(h.get("name") or "").lower().startswith(lowered)]
        )
    if len(matches) != 1:
        names = sorted(str(h.get("name")) for h in (matches or online)) or "none"
        found = "matched" if matches else "online hosts are"
        raise OmnigentError(f"host {spec!r} must match exactly one online Omnigent host; {found} {names}")
    return matches[0]


def resolve_agent(agents: list[dict[str, Any]], spec: str) -> dict[str, Any]:
    for agent in agents:
        if agent.get("id") == spec:
            return agent
    named = [a for a in agents if a.get("name") == spec]
    if len(named) != 1:
        raise OmnigentError(f"--agent {spec!r} matched {len(named)} Omnigent agents")
    return named[0]


# ---------------------------------------------------------------------------
# ACP agent.
# ---------------------------------------------------------------------------


@dataclass
class Turn:
    tracker: TurnTracker
    outputs: asyncio.Queue[TurnOutput] = field(default_factory=asyncio.Queue)
    cancelled: asyncio.Event = field(default_factory=asyncio.Event)
    posted: bool = False
    """Our message reached Omnigent; only then is there an Omnigent turn to interrupt."""

    @property
    def cancel_requested(self) -> bool:
        return self.cancelled.is_set()


@dataclass
class Session:
    acp_id: str
    cwd: str
    model: str | None
    effort: str | None = None
    mode: T3Mode = "default"
    told_mode: T3Mode = "default"
    mcp_servers: list[Any] = field(default_factory=list)
    conversation_id: str | None = None
    turn: Turn | None = None
    connected: asyncio.Event = field(default_factory=asyncio.Event)
    stream_task: asyncio.Task[None] | None = None
    gone: str | None = None
    """Why the Omnigent session can no longer be streamed (deleted), once it cannot."""
    elicitations: set[str] = field(default_factory=set)
    background: set[asyncio.Task[None]] = field(default_factory=set)
    tool_diffs: dict[str, list[FileEditToolCallContent]] = field(default_factory=dict)


@dataclass(frozen=True)
class Target:
    agent_id: str
    host_id: str
    harness: str
    models: list[dict[str, Any]]

    @property
    def native(self) -> bool:
        return self.harness.endswith("-native")

    @property
    def native_plan(self) -> bool:
        # claude-native's plan permission mode is not used: Omnigent cannot switch
        # back to bypassPermissions after launch, so leaving Plan would downgrade it.
        return self.harness == "codex-native"

    @property
    def default_model(self) -> str | None:
        default = next((m for m in self.models if m.get("isDefault")), self.models[0] if self.models else None)
        return default.get("id") if default else None

    @property
    def efforts(self) -> tuple[str, ...]:
        offered = {
            e["reasoningEffort"]
            for m in self.models
            for e in m.get("supportedReasoningEfforts") or []
            if isinstance(e, dict) and isinstance(e.get("reasoningEffort"), str)
        }
        if not offered and self.harness.startswith("claude"):
            offered = set(CLAUDE_EFFORTS)
        return tuple(e for e in EFFORT_ORDER if e in offered)


def _tool_kind(name: str) -> str:
    lowered = name.lower()
    if lowered in ("bash", "shell", "exec_command", "sys_os_shell") or "command" in lowered:
        return "execute"
    if lowered in ("edit", "write", "multiedit", "apply_patch", "notebookedit", "sys_os_edit", "sys_os_write"):
        return "edit"
    if lowered in ("read", "sys_os_read", "view"):
        return "read"
    if lowered in ("grep", "glob", "search", "find"):
        return "search"
    if lowered in ("webfetch", "websearch", "fetch"):
        return "fetch"
    return "other"


def same_dir(a: str, b: str) -> bool:
    """Whether two paths name one directory, regardless of trailing slashes or symlinks on this machine."""
    return os.path.normpath(a) == os.path.normpath(b) or os.path.realpath(a) == os.path.realpath(b)


def _absolute(path: str, cwd: str) -> str:
    return os.path.normpath(os.path.join(cwd, path))


def _unified_hunks(diff: str) -> list[tuple[str, str]]:
    """Each hunk of a unified diff as its (old, new) snippet."""
    hunks: list[tuple[list[str], list[str]]] = []
    for line in diff.splitlines(keepends=True):
        if line.startswith("@@"):
            hunks.append(([], []))
            continue
        if not hunks or line.startswith("\\"):
            continue
        tag, text = (" ", line) if line in ("\n", "\r\n") else (line[:1], line[1:])
        old, new = hunks[-1]
        if tag in (" ", "-"):
            old.append(text)
        if tag in (" ", "+"):
            new.append(text)
    return [("".join(old), "".join(new)) for old, new in hunks]


def _codex_change_diffs(change: dict[str, Any], cwd: str) -> list[FileEditToolCallContent]:
    # codex-native's fileChange: add/delete carry the file's content, update a unified diff.
    path, diff, kind = change.get("path"), change.get("diff"), change.get("kind")
    if not isinstance(path, str) or not isinstance(diff, str) or not isinstance(kind, dict):
        return []
    moved = kind.get("move_path") or kind.get("movePath")
    path = _absolute(moved if isinstance(moved, str) else path, cwd)
    match kind.get("type"):
        case "add":
            return [acp.tool_diff_content(path, diff)]
        case "delete":
            return [acp.tool_diff_content(path, "", diff)]
        case _:
            return [acp.tool_diff_content(path, new, old) for old, new in _unified_hunks(diff)]


def edit_diffs(name: str, arguments: Any, cwd: str) -> list[FileEditToolCallContent]:
    """ACP diff content for a file-editing tool call; relative paths resolve against ``cwd``."""
    if not isinstance(arguments, dict):
        return []
    lowered = name.lower()
    if lowered == "apply_patch":
        changes = arguments.get("changes")
        return [d for c in changes if isinstance(c, dict) for d in _codex_change_diffs(c, cwd)] if isinstance(changes, list) else []
    file_path = arguments.get("file_path")
    if not isinstance(file_path, str):
        return []
    path = _absolute(file_path, cwd)
    if lowered == "write":
        content = arguments.get("content")
        return [acp.tool_diff_content(path, content)] if isinstance(content, str) else []
    edits = arguments.get("edits") if lowered == "multiedit" else [arguments] if lowered == "edit" else None
    return [
        acp.tool_diff_content(path, edit["new_string"], edit["old_string"])
        for edit in (edits if isinstance(edits, list) else [])
        if isinstance(edit, dict) and isinstance(edit.get("old_string"), str) and isinstance(edit.get("new_string"), str)
    ]


COMMANDS = [
    AvailableCommand(
        name=FORK_COMMAND,
        description="Fork this session onto another Omnigent host, in CHECKOUT (default: this checkout's name) there",
        input=AvailableCommandInput(root=UnstructuredCommandInput(hint=FORK_HINT)),
    )
]


def history_updates(items: list[dict[str, Any]], cwd: str) -> list[Any]:
    """``session/load``'s replay of an Omnigent transcript: its messages and tool calls."""
    outputs = {
        item["call_id"]: item.get("output")
        for item in items
        if item.get("type") == "function_call_output" and isinstance(item.get("call_id"), str)
    }
    updates: list[Any] = []
    seen: set[str] = set()
    for item in items:
        if item.get("type") == "message" and not item.get("is_meta"):
            text = _message_text(item)
            if text and item.get("role") == "user":
                updates.append(acp.update_user_message_text(text))
            elif text and item.get("role") == "assistant":
                updates.append(acp.update_agent_message_text(text))
        elif item.get("type") == "function_call" and isinstance(item.get("call_id"), str) and item["call_id"] not in seen:
            call_id = item["call_id"]
            seen.add(call_id)
            name = str(item.get("name") or "tool")
            arguments: Any = item.get("arguments")
            if isinstance(arguments, str):
                try:
                    arguments = json.loads(arguments)
                except json.JSONDecodeError:
                    pass
            content: list[Any] = list(edit_diffs(name, arguments, cwd))
            done = call_id in outputs
            if done:
                output = outputs[call_id]
                text = output if isinstance(output, str) else json.dumps(output)
                content.append(acp.tool_content(acp.text_block(text[:TOOL_OUTPUT_LIMIT])))
            updates.append(
                acp.start_tool_call(
                    call_id,
                    name,
                    kind=_tool_kind(name),
                    status="completed" if done else "in_progress",
                    content=content or None,
                    raw_input=arguments,
                )
            )
    return updates


def mcp_launch_args(servers: list[Any]) -> list[str]:
    """Claude Code ``--mcp-config`` for the client's stdio MCP servers (T3 Code's tools)."""
    config = {
        server.name: {
            "type": "stdio",
            "command": server.command,
            "args": list(server.args),
            "env": {env.name: env.value for env in server.env},
        }
        for server in servers
        if isinstance(getattr(server, "command", None), str)
    }
    return ["--mcp-config", json.dumps({"mcpServers": config}, separators=(",", ":"))] if config else []


def _iso(epoch: Any) -> str | None:
    return datetime.fromtimestamp(epoch, UTC).isoformat() if isinstance(epoch, int | float) else None


class OmnigentAgent:
    def __init__(
        self, client: OmnigentClient, agent_spec: str, host_spec: str, *, strip: bool, t3_tools: bool, trace: Any
    ) -> None:
        self._client = client
        self._agent_spec = agent_spec
        self._host_spec = host_spec
        self._strip = strip
        self._t3_tools = t3_tools
        self._trace = trace
        self._target: Target | None = None
        self._sessions: dict[str, Session] = {}
        self._conn: Any = None

    def on_connect(self, conn: Any) -> None:
        self._conn = conn

    async def _resolve_target(self) -> Target:
        if self._target is None:
            agent = resolve_agent(await self._client.agents(), self._agent_spec)
            host = resolve_host(await self._client.hosts(), self._host_spec)
            harness = str(agent.get("harness"))
            catalog = CATALOG_HARNESS.get(harness)
            models = await self._client.model_options(host["host_id"], catalog) if catalog else []
            self._target = Target(agent["id"], host["host_id"], harness, models)
        return self._target

    def _config_options(self, session: Session, target: Target) -> list[SessionConfigOptionSelect]:
        options: list[SessionConfigOptionSelect] = []
        if target.models:
            options.append(
                SessionConfigOptionSelect(
                    id=MODEL_CONFIG_ID,
                    name="Model",
                    category="model",
                    type="select",
                    current_value=session.model or target.default_model or "",
                    options=[
                        SessionConfigSelectOption(value=m["id"], name=m.get("displayName") or m["id"])
                        for m in target.models
                    ],
                )
            )
        if target.efforts:
            # T3 Code v0.1.6 recognizes reasoning controls by id, newer versions by category.
            options.append(
                SessionConfigOptionSelect(
                    id=EFFORT_CONFIG_ID,
                    name="Effort",
                    category="thought_level",
                    type="select",
                    current_value=session.effort or EFFORT_DEFAULT,
                    options=[SessionConfigSelectOption(value=EFFORT_DEFAULT, name="Default")]
                    + [SessionConfigSelectOption(value=e, name=e.capitalize()) for e in target.efforts],
                )
            )
        return options

    def _modes(self, session: Session, target: Target) -> SessionModeState | None:
        if not target.native_plan:
            return None
        return SessionModeState(
            current_mode_id=session.mode,
            available_modes=[SessionMode(id="default", name="Default"), SessionMode(id="plan", name="Plan")],
        )

    def _session(self, session_id: str) -> Session:
        session = self._sessions.get(session_id)
        if session is None:
            raise acp.RequestError.invalid_params({"sessionId": f"unknown session {session_id}"})
        return session

    def _passes_t3_tools(self, target: Target) -> bool:
        return self._t3_tools and target.harness == "claude-native"

    async def initialize(self, protocol_version: int, **kwargs: Any) -> acp.InitializeResponse:
        return acp.InitializeResponse(
            protocol_version=acp.PROTOCOL_VERSION,
            agent_capabilities=AgentCapabilities(
                load_session=True,
                prompt_capabilities=PromptCapabilities(image=False),
                session_capabilities=SessionCapabilities(
                    close=SessionCloseCapabilities(), list=SessionListCapabilities()
                ),
            ),
            auth_methods=[],
            agent_info=Implementation(name="omnigent-acp", title="Omnigent", version="0.2.0"),
        )

    async def new_session(self, cwd: str, mcp_servers: list[Any] | None = None, **kwargs: Any) -> acp.NewSessionResponse:
        target = await self._resolve_target()
        session = Session(acp_id=uuid.uuid4().hex, cwd=cwd, model=target.default_model, mcp_servers=mcp_servers or [])
        self._sessions[session.acp_id] = session
        self._advertise_commands(session)
        return acp.NewSessionResponse(
            session_id=session.acp_id,
            config_options=self._config_options(session, target),
            modes=self._modes(session, target),
        )

    async def load_session(
        self, cwd: str, session_id: str, mcp_servers: list[Any] | None = None, **kwargs: Any
    ) -> acp.LoadSessionResponse:
        target = await self._resolve_target()
        if session_id.startswith(IMPORTED_PREFIX):
            conversation_id = session_id.removeprefix(IMPORTED_PREFIX)
        else:
            found = await self._client.find_session_by_label(target.agent_id, SESSION_LABEL, session_id)
            if found is None:
                raise acp.RequestError.resource_not_found(session_id)
            conversation_id = str(found["id"])
        try:
            details = await self._client.session_snapshot(conversation_id, items=False)
            # Read in full first: T3 Code ends a load whose replay pauses for 2s, and takes later chunks as turn output.
            history = [item async for item in self._client.session_items(conversation_id)]
        except OmnigentError as exc:
            if exc.gone:
                raise acp.RequestError.resource_not_found(session_id) from None
            raise
        session = self._sessions.get(session_id) or Session(acp_id=session_id, cwd=cwd, model=target.default_model)
        session.mcp_servers = mcp_servers or []
        session.conversation_id = conversation_id
        session.model = details.get("model_override") or session.model
        session.effort = details.get("reasoning_effort") or session.effort
        labels = details.get("labels") or {}
        if labels.get(CODEX_COLLABORATION_LABEL) == "plan":
            session.mode = "plan"
        launch_args = mcp_launch_args(session.mcp_servers)
        if self._passes_t3_tools(target) and launch_args:
            # The bridge token is per load; a running TUI keeps its launch-time token.
            await self._client.update_session(conversation_id, {"terminal_launch_args": launch_args})
        self._sessions[session_id] = session
        for update in history_updates(history, session.cwd):
            await self._conn.session_update(session_id, update)
        self._advertise_commands(session)
        return acp.LoadSessionResponse(
            config_options=self._config_options(session, target), modes=self._modes(session, target)
        )

    async def list_sessions(self, cwd: str | None = None, cursor: str | None = None, **kwargs: Any) -> ListSessionsResponse:
        target = await self._resolve_target()
        listed: list[SessionInfo] = []
        after = cursor
        while len(listed) < LIST_PAGE_SIZE:
            params: dict[str, Any] = {"agent_id": target.agent_id, "kind": "default", "sort_by": "updated_at", "limit": 100}
            if after:
                params["after"] = after
            page = await self._client.session_page(params)
            for row in page.get("data", []):
                workspace = row.get("workspace")
                if row.get("host_id") != target.host_id or not workspace or (cwd and not same_dir(workspace, cwd)):
                    continue
                label = (row.get("labels") or {}).get(SESSION_LABEL)
                listed.append(
                    SessionInfo(
                        session_id=label or f"{IMPORTED_PREFIX}{row['id']}",
                        cwd=workspace,
                        title=row.get("title"),
                        updated_at=_iso(row.get("updated_at")),
                    )
                )
            after = next_cursor(page, after)
            if after is None:
                break
        return ListSessionsResponse(sessions=listed, next_cursor=after)

    async def set_config_option(
        self, config_id: str, session_id: str, value: str | bool, **kwargs: Any
    ) -> acp.SetSessionConfigOptionResponse:
        session = self._session(session_id)
        target = await self._resolve_target()
        if not isinstance(value, str) or config_id not in (MODEL_CONFIG_ID, EFFORT_CONFIG_ID):
            raise acp.RequestError.invalid_params({"configId": config_id})
        if config_id == MODEL_CONFIG_ID:
            session.model = value
            patch = {"model_override": value}
        else:
            session.effort = None if value == EFFORT_DEFAULT else value
            patch = {"reasoning_effort": value}
        if session.conversation_id is not None:
            await self._client.update_session(session.conversation_id, patch)
        return acp.SetSessionConfigOptionResponse(config_options=self._config_options(session, target))

    async def set_session_mode(self, session_id: str, mode_id: str, **kwargs: Any) -> acp.SetSessionModeResponse:
        session = self._session(session_id)
        target = await self._resolve_target()
        if not target.native_plan or mode_id not in ("default", "plan"):
            raise acp.RequestError.invalid_params({"modeId": mode_id})
        session.mode = "plan" if mode_id == "plan" else "default"
        if session.conversation_id is not None:
            await self._client.update_session(session.conversation_id, {"collaboration_mode": session.mode})
        return acp.SetSessionModeResponse()

    async def close_session(self, session_id: str, **kwargs: Any) -> None:
        session = self._sessions.pop(session_id, None)
        if session is None:
            return
        for task in [session.stream_task, *session.background]:
            if task is not None:
                task.cancel()
        turn = session.turn
        if turn is None:
            return
        turn.cancelled.set()
        turn.outputs.put_nowait(TurnEnded("cancelled"))
        if turn.posted and session.conversation_id is not None:
            try:
                await self._client.post_event(session.conversation_id, {"type": "interrupt", "data": {}})
            except (OmnigentError, httpx.HTTPError) as exc:
                LOG.warning("interrupt on close of %s failed: %s", session.conversation_id, exc)

    async def cancel(self, session_id: str, **kwargs: Any) -> None:
        session = self._sessions.get(session_id)
        if session is None or session.turn is None:
            return
        turn = session.turn
        turn.cancelled.set()
        if turn.posted and session.conversation_id is not None:
            await self._interrupt(session.conversation_id, turn)

    async def _interrupt(self, conversation_id: str, turn: Turn) -> None:
        turn.tracker.request_cancel()
        asyncio.get_running_loop().call_later(
            CANCEL_GRACE_S, lambda: turn.outputs.put_nowait(TurnEnded("cancelled"))
        )
        await self._client.post_event(conversation_id, {"type": "interrupt", "data": {}})

    async def _ensure_conversation(self, session: Session, target: Target) -> str:
        if session.conversation_id is None:
            body: dict[str, Any] = {
                "agent_id": target.agent_id,
                "host_id": target.host_id,
                "workspace": session.cwd,
                "labels": {SESSION_LABEL: session.acp_id, "t3.client": "t3code"},
            }
            if session.model:
                body["model_override"] = session.model
            if session.effort:
                body["reasoning_effort"] = session.effort
            launch_args = mcp_launch_args(session.mcp_servers) if self._passes_t3_tools(target) else []
            if launch_args:
                body["terminal_launch_args"] = launch_args
            created = await self._client.create_session(body)
            session.conversation_id = created["id"]
            LOG.info("created Omnigent session %s for %s", created["id"], session.acp_id)
            if target.native_plan and session.mode == "plan":
                await self._client.update_session(session.conversation_id, {"collaboration_mode": "plan"})
        return session.conversation_id

    def _advertise_commands(self, session: Session) -> None:
        """Offer this agent's slash commands once the session's response is out (T3 Code waits 500ms for them)."""
        update = AvailableCommandsUpdate(session_update="available_commands_update", available_commands=COMMANDS)
        self._in_background(session, self._conn.session_update(session.acp_id, update))

    def _in_background(self, session: Session, work: Coroutine[Any, Any, None]) -> None:
        task: asyncio.Task[None] = asyncio.create_task(work)
        session.background.add(task)

        def settled(done: asyncio.Task[None]) -> None:
            session.background.discard(done)
            if not done.cancelled() and done.exception() is not None:
                LOG.warning("background work on %s failed: %s", session.acp_id, done.exception())

        task.add_done_callback(settled)

    async def _resync(self, session: Session, conversation_id: str) -> None:
        turn = session.turn if session.turn is not None and session.turn.posted else None
        try:
            snapshot = await self._client.session_snapshot(conversation_id, items=turn is not None)
        except (OmnigentError, httpx.HTTPError) as exc:
            LOG.warning("snapshot of %s failed: %s", conversation_id, exc)
            return
        if turn is not None and session.turn is turn:
            for output in turn.tracker.on_snapshot(snapshot):
                turn.outputs.put_nowait(output)
        for event in snapshot.get("pending_elicitations") or []:
            if isinstance(event, dict):
                self._in_background(session, self._approve(session, conversation_id, elicitation_from(event)))

    async def _pump(self, session: Session, conversation_id: str) -> None:
        while True:
            try:
                async for event_type, payload in self._client.stream(conversation_id, session.connected):
                    if event_type == STREAM_OPENED:
                        await self._resync(session, conversation_id)
                        continue
                    if self._trace is not None:
                        self._trace.write(json.dumps({"type": event_type, "data": payload}) + "\n")
                        self._trace.flush()
                    turn = session.turn
                    # Approvals outside a running prompt still block the agent until answered.
                    if event_type == "response.elicitation_request" and (
                        turn is None or not turn.posted or turn.tracker.ended
                    ):
                        self._in_background(session, self._approve(session, conversation_id, elicitation_from(payload)))
                    elif turn is not None:
                        for output in turn.tracker.feed(event_type, payload):
                            turn.outputs.put_nowait(output)
            except asyncio.CancelledError:
                raise
            except Exception as exc:  # noqa: BLE001 - reconnect on any transport failure
                if isinstance(exc, OmnigentError) and exc.gone:
                    session.gone = f"Omnigent session {conversation_id} no longer exists (HTTP {exc.status})"
                    LOG.warning("%s; not reconnecting", session.gone)
                    if session.turn is not None:
                        session.turn.outputs.put_nowait(TurnEnded("failed", session.gone))
                    return
                LOG.warning("stream %s dropped: %s", conversation_id, exc)
            session.connected.clear()
            if session.turn is not None:
                session.turn.tracker.on_reconnect()
            await asyncio.sleep(1.0)

    async def _ensure_stream(self, session: Session, conversation_id: str) -> None:
        if session.stream_task is None or session.stream_task.done():
            session.gone = None
            session.stream_task = asyncio.create_task(self._pump(session, conversation_id))
        connected = asyncio.ensure_future(session.connected.wait())
        try:
            await asyncio.wait(
                (connected, session.stream_task), timeout=STREAM_CONNECT_S, return_when=asyncio.FIRST_COMPLETED
            )
        finally:
            connected.cancel()
        if session.connected.is_set():
            return
        if session.gone is not None:
            raise OmnigentError(session.gone)
        raise OmnigentError(f"Omnigent stream for {conversation_id} did not connect in {STREAM_CONNECT_S:.0f}s")

    async def _connect_unless_cancelled(self, session: Session, conversation_id: str, turn: Turn) -> bool:
        connect = asyncio.ensure_future(self._ensure_stream(session, conversation_id))
        cancelled = asyncio.ensure_future(turn.cancelled.wait())
        await asyncio.wait((connect, cancelled), return_when=asyncio.FIRST_COMPLETED)
        cancelled.cancel()
        if turn.cancel_requested:
            connect.cancel()
            return False
        connect.result()
        return True

    async def prompt(self, session_id: str, prompt: list[Any], **kwargs: Any) -> acp.PromptResponse:
        session = self._session(session_id)
        if session.turn is not None:
            raise acp.RequestError.invalid_request({"reason": "a prompt is already running"})
        # The turn exists from the start so that a cancel during setup is not lost.
        turn = Turn(TurnTracker())
        session.turn = turn
        try:
            target = await self._resolve_target()
            turn.tracker.native = target.native
            texts = [block.text for block in prompt if getattr(block, "type", None) == "text"]
            told: T3Mode | None = None
            if self._strip:
                rewritten = strip_t3_instructions(texts, agent_mode=None if target.native_plan else session.told_mode)
                text = rewritten.text
                if not target.native_plan:
                    told = rewritten.announced_mode
            else:
                text = "\n\n".join(texts)
            fork_args = fork_invocation(strip_t3_instructions(texts, agent_mode=None).text)
            if fork_args is not None:
                reply = await self._fork_to(session, fork_args)
                await self._conn.session_update(session.acp_id, acp.update_agent_message_text(reply))
                return acp.PromptResponse(stop_reason="end_turn")
            if turn.cancel_requested:
                return acp.PromptResponse(stop_reason="cancelled")
            conversation_id = await self._ensure_conversation(session, target)
            if not await self._connect_unless_cancelled(session, conversation_id, turn):
                return acp.PromptResponse(stop_reason="cancelled")
            posted = await self._client.post_event(
                conversation_id,
                {"type": "message", "data": {"role": "user", "content": [{"type": "input_text", "text": text}]}},
            )
            if posted.get("denied"):
                reason = str(posted.get("reason") or "Denied by policy")
                await self._conn.session_update(session.acp_id, acp.update_agent_message_text(reason))
                return acp.PromptResponse(stop_reason="refusal")
            turn.posted = True
            if told is not None:
                session.told_mode = told
            turn.tracker.expect_input(posted.get("pending_id"), posted.get("item_id"))
            if turn.cancel_requested:
                await self._interrupt(conversation_id, turn)
            quiet: Quiescent | None = None
            while True:
                try:
                    output = await asyncio.wait_for(turn.outputs.get(), QUIESCENT_END_S if quiet else None)
                except TimeoutError:
                    tracker = turn.tracker
                    if quiet is not None and tracker.quiescent and tracker.quiet_generation == quiet.generation:
                        LOG.info("turn on %s ended by quiescence; no confirmed idle arrived", conversation_id)
                        return acp.PromptResponse(stop_reason="end_turn")
                    quiet = Quiescent(tracker.quiet_generation) if tracker.quiescent else None
                    continue
                if isinstance(output, Quiescent):
                    quiet = output
                    continue
                if isinstance(output, TurnEnded):
                    if output.outcome == "cancelled" or turn.cancel_requested:
                        return acp.PromptResponse(stop_reason="cancelled")
                    if output.outcome == "failed":
                        raise acp.RequestError.internal_error({"message": output.error})
                    return acp.PromptResponse(stop_reason="end_turn")
                await self._forward(session, conversation_id, output)
        finally:
            session.turn = None

    async def _fork_to(self, session: Session, args: list[str]) -> str:
        """Fork this thread's Omnigent session onto another host; the reply to show in the thread."""
        if not args or len(args) > 2:
            return f"Usage: /{FORK_COMMAND} {FORK_HINT}"
        if session.conversation_id is None:
            return "Nothing to fork yet: this thread gets its Omnigent session with its first message."
        try:
            host = resolve_host(await self._client.hosts(), args[0])
        except (OmnigentError, httpx.HTTPError) as exc:
            return f"Fork failed: {exc}"
        try:
            home = await self._client.host_home(host["host_id"])
        except (OmnigentError, httpx.HTTPError) as exc:
            LOG.warning("home of %s unknown, assuming this machine's layout: %s", host["host_id"], exc)
            home = None
        name = str(host.get("name") or host["host_id"])
        workspace = fork_workspace(args[1] if len(args) == 2 else None, session.cwd, home)
        try:
            fork_id = str((await self._client.fork_session(session.conversation_id, {}))["id"])
        except (OmnigentError, httpx.HTTPError) as exc:
            return f"Fork failed: {exc}"
        imported = f"{IMPORTED_PREFIX}{fork_id}"
        try:
            # The copied label would make the fork answer for this thread on its new host.
            await self._client.update_session(fork_id, {"labels": {SESSION_LABEL: imported}})
            await self._client.launch_runner(host["host_id"], fork_id, workspace)
        except (OmnigentError, httpx.HTTPError) as exc:
            return (
                f"Forked this session to `{fork_id}`, but could not start it on {name} in `{workspace}`: {exc}\n"
                "Pick its host and directory in the Omnigent app."
            )
        return (
            f"Forked this session to `{fork_id}` on {name}, in `{workspace}`.\n"
            f"Continue it in the Omnigent app, or in T3 Code on {name}, where it is listed as `{imported}`."
        )

    async def _forward(self, session: Session, conversation_id: str, output: TurnOutput) -> None:
        sid = session.acp_id
        match output:
            case TextDelta(text):
                await self._conn.session_update(sid, acp.update_agent_message_text(text))
            case ThoughtDelta(text):
                await self._conn.session_update(sid, acp.update_agent_thought_text(text))
            case ToolStarted(call_id, name, arguments):
                diffs = edit_diffs(name, arguments, session.cwd)
                if diffs:
                    session.tool_diffs[call_id] = diffs
                paths = dict.fromkeys(diff.path for diff in diffs)
                await self._conn.session_update(
                    sid,
                    acp.start_tool_call(
                        call_id,
                        name,
                        kind=_tool_kind(name),
                        status="in_progress",
                        content=diffs or None,
                        locations=[ToolCallLocation(path=path) for path in paths] or None,
                        raw_input=arguments,
                    ),
                )
            case ToolFinished(call_id, text):
                # Updated content replaces the call's content, so an edit's diff is sent again.
                await self._conn.session_update(
                    sid,
                    acp.update_tool_call(
                        call_id,
                        status="completed",
                        content=[
                            *session.tool_diffs.pop(call_id, []),
                            acp.tool_content(acp.text_block(text[:TOOL_OUTPUT_LIMIT])),
                        ],
                    ),
                )
            case Usage(used, size):
                await self._conn.session_update(sid, UsageUpdate(session_update="usage_update", used=used, size=size))
            case Elicitation():
                await self._approve(session, conversation_id, output)
            case TurnEnded() | Quiescent():
                pass

    async def _approve(self, session: Session, conversation_id: str, request: Elicitation) -> None:
        # The snapshot re-lists approvals the stream already delivered.
        if request.elicitation_id in session.elicitations:
            return
        session.elicitations.add(request.elicitation_id)
        response = await self._conn.request_permission(
            session.acp_id,
            ToolCallUpdate(
                tool_call_id=f"omnigent-elicitation-{request.elicitation_id}",
                title=request.message,
                kind="execute",
                raw_input={"command": request.preview} if request.preview else None,
            ),
            [
                PermissionOption(option_id="accept", name="Approve", kind="allow_once"),
                # Omnigent asks per call; T3 Code's "always" button still means approve this one.
                PermissionOption(option_id="accept_always", name="Approve", kind="allow_always"),
                PermissionOption(option_id="decline", name="Deny", kind="reject_once"),
            ],
        )
        outcome = response.outcome
        selected = outcome.option_id if getattr(outcome, "outcome", None) == "selected" else None
        action = {"accept": "accept", "accept_always": "accept", "decline": "decline"}.get(selected or "", "cancel")
        target = request.target_session_id or conversation_id
        try:
            await self._client.resolve_elicitation(target, request.elicitation_id, action)
        except (OmnigentError, httpx.HTTPError) as exc:
            # Resolved elsewhere or timed out; the agent has moved on either way.
            LOG.warning("resolving approval %s on %s failed: %s", request.elicitation_id, target, exc)


def open_trace(path: str) -> TextIO:
    """Open the trace for appending, readable by its owner only: it holds every prompt and output."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    os.fchmod(fd, 0o600)
    return os.fdopen(fd, "a", encoding="utf-8")


async def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--agent", default="claude-native-ui", help="Omnigent agent name or id")
    parser.add_argument("--host", default="auto", help="'auto' (this machine), or a host name or id")
    parser.add_argument("--url", default=os.environ.get("OMNIGENT_URL", "http://127.0.0.1:6767"))
    parser.add_argument("--keep-t3-instructions", action="store_true", help="forward T3 Code's prompt wrappers")
    parser.add_argument(
        "--t3-tools",
        action="store_true",
        help="claude-native only: give the TUI the client's MCP servers at launch and keep T3 Code's tool instructions",
    )
    parser.add_argument("--trace", help="append every Omnigent stream event to this JSONL file")
    args = parser.parse_args()
    logging.basicConfig(
        stream=sys.stderr,
        level=os.environ.get("OMNIGENT_ACP_LOG", "INFO").upper(),
        format="omnigent-acp %(levelname)s %(message)s",
    )
    client = OmnigentClient(args.url)
    trace = open_trace(args.trace) if args.trace else None
    try:
        agent = OmnigentAgent(
            client,
            args.agent,
            args.host,
            strip=not (args.keep_t3_instructions or args.t3_tools),
            t3_tools=args.t3_tools,
            trace=trace,
        )
        # session/close and session/fork are "unstable" in this SDK and 404 without the flag.
        await acp.run_agent(agent, use_unstable_protocol=True)
    finally:
        await client.aclose()
        if trace is not None:
            trace.close()


if __name__ == "__main__":
    asyncio.run(main())
