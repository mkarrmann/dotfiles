#!/usr/bin/env bash
# Stage or activate the desktop's standard local Omnigent service.
set -euo pipefail

DOTFILES="${DOTFILES_DIR:-$HOME/dotfiles}"
if [[ "$("$DOTFILES/bin/dotfiles-profile")" != desktop ]]; then
  echo "omnigent-desktop-ensure requires the desktop profile" >&2
  exit 1
fi

if [[ $# -gt 1 || ( $# -eq 1 && "$1" != --stage ) ]]; then
  echo "usage: omnigent-desktop-ensure [--stage]" >&2
  exit 2
fi

platform="$(uname -s)"
if [[ "$platform" == Linux ]]; then
  unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  for name in omnigent-host.service omnigent-watcher.service; do
    unit="$unit_dir/$name"
    source="$DOTFILES/systemd/desktop/$name"
    if [[ -e "$unit" || -L "$unit" ]]; then
      if [[ ! -L "$unit" ]] || {
        target="$(readlink -f "$unit")"
        [[ "$target" != "$source" && "$target" != "$DOTFILES/systemd/$name" ]]
      }; then
        echo "ERROR: $unit is not a managed dotfiles unit; merge it before setup" >&2
        exit 1
      fi
    fi
  done
  mkdir -p "$unit_dir" "$HOME/.local/state/omnigent-watcher"
  for name in omnigent-host.service omnigent-watcher.service; do
    ln -sfn "$DOTFILES/systemd/desktop/$name" "$unit_dir/$name"
  done
elif [[ "$platform" == Darwin ]]; then
  watcher_label=com.mkarrmann.omnigent-watcher
  watcher_plist="$HOME/Library/LaunchAgents/$watcher_label.plist"
  python3 - "$HOME" "$DOTFILES" "$watcher_plist" "$watcher_label" <<'PY'
from pathlib import Path
import plistlib
import sys

home, dotfiles, destination = map(Path, sys.argv[1:4])
label = sys.argv[4]
project = dotfiles / "services/omnigent-watcher"
log_dir = home / ".local/state/omnigent-watcher"
payload = {
    "Label": label,
    "ProgramArguments": [
        str(project / ".venv/bin/omnigent-watcher"),
        "--config", str(project / "config.toml"), "run",
    ],
    "WorkingDirectory": str(project),
    "EnvironmentVariables": {
        "PATH": f"{home}/.local/bin:{home}/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "OMNIGENT_URL": "http://127.0.0.1:6767",
    },
    "RunAtLoad": True,
    "KeepAlive": True,
    "ThrottleInterval": 5,
    "StandardOutPath": str(log_dir / "service.log"),
    "StandardErrorPath": str(log_dir / "service.log"),
    "Umask": 0o077,
}
encoded = plistlib.dumps(payload)
if destination.exists() or destination.is_symlink():
    try:
        existing = plistlib.loads(destination.read_bytes())
    except (OSError, ValueError):
        existing = {}
    arguments = existing.get("ProgramArguments") if isinstance(existing, dict) else None
    if destination.is_symlink() or not isinstance(arguments, list) or arguments[:1] != payload["ProgramArguments"][:1]:
        raise SystemExit(f"ERROR: {destination} is not a managed dotfiles job; merge it before setup")
log_dir.mkdir(parents=True, exist_ok=True)
destination.parent.mkdir(parents=True, exist_ok=True)
if not destination.exists() or destination.read_bytes() != encoded:
    destination.write_bytes(encoded)
PY
else
  echo "Unsupported desktop platform: $platform" >&2
  exit 1
fi

[[ "${1:-}" != --stage ]] || exit 0

real="$HOME/.local/bin/omnigent"
if [[ ! -x "$real" ]]; then
  if ! command -v uv >/dev/null 2>&1; then
    echo "uv is required to install Omnigent" >&2
    exit 1
  fi
  uv tool install 'omnigent>=0.12.0'
fi

"$DOTFILES/bin/omnigent-config-ensure"
export OMNIGENT_URL=http://127.0.0.1:6767

if [[ "$platform" == Linux ]]; then
  # Retire only the work units we own, before starting the local runtime.
  retired=()
  while IFS= read -r name; do
    [[ -n "$name" && "$name" != \#* ]] || continue
    if [[ -L "$unit_dir/$name" &&
          "$(readlink -f "$unit_dir/$name")" == "$DOTFILES/systemd/$name" ]]; then
      retired+=("$name")
    fi
  done < "$DOTFILES/systemd/desktop/disabled-units.list"
  if (( ${#retired[@]} )); then
    systemctl --user disable --now "${retired[@]}"
  fi
  # init.sh deliberately converges running services. Stop before reloading so
  # the old service completes its own shutdown using its loaded definition.
  systemctl --user stop omnigent-watcher.service omnigent-host.service
  # A CLI invocation may have left a detached local server. Stop it as well:
  # host-only stop preserves that server and its old router imports.
  "$real" server stop
  systemctl --user daemon-reload
  exec systemctl --user enable --now omnigent-host.service omnigent-watcher.service
fi

export PYTHONPATH="$DOTFILES/omnigent_config/policy_modules:$DOTFILES/services/omnigent-watcher/src${PYTHONPATH:+:$PYTHONPATH}"
# `start` reuses a daemon whose signature excludes router configuration.
# Explicit convergence must cycle the local server to load these imports.
"$real" server stop
"$real" start --server '' --non-interactive
launch_domain="gui/$(id -u)"
if launchctl print "$launch_domain/$watcher_label" >/dev/null 2>&1; then
  launchctl bootout "$launch_domain/$watcher_label"
fi
exec launchctl bootstrap "$launch_domain" "$watcher_plist"
