#!/usr/bin/env bash
# Install the Markdown language server (marksman) used by nvim.
#
# The markdown extra imported in nvim/lua/config/lazy.lua registers marksman,
# but Mason fetches it from GitHub releases and cannot install it in this
# environment, so vim.lsp rejected the config on every startup. Installing it
# here means the nvim spec can enable it on any machine that has it and stay
# quiet on machines that do not.
#
# NOT installed to ~/bin: that directory is populated by sync.sh from
# dotfiles/bin, and a ~20MB binary does not belong in the repo. ~/.local/bin is
# machine-local; dotsync2 manages individual files there (.local/bin/tmux), not
# the directory, so an extra binary is left alone.
#
# The absolute path matters. The nvs units inherit the systemd --user PATH,
# which is only /usr/local/{s,}bin:/usr/{s,}bin -- no ~/.local/bin -- so
# nvim/lua/plugins/overrides.lua points marksman's cmd at BIN directly rather
# than relying on PATH.
#
# Curl is deliberately invoked with no --proxy: ~/.curlrc already routes through
# fwdproxy:8082 with an x509 client cert, and overriding that with a bare
# fwdproxy:8080 gets a 403.
#
# Override for a one-off with MARKSMAN_VERSION=x.y.z marksman-ensure.
set -euo pipefail

VERSION="${MARKSMAN_VERSION:-2024-12-18}"
BIN="${MARKSMAN_BIN:-$HOME/.local/bin/marksman}"

# Candidate asset names, tried in order. Upstream has published macOS both as
# per-arch files and as a single universal `marksman-macos`, so rather than pin
# one guess we take the first that downloads.
case "$(uname -s)/$(uname -m)" in
  Linux/x86_64)   assets=(marksman-linux-x64) ;;
  Linux/aarch64)  assets=(marksman-linux-arm64) ;;
  Darwin/arm64)   assets=(marksman-macos-arm64 marksman-macos) ;;
  Darwin/x86_64)  assets=(marksman-macos-x64 marksman-macos) ;;
  *)
    echo "[marksman] unsupported platform $(uname -s)/$(uname -m); skipping" >&2
    exit 0
    ;;
esac

# The release tag cannot be recovered from the binary: `marksman --version`
# reports a build id ("1.0.0-8299f11+8299f11dfad36a9162e010245b380ba25001b15c"),
# not "2024-12-18". So record which tag we installed alongside it. Deriving the
# stamp from BIN keeps MARKSMAN_BIN overrides self-consistent.
STAMP="$(dirname "$BIN")/.marksman-release"

installed=""
if [[ -x "$BIN" && -r "$STAMP" ]] && "$BIN" --version >/dev/null 2>&1; then
  installed="$(<"$STAMP")"
fi

if [[ "$installed" == "$VERSION" ]]; then
  echo "[marksman] $VERSION already installed at $BIN"
  exit 0
fi

echo "[marksman] installing $VERSION (was ${installed:-none})"

mkdir -p "$(dirname "$BIN")"
tmp="$(mktemp "${TMPDIR:-/tmp}/marksman.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

# --fail so an HTML error page is not written out as if it were the binary:
# a plain `curl -sSL -o` can exit 0 having produced nothing usable.
got=""
for asset in "${assets[@]}"; do
  url="https://github.com/artempyanykh/marksman/releases/download/${VERSION}/${asset}"
  if curl -sSLf -o "$tmp" "$url"; then
    got="$url"
    break
  fi
  echo "[marksman] not available: $asset" >&2
done

if [[ -z "$got" ]]; then
  echo "WARNING: could not download marksman $VERSION for $(uname -s)/$(uname -m)" >&2
  echo "         tried: ${assets[*]}" >&2
  echo "         (nvim leaves marksman disabled when the binary is absent)" >&2
  exit 1
fi
echo "[marksman] downloaded $got"

# Size guard: the real binary is tens of MB, an error page is bytes.
size="$(wc -c <"$tmp")"
if (( size < 1000000 )); then
  echo "ERROR: downloaded marksman is only ${size} bytes; refusing to install" >&2
  exit 1
fi

chmod +x "$tmp"

# Prove it runs on this machine before putting it in place -- it is a
# self-contained .NET binary and can fail on an unexpected libc. Only that it
# runs is checked: the reported build id says nothing about the release tag.
if ! build="$("$tmp" --version 2>/dev/null)" || [[ -z "$build" ]]; then
  echo "ERROR: downloaded marksman does not execute here" >&2
  exit 1
fi

mv -f "$tmp" "$BIN"
trap - EXIT
# Written after the move, so a failed install never claims a version.
printf '%s\n' "$VERSION" >"$STAMP"
echo "[marksman] installed $VERSION at $BIN ($build)"
