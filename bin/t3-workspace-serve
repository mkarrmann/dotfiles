#!/usr/bin/env bash
# t3-workspace-serve NAME — run this host's T3 Code server (systemd/t3@.service).
#
# The server's data lives in ~/.t3-workspaces/NAME and it serves from $HOME;
# its projects are the workspaces' directories, which bin/t3-ensure adds with
# `t3 project add` rather than --auto-bootstrap-project-from-cwd: T3 Code shows
# its first-run wizard while a server's only project is the one it bootstrapped
# on its current start.
#
# On the work hubs NAME is "checkouts", the one server for every ~/checkoutN,
# and it listens on 127.0.0.1:T3_PORT (omnigent_config/topology.env); on the Mac
# NAME is "local" (launchd/com.mkarrmann.t3-local.plist), on the same port. The
# desktop runs one server for every t3 row of bin-linux/startup-windows' table:
# NAME is that layout's t3Server and it listens on its t3Port. Any other NAME,
# such as a t3@checkoutN from when each checkout had a server of its own, exits
# 2, which the unit takes as a stop rather than a restart.
set -euo pipefail

name="${1:?usage: t3-workspace-serve SERVER}"
dotfiles="${DOTFILES_DIR:-$HOME/dotfiles}"

if [[ "$("$dotfiles/bin/dotfiles-profile")" == desktop ]]; then
  layout="$("$dotfiles/bin-linux/startup-windows" --print-layout)"
  [[ "$name" == "$(jq -r .t3Server <<< "$layout")" ]] || {
    echo "t3-workspace-serve: bin-linux/startup-windows' t3 server is '$(jq -r .t3Server <<< "$layout")', not '$name'" >&2
    exit 2
  }
  port="$(jq -r .t3Port <<< "$layout")"
else
  expected=checkouts
  [[ "$(uname -s)" != Darwin ]] || expected=local
  [[ "$name" == "$expected" ]] || {
    echo "t3-workspace-serve: this host's t3 server is '$expected', not '$name'" >&2
    exit 2
  }
  topology="${OMNIGENT_TOPOLOGY_FILE:-$dotfiles/omnigent_config/topology.env}"
  port="$(sed -n 's/^T3_PORT=//p' "$topology" 2>/dev/null | tail -n 1)"
  port="${port:-3780}"
fi

t3="$HOME/.local/bin/t3"
[[ -x "$t3" ]] || t3="$(command -v t3)" || {
  echo "t3-workspace-serve: no t3 command; run bin/t3-ensure" >&2
  exit 1
}

export T3CODE_HOME="$HOME/.t3-workspaces/$name"
# T3 Code's product analytics (PostHog through ingest.t3.codes, token counts
# included) and relay tracing are on unless this is false (.shell_env sets it
# too, for the desktop app); the services do not read the shell's env.
export T3CODE_TELEMETRY_ENABLED=false
cd "$HOME"
exec "$t3" serve --host 127.0.0.1 --port "$port" --no-browser
