#!/usr/bin/env bash
# t3-workspace-serve NAME — run T3 Code's server for one workspace (systemd/t3@.service).
#
# The server's data lives in ~/.t3-workspaces/NAME and its one project is the
# workspace's directory, so a client sees only that workspace. bin/t3-ensure
# adds that project with `t3 project add` rather than
# --auto-bootstrap-project-from-cwd: T3 Code shows its first-run wizard while a
# server's only project is the one it bootstrapped on its current start.
#
# On the work hubs NAME is a checkout: ~/checkoutN listens on
# 127.0.0.1:T3_BASE_PORT+N (omnigent_config/topology.env). On the desktop NAME
# is a terminal slot with a t3 row in bin-linux/startup-windows' table, which
# gives its directory and port.
set -euo pipefail

name="${1:?usage: t3-workspace-serve CHECKOUT|SLOT}"
dotfiles="${DOTFILES_DIR:-$HOME/dotfiles}"

if [[ "$("$dotfiles/bin/dotfiles-profile")" == desktop ]]; then
  server="$("$dotfiles/bin-linux/startup-windows" --print-layout |
    jq -c --arg slot "$name" 'first(.t3[] | select(.slot == $slot)) // empty')"
  [[ -n "$server" ]] || {
    echo "t3-workspace-serve: no t3 row in bin-linux/startup-windows declares slot '$name'" >&2
    exit 2
  }
  workdir="$(jq -r .workdir <<< "$server")"
  port="$(jq -r .port <<< "$server")"
else
  [[ "$name" =~ ^checkout([0-9]+)$ ]] || {
    echo "t3-workspace-serve: expected a checkoutN directory name, got '$name'" >&2
    exit 2
  }
  index="${BASH_REMATCH[1]}"
  topology="${OMNIGENT_TOPOLOGY_FILE:-$dotfiles/omnigent_config/topology.env}"
  base_port="$(sed -n 's/^T3_BASE_PORT=//p' "$topology" 2>/dev/null | tail -n 1)"
  port=$(( ${base_port:-3780} + index ))
  workdir="$HOME/$name"
fi

t3="$HOME/.local/bin/t3"
[[ -x "$t3" ]] || t3="$(command -v t3)" || {
  echo "t3-workspace-serve: no t3 command; run bin/t3-ensure" >&2
  exit 1
}

export T3CODE_HOME="$HOME/.t3-workspaces/$name"
cd "$workdir"
exec "$t3" serve --host 127.0.0.1 --port "$port" --no-browser
