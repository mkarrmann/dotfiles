#!/usr/bin/env bash
# t3-pairing-tokens [COUNT] — print COUNT one-time pairing tokens from t3@checkouts.
#
# bin-macos/nvs-tunnels runs this inside its ET session, so minting needs no
# login beyond the tunnel's own, and hands the tokens to startup-windows. Every
# Mac workspace window pairs with each devserver's server, its own host's and
# the others' (bin/t3-window-scope --link), and a token pairs only once, so
# nvs-tunnels asks for enough for every window, with room for windows reopened
# before the tunnel next reconnects. Tokens last 12 hours.
# Output: one "T3_PAIR TOKEN" line per token; nothing while the server is not
# running.
set -uo pipefail

count="${1:-16}"
[[ "$count" =~ ^[0-9]+$ ]] || { echo "usage: t3-pairing-tokens [COUNT]" >&2; exit 2; }
t3="$HOME/.local/bin/t3"
[[ -x "$t3" ]] || exit 0
systemctl --user is-active --quiet t3@checkouts.service || exit 0
for ((i = 0; i < count; i++)); do
  token="$(T3CODE_HOME="$HOME/.t3-workspaces/checkouts" "$t3" pair --ttl 12h --label "mac-startup-windows" 2>/dev/null \
    | sed -n 's/^Token: //p' | tr -d '\r')"
  [[ -n "$token" ]] && echo "T3_PAIR $token"
done
exit 0
