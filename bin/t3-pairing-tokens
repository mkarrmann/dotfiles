#!/usr/bin/env bash
# t3-pairing-tokens — print a one-time pairing token per ~/checkoutN from t3@checkouts.
#
# bin-macos/nvs-tunnels runs this inside its ET session, so minting needs no
# login beyond the tunnel's own, and hands the tokens to startup-windows, which
# opens each new workspace window on /pair with its checkout's token. The
# checkouts share one server, but a token pairs only once, so each window
# needs its own.
# Output: one "T3_PAIR checkoutN TOKEN" line per checkout; nothing while the
# server is not running.
set -uo pipefail

t3="$HOME/.local/bin/t3"
[[ -x "$t3" ]] || exit 0
systemctl --user is-active --quiet t3@checkouts.service || exit 0
for dir in "$HOME"/checkout*; do
  checkout="$(basename "$dir")"
  [[ -d "$dir" && "$checkout" =~ ^checkout[0-9]+$ ]] || continue
  token="$(T3CODE_HOME="$HOME/.t3-workspaces/checkouts" "$t3" pair --ttl 12h --label "mac-startup-windows" 2>/dev/null \
    | sed -n 's/^Token: //p' | tr -d '\r')"
  [[ -n "$token" ]] && echo "T3_PAIR $checkout $token"
done
exit 0
