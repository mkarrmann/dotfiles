# TLS + HTTP/2 front door for the Omnigent desktop app.
#
# The app's web layer picks its live-stream budget from the navigation's
# negotiated ALPN id (`getConnectionProtocol` -> `maxLiveConversations`):
# HTTP/1.1 allows 3 concurrent conversation streams origin-wide, HTTP/2 allows
# 30. Chromium caps HTTP/1.1 at 6 sockets per origin and an SSE stream holds one
# for its whole life, so with more than ~3 Omnigent windows the app opens more
# streams than the pool can hold and every other fetch deadlocks behind them —
# recoverable only by restarting the app. Chromium never negotiates cleartext
# h2, so lifting that ceiling requires TLS.
#
# This listener exists purely to give the app an h2 origin. `mac_proxy` keeps
# serving plain HTTP on OMNIGENT_PORT for the CLI and every dotfiles health
# probe, so rollback is just re-pointing the app back at http://127.0.0.1:6767.
#
# `admin off` below is deliberate -- the admin API is a full reconfiguration
# endpoint on loopback, and this machine runs a lot of local agents. It costs
# the two caddy subcommands that talk to it, so use these instead:
#
#   trust the local CA (what `caddy trust` would do):
#     sudo security add-trusted-cert -d -r trustRoot \
#       -k /Library/Keychains/System.keychain \
#       ~/Library/Application\ Support/Caddy/pki/authorities/local/root.crt
#
#   apply an edit to this file (what `caddy reload` would do):
#     launchctl kickstart -k gui/$UID/com.mkarrmann.omnigent-tls
#
# Re-trust is only needed if caddy regenerates its CA -- a wiped data
# directory, or root expiry in 2036.
{
	admin off
	auto_https disable_redirects

	# h3 would also satisfy the app's multiplexed check, but QUIC adds a
	# transport that can fail independently of TCP. h2 is all this needs.
	servers {
		protocols h1 h2
	}
}

# Port mirrors OMNIGENT_TLS_PORT in omnigent_config/topology.env, the same way
# mac_proxy mirrors the tunnel-port defaults. topology.env is authoritative for
# the shell side; change both together.
#
# The `*.omnigent.localhost` names give each AeroSpace workspace's Omnigent
# window its own ORIGIN on this one listener. The app persists "which host and
# which checkout the composer starts on" in localStorage
# (`omnigent:last-host-choice`, `omnigent:recent-workspaces`), which is
# app-global -- every window shares it, so picking a checkout in one window
# silently moves every other window. localStorage is partitioned by origin, so
# distinct names turn that shared memory into per-window memory with no change
# to the app. See docs/omnigent-window-location-design.md.
#
# Names rather than extra ports, for two reasons: `web/electron/src/url.js`
# treats {localhost, 127.0.0.1, ::1} as an exact set that infers `http`, so
# `localhost:<other port>` deep links could never reach a TLS listener; and the
# app prefixes notification titles with the firing origin's host, which makes a
# descriptive name useful attribution instead of noise.
#
# No /etc/hosts entries: macOS resolves *.localhost to loopback natively
# (verified with getaddrinfo). One `tls internal` covers every name here --
# Caddy issues each from the CA already trusted for 6443, so no new trust step.
#
# TODO: this address list is about to be generated from the bin/workspaces
# table rather than hand-maintained; see the design doc's single-source-of-truth
# section.
localhost:6443, 127.0.0.1:6443,
local.omnigent.localhost:6443,
cco-checkout1.omnigent.localhost:6443,
ftw-checkout1.omnigent.localhost:6443,
cco-checkout2.omnigent.localhost:6443,
ftw-checkout2.omnigent.localhost:6443,
cco-checkout3.omnigent.localhost:6443,
ftw-checkout3.omnigent.localhost:6443,
cco-checkout4.omnigent.localhost:6443 {
	tls internal

	reverse_proxy 127.0.0.1:6767 {
		# SSE and the updates WebSocket must not sit in a proxy buffer.
		flush_interval -1

		# The hub currently sees `Host: 127.0.0.1:6767` from the app. Keep that
		# exact value so introducing this hop cannot change server-side routing
		# or any absolute URL the hub builds from Host.
		header_up Host {upstream_hostport}
	}
}
