# Personal Omnigent topology shared by the Mac and every devserver.
OMNIGENT_PRIMARY_FQDN=devvm20365.cco0.facebook.com
OMNIGENT_STANDBY_FQDN=devvm36111.ftw0.facebook.com
OMNIGENT_PORT=6767
# TLS + HTTP/2 front door the macOS desktop app connects through. It reverse
# proxies to OMNIGENT_PORT; the CLI and every health probe keep using the plain
# port. Exists because an HTTP/1.1 origin caps the app at 3 live conversation
# streams and deadlocks its connection pool past that -- see
# services/omnigent-tls/Caddyfile. Mirrored as a default in that Caddyfile.
OMNIGENT_TLS_PORT=6443
# Private local backend port the Linux client proxy's SSH tunnel feeds; the
# persistent forwarder owns OMNIGENT_PORT and relays to it (Linux clients only).
OMNIGENT_CLIENT_BACKEND_PORT=6768
OMNIGENT_PRIMARY_TUNNEL_PORT=16767
OMNIGENT_STANDBY_TUNNEL_PORT=26767
# Minimum Omnigent release every hub and the Mac client must run. A FLOOR, not
# a pin: bin/omnigent-version-ensure rolls a host below this up to the latest
# release and leaves a host above it alone, so a machine can run ahead
# deliberately. Bump this to move the fleet forward (see the script's header).
OMNIGENT_MIN_VERSION=0.20.0
OMNIGENT_OWNER_FBID=1097089018461839
# T3 Code server on each candidate (bin/t3-ensure), loopback-only, as a UI over
# that host's Omnigent sessions. The Mac reaches it on these local ports through
# bin-macos/nvs-tunnels. Not named T3CODE_PORT: that is T3 Code's own variable.
T3_SERVER_PORT=3773
T3_PRIMARY_TUNNEL_PORT=13773
T3_STANDBY_TUNNEL_PORT=23773
