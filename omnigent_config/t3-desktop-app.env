# First-install pin for bin/t3-desktop-app-ensure, from
# https://github.com/pingdotgg/t3code/releases/tag/v0.1.7. The installed app
# updates itself, so a bump only moves what a fresh machine starts from.
# Update the version, versioned asset URL, and checksum together. The checksum
# is the .deb's sha512 exactly as the release's latest-linux.yml publishes it
# (base64): the release's SHA256SUMS covers only the t3 CLI archives.
T3_DESKTOP_APP_VERSION=0.1.7
T3_DESKTOP_APP_URL=https://github.com/pingdotgg/t3code/releases/download/v0.1.7/T3-Code-0.1.7-amd64.deb
T3_DESKTOP_APP_SHA512=y3zMDEKizwpskpAmrwzS97GiBoFhtIVNFkAVrXWIs5gbaV4ij9HxOHRhulsJ1Af3HLw5rKAYuTlrhb/FaPxvYA==
